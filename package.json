{
  "name": "cubby-ui",
  "version": "0.2.0",
  "description": "Framework-agnostic UI components with pure HTML + Tailwind CSS",
  "type": "module",
  "main": "dist/core/cubby-ui.js",
  "types": "dist/core/cubby-ui.d.ts",
  "style": "dist/core/cubby-ui.css",
  "browser": "dist/core/cubby-ui.min.js",
  "unpkg": "dist/core/cubby-ui.min.css",
  "jsdelivr": "dist/core/cubby-ui.min.css",
  "exports": {
    ".": {
      "types": "./dist/core/cubby-ui.d.ts",
      "style": "./dist/core/cubby-ui.css",
      "default": "./dist/core/cubby-ui.js"
    },
    "./css": "./dist/core/cubby-ui.css",
    "./css/min": "./dist/core/cubby-ui.min.css",
    "./js": "./dist/core/cubby-ui.js",
    "./js/min": "./dist/core/cubby-ui.min.js",
    "./components.json": "./dist/components.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "components.json"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "rm -rf dist && mkdir -p dist/core && tailwindcss -i ./src/styles/lib.css -o ./dist/core/cubby-ui.css && tailwindcss -i ./src/styles/lib.css -o ./dist/core/cubby-ui.min.css --minify && node scripts/build-js.mjs && cp ./src/scripts/cubby-ui.d.ts ./dist/core/cubby-ui.d.ts && cp ./components.json ./dist/components.json && terser ./dist/core/cubby-ui.js -o ./dist/core/cubby-ui.min.js -c -m --source-map",
    "build:js": "node scripts/build-js.mjs",
    "build:blade": "node scripts/generate-blade-components.cjs && cp stubs/laravel/CubbyUiServiceProvider.php stubs/laravel/README.md dist/laravel/",
    "test": "npm run check:sync && npm run test:blade && npm run test:e2e",
    "test:blade": "node scripts/blade/test-blade-syntax.cjs",
    "test:e2e": "playwright test",
    "check:sync": "node scripts/check-component-sync.cjs",
    "type-check": "astro check",
    "build:docs": "npm run i18n:routes && astro build",
    "build:all": "npm run build && npm run build:blade",
    "preview": "astro preview",
    "clean": "rm -rf dist node_modules/.astro node_modules/.vite",
    "i18n:routes": "node scripts/generate-i18n-routes.js",
    "astro": "astro",
    "prepare": "npm run build:all",
    "prepublishOnly": "npm run build"
  },
  "sideEffects": [
    "*.css",
    "dist/core/cubby-ui.js",
    "dist/core/cubby-ui.min.js"
  ],
  "keywords": [
    "ui",
    "components",
    "tailwindcss",
    "html",
    "css",
    "framework-agnostic"
  ],
  "author": "Denny Kuo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dennykuo/cubby-ui.git"
  },
  "bugs": {
    "url": "https://github.com/dennykuo/cubby-ui/issues"
  },
  "homepage": "https://github.com/dennykuo/cubby-ui#readme",
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^20.19.43",
    "astro": "^5.1.0",
    "astro-expressive-code": "^0.41.6",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.18",
    "terser": "^5.37.0"
  }
}
