---
import "../../../styles/global.css";
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Forgot Password — Dashboard" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>重設密碼 — Acme Inc.</title>
	</head>
	<body class="min-h-screen font-sans">
		<div class="grid min-h-screen lg:grid-cols-2">
			<!-- Left: Brand -->
			<div class="hidden lg:flex flex-col justify-between bg-gradient-to-br from-foreground to-foreground/85 p-10 text-primary-foreground">
				<div class="flex items-center gap-2.5">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary-foreground">
						<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
						<polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
						<line x1="12" y1="22.08" x2="12" y2="12"></line>
					</svg>
					<span class="text-lg font-semibold tracking-tight">Acme Inc.</span>
				</div>
				<div class="space-y-6">
					<div class="p-6 rounded-2xl bg-white/5 border border-white/10">
						<div class="flex items-center justify-center w-16 h-16 rounded-full bg-white/10 mb-4">
							<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<rect width="20" height="16" x="2" y="4" rx="2"/>
								<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-2">檢查您的信箱</h3>
						<p class="text-sm opacity-70 leading-relaxed">
							我們將發送一封包含重設密碼連結的郵件到您的信箱。請確認您輸入的是註冊時使用的 Email 地址。
						</p>
					</div>
				</div>
				<p class="text-xs opacity-50">© 2026 Acme Inc. All rights reserved.</p>
			</div>

			<!-- Right: Forgot Password form -->
			<div class="flex items-center justify-center p-8">
				<div class="w-full max-w-sm space-y-6">
					<!-- Mobile logo -->
					<div class="flex items-center gap-2.5 lg:hidden mb-8">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
							<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
							<polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
							<line x1="12" y1="22.08" x2="12" y2="12"></line>
						</svg>
						<span class="text-base font-semibold tracking-tight">Acme Inc.</span>
					</div>

					<div class="space-y-2">
						<h1 class="text-2xl font-bold tracking-tight">忘記密碼？</h1>
						<p class="text-sm text-muted-foreground">輸入您的 Email，我們將發送重設密碼的連結</p>
					</div>

					<form class="space-y-4" action="/examples/dashboard/login">
						<div class="cu-form-group">
							<label class="cu-label" for="email">Email</label>
							<input class="cu-input" id="email" type="email" placeholder="name@example.com" required aria-required="true" />
						</div>
						<button type="submit" class="cu-button cu-button-default cu-button-md w-full">發送重設連結</button>
					</form>

					<p class="text-center text-sm text-muted-foreground">
						想起密碼了？
						<a href="/examples/dashboard/login" class="cu-link">返回登入</a>
					</p>
				</div>
			</div>
		</div>
	</body>
</html>
