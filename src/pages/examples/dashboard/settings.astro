---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
---

<DashboardLayout title="設定 — Acme Inc.">
	<div class="space-y-6">
		<!-- Page header -->
		<div>
			<h1 class="text-2xl font-bold tracking-tight">設定</h1>
			<p class="text-sm text-muted-foreground mt-1">管理您的帳號偏好設定。</p>
		</div>

		<!-- Tabs -->
		<div class="cu-tabs" data-cu-tabs>
			<div class="cu-tabs-list">
				<button class="cu-tabs-trigger cu-tabs-trigger-active" data-cu-tabs-trigger="general">一般</button>
				<button class="cu-tabs-trigger" data-cu-tabs-trigger="notifications">通知</button>
				<button class="cu-tabs-trigger" data-cu-tabs-trigger="security">安全</button>
			</div>

			<!-- General tab -->
			<div class="cu-tabs-content" data-cu-tabs-content="general">
				<div class="rounded-xl border border-border p-6">
					<div class="space-y-1.5 mb-6">
						<h3 class="font-semibold leading-none tracking-tight">個人資料</h3>
						<p class="text-sm text-muted-foreground">更新您的基本資訊。</p>
					</div>
					<form class="space-y-4">
						<div class="cu-form-group">
							<label class="cu-label" for="name">姓名</label>
							<input class="cu-input" id="name" type="text" value="John Doe" />
						</div>
						<div class="cu-form-group">
							<label class="cu-label" for="settings-email">Email</label>
							<input class="cu-input" id="settings-email" type="email" value="john@example.com" />
						</div>
						<div class="cu-form-group">
							<label class="cu-label" for="language">語言</label>
							<div class="cu-select-wrapper">
								<select class="cu-select" id="language">
									<option>繁體中文</option>
									<option>English</option>
									<option>日本語</option>
								</select>
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cu-select-icon"><path d="m6 9 6 6 6-6"></path></svg>
							</div>
						</div>
						<div class="cu-form-group">
							<label class="cu-label" for="bio">自我介紹</label>
							<textarea class="cu-textarea" id="bio" rows="3" placeholder="簡短介紹您自己…"></textarea>
						</div>
						<div class="flex gap-3 pt-2">
							<button type="button" class="cu-button cu-button-default cu-button-md">儲存變更</button>
							<button type="button" class="cu-button cu-button-outline cu-button-md">取消</button>
						</div>
					</form>
				</div>
			</div>

			<!-- Notifications tab -->
			<div class="cu-tabs-content" data-cu-tabs-content="notifications" hidden>
				<div class="rounded-xl border border-border p-6">
					<div class="space-y-1.5 mb-6">
						<h3 class="font-semibold leading-none tracking-tight">通知偏好</h3>
						<p class="text-sm text-muted-foreground">選擇您要接收的通知類型。</p>
					</div>
					<div class="space-y-5">
						<div class="flex items-center justify-between">
							<div>
								<p class="text-sm font-medium">Email 通知</p>
								<p class="text-sm text-muted-foreground">接收系統通知至您的信箱。</p>
							</div>
							<label class="cu-toggle-wrapper">
								<input type="checkbox" class="cu-toggle-input" checked />
								<span class="cu-toggle"><span class="cu-toggle-thumb"></span></span>
							</label>
						</div>
						<div class="cu-separator"></div>
						<div class="flex items-center justify-between">
							<div>
								<p class="text-sm font-medium">安全警報</p>
								<p class="text-sm text-muted-foreground">登入異常時發送警告通知。</p>
							</div>
							<label class="cu-toggle-wrapper">
								<input type="checkbox" class="cu-toggle-input" checked />
								<span class="cu-toggle"><span class="cu-toggle-thumb"></span></span>
							</label>
						</div>
						<div class="cu-separator"></div>
						<div class="flex items-center justify-between">
							<div>
								<p class="text-sm font-medium">行銷訊息</p>
								<p class="text-sm text-muted-foreground">接收產品更新與促銷資訊。</p>
							</div>
							<label class="cu-toggle-wrapper">
								<input type="checkbox" class="cu-toggle-input" />
								<span class="cu-toggle"><span class="cu-toggle-thumb"></span></span>
							</label>
						</div>
						<div class="cu-separator"></div>
						<div class="flex items-center justify-between">
							<div>
								<p class="text-sm font-medium">週報摘要</p>
								<p class="text-sm text-muted-foreground">每週寄送業務摘要報告。</p>
							</div>
							<label class="cu-toggle-wrapper">
								<input type="checkbox" class="cu-toggle-input" checked />
								<span class="cu-toggle"><span class="cu-toggle-thumb"></span></span>
							</label>
						</div>
					</div>
				</div>
			</div>

			<!-- Security tab -->
			<div class="cu-tabs-content" data-cu-tabs-content="security" hidden>
				<div class="rounded-xl border border-border p-6">
					<div class="space-y-1.5 mb-6">
						<h3 class="font-semibold leading-none tracking-tight">變更密碼</h3>
						<p class="text-sm text-muted-foreground">請確認新密碼至少 8 個字元。</p>
					</div>
					<form class="space-y-4">
						<div class="cu-form-group">
							<label class="cu-label" for="current-password">目前密碼</label>
							<input class="cu-input" id="current-password" type="password" />
						</div>
						<div class="cu-form-group">
							<label class="cu-label" for="new-password">新密碼</label>
							<input class="cu-input" id="new-password" type="password" />
						</div>
						<div class="cu-form-group">
							<label class="cu-label" for="confirm-password">確認新密碼</label>
							<input class="cu-input" id="confirm-password" type="password" />
						</div>
						<div class="pt-2">
							<button type="button" class="cu-button cu-button-default cu-button-md">更新密碼</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>

	<script>
		document.querySelectorAll("[data-cu-tabs]").forEach((tabs) => {
			const triggers = tabs.querySelectorAll("[data-cu-tabs-trigger]");
			const contents = tabs.querySelectorAll("[data-cu-tabs-content]");
			triggers.forEach((trigger) => {
				trigger.addEventListener("click", () => {
					const value = trigger.getAttribute("data-cu-tabs-trigger");
					triggers.forEach((t) => t.classList.remove("cu-tabs-trigger-active"));
					trigger.classList.add("cu-tabs-trigger-active");
					contents.forEach((c) => {
						c.hidden = c.getAttribute("data-cu-tabs-content") !== value;
					});
				});
			});
		});
	</script>
</DashboardLayout>
