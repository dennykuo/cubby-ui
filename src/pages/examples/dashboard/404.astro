---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
---

<DashboardLayout title="找不到頁面 — Acme Inc.">
	<div class="flex items-center justify-center py-24">
		<div class="cu-empty-state">
			<div class="cu-empty-state-icon">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
			</div>
			<h2 class="cu-empty-state-title">找不到頁面</h2>
			<p class="cu-empty-state-description">您要尋找的頁面不存在或已被移除。</p>
			<div class="cu-empty-state-action">
				<a href="/examples/dashboard" class="cu-button cu-button-default cu-button-md">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
					返回儀表板
				</a>
			</div>
		</div>
	</div>
</DashboardLayout>
