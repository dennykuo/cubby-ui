---
import "@/styles/global.css";
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Login — Prism" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>登入 — Prism</title>
		<style>
			body { font-family: 'Inter', system-ui, sans-serif; }
		</style>
	</head>
	<body class="min-h-screen antialiased bg-slate-50">
		<div class="grid min-h-screen lg:grid-cols-2">
			<!-- Left: Brand Panel -->
			<div class="hidden lg:flex flex-col justify-between bg-white p-10 border-r border-slate-200/80">
				<div class="flex items-center gap-2.5">
					<div class="flex items-center justify-center w-9 h-9 rounded-xl bg-violet-600 text-white">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 3L2 12h3v9h14v-9h3L12 3z"/>
						</svg>
					</div>
					<span class="text-xl font-bold tracking-tight text-slate-900">Prism</span>
				</div>
				<div class="space-y-8">
					<div class="space-y-4">
						<h2 class="text-3xl font-bold leading-tight text-slate-900">數據驅動決策<br/>洞察商業未來</h2>
						<p class="text-slate-500 max-w-md">
							Prism 提供企業級的數據分析與視覺化解決方案，協助您從數據中發現價值。
						</p>
					</div>
					<div class="space-y-4">
						<div class="flex items-start gap-4 p-4 rounded-xl bg-slate-50 border border-slate-100">
							<div class="flex items-center justify-center w-10 h-10 rounded-lg bg-violet-100">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-violet-600"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
							</div>
							<div>
								<p class="font-medium text-slate-900">即時數據分析</p>
								<p class="text-sm text-slate-500">毫秒級回應，支援大規模資料處理</p>
							</div>
						</div>
						<div class="flex items-start gap-4 p-4 rounded-xl bg-slate-50 border border-slate-100">
							<div class="flex items-center justify-center w-10 h-10 rounded-lg bg-blue-100">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 7h.01"/><path d="M17 7h.01"/><path d="M7 17h.01"/><path d="M17 17h.01"/></svg>
							</div>
							<div>
								<p class="font-medium text-slate-900">智慧報表產生</p>
								<p class="text-sm text-slate-500">一鍵產生專業報表，支援多種格式匯出</p>
							</div>
						</div>
					</div>
				</div>
				<p class="text-xs text-slate-400">© 2026 Prism Analytics. All rights reserved.</p>
			</div>

			<!-- Right: Login Form -->
			<div class="flex items-center justify-center p-8">
				<div class="w-full max-w-sm space-y-6">
					<!-- Mobile Logo -->
					<div class="flex items-center gap-2.5 lg:hidden mb-8">
						<div class="flex items-center justify-center w-9 h-9 rounded-xl bg-violet-600 text-white">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 3L2 12h3v9h14v-9h3L12 3z"/>
							</svg>
						</div>
						<span class="text-xl font-bold tracking-tight">Prism</span>
					</div>

					<div class="space-y-2">
						<h1 class="text-2xl font-bold tracking-tight text-slate-900">歡迎回來</h1>
						<p class="text-sm text-slate-500">請輸入您的帳號密碼以登入系統</p>
					</div>

					<form class="space-y-4" action="/examples/dashboard-v4">
						<div class="cu-form-group">
							<label class="cu-label" for="email">Email</label>
							<input class="cu-input" id="email" type="email" placeholder="name@company.com" required aria-required="true" />
						</div>
						<div class="cu-form-group">
							<div class="flex items-center justify-between">
								<label class="cu-label" for="password">密碼</label>
								<a href="/examples/dashboard-v4/forgot-password" class="text-xs text-slate-500 hover:text-slate-700 transition-colors duration-150">忘記密碼？</a>
							</div>
							<input class="cu-input" id="password" type="password" placeholder="請輸入密碼" required aria-required="true" />
						</div>
						<label class="cu-checkbox-wrapper">
							<input type="checkbox" class="cu-checkbox" />
							<span class="text-sm">記住我的登入狀態</span>
						</label>
						<button type="submit" class="cu-button cu-button-md w-full bg-violet-600 hover:bg-violet-700 text-white border-0">登入</button>
					</form>

					<div class="relative">
						<div class="absolute inset-0 flex items-center"><div class="cu-separator"></div></div>
						<div class="relative flex justify-center"><span class="bg-slate-50 px-3 text-xs text-slate-500">或使用其他方式</span></div>
					</div>

					<button type="button" class="cu-button cu-button-outline cu-button-md w-full">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" class="mr-2"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
						使用 Google 帳號登入
					</button>

					<p class="text-center text-sm text-slate-500">
						還沒有帳號？
						<a href="/examples/dashboard-v4/register" class="text-violet-600 hover:text-violet-700 font-medium transition-colors duration-150">立即註冊</a>
					</p>
				</div>
			</div>
		</div>
	</body>
</html>
