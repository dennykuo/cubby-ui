    <script>
        const tabs = document.querySelectorAll('[data-settings-tab]');
        const panels = document.querySelectorAll('[data-settings-panel]');

        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                const targetPanel = tab.getAttribute('data-settings-tab');

                // Update tabs
                tabs.forEach(t => {
                    t.classList.remove('text-violet-700', 'bg-violet-50', 'border-violet-600');
                    t.classList.add('text-slate-600', 'border-transparent');
                });
                tab.classList.remove('text-slate-600', 'border-transparent');
                tab.classList.add('text-violet-700', 'bg-violet-50', 'border-violet-600');

                // Update panels
                panels.forEach(panel => {
                    if (panel.getAttribute('data-settings-panel') === targetPanel) {
                        panel.classList.remove('hidden');
                    } else {
                        panel.classList.add('hidden');
                    }
                });
            });
        });
    </script>
