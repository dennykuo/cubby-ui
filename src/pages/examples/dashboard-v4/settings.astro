---
import DashboardV4Layout from "@/layouts/DashboardV4Layout.astro";
import Card from "@/components/ui/Card.astro";
import CardHeader from "@/components/ui/CardHeader.astro";
import CardTitle from "@/components/ui/CardTitle.astro";
import CardDescription from "@/components/ui/CardDescription.astro";
import CardContent from "@/components/ui/CardContent.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import Avatar from "@/components/ui/Avatar.astro";
import AvatarFallback from "@/components/ui/AvatarFallback.astro";
import Input from "@/components/ui/Input.astro";
import Label from "@/components/ui/Label.astro";
import Toggle from "@/components/ui/Toggle.astro";
import Separator from "@/components/ui/Separator.astro";
import cubbyUiUrl from "../../../../dist/core/cubby-ui.js?url";

const tabs = [
  { value: "profile", label: "個人資料", icon: "user" },
  { value: "team", label: "團隊管理", icon: "users" },
  { value: "billing", label: "訂閱與帳單", icon: "card" },
  { value: "integrations", label: "整合服務", icon: "plug" },
  { value: "api", label: "API 金鑰", icon: "key" },
];

const members = [
  { name: "林小明", email: "lin.xiaoming@example.com", role: "管理員", self: true },
  { name: "陳美玲", email: "chen.meiling@example.com", role: "編輯者", self: false },
  { name: "王大偉", email: "wang.dawei@example.com", role: "檢視者", self: false },
  { name: "李佳穎", email: "lee.jiaying@example.com", role: "編輯者", self: false },
];

const apiKeys = [
  { name: "Production API", key: "sk-prod-****...8f2a", created: "2025/06/15", lastUsed: "2 小時前" },
  { name: "Development", key: "sk-dev-****...3b1c", created: "2025/08/22", lastUsed: "昨天" },
  { name: "Testing", key: "sk-test-****...9e4d", created: "2025/11/10", lastUsed: "5 天前" },
];
---

<DashboardV4Layout title="偏好設定 — Prism">
  <div class="space-y-6">
    <!-- Page Header -->
    <div class="cu-page-header">
      <div class="cu-page-header-content">
        <h1 class="cu-page-header-title text-2xl md:text-2xl">偏好設定</h1>
        <p class="cu-page-header-description mt-1">管理您的帳號設定與偏好。</p>
      </div>
    </div>

    <!-- Settings Layout -->
    <div class="cu-tabs flex flex-col lg:flex-row gap-6" data-cu-tabs>
      <!-- Left Nav -->
      <div
        class="cu-tabs-list cu-tabs-list-vertical flex-row self-start max-w-full overflow-x-auto shrink-0 lg:flex-col lg:w-56"
        role="tablist"
        aria-label="設定分類"
      >
        {tabs.map((tab, i) => (
          <button
            type="button"
            class:list={["cu-tabs-trigger justify-start gap-2 py-2", i === 0 && "cu-tabs-trigger-active"]}
            data-cu-tabs-trigger={tab.value}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              {tab.icon === "user" && (
                <>
                  <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                  <circle cx="12" cy="7" r="4" />
                </>
              )}
              {tab.icon === "users" && (
                <>
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                  <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </>
              )}
              {tab.icon === "card" && (
                <>
                  <rect width="20" height="14" x="2" y="5" rx="2" />
                  <line x1="2" x2="22" y1="10" y2="10" />
                </>
              )}
              {tab.icon === "plug" && (
                <>
                  <path d="M12 22v-5" />
                  <path d="M9 8V2" />
                  <path d="M15 8V2" />
                  <path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z" />
                </>
              )}
              {tab.icon === "key" && (
                <path d="m21 2-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4" />
              )}
            </svg>
            {tab.label}
          </button>
        ))}
      </div>

      <!-- Profile Panel -->
      <div class="cu-tabs-content mt-0 flex-1 min-w-0" data-cu-tabs-content="profile">
        <Card>
          <CardHeader>
            <CardTitle class="text-base font-semibold">個人資料</CardTitle>
            <CardDescription>更新您的個人資訊與頭像。</CardDescription>
          </CardHeader>
          <CardContent class="space-y-6">
            <!-- Avatar -->
            <div class="flex items-center gap-6">
              <Avatar class="w-20 h-20">
                <AvatarFallback class="bg-primary text-primary-foreground text-2xl">林</AvatarFallback>
              </Avatar>
              <div class="space-y-2">
                <Button type="button" variant="outline" size="sm">
                  變更頭像
                </Button>
                <p class="text-xs text-muted-foreground">建議尺寸 400x400px，支援 JPG、PNG 格式</p>
              </div>
            </div>

            <Separator />

            <!-- Form -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="cu-form-group">
                <Label for="v4-settings-name">姓名</Label>
                <Input id="v4-settings-name" value="林小明" autocomplete="name" />
              </div>
              <div class="cu-form-group">
                <Label for="v4-settings-email">電子郵件</Label>
                <Input id="v4-settings-email" type="email" value="lin.xiaoming@example.com" autocomplete="email" />
              </div>
              <div class="cu-form-group">
                <Label for="v4-settings-role">角色</Label>
                <Input id="v4-settings-role" value="管理員" disabled />
              </div>
              <div class="cu-form-group">
                <Label for="v4-settings-phone">電話</Label>
                <Input id="v4-settings-phone" type="tel" value="+886 912 345 678" autocomplete="tel" />
              </div>
            </div>

            <div class="cu-form-group">
              <Label for="v4-settings-bio">個人簡介</Label>
              <textarea
                id="v4-settings-bio"
                class="cu-textarea"
                rows="3"
                placeholder="簡單介紹一下自己..."
              >資深產品經理，擁有 8 年軟體產業經驗，專注於數據分析與用戶體驗優化。</textarea>
            </div>

            <div class="flex justify-end gap-3 pt-4">
              <Button type="button" variant="outline">
                取消
              </Button>
              <Button type="button">儲存變更</Button>
            </div>
          </CardContent>
        </Card>
      </div>

      <!-- Team Panel -->
      <div class="cu-tabs-content mt-0 flex-1 min-w-0" data-cu-tabs-content="team" hidden>
        <Card>
          <CardHeader>
            <div class="flex items-center justify-between gap-4">
              <div class="space-y-1.5">
                <CardTitle class="text-base font-semibold">團隊成員</CardTitle>
                <CardDescription>管理您團隊的成員與權限。</CardDescription>
              </div>
              <Button type="button" size="sm" class="gap-2 shrink-0">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <line x1="19" x2="19" y1="8" y2="14" />
                  <line x1="22" x2="16" y1="11" y2="11" />
                </svg>
                邀請成員
              </Button>
            </div>
          </CardHeader>
          <CardContent>
            <ul class="space-y-3">
              {members.map((m) => (
                <li class="flex items-center justify-between gap-4 p-4 bg-muted/50 rounded-lg">
                  <div class="flex items-center gap-3 min-w-0">
                    <Avatar class="w-10 h-10">
                      <AvatarFallback class="bg-primary/10 text-primary font-medium">{m.name.charAt(0)}</AvatarFallback>
                    </Avatar>
                    <div class="min-w-0">
                      <p class="text-sm font-medium text-foreground">{m.name}</p>
                      <p class="text-xs text-muted-foreground truncate">{m.email}</p>
                    </div>
                  </div>
                  <div class="flex items-center gap-3 shrink-0">
                    <Badge variant={m.role === "管理員" ? "soft-default" : "outline"}>{m.role}</Badge>
                    {m.self ? (
                      <span class="text-xs text-muted-foreground">你</span>
                    ) : (
                      <button
                        type="button"
                        class="cu-button cu-button-ghost cu-button-xs text-destructive hover:text-destructive"
                        aria-label={`移除 ${m.name}`}
                      >
                        移除
                      </button>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </CardContent>
        </Card>
      </div>

      <!-- Billing Panel -->
      <div class="cu-tabs-content mt-0 flex-1 min-w-0 space-y-6" data-cu-tabs-content="billing" hidden>
        <Card>
          <CardHeader>
            <CardTitle class="text-base font-semibold">目前方案</CardTitle>
            <CardDescription>您目前的訂閱方案與用量。</CardDescription>
          </CardHeader>
          <CardContent class="space-y-6">
            <div class="flex flex-wrap items-center justify-between gap-4 p-4 bg-primary/5 rounded-lg border border-primary/20">
              <div>
                <div class="flex items-center gap-2">
                  <p class="text-lg font-semibold text-foreground">專業版</p>
                  <Badge variant="soft-default">目前方案</Badge>
                </div>
                <p class="text-sm text-muted-foreground mt-1">$99 / 月</p>
              </div>
              <Button type="button" variant="outline">
                升級方案
              </Button>
            </div>

            <div class="space-y-3">
              <div class="flex items-center justify-between text-sm">
                <span id="v4-usage-api" class="text-muted-foreground">
                  API 呼叫次數
                </span>
                <span class="font-medium tabular-nums text-foreground">8,420 / 10,000</span>
              </div>
              <div
                class="cu-progress"
                role="progressbar"
                aria-labelledby="v4-usage-api"
                aria-valuemin="0"
                aria-valuemax="10000"
                aria-valuenow="8420"
                aria-valuetext="8,420 / 10,000 次"
              >
                <div class="cu-progress-bar" style="width: 84.2%"></div>
              </div>
              <p class="text-xs text-muted-foreground">本月剩餘 1,580 次呼叫</p>
            </div>

            <Separator />

            <div class="space-y-3">
              <div class="flex items-center justify-between text-sm">
                <span id="v4-usage-storage" class="text-muted-foreground">
                  儲存空間
                </span>
                <span class="font-medium tabular-nums text-foreground">12.4 GB / 50 GB</span>
              </div>
              <div
                class="cu-progress"
                role="progressbar"
                aria-labelledby="v4-usage-storage"
                aria-valuemin="0"
                aria-valuemax="50"
                aria-valuenow="12.4"
                aria-valuetext="12.4 GB / 50 GB"
              >
                <div class="cu-progress-bar cu-progress-bar-success" style="width: 24.8%"></div>
              </div>
            </div>

            <p class="pt-2 text-sm text-muted-foreground">
              下次帳單日期：<span class="font-medium text-foreground">2026 年 3 月 1 日</span>
            </p>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle class="text-base font-semibold">付款方式</CardTitle>
            <CardDescription>管理您的付款資訊。</CardDescription>
          </CardHeader>
          <CardContent>
            <div class="flex items-center justify-between gap-4 p-4 bg-muted/50 rounded-lg">
              <div class="flex items-center gap-3">
                <div class="w-12 h-8 bg-foreground text-background rounded flex items-center justify-center text-xs font-bold tracking-wide">
                  VISA
                </div>
                <div>
                  <p class="text-sm font-medium text-foreground tabular-nums">
                    <span class="sr-only">卡號末四碼</span>
                    <span aria-hidden="true">•••• •••• ••••</span> 4242
                  </p>
                  <p class="text-xs text-muted-foreground">到期日 12/2027</p>
                </div>
              </div>
              <Button type="button" variant="outline" size="sm" aria-label="更新付款方式">
                更新
              </Button>
            </div>
          </CardContent>
        </Card>
      </div>

      <!-- Integrations Panel -->
      <div class="cu-tabs-content mt-0 flex-1 min-w-0" data-cu-tabs-content="integrations" hidden>
        <Card>
          <CardHeader>
            <CardTitle class="text-base font-semibold">整合服務</CardTitle>
            <CardDescription>連接第三方應用程式。</CardDescription>
          </CardHeader>
          <CardContent>
            <ul class="space-y-4">
              <li class="flex flex-wrap items-center justify-between gap-4 p-4 border border-border rounded-lg">
                <div class="flex items-center gap-4">
                  <div
                    class="w-12 h-12 bg-[#4A154B] text-white rounded-lg flex items-center justify-center shrink-0"
                    aria-hidden="true"
                  >
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zm1.271 0a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zm0 1.271a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zm10.124 2.521a2.528 2.528 0 0 1 2.52-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.52V8.834zm-1.271 0a2.528 2.528 0 0 1-2.521 2.521 2.528 2.528 0 0 1-2.521-2.521V2.522A2.528 2.528 0 0 1 15.166 0a2.528 2.528 0 0 1 2.521 2.522v6.312zm-2.521 10.124a2.528 2.528 0 0 1 2.521 2.52A2.528 2.528 0 0 1 15.166 24a2.528 2.528 0 0 1-2.521-2.522v-2.52h2.521zm0-1.271a2.528 2.528 0 0 1-2.521-2.521 2.528 2.528 0 0 1 2.521-2.521h6.312A2.528 2.528 0 0 1 24 15.166a2.528 2.528 0 0 1-2.522 2.521h-6.312z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-foreground">Slack</p>
                    <p class="text-xs text-muted-foreground">接收即時通知到 Slack 頻道</p>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <Badge variant="soft-success">已連接</Badge>
                  <Toggle checked aria-label="啟用 Slack 整合" />
                </div>
              </li>

              <li class="flex flex-wrap items-center justify-between gap-4 p-4 border border-border rounded-lg">
                <div class="flex items-center gap-4">
                  <div
                    class="w-12 h-12 bg-foreground text-background rounded-lg flex items-center justify-center shrink-0"
                    aria-hidden="true"
                  >
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-foreground">GitHub</p>
                    <p class="text-xs text-muted-foreground">同步程式碼儲存庫資訊</p>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <Badge variant="soft-success">已連接</Badge>
                  <Toggle checked aria-label="啟用 GitHub 整合" />
                </div>
              </li>

              <li class="flex flex-wrap items-center justify-between gap-4 p-4 border border-border rounded-lg">
                <div class="flex items-center gap-4">
                  <div
                    class="w-12 h-12 bg-[#F24E1E] text-white rounded-lg flex items-center justify-center shrink-0"
                    aria-hidden="true"
                  >
                    <svg width="16" height="24" viewBox="0 0 38 57" fill="currentColor">
                      <path d="M19 28.5a9.5 9.5 0 1 1 19 0 9.5 9.5 0 0 1-19 0z" />
                      <path d="M0 47.5A9.5 9.5 0 0 1 9.5 38H19v9.5a9.5 9.5 0 1 1-19 0z" />
                      <path d="M19 0v19h9.5a9.5 9.5 0 1 0 0-19H19z" />
                      <path d="M0 9.5A9.5 9.5 0 0 0 9.5 19H19V0H9.5A9.5 9.5 0 0 0 0 9.5z" />
                      <path d="M0 28.5A9.5 9.5 0 0 0 9.5 38H19V19H9.5A9.5 9.5 0 0 0 0 28.5z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm font-medium text-foreground">Figma</p>
                    <p class="text-xs text-muted-foreground">匯入設計稿與資源</p>
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <Badge variant="soft-secondary">未連接</Badge>
                  <Button type="button" variant="outline" size="sm" aria-label="連接 Figma">
                    連接
                  </Button>
                </div>
              </li>
            </ul>
          </CardContent>
        </Card>
      </div>

      <!-- API Keys Panel -->
      <div class="cu-tabs-content mt-0 flex-1 min-w-0" data-cu-tabs-content="api" hidden>
        <Card class="overflow-hidden">
          <CardHeader>
            <div class="flex items-center justify-between gap-4">
              <div class="space-y-1.5">
                <CardTitle class="text-base font-semibold">API 金鑰</CardTitle>
                <CardDescription>管理您的 API 存取金鑰。</CardDescription>
              </div>
              <Button type="button" size="sm" class="gap-2 shrink-0">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <line x1="12" x2="12" y1="5" y2="19" />
                  <line x1="5" x2="19" y1="12" y2="12" />
                </svg>
                建立金鑰
              </Button>
            </div>
          </CardHeader>
          <div class="cu-table-wrapper" role="region" aria-label="API 金鑰列表" tabindex="0">
            <table class="cu-table">
              <thead class="cu-table-header">
                <tr class="cu-table-row hover:bg-transparent">
                  <th scope="col" class="cu-table-head pl-6">
                    名稱
                  </th>
                  <th scope="col" class="cu-table-head">
                    金鑰
                  </th>
                  <th scope="col" class="cu-table-head">
                    建立日期
                  </th>
                  <th scope="col" class="cu-table-head">
                    最後使用
                  </th>
                  <th scope="col" class="cu-table-head text-right pr-6">
                    <span class="sr-only">操作</span>
                  </th>
                </tr>
              </thead>
              <tbody class="cu-table-body">
                {apiKeys.map((k) => (
                  <tr class="cu-table-row">
                    <td class="cu-table-cell pl-6 font-medium text-foreground whitespace-nowrap">{k.name}</td>
                    <td class="cu-table-cell">
                      <code class="px-2 py-1 bg-muted rounded text-xs font-mono text-muted-foreground whitespace-nowrap">
                        {k.key}
                      </code>
                    </td>
                    <td class="cu-table-cell tabular-nums text-muted-foreground">{k.created}</td>
                    <td class="cu-table-cell text-muted-foreground whitespace-nowrap">{k.lastUsed}</td>
                    <td class="cu-table-cell text-right pr-6">
                      <div class="flex items-center justify-end gap-1">
                        <button
                          type="button"
                          class="cu-button cu-button-ghost cu-button-xs"
                          aria-label={`重新產生 ${k.name} 金鑰`}
                        >
                          重新產生
                        </button>
                        <button
                          type="button"
                          class="cu-button cu-button-ghost cu-button-xs text-destructive hover:text-destructive"
                          aria-label={`刪除 ${k.name} 金鑰`}
                        >
                          刪除
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </Card>
      </div>
    </div>
  </div>

  <script src={cubbyUiUrl} is:inline></script>
</DashboardV4Layout>
