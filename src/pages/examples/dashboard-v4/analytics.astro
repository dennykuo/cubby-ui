---
import DashboardV4Layout from "../../../layouts/DashboardV4Layout.astro";
import Card from "../../../components/ui/Card.astro";
import CardHeader from "../../../components/ui/CardHeader.astro";
import CardTitle from "../../../components/ui/CardTitle.astro";
import CardDescription from "../../../components/ui/CardDescription.astro";
import CardContent from "../../../components/ui/CardContent.astro";
import Button from "../../../components/ui/Button.astro";
import Badge from "../../../components/ui/Badge.astro";
---

<DashboardV4Layout title="分析報表 — Prism">
    <div class="space-y-6">
        <!-- Page Header -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">分析報表</h1>
                <p class="text-slate-500 mt-1">深入了解您的業務數據與趨勢。</p>
            </div>
            <div class="flex items-center gap-2">
                <!-- Date Range Picker -->
                <div class="flex items-center gap-2 px-3 py-2 bg-white border border-slate-200 rounded-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400">
                        <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/>
                    </svg>
                    <span class="text-sm text-slate-600">2026/01/01 - 2026/02/03</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400">
                        <path d="m6 9 6 6 6-6"/>
                    </svg>
                </div>
            </div>
        </div>

        <!-- Period Selector -->
        <div class="flex items-center gap-2">
            <button class="px-4 py-2 text-sm font-medium text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors">7 天</button>
            <button class="px-4 py-2 text-sm font-medium text-white bg-violet-600 rounded-lg shadow-sm">30 天</button>
            <button class="px-4 py-2 text-sm font-medium text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors">90 天</button>
            <button class="px-4 py-2 text-sm font-medium text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors">本年度</button>
        </div>

        <!-- Metrics Cards -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <Card class="bg-white border-slate-200/80 shadow-sm">
                <CardContent class="p-4">
                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">瀏覽量</p>
                    <p class="text-2xl font-bold text-slate-900 mt-1">248,472</p>
                    <div class="flex items-center gap-1 mt-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-500"><path d="m18 15-6-6-6 6"/></svg>
                        <span class="text-xs text-emerald-600 font-medium">+18.2%</span>
                    </div>
                </CardContent>
            </Card>
            <Card class="bg-white border-slate-200/80 shadow-sm">
                <CardContent class="p-4">
                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">不重複訪客</p>
                    <p class="text-2xl font-bold text-slate-900 mt-1">64,827</p>
                    <div class="flex items-center gap-1 mt-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-500"><path d="m18 15-6-6-6 6"/></svg>
                        <span class="text-xs text-emerald-600 font-medium">+12.5%</span>
                    </div>
                </CardContent>
            </Card>
            <Card class="bg-white border-slate-200/80 shadow-sm">
                <CardContent class="p-4">
                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">跳出率</p>
                    <p class="text-2xl font-bold text-slate-900 mt-1">34.2%</p>
                    <div class="flex items-center gap-1 mt-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-500"><path d="m18 15-6-6-6 6"/></svg>
                        <span class="text-xs text-emerald-600 font-medium">-2.4%</span>
                    </div>
                </CardContent>
            </Card>
            <Card class="bg-white border-slate-200/80 shadow-sm">
                <CardContent class="p-4">
                    <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">平均停留時間</p>
                    <p class="text-2xl font-bold text-slate-900 mt-1">4 分 28 秒</p>
                    <div class="flex items-center gap-1 mt-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-500"><path d="m18 15-6-6-6 6"/></svg>
                        <span class="text-xs text-emerald-600 font-medium">+8.7%</span>
                    </div>
                </CardContent>
            </Card>
        </div>

        <!-- Main Charts -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Traffic Chart -->
            <Card class="lg:col-span-2 bg-white border-slate-200/80 shadow-sm">
                <CardHeader class="pb-2">
                    <div class="flex items-center justify-between">
                        <div>
                            <CardTitle class="text-base font-semibold text-slate-900">流量趨勢</CardTitle>
                            <CardDescription>每日訪客與瀏覽量</CardDescription>
                        </div>
                        <div class="flex items-center gap-4 text-xs">
                            <div class="flex items-center gap-1.5">
                                <span class="w-2.5 h-2.5 rounded-full bg-violet-500"></span>
                                <span class="text-slate-500">訪客</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <span class="w-2.5 h-2.5 rounded-full bg-slate-300"></span>
                                <span class="text-slate-500">瀏覽量</span>
                            </div>
                        </div>
                    </div>
                </CardHeader>
                <CardContent>
                    <div class="h-72 mt-4">
                        <svg viewBox="0 0 500 200" class="w-full h-full" preserveAspectRatio="none">
                            <defs>
                                <linearGradient id="visitorsGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                                    <stop offset="0%" style="stop-color:rgb(139,92,246);stop-opacity:0.2" />
                                    <stop offset="100%" style="stop-color:rgb(139,92,246);stop-opacity:0" />
                                </linearGradient>
                            </defs>
                            <!-- Grid -->
                            <line x1="0" y1="50" x2="500" y2="50" stroke="#f1f5f9" stroke-width="1" />
                            <line x1="0" y1="100" x2="500" y2="100" stroke="#f1f5f9" stroke-width="1" />
                            <line x1="0" y1="150" x2="500" y2="150" stroke="#f1f5f9" stroke-width="1" />
                            <!-- Page views line (background) -->
                            <path d="M0,160 Q40,150 80,140 T160,120 T240,130 T320,100 T400,110 T500,80" fill="none" stroke="#cbd5e1" stroke-width="2" stroke-linecap="round" />
                            <!-- Visitors area -->
                            <path d="M0,180 Q40,170 80,155 T160,140 T240,150 T320,110 T400,125 T500,90 L500,200 L0,200 Z" fill="url(#visitorsGradient)" />
                            <!-- Visitors line -->
                            <path d="M0,180 Q40,170 80,155 T160,140 T240,150 T320,110 T400,125 T500,90" fill="none" stroke="#8b5cf6" stroke-width="2.5" stroke-linecap="round" />
                        </svg>
                    </div>
                    <div class="flex justify-between mt-4 text-xs text-slate-400 border-t border-slate-100 pt-3">
                        <span>1月5日</span>
                        <span>1月12日</span>
                        <span>1月19日</span>
                        <span>1月26日</span>
                        <span>2月2日</span>
                    </div>
                </CardContent>
            </Card>

            <!-- Device Breakdown -->
            <Card class="bg-white border-slate-200/80 shadow-sm">
                <CardHeader class="pb-2">
                    <CardTitle class="text-base font-semibold text-slate-900">裝置分布</CardTitle>
                    <CardDescription>訪客使用裝置類型</CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="space-y-4 mt-4">
                        <div>
                            <div class="flex items-center justify-between text-sm mb-2">
                                <div class="flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
                                    <span class="text-slate-700">桌面電腦</span>
                                </div>
                                <span class="font-medium text-slate-900">52%</span>
                            </div>
                            <div class="h-2 bg-slate-100 rounded-full overflow-hidden">
                                <div class="h-full bg-violet-500 rounded-full" style="width: 52%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex items-center justify-between text-sm mb-2">
                                <div class="flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>
                                    <span class="text-slate-700">行動裝置</span>
                                </div>
                                <span class="font-medium text-slate-900">38%</span>
                            </div>
                            <div class="h-2 bg-slate-100 rounded-full overflow-hidden">
                                <div class="h-full bg-blue-500 rounded-full" style="width: 38%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex items-center justify-between text-sm mb-2">
                                <div class="flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400"><rect width="18" height="12" x="3" y="4" rx="2" ry="2"/><line x1="2" x2="22" y1="20" y2="20"/></svg>
                                    <span class="text-slate-700">平板電腦</span>
                                </div>
                                <span class="font-medium text-slate-900">10%</span>
                            </div>
                            <div class="h-2 bg-slate-100 rounded-full overflow-hidden">
                                <div class="h-full bg-emerald-500 rounded-full" style="width: 10%"></div>
                            </div>
                        </div>
                    </div>

                    <!-- OS breakdown -->
                    <div class="mt-6 pt-6 border-t border-slate-100">
                        <p class="text-sm font-medium text-slate-700 mb-3">作業系統</p>
                        <div class="grid grid-cols-2 gap-3">
                            <div class="flex items-center gap-2 text-sm">
                                <span class="w-2 h-2 rounded-full bg-slate-800"></span>
                                <span class="text-slate-600">Windows</span>
                                <span class="ml-auto font-medium text-slate-900">42%</span>
                            </div>
                            <div class="flex items-center gap-2 text-sm">
                                <span class="w-2 h-2 rounded-full bg-slate-500"></span>
                                <span class="text-slate-600">macOS</span>
                                <span class="ml-auto font-medium text-slate-900">28%</span>
                            </div>
                            <div class="flex items-center gap-2 text-sm">
                                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                <span class="text-slate-600">iOS</span>
                                <span class="ml-auto font-medium text-slate-900">18%</span>
                            </div>
                            <div class="flex items-center gap-2 text-sm">
                                <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                                <span class="text-slate-600">Android</span>
                                <span class="ml-auto font-medium text-slate-900">12%</span>
                            </div>
                        </div>
                    </div>
                </CardContent>
            </Card>
        </div>

        <!-- Conversion Funnel & Geographic -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Conversion Funnel -->
            <Card class="bg-white border-slate-200/80 shadow-sm">
                <CardHeader class="pb-2">
                    <CardTitle class="text-base font-semibold text-slate-900">轉換漏斗</CardTitle>
                    <CardDescription>從訪問到購買的轉換過程</CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="space-y-3 mt-4">
                        <div class="relative">
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-sm font-medium text-slate-700">訪客</span>
                                <span class="text-sm text-slate-500">64,827</span>
                            </div>
                            <div class="h-10 bg-violet-500 rounded-lg flex items-center justify-center">
                                <span class="text-sm font-medium text-white">100%</span>
                            </div>
                        </div>
                        <div class="flex justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-300"><path d="m6 9 6 6 6-6"/></svg>
                        </div>
                        <div class="relative">
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-sm font-medium text-slate-700">產品瀏覽</span>
                                <span class="text-sm text-slate-500">32,414</span>
                            </div>
                            <div class="h-10 bg-violet-400 rounded-lg flex items-center justify-center" style="width: 50%">
                                <span class="text-sm font-medium text-white">50%</span>
                            </div>
                        </div>
                        <div class="flex justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-300"><path d="m6 9 6 6 6-6"/></svg>
                        </div>
                        <div class="relative">
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-sm font-medium text-slate-700">加入購物車</span>
                                <span class="text-sm text-slate-500">8,103</span>
                            </div>
                            <div class="h-10 bg-violet-300 rounded-lg flex items-center justify-center" style="width: 25%">
                                <span class="text-sm font-medium text-white">12.5%</span>
                            </div>
                        </div>
                        <div class="flex justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-300"><path d="m6 9 6 6 6-6"/></svg>
                        </div>
                        <div class="relative">
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-sm font-medium text-slate-700">完成購買</span>
                                <span class="text-sm text-slate-500">2,101</span>
                            </div>
                            <div class="h-10 bg-emerald-500 rounded-lg flex items-center justify-center" style="width: 12.5%">
                                <span class="text-sm font-medium text-white">3.2%</span>
                            </div>
                        </div>
                    </div>
                </CardContent>
            </Card>

            <!-- Geographic Distribution -->
            <Card class="bg-white border-slate-200/80 shadow-sm">
                <CardHeader class="pb-2">
                    <CardTitle class="text-base font-semibold text-slate-900">地區分布</CardTitle>
                    <CardDescription>訪客來源地區</CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="space-y-3 mt-4">
                        <div>
                            <div class="flex items-center justify-between text-sm mb-1.5">
                                <div class="flex items-center gap-2">
                                    <span class="text-base">🇹🇼</span>
                                    <span class="text-slate-700">台灣</span>
                                </div>
                                <span class="font-medium text-slate-900">45.2%</span>
                            </div>
                            <div class="h-2 bg-slate-100 rounded-full overflow-hidden">
                                <div class="h-full bg-violet-500 rounded-full" style="width: 45.2%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex items-center justify-between text-sm mb-1.5">
                                <div class="flex items-center gap-2">
                                    <span class="text-base">🇺🇸</span>
                                    <span class="text-slate-700">美國</span>
                                </div>
                                <span class="font-medium text-slate-900">22.8%</span>
                            </div>
                            <div class="h-2 bg-slate-100 rounded-full overflow-hidden">
                                <div class="h-full bg-blue-500 rounded-full" style="width: 22.8%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex items-center justify-between text-sm mb-1.5">
                                <div class="flex items-center gap-2">
                                    <span class="text-base">🇯🇵</span>
                                    <span class="text-slate-700">日本</span>
                                </div>
                                <span class="font-medium text-slate-900">12.4%</span>
                            </div>
                            <div class="h-2 bg-slate-100 rounded-full overflow-hidden">
                                <div class="h-full bg-rose-400 rounded-full" style="width: 12.4%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex items-center justify-between text-sm mb-1.5">
                                <div class="flex items-center gap-2">
                                    <span class="text-base">🇭🇰</span>
                                    <span class="text-slate-700">香港</span>
                                </div>
                                <span class="font-medium text-slate-900">8.6%</span>
                            </div>
                            <div class="h-2 bg-slate-100 rounded-full overflow-hidden">
                                <div class="h-full bg-amber-500 rounded-full" style="width: 8.6%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex items-center justify-between text-sm mb-1.5">
                                <div class="flex items-center gap-2">
                                    <span class="text-base">🇸🇬</span>
                                    <span class="text-slate-700">新加坡</span>
                                </div>
                                <span class="font-medium text-slate-900">5.8%</span>
                            </div>
                            <div class="h-2 bg-slate-100 rounded-full overflow-hidden">
                                <div class="h-full bg-emerald-500 rounded-full" style="width: 5.8%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex items-center justify-between text-sm mb-1.5">
                                <div class="flex items-center gap-2">
                                    <span class="text-base">🌍</span>
                                    <span class="text-slate-700">其他</span>
                                </div>
                                <span class="font-medium text-slate-900">5.2%</span>
                            </div>
                            <div class="h-2 bg-slate-100 rounded-full overflow-hidden">
                                <div class="h-full bg-slate-400 rounded-full" style="width: 5.2%"></div>
                            </div>
                        </div>
                    </div>
                </CardContent>
            </Card>
        </div>

        <!-- Top Pages Table -->
        <Card class="bg-white border-slate-200/80 shadow-sm overflow-hidden">
            <CardHeader>
                <div class="flex items-center justify-between">
                    <div>
                        <CardTitle class="text-base font-semibold text-slate-900">熱門頁面</CardTitle>
                        <CardDescription>流量最高的頁面</CardDescription>
                    </div>
                </div>
            </CardHeader>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-slate-50 border-y border-slate-200/60">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">頁面</th>
                            <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">瀏覽量</th>
                            <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">不重複訪客</th>
                            <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">平均停留</th>
                            <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">跳出率</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded bg-violet-100 flex items-center justify-center">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-violet-600"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                                    </div>
                                    <div>
                                        <p class="text-sm font-medium text-slate-700">/</p>
                                        <p class="text-xs text-slate-500">首頁</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-900 text-right font-medium">42,847</td>
                            <td class="px-6 py-4 text-sm text-slate-600 text-right">28,412</td>
                            <td class="px-6 py-4 text-sm text-slate-600 text-right">2:34</td>
                            <td class="px-6 py-4 text-sm text-right">
                                <Badge class="bg-emerald-50 text-emerald-700">28.4%</Badge>
                            </td>
                        </tr>
                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="px-6 py-4">
