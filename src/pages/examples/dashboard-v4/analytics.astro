---
import DashboardV4Layout from "@/layouts/DashboardV4Layout.astro";
import Card from "@/components/ui/Card.astro";
import CardHeader from "@/components/ui/CardHeader.astro";
import CardTitle from "@/components/ui/CardTitle.astro";
import CardDescription from "@/components/ui/CardDescription.astro";
import CardContent from "@/components/ui/CardContent.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";

const periods = [
  { label: "7 天", active: false },
  { label: "30 天", active: true },
  { label: "90 天", active: false },
  { label: "本年度", active: false },
];

// good：該指標的變化對業務是否有利（跳出率下降為正面）
const metrics = [
  { label: "瀏覽量", value: "248,472", change: "+18.2%", good: true },
  { label: "不重複訪客", value: "64,827", change: "+12.5%", good: true },
  { label: "跳出率", value: "34.2%", change: "-2.4%", good: true },
  { label: "平均停留時間", value: "4 分 28 秒", change: "+8.7%", good: true },
];

const trafficSeries = [
  { label: "訪客", color: "cu-chart-color-1" },
  { label: "瀏覽量", color: "cu-chart-color-2" },
];

const trafficDates = ["1月5日", "1月12日", "1月19日", "1月26日", "2月2日"];

const devices = [
  { label: "桌面電腦", value: 52, color: "cu-chart-color-1", icon: "desktop" },
  { label: "行動裝置", value: 38, color: "cu-chart-color-2", icon: "mobile" },
  { label: "平板電腦", value: 10, color: "cu-chart-color-3", icon: "tablet" },
];

const operatingSystems = [
  { label: "Windows", value: "42%", color: "cu-chart-color-1" },
  { label: "macOS", value: "28%", color: "cu-chart-color-2" },
  { label: "iOS", value: "18%", color: "cu-chart-color-3" },
  { label: "Android", value: "12%", color: "cu-chart-color-4" },
];

const funnel = [
  { label: "訪客", count: "64,827", rate: 100, bar: "bg-primary" },
  { label: "產品瀏覽", count: "32,414", rate: 50, bar: "bg-primary/80" },
  { label: "加入購物車", count: "8,103", rate: 12.5, bar: "bg-primary/60" },
  { label: "完成購買", count: "2,101", rate: 3.2, bar: "bg-success" },
];

const regions = [
  { flag: "🇹🇼", label: "台灣", value: 45.2, color: "bg-current cu-chart-color-1" },
  { flag: "🇺🇸", label: "美國", value: 22.8, color: "bg-current cu-chart-color-2" },
  { flag: "🇯🇵", label: "日本", value: 12.4, color: "bg-current cu-chart-color-3" },
  { flag: "🇭🇰", label: "香港", value: 8.6, color: "bg-current cu-chart-color-4" },
  { flag: "🇸🇬", label: "新加坡", value: 5.8, color: "bg-current cu-chart-color-5" },
  { flag: "🌍", label: "其他", value: 5.2, color: "bg-muted-foreground/40" },
];

const bounceBadge = (rate: number) => (rate >= 30 ? "soft-warning" : "soft-success") as "soft-warning" | "soft-success";

const topPages = [
  { path: "/", name: "首頁", views: "42,847", visitors: "28,412", duration: "2:34", bounce: 28.4, icon: "home" },
  {
    path: "/products",
    name: "產品列表",
    views: "31,284",
    visitors: "22,847",
    duration: "4:12",
    bounce: 22.1,
    icon: "package",
  },
  {
    path: "/pricing",
    name: "價格方案",
    views: "18,472",
    visitors: "14,283",
    duration: "3:48",
    bounce: 35.6,
    icon: "dollar",
  },
  { path: "/docs", name: "文件中心", views: "12,847", visitors: "8,472", duration: "6:24", bounce: 18.2, icon: "file" },
];
---

<DashboardV4Layout title="分析報表 — Prism">
  <div class="space-y-6">
    <!-- Page Header -->
    <div class="cu-page-header sm:items-end">
      <div class="cu-page-header-content">
        <h1 class="cu-page-header-title text-2xl md:text-2xl">分析報表</h1>
        <p class="cu-page-header-description mt-1">深入了解您的業務數據與趨勢。</p>
      </div>
      <div class="cu-page-header-actions flex-wrap">
        <div class="cu-segmented cu-segmented-sm" role="group" aria-label="統計期間" data-v4-period>
          {periods.map((p) => (
            <button
              type="button"
              class:list={["cu-segmented-item", p.active && "cu-segmented-item-active"]}
              aria-pressed={p.active ? "true" : "false"}
            >
              {p.label}
            </button>
          ))}
        </div>
        <Button type="button" variant="outline" size="sm" class="gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-muted-foreground"
            aria-hidden="true"
          >
            <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
            <line x1="16" x2="16" y1="2" y2="6" />
            <line x1="8" x2="8" y1="2" y2="6" />
            <line x1="3" x2="21" y1="10" y2="10" />
          </svg>
          <span class="sr-only">日期範圍：</span>
          <span class="tabular-nums">2026/01/01 - 2026/02/03</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-muted-foreground"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </Button>
      </div>
    </div>

    <!-- Metrics Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      {metrics.map((m) => (
        <div class="cu-stat cu-stat-hover p-5">
          <div class="cu-stat-header">
            <span class="cu-stat-label">{m.label}</span>
          </div>
          <p class="cu-stat-value tabular-nums">{m.value}</p>
          <p class="cu-stat-description">
            <span class:list={["cu-stat-trend cu-stat-trend-pill", m.good ? "cu-stat-trend-up" : "cu-stat-trend-down"]}>
              {m.change}
            </span>{" "}
            較上期
          </p>
        </div>
      ))}
    </div>

    <!-- Main Charts -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Traffic Chart -->
      <Card class="lg:col-span-2">
        <CardHeader class="pb-2">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div class="space-y-1.5">
              <CardTitle class="text-base font-semibold">流量趨勢</CardTitle>
              <CardDescription>每日訪客與瀏覽量</CardDescription>
            </div>
            <ul class="cu-chart-legend" aria-label="圖例">
              {trafficSeries.map((s) => (
                <li class="cu-chart-legend-item">
                  <span class:list={["cu-chart-swatch cu-chart-swatch-dot", s.color]} aria-hidden="true"></span>
                  {s.label}
                </li>
              ))}
            </ul>
          </div>
        </CardHeader>
        <CardContent>
          <div class="h-72 mt-4">
            <svg
              viewBox="0 0 500 200"
              class="w-full h-full"
              preserveAspectRatio="none"
              role="img"
              aria-labelledby="v4-traffic-title v4-traffic-desc"
            >
              <title id="v4-traffic-title">流量趨勢</title>
              <desc id="v4-traffic-desc">
                1 月 5 日至 2 月 2 日的每日訪客與瀏覽量，兩者皆呈上升趨勢，瀏覽量持續高於訪客數。
              </desc>
              <defs>
                <linearGradient id="v4VisitorsGradient" class="cu-chart-color-1" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" stop-color="currentColor" stop-opacity="0.2" />
                  <stop offset="100%" stop-color="currentColor" stop-opacity="0" />
                </linearGradient>
              </defs>
              <!-- Grid -->
              <line x1="0" y1="50" x2="500" y2="50" class="cu-chart-grid" vector-effect="non-scaling-stroke" />
              <line x1="0" y1="100" x2="500" y2="100" class="cu-chart-grid" vector-effect="non-scaling-stroke" />
              <line x1="0" y1="150" x2="500" y2="150" class="cu-chart-grid" vector-effect="non-scaling-stroke" />
              <!-- Page views line -->
              <path
                d="M0,160 Q40,150 80,140 T160,120 T240,130 T320,100 T400,110 T500,80"
                class="cu-chart-color-2"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                vector-effect="non-scaling-stroke"
              />
              <!-- Visitors area -->
              <path
                d="M0,180 Q40,170 80,155 T160,140 T240,150 T320,110 T400,125 T500,90 L500,200 L0,200 Z"
                fill="url(#v4VisitorsGradient)"
              />
              <!-- Visitors line -->
              <path
                d="M0,180 Q40,170 80,155 T160,140 T240,150 T320,110 T400,125 T500,90"
                class="cu-chart-color-1"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                vector-effect="non-scaling-stroke"
              />
            </svg>
          </div>
          <div
            class="flex justify-between mt-4 text-xs text-muted-foreground border-t border-border pt-3"
            aria-hidden="true"
          >
            {trafficDates.map((d) => (
              <span>{d}</span>
            ))}
          </div>
        </CardContent>
      </Card>

      <!-- Device Breakdown -->
      <Card>
        <CardHeader class="pb-2">
          <CardTitle class="text-base font-semibold">裝置分布</CardTitle>
          <CardDescription>訪客使用裝置類型</CardDescription>
        </CardHeader>
        <CardContent>
          <ul class="space-y-4 mt-4">
            {devices.map((d) => (
              <li>
                <div class="flex items-center justify-between text-sm mb-2">
                  <span class="flex items-center gap-2 text-foreground">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="text-muted-foreground"
                      aria-hidden="true"
                    >
                      {d.icon === "desktop" && (
                        <>
                          <rect width="20" height="14" x="2" y="3" rx="2" />
                          <line x1="8" x2="16" y1="21" y2="21" />
                          <line x1="12" x2="12" y1="17" y2="21" />
                        </>
                      )}
                      {d.icon === "mobile" && (
                        <>
                          <rect width="14" height="20" x="5" y="2" rx="2" ry="2" />
                          <path d="M12 18h.01" />
                        </>
                      )}
                      {d.icon === "tablet" && (
                        <>
                          <rect width="18" height="12" x="3" y="4" rx="2" ry="2" />
                          <line x1="2" x2="22" y1="20" y2="20" />
                        </>
                      )}
                    </svg>
                    {d.label}
                  </span>
                  <span class="font-medium tabular-nums text-foreground">{d.value}%</span>
                </div>
                <div class="cu-progress" aria-hidden="true">
                  <div class:list={["cu-progress-bar bg-current", d.color]} style={`width: ${d.value}%`}></div>
                </div>
              </li>
            ))}
          </ul>

          <!-- OS breakdown -->
          <div class="mt-6 pt-6 border-t border-border">
            <h3 class="text-sm font-medium text-foreground mb-3">作業系統</h3>
            <ul class="grid grid-cols-2 gap-3">
              {operatingSystems.map((os) => (
                <li class="flex items-center gap-2 text-sm">
                  <span class:list={["cu-chart-swatch cu-chart-swatch-dot", os.color]} aria-hidden="true"></span>
                  <span class="text-muted-foreground">{os.label}</span>
                  <span class="ml-auto font-medium tabular-nums text-foreground">{os.value}</span>
                </li>
              ))}
            </ul>
          </div>
        </CardContent>
      </Card>
    </div>

    <!-- Conversion Funnel & Geographic -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Conversion Funnel -->
      <Card>
        <CardHeader class="pb-2">
          <CardTitle class="text-base font-semibold">轉換漏斗</CardTitle>
          <CardDescription>從訪問到購買的轉換過程</CardDescription>
        </CardHeader>
        <CardContent>
          <ol class="space-y-2 mt-4">
            {funnel.map((step, i) => (
              <li>
                {i > 0 && (
                  <div class="flex justify-center pb-2 text-muted-foreground/60" aria-hidden="true">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </div>
                )}
                <div class="flex items-center justify-between gap-3 mb-1.5 text-sm">
                  <span class="font-medium text-foreground">{step.label}</span>
                  <span class="text-muted-foreground tabular-nums">
                    {step.count}
                    <span class="ml-2 font-medium text-foreground">{step.rate}%</span>
                  </span>
                </div>
                <div class="h-8 rounded-lg bg-muted overflow-hidden" aria-hidden="true">
                  <div class:list={["h-full rounded-lg min-w-2", step.bar]} style={`width: ${step.rate}%`}></div>
                </div>
              </li>
            ))}
          </ol>
        </CardContent>
      </Card>

      <!-- Geographic Distribution -->
      <Card>
        <CardHeader class="pb-2">
          <CardTitle class="text-base font-semibold">地區分布</CardTitle>
          <CardDescription>訪客來源地區</CardDescription>
        </CardHeader>
        <CardContent>
          <ul class="space-y-3 mt-4">
            {regions.map((r) => (
              <li>
                <div class="flex items-center justify-between text-sm mb-1.5">
                  <span class="flex items-center gap-2 text-foreground">
                    <span class="text-base" aria-hidden="true">
                      {r.flag}
                    </span>
                    {r.label}
                  </span>
                  <span class="font-medium tabular-nums text-foreground">{r.value}%</span>
                </div>
                <div class="cu-progress" aria-hidden="true">
                  <div class:list={["cu-progress-bar", r.color]} style={`width: ${r.value}%`}></div>
                </div>
              </li>
            ))}
          </ul>
        </CardContent>
      </Card>
    </div>

    <!-- Top Pages Table -->
    <Card class="overflow-hidden">
      <CardHeader>
        <div class="space-y-1.5">
          <CardTitle class="text-base font-semibold">熱門頁面</CardTitle>
          <CardDescription>流量最高的頁面</CardDescription>
        </div>
      </CardHeader>
      <div class="cu-table-wrapper" role="region" aria-label="熱門頁面" tabindex="0">
        <table class="cu-table">
          <thead class="cu-table-header">
            <tr class="cu-table-row hover:bg-transparent">
              <th scope="col" class="cu-table-head pl-6">
                頁面
              </th>
              <th scope="col" class="cu-table-head text-right">
                瀏覽量
              </th>
              <th scope="col" class="cu-table-head text-right">
                不重複訪客
              </th>
              <th scope="col" class="cu-table-head text-right">
                平均停留
              </th>
              <th scope="col" class="cu-table-head text-right pr-6">
                跳出率
              </th>
            </tr>
          </thead>
          <tbody class="cu-table-body">
            {topPages.map((page) => (
              <tr class="cu-table-row">
                <td class="cu-table-cell pl-6">
                  <div class="flex items-center gap-3">
                    <div
                      class="w-8 h-8 rounded-md bg-primary/10 text-primary flex items-center justify-center shrink-0"
                      aria-hidden="true"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        {page.icon === "home" && (
                          <>
                            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                            <polyline points="9 22 9 12 15 12 15 22" />
                          </>
                        )}
                        {page.icon === "package" && (
                          <>
                            <path d="m7.5 4.27 9 5.15" />
                            <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
                          </>
                        )}
                        {page.icon === "dollar" && (
                          <>
                            <line x1="12" y1="1" x2="12" y2="23" />
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                          </>
                        )}
                        {page.icon === "file" && (
                          <>
                            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                            <polyline points="14 2 14 8 20 8" />
                          </>
                        )}
                      </svg>
                    </div>
                    <div>
                      <p class="text-sm font-medium font-mono text-foreground">{page.path}</p>
                      <p class="text-xs text-muted-foreground">{page.name}</p>
                    </div>
                  </div>
                </td>
                <td class="cu-table-cell text-right font-medium tabular-nums text-foreground">{page.views}</td>
                <td class="cu-table-cell text-right tabular-nums text-muted-foreground">{page.visitors}</td>
                <td class="cu-table-cell text-right tabular-nums text-muted-foreground">{page.duration}</td>
                <td class="cu-table-cell text-right pr-6">
                  <Badge variant={bounceBadge(page.bounce)} class="tabular-nums">
                    {page.bounce}%
                  </Badge>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Card>
  </div>
</DashboardV4Layout>

<script>
  document.querySelectorAll<HTMLElement>("[data-v4-period]").forEach((group) => {
    group.addEventListener("click", (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>(".cu-segmented-item");
      if (!btn) return;
      group.querySelectorAll(".cu-segmented-item").forEach((item) => {
        const active = item === btn;
        item.classList.toggle("cu-segmented-item-active", active);
        item.setAttribute("aria-pressed", String(active));
      });
    });
  });
</script>
