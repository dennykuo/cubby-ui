---
import { withBase } from "@/utils/paths";
import "@/styles/global.css";

const highlights = [
  { value: "500+", label: "企業客戶" },
  { value: "10M+", label: "資料筆數處理" },
  { value: "99.9%", label: "服務可用性" },
  { value: "4.9", label: "客戶滿意度" },
];
---

<!doctype html>
<html lang="zh-Hant" data-theme-prism>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Register — Prism" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>註冊 — Prism</title>
    <style is:global>
      /* Prism 品牌色：與 DashboardV4Layout 相同，覆寫 primary / ring / chart-1 */
      html[data-theme-prism] {
        --color-primary: hsl(262 83% 58%);
        --color-primary-foreground: hsl(0 0% 100%);
        --color-ring: hsl(262 83% 58%);
        --color-chart-1: hsl(262 83% 58%);
      }

      html.dark[data-theme-prism] {
        --color-primary: hsl(258 90% 66%);
        --color-primary-foreground: hsl(0 0% 100%);
        --color-ring: hsl(263 60% 40%);
        --color-chart-1: hsl(258 90% 66%);
      }
    </style>
  </head>
  <body class="min-h-screen font-sans antialiased text-foreground bg-background">
    <div class="grid min-h-screen lg:grid-cols-2">
      <!-- Left: Brand Panel -->
      <aside
        class="hidden lg:flex flex-col justify-between bg-muted/40 p-10 border-r border-border"
        aria-label="Prism 平台數據"
      >
        <a href={withBase("/examples/dashboard-v4")} class="flex items-center gap-2.5 self-start rounded-lg">
          <div
            class="flex items-center justify-center w-9 h-9 rounded-xl bg-gradient-to-br from-violet-500 to-purple-600 text-white shadow-sm"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <span class="text-xl font-bold tracking-tight text-foreground">Prism</span>
        </a>
        <div class="space-y-8">
          <div class="space-y-4">
            <h2 class="text-3xl font-bold leading-tight text-foreground">
              開始您的
              <br />
              數據分析之旅
            </h2>
            <p class="text-muted-foreground max-w-md">免費試用 14 天，無需信用卡。體驗企業級的數據分析平台。</p>
          </div>
          <dl class="grid grid-cols-2 gap-4">
            {highlights.map((h) => (
              <div class="flex flex-col-reverse p-4 rounded-xl bg-card border border-border/60 shadow-xs text-center">
                <dt class="text-sm text-muted-foreground">{h.label}</dt>
                <dd class="text-2xl font-bold tabular-nums text-foreground">{h.value}</dd>
              </div>
            ))}
          </dl>
        </div>
        <p class="text-xs text-muted-foreground">© 2026 Prism Analytics. All rights reserved.</p>
      </aside>

      <!-- Right: Register Form -->
      <main class="flex items-center justify-center p-6 sm:p-8">
        <div class="w-full max-w-sm space-y-6">
          <!-- Mobile Logo -->
          <a href={withBase("/examples/dashboard-v4")} class="flex items-center gap-2.5 lg:hidden mb-8 w-fit">
            <div
              class="flex items-center justify-center w-9 h-9 rounded-xl bg-gradient-to-br from-violet-500 to-purple-600 text-white shadow-sm"
              aria-hidden="true"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                <polyline points="2 17 12 22 22 17"></polyline>
                <polyline points="2 12 12 17 22 12"></polyline>
              </svg>
            </div>
            <span class="text-xl font-bold tracking-tight text-foreground">Prism</span>
          </a>

          <div class="space-y-2">
            <h1 class="text-2xl font-bold tracking-tight text-foreground">建立帳號</h1>
            <p class="text-sm text-muted-foreground">填寫以下資訊開始免費試用</p>
          </div>

          <form class="space-y-4" action={withBase("/examples/dashboard-v4")}>
            <div class="grid grid-cols-2 gap-3">
              <div class="cu-form-group">
                <label class="cu-label" for="family-name">
                  姓氏
                </label>
                <input
                  class="cu-input"
                  id="family-name"
                  name="family-name"
                  type="text"
                  autocomplete="family-name"
                  placeholder="王"
                  required
                  aria-required="true"
                />
              </div>
              <div class="cu-form-group">
                <label class="cu-label" for="given-name">
                  名字
                </label>
                <input
                  class="cu-input"
                  id="given-name"
                  name="given-name"
                  type="text"
                  autocomplete="given-name"
                  placeholder="小明"
                  required
                  aria-required="true"
                />
              </div>
            </div>
            <div class="cu-form-group">
              <label class="cu-label" for="email">
                公司 Email
              </label>
              <input
                class="cu-input"
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="name@company.com"
                required
                aria-required="true"
              />
            </div>
            <div class="cu-form-group">
              <label class="cu-label" for="company">
                公司名稱
              </label>
              <input
                class="cu-input"
                id="company"
                name="company"
                type="text"
                autocomplete="organization"
                placeholder="您的公司名稱"
              />
            </div>
            <div class="cu-form-group">
              <label class="cu-label" for="password">
                密碼
              </label>
              <input
                class="cu-input"
                id="password"
                name="password"
                type="password"
                autocomplete="new-password"
                minlength="8"
                placeholder="至少 8 個字元"
                required
                aria-required="true"
                aria-describedby="password-hint"
              />
              <p id="password-hint" class="cu-form-description">
                密碼長度至少 8 個字元
              </p>
            </div>
            <div class="cu-checkbox-wrapper items-start">
              <input type="checkbox" class="cu-checkbox mt-0.5" id="terms" name="terms" required aria-required="true" />
              <label for="terms" class="text-sm">
                我已閱讀並同意
                <a href="#" class="cu-link-plain">
                  服務條款
                </a>
                與
                <a href="#" class="cu-link-plain">
                  隱私政策
                </a>
              </label>
            </div>
            <button type="submit" class="cu-button cu-button-default cu-button-md w-full">
              建立帳號
            </button>
          </form>

          <div class="relative">
            <div class="absolute inset-0 flex items-center" aria-hidden="true">
              <div class="cu-separator cu-separator-horizontal"></div>
            </div>
            <div class="relative flex justify-center">
              <span class="bg-background px-3 text-xs text-muted-foreground">或使用其他方式</span>
            </div>
          </div>

          <button type="button" class="cu-button cu-button-outline cu-button-md w-full">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"
                fill="#4285F4"
              />
              <path
                d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                fill="#34A853"
              />
              <path
                d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                fill="#FBBC05"
              />
              <path
                d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                fill="#EA4335"
              />
            </svg>
            使用 Google 帳號註冊
          </button>

          <p class="text-center text-sm text-muted-foreground">
            已經有帳號？
            <a href={withBase("/examples/dashboard-v4/login")} class="cu-link-plain">
              立即登入
            </a>
          </p>
        </div>
      </main>
    </div>
  </body>
</html>
