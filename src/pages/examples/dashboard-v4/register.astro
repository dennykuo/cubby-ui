---
import "../../../styles/global.css";
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Register — Prism" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>註冊 — Prism</title>
		<style>
			body { font-family: 'Inter', system-ui, sans-serif; }
		</style>
	</head>
	<body class="min-h-screen antialiased bg-slate-50">
		<div class="grid min-h-screen lg:grid-cols-2">
			<!-- Left: Brand Panel -->
			<div class="hidden lg:flex flex-col justify-between bg-white p-10 border-r border-slate-200/80">
				<div class="flex items-center gap-2.5">
					<div class="flex items-center justify-center w-9 h-9 rounded-xl bg-violet-600 text-white">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 3L2 12h3v9h14v-9h3L12 3z"/>
						</svg>
					</div>
					<span class="text-xl font-bold tracking-tight text-slate-900">Prism</span>
				</div>
				<div class="space-y-8">
					<div class="space-y-4">
						<h2 class="text-3xl font-bold leading-tight text-slate-900">開始您的<br/>數據分析之旅</h2>
						<p class="text-slate-500 max-w-md">
							免費試用 14 天，無需信用卡。體驗企業級的數據分析平台。
						</p>
					</div>
					<div class="grid grid-cols-2 gap-4">
						<div class="p-4 rounded-xl bg-slate-50 border border-slate-100 text-center">
							<div class="text-2xl font-bold text-slate-900">500+</div>
							<div class="text-sm text-slate-500">企業客戶</div>
						</div>
						<div class="p-4 rounded-xl bg-slate-50 border border-slate-100 text-center">
							<div class="text-2xl font-bold text-slate-900">10M+</div>
							<div class="text-sm text-slate-500">資料筆數處理</div>
						</div>
						<div class="p-4 rounded-xl bg-slate-50 border border-slate-100 text-center">
							<div class="text-2xl font-bold text-slate-900">99.9%</div>
							<div class="text-sm text-slate-500">服務可用性</div>
						</div>
						<div class="p-4 rounded-xl bg-slate-50 border border-slate-100 text-center">
							<div class="text-2xl font-bold text-slate-900">4.9</div>
							<div class="text-sm text-slate-500">客戶滿意度</div>
						</div>
					</div>
				</div>
				<p class="text-xs text-slate-400">© 2026 Prism Analytics. All rights reserved.</p>
			</div>

			<!-- Right: Register Form -->
			<div class="flex items-center justify-center p-8">
				<div class="w-full max-w-sm space-y-6">
					<!-- Mobile Logo -->
					<div class="flex items-center gap-2.5 lg:hidden mb-8">
						<div class="flex items-center justify-center w-9 h-9 rounded-xl bg-violet-600 text-white">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 3L2 12h3v9h14v-9h3L12 3z"/>
							</svg>
						</div>
						<span class="text-xl font-bold tracking-tight">Prism</span>
					</div>

					<div class="space-y-2">
						<h1 class="text-2xl font-bold tracking-tight text-slate-900">建立帳號</h1>
						<p class="text-sm text-slate-500">填寫以下資訊開始免費試用</p>
					</div>

					<form class="space-y-4" action="/examples/dashboard-v4">
						<div class="grid grid-cols-2 gap-3">
							<div class="cu-form-group">
								<label class="cu-label" for="first-name">姓氏</label>
								<input class="cu-input" id="first-name" type="text" placeholder="王" required aria-required="true" />
							</div>
							<div class="cu-form-group">
								<label class="cu-label" for="last-name">名字</label>
								<input class="cu-input" id="last-name" type="text" placeholder="小明" required aria-required="true" />
							</div>
						</div>
						<div class="cu-form-group">
							<label class="cu-label" for="email">公司 Email</label>
							<input class="cu-input" id="email" type="email" placeholder="name@company.com" required aria-required="true" />
						</div>
						<div class="cu-form-group">
							<label class="cu-label" for="company">公司名稱</label>
							<input class="cu-input" id="company" type="text" placeholder="您的公司名稱" />
						</div>
						<div class="cu-form-group">
							<label class="cu-label" for="password">密碼</label>
							<input class="cu-input" id="password" type="password" placeholder="至少 8 個字元" required aria-required="true" />
						</div>
						<label class="cu-checkbox-wrapper">
							<input type="checkbox" class="cu-checkbox" required />
							<span class="text-sm">我已閱讀並同意<a href="#" class="text-violet-600 hover:text-violet-700">服務條款</a>與<a href="#" class="text-violet-600 hover:text-violet-700">隱私政策</a></span>
						</label>
						<button type="submit" class="cu-button cu-button-md w-full bg-violet-600 hover:bg-violet-700 text-white border-0">建立帳號</button>
					</form>

					<div class="relative">
						<div class="absolute inset-0 flex items-center"><div class="cu-separator"></div></div>
						<div class="relative flex justify-center"><span class="bg-slate-50 px-3 text-xs text-slate-500">或使用其他方式</span></div>
					</div>

					<button type="button" class="cu-button cu-button-outline cu-button-md w-full">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" class="mr-2"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
						使用 Google 帳號註冊
					</button>

					<p class="text-center text-sm text-slate-500">
						已經有帳號？
						<a href="/examples/dashboard-v4/login" class="text-violet-600 hover:text-violet-700 font-medium transition-colors duration-150">立即登入</a>
					</p>
				</div>
			</div>
		</div>
	</body>
</html>
