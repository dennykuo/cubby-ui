---
import { withBase } from "@/utils/paths";
import "@/styles/global.css";
---

<!doctype html>
<html lang="zh-Hant" data-theme-prism>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Reset Password — Prism" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>重設密碼 — Prism</title>
    <style is:global>
      /* Prism 品牌色：與 DashboardV4Layout 相同，覆寫 primary / ring / chart-1 */
      html[data-theme-prism] {
        --color-primary: hsl(262 83% 58%);
        --color-primary-foreground: hsl(0 0% 100%);
        --color-ring: hsl(262 83% 58%);
        --color-chart-1: hsl(262 83% 58%);
      }

      html.dark[data-theme-prism] {
        --color-primary: hsl(258 90% 66%);
        --color-primary-foreground: hsl(0 0% 100%);
        --color-ring: hsl(263 60% 40%);
        --color-chart-1: hsl(258 90% 66%);
      }
    </style>
  </head>
  <body class="min-h-screen font-sans antialiased text-foreground bg-background">
    <div class="grid min-h-screen lg:grid-cols-2">
      <!-- Left: Brand Panel -->
      <aside
        class="hidden lg:flex flex-col justify-between bg-muted/40 p-10 border-r border-border"
        aria-label="重設密碼說明"
      >
        <a href={withBase("/examples/dashboard-v4")} class="flex items-center gap-2.5 self-start rounded-lg">
          <div
            class="flex items-center justify-center w-9 h-9 rounded-xl bg-gradient-to-br from-violet-500 to-purple-600 text-white shadow-sm"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
          <span class="text-xl font-bold tracking-tight text-foreground">Prism</span>
        </a>
        <div class="space-y-6">
          <div class="p-8 rounded-2xl bg-card border border-border/60 shadow-xs">
            <div
              class="flex items-center justify-center w-16 h-16 rounded-full bg-primary/10 text-primary mb-6"
              aria-hidden="true"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect width="20" height="16" x="2" y="4" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
            </div>
            <h2 class="text-xl font-semibold text-foreground mb-3">檢查您的信箱</h2>
            <p class="text-muted-foreground text-sm leading-relaxed">
              我們將發送一封包含重設密碼連結的郵件。連結將於 1 小時後失效，請盡快完成重設。
            </p>
          </div>
          <div class="cu-alert cu-alert-info" role="note">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10" />
              <path d="M12 16v-4" />
              <path d="M12 8h.01" />
            </svg>
            <div class="cu-alert-description">如果您沒有收到郵件，請檢查垃圾郵件資料夾</div>
          </div>
        </div>
        <p class="text-xs text-muted-foreground">© 2026 Prism Analytics. All rights reserved.</p>
      </aside>

      <!-- Right: Forgot Password Form -->
      <main class="flex items-center justify-center p-6 sm:p-8">
        <div class="w-full max-w-sm space-y-6">
          <!-- Mobile Logo -->
          <a href={withBase("/examples/dashboard-v4")} class="flex items-center gap-2.5 lg:hidden mb-8 w-fit">
            <div
              class="flex items-center justify-center w-9 h-9 rounded-xl bg-gradient-to-br from-violet-500 to-purple-600 text-white shadow-sm"
              aria-hidden="true"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                <polyline points="2 17 12 22 22 17"></polyline>
                <polyline points="2 12 12 17 22 12"></polyline>
              </svg>
            </div>
            <span class="text-xl font-bold tracking-tight text-foreground">Prism</span>
          </a>

          <div class="space-y-2">
            <h1 class="text-2xl font-bold tracking-tight text-foreground">忘記密碼？</h1>
            <p class="text-sm text-muted-foreground">輸入您的 Email，我們將發送重設密碼連結</p>
          </div>

          <form class="space-y-4" action={withBase("/examples/dashboard-v4/login")}>
            <div class="cu-form-group">
              <label class="cu-label" for="email">
                Email
              </label>
              <input
                class="cu-input"
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="name@company.com"
                required
                aria-required="true"
              />
            </div>
            <button type="submit" class="cu-button cu-button-default cu-button-md w-full">
              發送重設連結
            </button>
          </form>

          <!-- 窄螢幕不顯示左側說明面板，在此補上提示 -->
          <div class="cu-alert cu-alert-info lg:hidden" role="note">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10" />
              <path d="M12 16v-4" />
              <path d="M12 8h.01" />
            </svg>
            <div class="cu-alert-description">連結將於 1 小時後失效；若沒有收到郵件，請檢查垃圾郵件資料夾</div>
          </div>

          <p class="text-center text-sm text-muted-foreground">
            想起密碼了？
            <a href={withBase("/examples/dashboard-v4/login")} class="cu-link-plain">
              返回登入
            </a>
          </p>
        </div>
      </main>
    </div>
  </body>
</html>
