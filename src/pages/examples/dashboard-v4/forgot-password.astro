---
import "@/styles/global.css";
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Reset Password — Prism" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>重設密碼 — Prism</title>
		<style>
			body { font-family: 'Inter', system-ui, sans-serif; }
		</style>
	</head>
	<body class="min-h-screen antialiased bg-slate-50">
		<div class="grid min-h-screen lg:grid-cols-2">
			<!-- Left: Brand Panel -->
			<div class="hidden lg:flex flex-col justify-between bg-white p-10 border-r border-slate-200/80">
				<div class="flex items-center gap-2.5">
					<div class="flex items-center justify-center w-9 h-9 rounded-xl bg-violet-600 text-white">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 3L2 12h3v9h14v-9h3L12 3z"/>
						</svg>
					</div>
					<span class="text-xl font-bold tracking-tight text-slate-900">Prism</span>
				</div>
				<div class="space-y-6">
					<div class="p-8 rounded-2xl bg-slate-50 border border-slate-100">
						<div class="flex items-center justify-center w-16 h-16 rounded-full bg-violet-100 mb-6">
							<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-violet-600">
								<rect width="20" height="16" x="2" y="4" rx="2"/>
								<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
							</svg>
						</div>
						<h3 class="text-xl font-semibold text-slate-900 mb-3">檢查您的信箱</h3>
						<p class="text-slate-500 text-sm leading-relaxed">
							我們將發送一封包含重設密碼連結的郵件。連結將於 1 小時後失效，請盡快完成重設。
						</p>
					</div>
					<div class="flex items-center gap-3 p-4 rounded-xl bg-blue-50 border border-blue-100">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-600 shrink-0"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
						<p class="text-sm text-blue-700">如果您沒有收到郵件，請檢查垃圾郵件資料夾</p>
					</div>
				</div>
				<p class="text-xs text-slate-400">© 2026 Prism Analytics. All rights reserved.</p>
			</div>

			<!-- Right: Forgot Password Form -->
			<div class="flex items-center justify-center p-8">
				<div class="w-full max-w-sm space-y-6">
					<!-- Mobile Logo -->
					<div class="flex items-center gap-2.5 lg:hidden mb-8">
						<div class="flex items-center justify-center w-9 h-9 rounded-xl bg-violet-600 text-white">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 3L2 12h3v9h14v-9h3L12 3z"/>
							</svg>
						</div>
						<span class="text-xl font-bold tracking-tight">Prism</span>
					</div>

					<div class="space-y-2">
						<h1 class="text-2xl font-bold tracking-tight text-slate-900">忘記密碼？</h1>
						<p class="text-sm text-slate-500">輸入您的 Email，我們將發送重設密碼連結</p>
					</div>

					<form class="space-y-4" action="/examples/dashboard-v4/login">
						<div class="cu-form-group">
							<label class="cu-label" for="email">Email</label>
							<input class="cu-input" id="email" type="email" placeholder="name@company.com" required aria-required="true" />
						</div>
						<button type="submit" class="cu-button cu-button-md w-full bg-violet-600 hover:bg-violet-700 text-white border-0">發送重設連結</button>
					</form>

					<p class="text-center text-sm text-slate-500">
						想起密碼了？
						<a href="/examples/dashboard-v4/login" class="text-violet-600 hover:text-violet-700 font-medium transition-colors duration-150">返回登入</a>
					</p>
				</div>
			</div>
		</div>
	</body>
</html>
