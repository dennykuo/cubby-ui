---
import { withBase } from "@/utils/paths";
import DashboardV5Layout from "@/layouts/DashboardV5Layout.astro";
---

<DashboardV5Layout title='MacBook Pro 14" — DataHub'>
    <Fragment slot="breadcrumb">
        <span class="text-muted-foreground/50">/</span>
        <a href={withBase("/examples/dashboard-v5")} class="text-muted-foreground hover:text-foreground transition-colors duration-150">產品管理</a>
        <span class="text-muted-foreground/50">/</span>
        <span class="font-medium">MacBook Pro 14"</span>
    </Fragment>

    <div class="space-y-6">
        <!-- Page Header -->
        <header class="cu-page-header">
            <div class="cu-page-header-content">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-lg bg-muted flex items-center justify-center text-2xl shrink-0">💻</div>
                    <div>
                        <h1 class="cu-page-header-title">MacBook Pro 14"</h1>
                        <p class="cu-page-header-description">PRD-001 · 筆記型電腦</p>
                    </div>
                </div>
            </div>
            <div class="cu-page-header-actions">
                <a href={withBase("/examples/dashboard-v5")} class="cu-button cu-button-outline">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                    返回列表
                </a>
                <a href={withBase("/examples/dashboard-v5/products/create")} class="cu-button cu-button-default">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                    編輯
                </a>
            </div>
        </header>

        <!-- Content Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left Column (2/3) -->
            <div class="lg:col-span-2 space-y-6">
                <!-- 基本資料 -->
                <div class="cu-card">
                    <div class="cu-card-header">
                        <h2 class="cu-card-title text-base">基本資料</h2>
                    </div>
                    <div class="cu-card-content">
                        <dl>
                            <div class="flex flex-col sm:flex-row sm:items-center py-3 border-b border-border">
                                <dt class="sm:w-1/3 text-sm text-muted-foreground">產品名稱</dt>
                                <dd class="sm:w-2/3 text-sm font-medium">MacBook Pro 14"</dd>
                            </div>
                            <div class="flex flex-col sm:flex-row sm:items-center py-3 border-b border-border">
                                <dt class="sm:w-1/3 text-sm text-muted-foreground">產品編號</dt>
                                <dd class="sm:w-2/3 text-sm font-medium">
                                    <code class="text-xs font-mono text-muted-foreground bg-muted px-2 py-1 rounded">PRD-001</code>
                                </dd>
                            </div>
                            <div class="flex flex-col sm:flex-row sm:items-center py-3 border-b border-border">
                                <dt class="sm:w-1/3 text-sm text-muted-foreground">分類</dt>
                                <dd class="sm:w-2/3 text-sm font-medium">筆記型電腦</dd>
                            </div>
                            <div class="flex flex-col sm:flex-row sm:items-center py-3 border-b border-border">
                                <dt class="sm:w-1/3 text-sm text-muted-foreground">售價</dt>
                                <dd class="sm:w-2/3 text-sm font-medium">$59,900</dd>
                            </div>
                            <div class="flex flex-col sm:flex-row sm:items-center py-3 border-b border-border">
                                <dt class="sm:w-1/3 text-sm text-muted-foreground">成本</dt>
                                <dd class="sm:w-2/3 text-sm font-medium">$45,000</dd>
                            </div>
                            <div class="flex flex-col sm:flex-row sm:items-center py-3 border-b border-border">
                                <dt class="sm:w-1/3 text-sm text-muted-foreground">庫存數量</dt>
                                <dd class="sm:w-2/3 text-sm font-medium">
                                    24 <span class="cu-badge cu-badge-soft-success ml-2">充足</span>
                                </dd>
                            </div>
                            <div class="flex flex-col sm:flex-row sm:items-center py-3">
                                <dt class="sm:w-1/3 text-sm text-muted-foreground">狀態</dt>
                                <dd class="sm:w-2/3 text-sm font-medium">
                                    <span class="cu-badge cu-badge-soft-success">上架中</span>
                                </dd>
                            </div>
                        </dl>
                    </div>
                </div>

                <!-- 產品描述 -->
                <div class="cu-card">
                    <div class="cu-card-header">
                        <h2 class="cu-card-title text-base">產品描述</h2>
                    </div>
                    <div class="cu-card-content">
                        <p class="text-sm text-muted-foreground leading-relaxed">全新 MacBook Pro 14 吋搭載 Apple M3 Pro 晶片，提供卓越的效能與續航力。配備 Liquid Retina XDR 顯示器，支援 ProMotion 自適應更新率技術，帶來極致流暢的視覺體驗。適合專業創作者、開發人員及對效能有高度需求的使用者。</p>
                    </div>
                </div>

                <!-- 近期訂單 -->
                <div class="cu-card">
                    <div class="cu-card-header">
                        <h2 class="cu-card-title text-base">近期訂單</h2>
                    </div>
                    <div class="cu-card-content-flush">
                        <div class="cu-table-wrapper">
                            <table class="cu-table">
                                <thead class="cu-table-header">
                                    <tr class="cu-table-row hover:bg-transparent">
                                        <th class="cu-table-head">訂單編號</th>
                                        <th class="cu-table-head">客戶</th>
                                        <th class="cu-table-head text-right">金額</th>
                                        <th class="cu-table-head text-right">日期</th>
                                    </tr>
                                </thead>
                                <tbody class="cu-table-body">
                                    <tr class="cu-table-row">
                                        <td class="cu-table-cell"><code class="text-xs font-mono font-medium">ORD-2024-001</code></td>
                                        <td class="cu-table-cell">陳柏翰</td>
                                        <td class="cu-table-cell text-right font-medium tabular-nums">$59,900</td>
                                        <td class="cu-table-cell text-right text-muted-foreground">2026/02/03</td>
                                    </tr>
                                    <tr class="cu-table-row">
                                        <td class="cu-table-cell"><code class="text-xs font-mono font-medium">ORD-2024-005</code></td>
                                        <td class="cu-table-cell">李佳穎</td>
                                        <td class="cu-table-cell text-right font-medium tabular-nums">$59,900</td>
                                        <td class="cu-table-cell text-right text-muted-foreground">2026/02/02</td>
                                    </tr>
                                    <tr class="cu-table-row">
                                        <td class="cu-table-cell"><code class="text-xs font-mono font-medium">ORD-2024-008</code></td>
                                        <td class="cu-table-cell">許志明</td>
                                        <td class="cu-table-cell text-right font-medium tabular-nums">$59,900</td>
                                        <td class="cu-table-cell text-right text-muted-foreground">2026/02/01</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="cu-card-footer">
                        <a href={withBase("/examples/dashboard-v5/orders")} class="text-sm cu-link">查看所有訂單 &rarr;</a>
                    </div>
                </div>
            </div>

            <!-- Right Column (1/3) -->
            <div class="space-y-6">
                <!-- Stat Cards -->
                <div class="cu-stat">
                    <div class="cu-stat-header">
                        <span class="cu-stat-label">瀏覽數</span>
                        <div class="cu-stat-icon-box">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                        </div>
                    </div>
                    <div class="cu-stat-value">1,284</div>
                </div>
                <div class="cu-stat">
                    <div class="cu-stat-header">
                        <span class="cu-stat-label">本月銷量</span>
                        <div class="cu-stat-icon-box cu-stat-icon-box-info">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
                        </div>
                    </div>
                    <div class="cu-stat-value">18</div>
                </div>
                <div class="cu-stat">
                    <div class="cu-stat-header">
                        <span class="cu-stat-label">本月營收</span>
                        <div class="cu-stat-icon-box cu-stat-icon-box-success">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                        </div>
                    </div>
                    <div class="cu-stat-value">$1,078,200</div>
                </div>

                <!-- 操作 -->
                <div class="cu-card">
                    <div class="cu-card-header">
                        <h2 class="cu-card-title text-base">操作</h2>
                    </div>
                    <div class="cu-card-content space-y-3">
                        <a href={withBase("/examples/dashboard-v5/products/create")} class="cu-button cu-button-default w-full">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                            編輯產品
                        </a>
                        <button class="cu-button cu-button-outline border-destructive/50 text-destructive hover:bg-destructive/10 w-full">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                            刪除產品
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</DashboardV5Layout>
