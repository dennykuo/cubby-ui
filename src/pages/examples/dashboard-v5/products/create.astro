---
import { withBase } from "@/utils/paths";
import DashboardV5Layout from "@/layouts/DashboardV5Layout.astro";
---

<DashboardV5Layout title="新增產品 — DataHub">
    <Fragment slot="breadcrumb">
        <span class="text-muted-foreground/50">/</span>
        <a href={withBase("/examples/dashboard-v5")} class="text-muted-foreground hover:text-foreground transition-colors duration-150">產品管理</a>
        <span class="text-muted-foreground/50">/</span>
        <span class="font-medium">新增產品</span>
    </Fragment>

    <div class="space-y-6">
        <!-- Page Header -->
        <header class="cu-page-header">
            <div class="cu-page-header-content">
                <h1 class="cu-page-header-title">新增產品</h1>
            </div>
            <div class="cu-page-header-actions">
                <a href={withBase("/examples/dashboard-v5")} class="cu-button cu-button-outline cu-button-md">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                    返回列表
                </a>
            </div>
        </header>

        <!-- Form Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left 2/3 -->
            <div class="lg:col-span-2 space-y-6">
                <!-- 基本資料 -->
                <div class="cu-card">
                    <div class="cu-card-header">
                        <h2 class="cu-card-title text-base">基本資料</h2>
                    </div>
                    <div class="cu-card-content space-y-4">
                        <div class="space-y-2">
                            <label class="cu-label cu-label-required">產品名稱</label>
                            <input type="text" class="cu-input cu-input-error" placeholder="輸入產品名稱" />
                            <p class="cu-form-error">請輸入產品名稱</p>
                        </div>
                        <div class="space-y-2">
                            <label class="cu-label">分類</label>
                            <div class="cu-select-wrapper">
                                <select class="cu-select">
                                    <option value="">選擇分類</option>
                                    <option value="laptop">筆記型電腦</option>
                                    <option value="phone">智慧型手機</option>
                                    <option value="tablet">平板電腦</option>
                                    <option value="headphone">耳機</option>
                                    <option value="wearable">穿戴裝置</option>
                                    <option value="accessory">配件</option>
                                    <option value="monitor">顯示器</option>
                                    <option value="desktop">桌上型電腦</option>
                                </select>
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cu-select-icon"><path d="m6 9 6 6 6-6"/></svg>
                            </div>
                        </div>
                        <div class="space-y-2">
                            <label class="cu-label">產品編號 (SKU)</label>
                            <input type="text" class="cu-input" placeholder="自動產生" />
                        </div>
                        <div class="space-y-2">
                            <label class="cu-label">產品描述</label>
                            <textarea class="cu-textarea" rows="4" placeholder="輸入產品描述..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- 定價與庫存 -->
                <div class="cu-card">
                    <div class="cu-card-header">
                        <h2 class="cu-card-title text-base">定價與庫存</h2>
                    </div>
                    <div class="cu-card-content space-y-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label class="cu-label">售價</label>
                                <input type="number" class="cu-input" placeholder="0" />
                            </div>
                            <div class="space-y-2">
                                <label class="cu-label">成本</label>
                                <input type="number" class="cu-input" placeholder="0" />
                            </div>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="space-y-2">
                                <label class="cu-label">庫存數量</label>
                                <input type="number" class="cu-input" placeholder="0" />
                            </div>
                            <div class="space-y-2">
                                <label class="cu-label">低庫存警示值</label>
                                <input type="number" class="cu-input" placeholder="10" />
                            </div>
                        </div>
                        <div class="flex items-start gap-2">
                            <input type="checkbox" class="cu-checkbox mt-0.5" id="track-inventory" />
                            <label for="track-inventory" class="text-sm">啟用庫存追蹤，當庫存低於警示值時發送通知</label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right 1/3 -->
            <div class="lg:sticky lg:top-6 lg:self-start space-y-6">
                <!-- 狀態 -->
                <div class="cu-card">
                    <div class="cu-card-header">
                        <h2 class="cu-card-title text-base">狀態</h2>
                    </div>
                    <div class="cu-card-content">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm font-medium">立即上架</p>
                                <p class="text-sm text-muted-foreground mt-0.5">開啟後產品將在前台顯示</p>
                            </div>
                            <label class="cu-toggle-wrapper">
                                <input type="checkbox" class="peer sr-only" />
                                <span class="cu-toggle"></span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- 操作 -->
                <div class="cu-card">
                    <div class="cu-card-header">
                        <h2 class="cu-card-title text-base">操作</h2>
                    </div>
                    <div class="cu-card-content space-y-3">
                        <button class="cu-button cu-button-default w-full">儲存產品</button>
                        <a href={withBase("/examples/dashboard-v5")} class="cu-button cu-button-outline w-full">取消</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</DashboardV5Layout>
