---
import { withBase } from "@/utils/paths";
import DashboardV5Layout from "@/layouts/DashboardV5Layout.astro";
---

<DashboardV5Layout title="新增產品 — DataHub">
  <Fragment slot="breadcrumb">
    <li class="cu-breadcrumb-separator" aria-hidden="true">
      /
    </li>
    <li class="cu-breadcrumb-item">
      <a href={withBase("/examples/dashboard-v5")} class="cu-breadcrumb-link">
        產品管理
      </a>
    </li>
    <li class="cu-breadcrumb-separator" aria-hidden="true">
      /
    </li>
    <li class="cu-breadcrumb-item">
      <span class="cu-breadcrumb-current" aria-current="page">
        新增產品
      </span>
    </li>
  </Fragment>

  <div class="space-y-6">
    <!-- Page Header -->
    <header class="cu-page-header">
      <div class="cu-page-header-content">
        <h1 class="cu-page-header-title text-2xl md:text-2xl">新增產品</h1>
        <p class="cu-page-header-description">填寫產品資訊、定價與庫存，儲存後即可加入產品目錄。</p>
      </div>
      <div class="cu-page-header-actions">
        <a href={withBase("/examples/dashboard-v5")} class="cu-button cu-button-outline cu-button-md">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m12 19-7-7 7-7" />
            <path d="M19 12H5" />
          </svg>
          返回列表
        </a>
      </div>
    </header>

    <!-- Form Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Left 2/3 -->
      <div class="lg:col-span-2 space-y-6">
        <!-- 基本資料 -->
        <div class="cu-card">
          <div class="cu-card-header">
            <h2 class="cu-card-title text-base">基本資料</h2>
          </div>
          <div class="cu-card-content space-y-4">
            <div class="space-y-2">
              <label class="cu-label cu-label-required" for="create-name">
                產品名稱
              </label>
              <input
                type="text"
                id="create-name"
                class="cu-input cu-input-error"
                placeholder="輸入產品名稱"
                required
                aria-invalid="true"
                aria-describedby="create-name-error"
              />
              <p class="cu-form-error" id="create-name-error">
                請輸入產品名稱
              </p>
            </div>
            <div class="space-y-2">
              <label class="cu-label" for="create-category">
                分類
              </label>
              <div class="cu-select-wrapper">
                <select class="cu-select" id="create-category">
                  <option value="">選擇分類</option>
                  <option value="laptop">筆記型電腦</option>
                  <option value="phone">智慧型手機</option>
                  <option value="tablet">平板電腦</option>
                  <option value="headphone">耳機</option>
                  <option value="wearable">穿戴裝置</option>
                  <option value="accessory">配件</option>
                  <option value="monitor">顯示器</option>
                  <option value="desktop">桌上型電腦</option>
                </select>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="cu-select-icon"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </div>
            </div>
            <div class="space-y-2">
              <label class="cu-label" for="create-sku">
                產品編號 (SKU)
              </label>
              <input type="text" id="create-sku" class="cu-input" placeholder="自動產生" />
            </div>
            <div class="space-y-2">
              <label class="cu-label" for="create-description">
                產品描述
              </label>
              <textarea id="create-description" class="cu-textarea" rows="4" placeholder="輸入產品描述..."></textarea>
            </div>
          </div>
        </div>

        <!-- 定價與庫存 -->
        <div class="cu-card">
          <div class="cu-card-header">
            <h2 class="cu-card-title text-base">定價與庫存</h2>
          </div>
          <div class="cu-card-content space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-2">
                <label class="cu-label" for="create-price">
                  售價
                </label>
                <input type="number" id="create-price" class="cu-input" placeholder="0" min="0" inputmode="numeric" />
              </div>
              <div class="space-y-2">
                <label class="cu-label" for="create-cost">
                  成本
                </label>
                <input type="number" id="create-cost" class="cu-input" placeholder="0" min="0" inputmode="numeric" />
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-2">
                <label class="cu-label" for="create-stock">
                  庫存數量
                </label>
                <input type="number" id="create-stock" class="cu-input" placeholder="0" min="0" inputmode="numeric" />
              </div>
              <div class="space-y-2">
                <label class="cu-label" for="create-stock-alert">
                  低庫存警示值
                </label>
                <input
                  type="number"
                  id="create-stock-alert"
                  class="cu-input"
                  placeholder="10"
                  min="0"
                  inputmode="numeric"
                />
              </div>
            </div>
            <div class="flex items-start gap-2">
              <input type="checkbox" class="cu-checkbox mt-0.5" id="track-inventory" />
              <label for="track-inventory" class="text-sm">
                啟用庫存追蹤，當庫存低於警示值時發送通知
              </label>
            </div>
          </div>
        </div>
      </div>

      <!-- Right 1/3 -->
      <div class="lg:sticky lg:top-6 lg:self-start space-y-6">
        <!-- 狀態 -->
        <div class="cu-card">
          <div class="cu-card-header">
            <h2 class="cu-card-title text-base">狀態</h2>
          </div>
          <div class="cu-card-content">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium" id="publish-now-label">
                  立即上架
                </p>
                <p class="text-sm text-muted-foreground mt-0.5" id="publish-now-desc">
                  開啟後產品將在前台顯示
                </p>
              </div>
              <label class="cu-toggle-wrapper">
                <input
                  type="checkbox"
                  class="cu-toggle-input"
                  aria-labelledby="publish-now-label"
                  aria-describedby="publish-now-desc"
                />
                <span class="cu-toggle">
                  <span class="cu-toggle-thumb"></span>
                </span>
              </label>
            </div>
          </div>
        </div>

        <!-- 操作 -->
        <div class="cu-card">
          <div class="cu-card-header">
            <h2 class="cu-card-title text-base">操作</h2>
          </div>
          <div class="cu-card-content space-y-3">
            <button type="button" class="cu-button cu-button-default cu-button-md w-full">
              儲存產品
            </button>
            <a href={withBase("/examples/dashboard-v5")} class="cu-button cu-button-outline cu-button-md w-full">
              取消
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</DashboardV5Layout>
