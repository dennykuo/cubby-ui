---
import "../../../styles/global.css";
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Login — DataHub" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>登入 — DataHub</title>
	</head>
	<body class="min-h-screen font-sans antialiased text-foreground bg-muted/30">
		<div class="min-h-screen flex items-center justify-center p-4">
			<div class="w-full max-w-md">
				<!-- Card -->
				<div class="cu-card">
					<div class="cu-card-header text-center pb-2">
						<!-- Logo -->
						<a href="/examples/dashboard-v5" class="inline-flex items-center gap-2.5 mb-6">
							<div class="flex items-center justify-center w-10 h-10 rounded-lg bg-primary text-primary-foreground">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>
								</svg>
							</div>
							<span class="text-xl font-semibold">DataHub</span>
						</a>
						<h1 class="cu-card-title text-2xl">歡迎回來</h1>
						<p class="cu-card-description">請輸入您的帳號資訊以登入</p>
					</div>
					<div class="cu-card-content space-y-4">
						<form class="space-y-4" action="/examples/dashboard-v5">
							<div class="cu-form-group">
								<label class="cu-label" for="email">Email</label>
								<input class="cu-input" id="email" type="email" placeholder="name@example.com" required aria-required="true" />
							</div>
							<div class="cu-form-group">
								<div class="flex items-center justify-between">
									<label class="cu-label" for="password">密碼</label>
									<a href="/examples/dashboard-v5/forgot-password" class="text-xs text-muted-foreground hover:text-foreground transition-colors duration-150">忘記密碼？</a>
								</div>
								<input class="cu-input" id="password" type="password" placeholder="請輸入密碼" required aria-required="true" />
							</div>
							<label class="cu-checkbox-wrapper">
								<input type="checkbox" class="cu-checkbox" />
								<span class="text-sm">記住我</span>
							</label>
							<button type="submit" class="cu-button cu-button-default cu-button-md w-full">登入</button>
						</form>

						<div class="relative py-2">
							<div class="absolute inset-0 flex items-center"><div class="cu-separator"></div></div>
							<div class="relative flex justify-center"><span class="bg-card px-3 text-xs text-muted-foreground">或</span></div>
						</div>

						<div class="grid grid-cols-2 gap-3">
							<button type="button" class="cu-button cu-button-outline cu-button-md">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" class="mr-2"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
								Google
							</button>
							<button type="button" class="cu-button cu-button-outline cu-button-md">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="mr-2"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
								GitHub
							</button>
						</div>
					</div>
					<div class="cu-card-footer justify-center">
						<p class="text-sm text-muted-foreground">
							還沒有帳號？
							<a href="/examples/dashboard-v5/register" class="cu-link">立即註冊</a>
						</p>
					</div>
				</div>

				<!-- Footer -->
				<p class="text-center text-xs text-muted-foreground mt-6">© 2026 DataHub. All rights reserved.</p>
			</div>
		</div>
	</body>
</html>
