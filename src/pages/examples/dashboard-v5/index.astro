---
import DashboardV5Layout from "@/layouts/DashboardV5Layout.astro";
import { withBase } from "@/utils/paths";

// 模擬產品資料
const products = [
  {
    id: "PRD-001",
    name: 'MacBook Pro 14"',
    category: "筆記型電腦",
    price: 59900,
    stock: 24,
    status: "active",
    icon: "laptop",
  },
  {
    id: "PRD-002",
    name: "iPhone 15 Pro Max",
    category: "智慧型手機",
    price: 52900,
    stock: 156,
    status: "active",
    icon: "smartphone",
  },
  {
    id: "PRD-003",
    name: "AirPods Pro 2",
    category: "耳機",
    price: 7490,
    stock: 89,
    status: "active",
    icon: "headphones",
  },
  {
    id: "PRD-004",
    name: "iPad Air M2",
    category: "平板電腦",
    price: 22900,
    stock: 42,
    status: "active",
    icon: "tablet",
  },
  {
    id: "PRD-005",
    name: "Apple Watch Ultra 2",
    category: "穿戴裝置",
    price: 27900,
    stock: 18,
    status: "low",
    icon: "watch",
  },
  { id: "PRD-006", name: "Magic Keyboard", category: "配件", price: 9990, stock: 0, status: "out", icon: "keyboard" },
  { id: "PRD-007", name: "Studio Display", category: "顯示器", price: 47900, stock: 7, status: "low", icon: "monitor" },
  {
    id: "PRD-008",
    name: "Mac Mini M2 Pro",
    category: "桌上型電腦",
    price: 42900,
    stock: 31,
    status: "active",
    icon: "desktop",
  },
];

// 單色線條圖示（lucide），取代各平台顯示不一致的 emoji
const productIcons: Record<string, string> = {
  laptop:
    '<path d="M20 16V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v9m16 0H4m16 0 1.28 2.55a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45L4 16"/>',
  smartphone: '<rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/>',
  headphones:
    '<path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"/>',
  tablet: '<rect width="16" height="20" x="4" y="2" rx="2" ry="2"/><line x1="12" x2="12.01" y1="18" y2="18"/>',
  watch:
    '<circle cx="12" cy="12" r="6"/><polyline points="12 10 12 12 13 13"/><path d="m16.13 7.66-.81-4.05a2 2 0 0 0-2-1.61h-2.68a2 2 0 0 0-2 1.61l-.78 4.05"/><path d="m7.88 16.36.8 4a2 2 0 0 0 2 1.61h2.72a2 2 0 0 0 2-1.61l.81-4.05"/>',
  keyboard:
    '<path d="M10 8h.01"/><path d="M12 12h.01"/><path d="M14 8h.01"/><path d="M16 12h.01"/><path d="M18 8h.01"/><path d="M6 8h.01"/><path d="M7 16h10"/><path d="M8 12h.01"/><rect width="20" height="16" x="2" y="4" rx="2"/>',
  monitor:
    '<rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/>',
  desktop:
    '<rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/>',
};
---

<DashboardV5Layout title="產品管理 — DataHub">
  <div class="space-y-6">
    <!-- Flash Message -->
    <div class="cu-alert cu-alert-success" role="status">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
        <polyline points="22 4 12 14.01 9 11.01" />
      </svg>
      <div>
        <p class="cu-alert-description">產品已成功新增。</p>
      </div>
    </div>

    <!-- Page Header -->
    <header class="cu-page-header">
      <div class="cu-page-header-content">
        <h1 class="cu-page-header-title text-2xl md:text-2xl">產品管理</h1>
        <p class="cu-page-header-description">管理您的產品庫存與定價。</p>
      </div>
      <div class="cu-page-header-actions">
        <button type="button" class="cu-button cu-button-default cu-button-md" data-cu-dialog-trigger="product-dialog">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="12" x2="12" y1="5" y2="19" />
            <line x1="5" x2="19" y1="12" y2="12" />
          </svg>
          新增產品
        </button>
      </div>
    </header>

    <!-- Stats Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="cu-stat">
        <div class="cu-stat-header">
          <span class="cu-stat-label">總產品數</span>
          <div class="cu-stat-icon-box">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m7.5 4.27 9 5.15" />
              <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
            </svg>
          </div>
        </div>
        <div class="cu-stat-value tabular-nums">248</div>
        <p class="cu-stat-description">共 12 個分類</p>
      </div>
      <div class="cu-stat">
        <div class="cu-stat-header">
          <span class="cu-stat-label">庫存充足</span>
          <div class="cu-stat-icon-box cu-stat-icon-box-success">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="20 6 9 17 4 12" />
            </svg>
          </div>
        </div>
        <div class="cu-stat-value tabular-nums">218</div>
        <p class="cu-stat-description">佔全部產品 87.9%</p>
      </div>
      <div class="cu-stat">
        <div class="cu-stat-header">
          <span class="cu-stat-label">庫存不足</span>
          <div class="cu-stat-icon-box cu-stat-icon-box-warning">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
              <path d="M12 9v4" />
              <path d="M12 17h.01" />
            </svg>
          </div>
        </div>
        <div class="cu-stat-value tabular-nums">18</div>
        <p class="cu-stat-description">庫存低於 20 件，建議補貨</p>
      </div>
      <div class="cu-stat">
        <div class="cu-stat-header">
          <span class="cu-stat-label">已售罄</span>
          <div class="cu-stat-icon-box cu-stat-icon-box-destructive">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10" />
              <path d="m15 9-6 6" />
              <path d="m9 9 6 6" />
            </svg>
          </div>
        </div>
        <div class="cu-stat-value tabular-nums">12</div>
        <p class="cu-stat-description">需盡快補貨或下架</p>
      </div>
    </div>

    <!-- Filter Bar -->
    <div class="cu-filter-bar">
      <div class="cu-filter-bar-inner">
        <div class="cu-filter-bar-search">
          <div class="cu-input-search" role="search">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="cu-input-search-icon"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8" />
              <path d="m21 21-4.3-4.3" />
            </svg>
            <input
              type="search"
              placeholder="搜尋產品名稱、編號..."
              aria-label="搜尋產品"
              aria-controls="products-table"
              class="cu-input-search-field"
              id="search-input"
            />
          </div>
        </div>
        <div class="cu-filter-bar-filters">
          <div class="cu-select-wrapper">
            <select class="cu-select" aria-label="分類篩選">
              <option value="">所有分類</option>
              <option value="laptop">筆記型電腦</option>
              <option value="phone">智慧型手機</option>
              <option value="tablet">平板電腦</option>
              <option value="accessory">配件</option>
            </select>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="cu-select-icon"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </div>
          <div class="cu-select-wrapper">
            <select class="cu-select" aria-label="庫存狀態篩選">
              <option value="">庫存狀態</option>
              <option value="active">庫存充足</option>
              <option value="low">庫存不足</option>
              <option value="out">已售罄</option>
            </select>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="cu-select-icon"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Data Table -->
    <div class="cu-card overflow-hidden">
      <!-- Table Header Actions -->
      <div class="cu-table-toolbar">
        <div class="cu-table-toolbar-select">
          <input type="checkbox" class="cu-checkbox" id="select-all" />
          <label for="select-all" class="text-sm text-muted-foreground">
            全選
          </label>
          <span class="text-muted-foreground" aria-hidden="true">
            |
          </span>
          <span class="text-sm text-muted-foreground" aria-live="polite">
            已選{" "}
            <span class="font-medium" id="selected-count">
              0
            </span>{" "}
            項
          </span>
        </div>
        <div class="cu-table-toolbar-actions" id="bulk-actions" hidden>
          <button type="button" class="cu-button cu-button-outline cu-button-sm">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="7 10 12 15 17 10" />
              <line x1="12" x2="12" y1="15" y2="3" />
            </svg>
            匯出
          </button>
          <button type="button" class="cu-button cu-button-destructive cu-button-sm">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 6h18" />
              <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
              <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
            </svg>
            刪除
          </button>
        </div>
      </div>

      <!-- Table -->
      <div class="cu-table-wrapper" role="region" aria-label="產品列表" tabindex="0">
        <table class="cu-table">
          <thead class="cu-table-header">
            <tr class="cu-table-row hover:bg-transparent">
              <th scope="col" class="cu-table-head w-12">
                <span class="sr-only">選取</span>
              </th>
              <th scope="col" class="cu-table-head">
                產品
              </th>
              <th scope="col" class="cu-table-head">
                編號
              </th>
              <th scope="col" class="cu-table-head">
                分類
              </th>
              <th scope="col" class="cu-table-head text-right">
                售價
              </th>
              <th scope="col" class="cu-table-head text-right">
                庫存
              </th>
              <th scope="col" class="cu-table-head text-center">
                狀態
              </th>
              <th scope="col" class="cu-table-head text-right">
                操作
              </th>
            </tr>
          </thead>
          <tbody class="cu-table-body" id="products-table">
            {products.map((product) => (
              <tr class="cu-table-row" data-id={product.id}>
                <td class="cu-table-cell">
                  <input type="checkbox" class="cu-checkbox row-checkbox" aria-label={`選取 ${product.name}`} />
                </td>
                <td class="cu-table-cell">
                  <div class="flex items-center gap-3">
                    <div
                      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-muted text-muted-foreground"
                      aria-hidden="true"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        set:html={productIcons[product.icon]}
                      />
                    </div>
                    <span class="font-medium">{product.name}</span>
                  </div>
                </td>
                <td class="cu-table-cell">
                  <code class="text-xs font-mono text-muted-foreground">{product.id}</code>
                </td>
                <td class="cu-table-cell text-muted-foreground">{product.category}</td>
                <td class="cu-table-cell text-right font-medium tabular-nums">${product.price.toLocaleString()}</td>
                <td class="cu-table-cell text-right">
                  <span
                    class:list={[
                      "font-medium tabular-nums",
                      product.stock === 0 ? "text-destructive" : product.stock < 20 ? "text-warning" : "",
                    ]}
                  >
                    {product.stock}
                  </span>
                </td>
                <td class="cu-table-cell text-center">
                  {product.status === "active" && <span class="cu-badge cu-badge-soft-success">充足</span>}
                  {product.status === "low" && <span class="cu-badge cu-badge-soft-warning">不足</span>}
                  {product.status === "out" && <span class="cu-badge cu-badge-soft-destructive">售罄</span>}
                </td>
                <td class="cu-table-cell text-right">
                  <div class="cu-table-actions">
                    <a
                      href={withBase("/examples/dashboard-v5/products/detail")}
                      class="cu-button cu-button-ghost cu-button-icon-xs"
                      aria-label={`檢視 ${product.name}`}
                      title="檢視"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                        <circle cx="12" cy="12" r="3" />
                      </svg>
                    </a>
                    <button
                      type="button"
                      class="cu-button cu-button-ghost cu-button-icon-xs"
                      aria-label={`編輯 ${product.name}`}
                      title="編輯"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
                        <path d="m15 5 4 4" />
                      </svg>
                    </button>
                    <button
                      type="button"
                      class="cu-button cu-button-ghost cu-button-icon-xs hover:text-destructive hover:bg-destructive/10"
                      aria-label={`刪除 ${product.name}`}
                      title="刪除"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M3 6h18" />
                        <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                        <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
            ))}
            <tr class="cu-table-row hover:bg-transparent" id="no-results" hidden>
              <td class="cu-table-cell py-10 text-center text-muted-foreground" colspan="8">
                找不到符合「<span id="no-results-query" class="font-medium text-foreground"></span>」的產品
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <p id="search-status" class="sr-only" role="status" aria-live="polite"></p>

      <!-- Pagination -->
      <div class="flex items-center justify-between px-4 py-3 border-t border-border">
        <span class="text-sm text-muted-foreground">顯示 1-8 筆，共 248 筆</span>
        <nav class="cu-pagination" aria-label="分頁">
          <button type="button" class="cu-pagination-prev" aria-label="上一頁" disabled>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m15 18-6-6 6-6" />
            </svg>
          </button>
          <button type="button" class="cu-pagination-item cu-pagination-item-active" aria-current="page">
            1
          </button>
          <button type="button" class="cu-pagination-item">
            2
          </button>
          <button type="button" class="cu-pagination-item">
            3
          </button>
          <span class="cu-pagination-ellipsis" aria-hidden="true">
            ...
          </span>
          <button type="button" class="cu-pagination-item">
            25
          </button>
          <button type="button" class="cu-pagination-next" aria-label="下一頁">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6" />
            </svg>
          </button>
        </nav>
      </div>
    </div>
  </div>

  <!-- Add/Edit Dialog -->
  <dialog id="product-dialog" class="cu-dialog" data-cu-dialog>
    <div class="cu-dialog-header">
      <h2 class="cu-dialog-title">新增產品</h2>
      <p class="cu-dialog-description">填寫產品資訊以新增產品。</p>
    </div>
    <button type="button" class="cu-dialog-close" data-cu-dialog-close aria-label="關閉">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M18 6 6 18" />
        <path d="m6 6 12 12" />
      </svg>
    </button>
    <form method="dialog" class="mt-6 space-y-4">
      <div class="space-y-2">
        <label class="cu-label cu-label-required" for="product-name">
          產品名稱
        </label>
        <input type="text" class="cu-input" id="product-name" placeholder="輸入產品名稱" required autofocus />
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="space-y-2">
          <label class="cu-label" for="product-category">
            分類
          </label>
          <div class="cu-select-wrapper">
            <select class="cu-select" id="product-category">
              <option value="">選擇分類</option>
              <option value="laptop">筆記型電腦</option>
              <option value="phone">智慧型手機</option>
              <option value="tablet">平板電腦</option>
            </select>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="cu-select-icon"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </div>
        </div>
        <div class="space-y-2">
          <label class="cu-label" for="product-price">
            售價
          </label>
          <input type="number" class="cu-input" id="product-price" placeholder="0" min="0" inputmode="numeric" />
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div class="space-y-2">
          <label class="cu-label" for="product-stock">
            庫存數量
          </label>
          <input type="number" class="cu-input" id="product-stock" placeholder="0" min="0" inputmode="numeric" />
        </div>
        <div class="space-y-2">
          <label class="cu-label" for="product-sku">
            產品編號
          </label>
          <input type="text" class="cu-input" id="product-sku" placeholder="自動產生" disabled />
        </div>
      </div>
      <div class="cu-dialog-footer">
        <button type="button" class="cu-button cu-button-outline cu-button-md" data-cu-dialog-close>
          取消
        </button>
        <button type="submit" class="cu-button cu-button-default cu-button-md">
          儲存
        </button>
      </div>
    </form>
  </dialog>

  <script>
    // Checkbox selection（只計算目前可見的列）
    const selectAll = document.getElementById("select-all") as HTMLInputElement | null;
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>("#products-table tr[data-id]"));
    const selectedCount = document.getElementById("selected-count");
    const bulkActions = document.getElementById("bulk-actions");
    const checkboxOf = (row: HTMLTableRowElement) => row.querySelector<HTMLInputElement>(".row-checkbox")!;

    function updateSelection() {
      const visible = rows.filter((row) => !row.hidden);
      const checked = rows.filter((row) => checkboxOf(row).checked).length;
      const visibleChecked = visible.filter((row) => checkboxOf(row).checked).length;
      if (selectedCount) selectedCount.textContent = String(checked);
      if (bulkActions) bulkActions.hidden = checked === 0;
      if (selectAll) {
        selectAll.checked = visible.length > 0 && visibleChecked === visible.length;
        selectAll.indeterminate = visibleChecked > 0 && visibleChecked < visible.length;
      }
    }

    selectAll?.addEventListener("change", () => {
      rows.filter((row) => !row.hidden).forEach((row) => (checkboxOf(row).checked = selectAll.checked));
      updateSelection();
    });
    rows.forEach((row) => checkboxOf(row).addEventListener("change", updateSelection));

    // Search
    const searchInput = document.getElementById("search-input") as HTMLInputElement | null;
    const noResults = document.getElementById("no-results");
    const noResultsQuery = document.getElementById("no-results-query");
    const searchStatus = document.getElementById("search-status");

    searchInput?.addEventListener("input", () => {
      const query = searchInput.value.trim().toLowerCase();
      let matches = 0;
      rows.forEach((row) => {
        const match = (row.textContent ?? "").toLowerCase().includes(query);
        row.hidden = !match;
        if (match) matches++;
      });
      if (noResults) noResults.hidden = matches > 0;
      if (noResultsQuery) noResultsQuery.textContent = searchInput.value.trim();
      if (searchStatus) searchStatus.textContent = query ? `找到 ${matches} 項產品` : "";
      updateSelection();
    });
  </script>
</DashboardV5Layout>
