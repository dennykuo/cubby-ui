---
import DashboardV5Layout from "@/layouts/DashboardV5Layout.astro";
---

<DashboardV5Layout title="活動紀錄 — DataHub">
    <Fragment slot="breadcrumb">
        <span class="text-muted-foreground/50">/</span>
        <span class="font-medium">活動紀錄</span>
    </Fragment>

    <div class="space-y-6">
        <!-- Page Header -->
        <header class="cu-page-header">
            <div class="cu-page-header-content">
                <h1 class="cu-page-header-title">活動紀錄</h1>
                <p class="cu-page-header-description">追蹤系統中所有使用者操作與事件。</p>
            </div>
        </header>

        <!-- Stats with Progress -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="cu-stat">
                <div class="cu-stat-header">
                    <span class="cu-stat-label">全部事件</span>
                    <div class="cu-stat-icon-box">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/></svg>
                    </div>
                </div>
                <div class="cu-stat-value">2,847</div>
                <div class="cu-progress mt-3"><div class="cu-progress-bar" style="width: 100%"></div></div>
            </div>
            <div class="cu-stat">
                <div class="cu-stat-header">
                    <span class="cu-stat-label">成功</span>
                    <div class="cu-stat-icon-box cu-stat-icon-box-success">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    </div>
                </div>
                <div class="cu-stat-value">2,634</div>
                <div class="cu-progress mt-3"><div class="cu-progress-bar bg-success" style="width: 92.5%"></div></div>
            </div>
            <div class="cu-stat">
                <div class="cu-stat-header">
                    <span class="cu-stat-label">錯誤</span>
                    <div class="cu-stat-icon-box cu-stat-icon-box-destructive">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
                    </div>
                </div>
                <div class="cu-stat-value">89</div>
                <div class="cu-progress mt-3"><div class="cu-progress-bar bg-destructive" style="width: 3.1%"></div></div>
            </div>
            <div class="cu-stat">
                <div class="cu-stat-header">
                    <span class="cu-stat-label">警告</span>
                    <div class="cu-stat-icon-box cu-stat-icon-box-warning">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                    </div>
                </div>
                <div class="cu-stat-value">124</div>
                <div class="cu-progress mt-3"><div class="cu-progress-bar bg-warning" style="width: 4.4%"></div></div>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="cu-filter-bar">
            <div class="cu-filter-bar-inner">
                <div class="cu-filter-bar-filters">
                    <div class="flex items-center gap-2">
                        <label class="text-sm text-muted-foreground shrink-0">起始日</label>
                        <input type="date" value="2026-02-01" class="cu-input cu-input-sm" />
                    </div>
                    <div class="flex items-center gap-2">
                        <label class="text-sm text-muted-foreground shrink-0">結束日</label>
                        <input type="date" value="2026-02-27" class="cu-input cu-input-sm" />
                    </div>
                    <div class="cu-select-wrapper">
                        <select class="cu-select">
                            <option value="">所有狀態</option>
                            <option value="success">成功</option>
                            <option value="error">錯誤</option>
                            <option value="warning">警告</option>
                        </select>
                        <svg class="cu-select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                    </div>
                    <button class="cu-button cu-button-default cu-button-sm">篩選</button>
                    <button class="cu-button cu-button-outline cu-button-sm">清除</button>
                </div>
            </div>
        </div>

        <!-- Activity Table -->
        <div class="cu-card overflow-hidden">
            <div class="cu-table-wrapper">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row hover:bg-transparent">
                            <th class="cu-table-head">時間</th>
                            <th class="cu-table-head">使用者</th>
                            <th class="cu-table-head">動作</th>
                            <th class="cu-table-head">對象</th>
                            <th class="cu-table-head text-center">狀態</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><span class="text-sm text-muted-foreground">2026/02/27 14:32</span></td>
                            <td class="cu-table-cell">
                                <div class="flex items-center gap-3">
                                    <div class="cu-avatar cu-avatar-sm"><div class="cu-avatar-fallback">林</div></div>
                                    <span class="text-sm font-medium">林小明</span>
                                </div>
                            </td>
                            <td class="cu-table-cell"><span class="text-sm">更新產品</span></td>
                            <td class="cu-table-cell"><span class="text-sm text-muted-foreground">MacBook Pro 14"</span></td>
                            <td class="cu-table-cell text-center"><span class="cu-badge cu-badge-soft-success">成功</span></td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><span class="text-sm text-muted-foreground">2026/02/27 13:15</span></td>
                            <td class="cu-table-cell">
                                <div class="flex items-center gap-3">
                                    <div class="cu-avatar cu-avatar-sm"><div class="cu-avatar-fallback">陳</div></div>
                                    <span class="text-sm font-medium">陳柏翰</span>
                                </div>
                            </td>
                            <td class="cu-table-cell"><span class="text-sm">新增訂單</span></td>
                            <td class="cu-table-cell"><span class="text-sm text-muted-foreground">ORD-2024-053</span></td>
                            <td class="cu-table-cell text-center"><span class="cu-badge cu-badge-soft-success">成功</span></td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><span class="text-sm text-muted-foreground">2026/02/27 11:48</span></td>
                            <td class="cu-table-cell">
                                <div class="flex items-center gap-3">
                                    <div class="cu-avatar cu-avatar-sm"><div class="cu-avatar-fallback">林</div></div>
                                    <span class="text-sm font-medium">林小明</span>
                                </div>
                            </td>
                            <td class="cu-table-cell"><span class="text-sm">刪除產品</span></td>
                            <td class="cu-table-cell"><span class="text-sm text-muted-foreground">Magic Mouse</span></td>
                            <td class="cu-table-cell text-center"><span class="cu-badge cu-badge-soft-warning">警告</span></td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><span class="text-sm text-muted-foreground">2026/02/27 10:22</span></td>
                            <td class="cu-table-cell">
                                <div class="flex items-center gap-3">
                                    <div class="cu-avatar cu-avatar-sm"><div class="cu-avatar-fallback">王</div></div>
                                    <span class="text-sm font-medium">王俊傑</span>
                                </div>
                            </td>
                            <td class="cu-table-cell"><span class="text-sm">匯出報表</span></td>
                            <td class="cu-table-cell"><span class="text-sm text-muted-foreground">月報表-2026-01</span></td>
                            <td class="cu-table-cell text-center"><span class="cu-badge cu-badge-soft-success">成功</span></td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><span class="text-sm text-muted-foreground">2026/02/26 18:05</span></td>
                            <td class="cu-table-cell">
                                <div class="flex items-center gap-3">
                                    <div class="cu-avatar cu-avatar-sm"><div class="cu-avatar-fallback">系</div></div>
                                    <span class="text-sm font-medium">系統</span>
                                </div>
                            </td>
                            <td class="cu-table-cell"><span class="text-sm">自動備份</span></td>
                            <td class="cu-table-cell"><span class="text-sm text-muted-foreground">資料庫備份</span></td>
                            <td class="cu-table-cell text-center"><span class="cu-badge cu-badge-soft-success">成功</span></td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><span class="text-sm text-muted-foreground">2026/02/26 16:33</span></td>
                            <td class="cu-table-cell">
                                <div class="flex items-center gap-3">
                                    <div class="cu-avatar cu-avatar-sm"><div class="cu-avatar-fallback">林</div></div>
                                    <span class="text-sm font-medium">林雅婷</span>
                                </div>
                            </td>
                            <td class="cu-table-cell"><span class="text-sm">更新客戶</span></td>
                            <td class="cu-table-cell"><span class="text-sm text-muted-foreground">張家豪</span></td>
                            <td class="cu-table-cell text-center"><span class="cu-badge cu-badge-soft-success">成功</span></td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><span class="text-sm text-muted-foreground">2026/02/26 14:20</span></td>
                            <td class="cu-table-cell">
                                <div class="flex items-center gap-3">
                                    <div class="cu-avatar cu-avatar-sm"><div class="cu-avatar-fallback">系</div></div>
                                    <span class="text-sm font-medium">系統</span>
                                </div>
                            </td>
                            <td class="cu-table-cell"><span class="text-sm">API 呼叫失敗</span></td>
                            <td class="cu-table-cell"><span class="text-sm text-muted-foreground">金流服務</span></td>
                            <td class="cu-table-cell text-center"><span class="cu-badge cu-badge-soft-destructive">錯誤</span></td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><span class="text-sm text-muted-foreground">2026/02/26 09:15</span></td>
                            <td class="cu-table-cell">
                                <div class="flex items-center gap-3">
                                    <div class="cu-avatar cu-avatar-sm"><div class="cu-avatar-fallback">陳</div></div>
                                    <span class="text-sm font-medium">陳柏翰</span>
                                </div>
                            </td>
                            <td class="cu-table-cell"><span class="text-sm">登入系統</span></td>
                            <td class="cu-table-cell"><span class="text-sm text-muted-foreground">—</span></td>
                            <td class="cu-table-cell text-center"><span class="cu-badge cu-badge-soft-success">成功</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="flex items-center justify-between px-4 py-3 border-t border-border bg-muted/20">
                <span class="text-sm text-muted-foreground">顯示 1-8 筆，共 2,847 筆</span>
                <nav class="cu-pagination">
                    <button class="cu-pagination-prev" disabled>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                    </button>
                    <button class="cu-pagination-item cu-pagination-item-active">1</button>
                    <button class="cu-pagination-item">2</button>
                    <button class="cu-pagination-item">3</button>
                    <span class="cu-pagination-ellipsis">...</span>
                    <button class="cu-pagination-item">356</button>
                    <button class="cu-pagination-next">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                    </button>
                </nav>
            </div>
        </div>
    </div>
</DashboardV5Layout>
