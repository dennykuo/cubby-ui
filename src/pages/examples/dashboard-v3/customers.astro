---

<DashboardV3Layout title="Customers — Nexus">
  <div class="max-w-7xl mx-auto space-y-8">
    <!-- Page Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold tracking-tight">Customers</h1>
        <p class="text-muted-foreground mt-1">Manage your customer base</p>
      </div>
      <Button variant="teal">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
          <path d="M5 12h14"/>
          <path d="M12 5v14"/>
        </svg>
        Add Customer
      </Button>
    </div>

    <!-- Customer Stats -->
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      <Stat>
        <StatHeader>
          <StatLabel>Total Customers</StatLabel>
        </StatHeader>
        <StatValue>12,847</StatValue>
        <StatDescription>
          <StatTrend trend="up">+5.2%</StatTrend>
          from last month
        </StatDescription>
      </Stat>

      <Stat>
        <StatHeader>
          <StatLabel>New This Month</StatLabel>
        </StatHeader>
        <StatValue>342</StatValue>
        <StatDescription>
          <StatTrend trend="up">+12.8%</StatTrend>
          from last month
        </StatDescription>
      </Stat>

      <Stat>
        <StatHeader>
          <StatLabel>Churn Rate</StatLabel>
        </StatHeader>
        <StatValue>2.4%</StatValue>
        <StatDescription>
          <StatTrend trend="down">-0.3%</StatTrend>
          from last month
        </StatDescription>
      </Stat>

      <Stat>
        <StatHeader>
          <StatLabel>Avg. LTV</StatLabel>
        </StatHeader>
        <StatValue>$1,240</StatValue>
        <StatDescription>
          <StatTrend trend="up">+8.5%</StatTrend>
          from last month
        </StatDescription>
      </Stat>
    </div>

    <!-- Search & Filter Bar -->
    <div class="flex items-center gap-4">
      <div class="flex-1">
        <Input type="text" placeholder="Search customers..." />
      </div>
      <div class="flex items-center gap-2">
        <Button variant="teal" size="sm">All</Button>
        <Button variant="outline" size="sm">Active</Button>
        <Button variant="outline" size="sm">Trial</Button>
        <Button variant="outline" size="sm">Churned</Button>
      </div>
    </div>

    <!-- Customer Table -->
    <Card>
      <CardHeader>
        <CardTitle>Customer List</CardTitle>
        <CardDescription>View and manage all customer accounts</CardDescription>
      </CardHeader>
      <CardContent class="cu-card-content-flush">
        <Table>
          <TableHeader>
            <TableRow>
              <TableHead>Customer</TableHead>
              <TableHead>Plan</TableHead>
              <TableHead>MRR</TableHead>
              <TableHead>Status</TableHead>
              <TableHead>Joined</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {customers.map((customer) => (
              <TableRow>
                <TableCell>
                  <div class="flex items-center gap-3">
                    <Avatar>
                      <AvatarFallback>{customer.initials}</AvatarFallback>
                    </Avatar>
                    <div>
                      <div class="font-medium">{customer.name}</div>
                      <div class="text-sm text-muted-foreground">{customer.email}</div>
                    </div>
                  </div>
                </TableCell>
                <TableCell>
                  <span class="font-medium">{customer.plan}</span>
                </TableCell>
                <TableCell>
                  <span class="font-medium">{customer.mrr}</span>
                </TableCell>
                <TableCell>
                  <Badge variant={customer.statusVariant}>{customer.status}</Badge>
                </TableCell>
                <TableCell>
                  <span class="text-muted-foreground">{customer.joined}</span>
                </TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
      </CardContent>
    </Card>

    <!-- Pagination -->
    <div class="flex items-center justify-between">
      <p class="text-sm text-muted-foreground">
        Showing 1-8 of 847 customers
      </p>
      <div class="flex items-center gap-2">
        <Button variant="outline" size="sm">Previous</Button>
        <Button variant="outline" size="sm">Next</Button>
      </div>
    </div>
  </div>
</DashboardV3Layout>
