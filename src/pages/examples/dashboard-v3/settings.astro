---
import cubbyUiUrl from "../../../../dist/core/cubby-ui.js?url";
import DashboardV3Layout from "@/layouts/DashboardV3Layout.astro";
import Card from "@/components/ui/Card.astro";
import CardHeader from "@/components/ui/CardHeader.astro";
import CardTitle from "@/components/ui/CardTitle.astro";
import CardDescription from "@/components/ui/CardDescription.astro";
import CardContent from "@/components/ui/CardContent.astro";
import CardFooter from "@/components/ui/CardFooter.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import Avatar from "@/components/ui/Avatar.astro";
import AvatarFallback from "@/components/ui/AvatarFallback.astro";
import Input from "@/components/ui/Input.astro";
import Label from "@/components/ui/Label.astro";
import Toggle from "@/components/ui/Toggle.astro";
import Separator from "@/components/ui/Separator.astro";
import Textarea from "@/components/ui/Textarea.astro";

const sections = [
  { value: "profile", label: "Profile" },
  { value: "team", label: "Team" },
  { value: "billing", label: "Billing" },
  { value: "integrations", label: "Integrations" },
  { value: "api-keys", label: "API Keys" },
];

const teamMembers = [
  { name: "Jane Doe", email: "jane@nexus.ai", initials: "JD", role: "Admin" },
  { name: "Mike Smith", email: "mike@nexus.ai", initials: "MS", role: "Editor" },
  { name: "Sarah Johnson", email: "sarah@nexus.ai", initials: "SJ", role: "Editor" },
  { name: "Tom Chen", email: "tom@nexus.ai", initials: "TC", role: "Viewer" },
];

const integrations = [
  { id: "slack", name: "Slack", description: "Team communication", initial: "S", connected: true },
  { id: "github", name: "GitHub", description: "Code repository", initial: "G", connected: true },
  { id: "figma", name: "Figma", description: "Design collaboration", initial: "F", connected: false },
];

const apiKeys = [
  { name: "Production Key", key: "sk-...a1b2", created: "Jan 15, 2026", lastUsed: "2 hours ago" },
  { name: "Development Key", key: "sk-...c3d4", created: "Jan 10, 2026", lastUsed: "1 day ago" },
  { name: "Testing Key", key: "sk-...e5f6", created: "Jan 5, 2026", lastUsed: "3 days ago" },
];
---

<DashboardV3Layout title="Settings — Nexus">
  <div class="max-w-7xl mx-auto space-y-8">
    <header class="cu-page-header">
      <div class="cu-page-header-content">
        <h1 class="cu-page-header-title text-2xl md:text-2xl">Settings</h1>
        <p class="cu-page-header-description">Manage your account settings and preferences</p>
      </div>
    </header>

    <!-- 垂直 Tabs：data-cu-tabs 由 cubby-ui.js 處理 role / aria-selected / aria-controls 與面板切換 -->
    <div data-cu-tabs class="grid lg:grid-cols-[224px_1fr] gap-8">
      <!-- Left Navigation -->
      <div
        class="cu-tabs-list cu-tabs-list-vertical flex-row overflow-x-auto lg:flex-col lg:self-start"
        aria-label="Settings sections"
      >
        {sections.map((section, index) => (
          <button
            type="button"
            class:list={["cu-tabs-trigger justify-start", index === 0 && "cu-tabs-trigger-active"]}
            data-cu-tabs-trigger={section.value}
          >
            {section.label}
          </button>
        ))}
      </div>

      <!-- Right Content Area -->
      <div class="min-w-0">
        <!-- Profile Panel -->
        <div class="cu-tabs-content mt-0" data-cu-tabs-content="profile">
          <Card>
            <CardHeader>
              <CardTitle>Profile Settings</CardTitle>
              <CardDescription>Update your personal information and profile picture</CardDescription>
            </CardHeader>
            <CardContent>
              <div class="space-y-6">
                <!-- Avatar Upload -->
                <div class="flex items-center gap-6">
                  <Avatar class="h-20 w-20 text-xl">
                    <AvatarFallback>JD</AvatarFallback>
                  </Avatar>
                  <div class="space-y-1">
                    <Button type="button" variant="secondary" size="sm">
                      Change Photo
                    </Button>
                    <p class="text-xs text-muted-foreground">JPG, PNG or GIF. Max 2 MB.</p>
                  </div>
                </div>

                <Separator />

                <!-- Form Fields -->
                <div class="space-y-4">
                  <div class="cu-form-group">
                    <Label for="full-name">Full Name</Label>
                    <Input id="full-name" value="Jane Doe" autocomplete="name" />
                  </div>

                  <div class="cu-form-group">
                    <Label for="email">Email</Label>
                    <Input id="email" type="email" value="jane@nexus.ai" autocomplete="email" />
                  </div>

                  <div class="cu-form-group">
                    <Label for="role">Role</Label>
                    <Input id="role" value="Admin" disabled aria-describedby="role-description" />
                    <p id="role-description" class="cu-form-description">
                      Only workspace owners can change roles.
                    </p>
                  </div>

                  <div class="cu-form-group">
                    <Label for="bio">Bio</Label>
                    <Textarea id="bio" rows={4} placeholder="Tell us about yourself..." />
                  </div>
                </div>
              </div>
            </CardContent>
            <CardFooter class="flex justify-end gap-3">
              <Button type="button" variant="ghost">
                Cancel
              </Button>
              <Button type="button">Save Changes</Button>
            </CardFooter>
          </Card>
        </div>

        <!-- Team Panel -->
        <div class="cu-tabs-content mt-0" data-cu-tabs-content="team" hidden>
          <Card>
            <CardHeader>
              <CardTitle>Team Members</CardTitle>
              <CardDescription>Manage your team and member permissions</CardDescription>
            </CardHeader>
            <CardContent>
              <div class="space-y-6">
                <ul class="space-y-3" aria-label="Team members">
                  {teamMembers.map((member) => (
                    <li class="flex flex-col gap-3 p-4 border border-border rounded-lg sm:flex-row sm:items-center sm:justify-between">
                      <div class="flex items-center gap-4 min-w-0">
                        <Avatar aria-hidden="true">
                          <AvatarFallback>{member.initials}</AvatarFallback>
                        </Avatar>
                        <div class="min-w-0">
                          <div class="font-medium">{member.name}</div>
                          <div class="text-sm text-muted-foreground truncate">{member.email}</div>
                        </div>
                      </div>
                      <div class="flex items-center gap-3">
                        <Badge variant="outline">{member.role}</Badge>
                        <Button
                          type="button"
                          variant="ghost"
                          size="sm"
                          class="text-destructive hover:bg-destructive/10 hover:text-destructive"
                          aria-label={`Remove ${member.name}`}
                        >
                          Remove
                        </Button>
                      </div>
                    </li>
                  ))}
                </ul>

                <Separator />

                <!-- Invite Member Form -->
                <div>
                  <h3 class="font-semibold mb-4">Invite New Member</h3>
                  <div class="grid gap-4 sm:grid-cols-2">
                    <div class="cu-form-group">
                      <Label for="invite-email">Email Address</Label>
                      <Input id="invite-email" type="email" placeholder="email@example.com" />
                    </div>
                    <div class="cu-form-group">
                      <Label for="invite-role">Role</Label>
                      <div class="cu-select-wrapper">
                        <select id="invite-role" class="cu-select">
                          <option>Viewer</option>
                          <option>Editor</option>
                          <option>Admin</option>
                        </select>
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="cu-select-icon"
                          aria-hidden="true"
                        >
                          <path d="m6 9 6 6 6-6" />
                        </svg>
                      </div>
                    </div>
                  </div>
                  <Button type="button" class="mt-4">
                    Send Invite
                  </Button>
                </div>
              </div>
            </CardContent>
          </Card>
        </div>

        <!-- Billing Panel -->
        <div class="cu-tabs-content mt-0" data-cu-tabs-content="billing" hidden>
          <div class="space-y-6">
            <!-- Current Plan -->
            <Card>
              <CardHeader>
                <CardTitle>Current Plan</CardTitle>
                <CardDescription>Manage your subscription and billing</CardDescription>
              </CardHeader>
              <CardContent>
                <div class="space-y-4">
                  <div class="flex items-center justify-between">
                    <div>
                      <div class="font-semibold text-lg">Pro Plan</div>
                      <div class="text-muted-foreground tabular-nums">$49/month</div>
                    </div>
                    <Badge variant="soft-success">Active</Badge>
                  </div>

                  <Separator />

                  <div>
                    <div class="flex items-center justify-between mb-2">
                      <span id="usage-label" class="text-sm font-medium">
                        Usage
                      </span>
                      <span class="text-sm text-muted-foreground tabular-nums">75% of limit</span>
                    </div>
                    <div
                      class="cu-progress"
                      role="progressbar"
                      aria-labelledby="usage-label"
                      aria-valuemin="0"
                      aria-valuemax="100"
                      aria-valuenow="75"
                    >
                      <div class="cu-progress-bar" style="width: 75%"></div>
                    </div>
                  </div>

                  <p class="pt-2 text-sm text-muted-foreground">Next billing date: March 1, 2026</p>
                </div>
              </CardContent>
              <CardFooter>
                <Button type="button">Upgrade Plan</Button>
              </CardFooter>
            </Card>

            <!-- Payment Method -->
            <Card>
              <CardHeader>
                <CardTitle>Payment Method</CardTitle>
                <CardDescription>Your current payment method on file</CardDescription>
              </CardHeader>
              <CardContent>
                <div class="flex flex-col gap-4 p-4 border border-border rounded-lg sm:flex-row sm:items-center sm:justify-between">
                  <div class="flex items-center gap-4">
                    <div
                      class="w-12 h-8 rounded-md border border-border bg-muted flex items-center justify-center text-xs font-bold tracking-wide text-foreground"
                      aria-hidden="true"
                    >
                      VISA
                    </div>
                    <div>
                      <div class="font-medium tabular-nums">
                        <span class="sr-only">Visa ending in 4242</span>
                        <span aria-hidden="true">•••• •••• •••• 4242</span>
                      </div>
                      <div class="text-sm text-muted-foreground">Expires 12/26</div>
                    </div>
                  </div>
                  <Button type="button" variant="outline" size="sm">
                    Update Payment
                  </Button>
                </div>
              </CardContent>
            </Card>
          </div>
        </div>

        <!-- Integrations Panel -->
        <div class="cu-tabs-content mt-0" data-cu-tabs-content="integrations" hidden>
          <Card>
            <CardHeader>
              <CardTitle>Integrations</CardTitle>
              <CardDescription>Connect your favorite tools and services</CardDescription>
            </CardHeader>
            <CardContent>
              <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {integrations.map((integration) => (
                  <li class="border border-border rounded-lg p-4">
                    <div class="flex items-start justify-between mb-3">
                      <div
                        class="w-10 h-10 rounded-lg bg-primary/8 text-primary flex items-center justify-center font-bold"
                        aria-hidden="true"
                      >
                        {integration.initial}
                      </div>
                      <Badge variant={integration.connected ? "soft-success" : "soft-secondary"}>
                        {integration.connected ? "Connected" : "Not Connected"}
                      </Badge>
                    </div>
                    <div class="mb-3">
                      <h3 class="font-semibold">{integration.name}</h3>
                      <p class="text-sm text-muted-foreground">{integration.description}</p>
                    </div>
                    <Toggle id={`integration-${integration.id}`} checked={integration.connected}>
                      <span class="sr-only">Enable {integration.name} integration</span>
                    </Toggle>
                  </li>
                ))}
              </ul>
            </CardContent>
          </Card>
        </div>

        <!-- API Keys Panel -->
        <div class="cu-tabs-content mt-0" data-cu-tabs-content="api-keys" hidden>
          <Card>
            <CardHeader>
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div class="space-y-1.5">
                  <CardTitle>API Keys</CardTitle>
                  <CardDescription>Manage your API keys for integration</CardDescription>
                </div>
                <Button type="button" size="sm">
                  Create New Key
                </Button>
              </div>
            </CardHeader>
            <CardContent>
              <div
                class="cu-table-wrapper border border-border rounded-lg"
                role="region"
                aria-label="API keys"
                tabindex="0"
              >
                <table class="cu-table">
                  <thead class="cu-table-header bg-muted/50">
                    <tr class="cu-table-row hover:bg-transparent">
                      <th scope="col" class="cu-table-head">
                        Name
                      </th>
                      <th scope="col" class="cu-table-head">
                        Key
                      </th>
                      <th scope="col" class="cu-table-head">
                        Created
                      </th>
                      <th scope="col" class="cu-table-head">
                        Last Used
                      </th>
                      <th scope="col" class="cu-table-head text-right">
                        Actions
                      </th>
                    </tr>
                  </thead>
                  <tbody class="cu-table-body">
                    {apiKeys.map((apiKey) => (
                      <tr class="cu-table-row">
                        <td class="cu-table-cell font-medium whitespace-nowrap">{apiKey.name}</td>
                        <td class="cu-table-cell">
                          <code class="font-mono text-xs bg-muted px-2 py-1 rounded">{apiKey.key}</code>
                        </td>
                        <td class="cu-table-cell text-muted-foreground whitespace-nowrap">{apiKey.created}</td>
                        <td class="cu-table-cell text-muted-foreground whitespace-nowrap">{apiKey.lastUsed}</td>
                        <td class="cu-table-cell">
                          <div class="cu-table-actions">
                            <Button type="button" variant="ghost" size="sm" aria-label={`Regenerate ${apiKey.name}`}>
                              Regenerate
                            </Button>
                            <Button
                              type="button"
                              variant="ghost"
                              size="sm"
                              class="text-destructive hover:bg-destructive/10 hover:text-destructive"
                              aria-label={`Delete ${apiKey.name}`}
                            >
                              Delete
                            </Button>
                          </div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </CardContent>
          </Card>
        </div>
      </div>
    </div>
  </div>

  <script src={cubbyUiUrl} is:inline></script>
</DashboardV3Layout>
