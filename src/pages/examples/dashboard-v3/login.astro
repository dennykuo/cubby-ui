---
import "@/styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Login — Nexus" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Login — Nexus</title>
		<style>
			body { font-family: 'Inter', system-ui, sans-serif; }
		</style>
	</head>
	<body class="min-h-screen antialiased bg-stone-50">
		<div class="grid min-h-screen lg:grid-cols-2">
			<!-- Left: Brand Panel with Gradient -->
			<div class="hidden lg:flex flex-col justify-between bg-gradient-to-br from-teal-600 to-emerald-600 p-10 text-white relative overflow-hidden">
				<!-- Background Pattern -->
				<div class="absolute inset-0 opacity-10">
					<svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
						<defs>
							<pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse">
								<circle cx="1" cy="1" r="1" fill="white"/>
							</pattern>
						</defs>
						<rect width="100" height="100" fill="url(#grid)"/>
					</svg>
				</div>
				<div class="relative flex items-center gap-2.5">
					<div class="flex items-center justify-center w-9 h-9 rounded-xl bg-white/20 backdrop-blur-sm">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<polygon points="12 2 2 7 12 12 22 7 12 2"/>
							<polyline points="2 17 12 22 22 17"/>
							<polyline points="2 12 12 17 22 12"/>
						</svg>
					</div>
					<span class="text-xl font-bold tracking-tight">Nexus</span>
				</div>
				<div class="relative space-y-6">
					<h2 class="text-4xl font-bold leading-tight">AI-Powered<br/>Analytics Platform</h2>
					<p class="text-white/80 text-lg max-w-md">
						Transform your data into actionable insights with our intelligent analytics suite.
					</p>
					<div class="flex items-center gap-4 pt-4">
						<div class="flex -space-x-2">
							<div class="w-10 h-10 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center text-sm font-medium border-2 border-white/30">JD</div>
							<div class="w-10 h-10 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center text-sm font-medium border-2 border-white/30">AS</div>
							<div class="w-10 h-10 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center text-sm font-medium border-2 border-white/30">MK</div>
							<div class="w-10 h-10 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center text-sm font-medium border-2 border-white/30">+5</div>
						</div>
						<p class="text-sm text-white/70">Trusted by 10,000+ teams worldwide</p>
					</div>
				</div>
				<p class="relative text-xs text-white/50">© 2026 Nexus Technologies. All rights reserved.</p>
			</div>

			<!-- Right: Login Form -->
			<div class="flex items-center justify-center p-8">
				<div class="w-full max-w-sm space-y-6">
					<!-- Mobile Logo -->
					<div class="flex items-center gap-2.5 lg:hidden mb-8">
						<div class="flex items-center justify-center w-9 h-9 rounded-xl bg-teal-600 text-white">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<polygon points="12 2 2 7 12 12 22 7 12 2"/>
								<polyline points="2 17 12 22 22 17"/>
								<polyline points="2 12 12 17 22 12"/>
							</svg>
						</div>
						<span class="text-xl font-bold tracking-tight">Nexus</span>
					</div>

					<div class="space-y-2">
						<h1 class="text-2xl font-bold tracking-tight">Welcome back</h1>
						<p class="text-sm text-muted-foreground">Enter your credentials to access your account</p>
					</div>

					<form class="space-y-4" action="/examples/dashboard-v3">
						<div class="cu-form-group">
							<label class="cu-label" for="email">Email</label>
							<input class="cu-input" id="email" type="email" placeholder="jane@company.com" required aria-required="true" />
						</div>
						<div class="cu-form-group">
							<div class="flex items-center justify-between">
								<label class="cu-label" for="password">Password</label>
								<a href="/examples/dashboard-v3/forgot-password" class="text-xs text-muted-foreground hover:text-foreground transition-colors duration-150">Forgot password?</a>
							</div>
							<input class="cu-input" id="password" type="password" placeholder="Enter your password" required aria-required="true" />
						</div>
						<label class="cu-checkbox-wrapper">
							<input type="checkbox" class="cu-checkbox" />
							<span class="text-sm">Remember me for 30 days</span>
						</label>
						<button type="submit" class="cu-button cu-button-md w-full bg-teal-600 hover:bg-teal-700 text-white border-0">Sign in</button>
					</form>

					<div class="relative">
						<div class="absolute inset-0 flex items-center"><div class="cu-separator"></div></div>
						<div class="relative flex justify-center"><span class="bg-stone-50 px-3 text-xs text-muted-foreground">or continue with</span></div>
					</div>

					<div class="grid grid-cols-2 gap-3">
						<button type="button" class="cu-button cu-button-outline cu-button-md">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" class="mr-2"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
							Google
						</button>
						<button type="button" class="cu-button cu-button-outline cu-button-md">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="mr-2"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
							Apple
						</button>
					</div>

					<p class="text-center text-sm text-muted-foreground">
						Don't have an account?{" "}
						<a href="/examples/dashboard-v3/register" class="cu-link text-teal-600 hover:text-teal-700">Sign up</a>
					</p>
				</div>
			</div>
		</div>
	</body>
</html>
