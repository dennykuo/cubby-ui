---
import DashboardV3Layout from "@/layouts/DashboardV3Layout.astro";
import Card from "@/components/ui/Card.astro";
import CardHeader from "@/components/ui/CardHeader.astro";
import CardTitle from "@/components/ui/CardTitle.astro";
import CardDescription from "@/components/ui/CardDescription.astro";
import CardContent from "@/components/ui/CardContent.astro";

const ranges = [
  { value: "7d", label: "7D" },
  { value: "30d", label: "30D", checked: true },
  { value: "90d", label: "90D" },
  { value: "1y", label: "1Y" },
  { value: "custom", label: "Custom" },
];

const metrics = [
  { label: "Page Views", value: "124.5K" },
  { label: "Unique Visitors", value: "48.2K" },
  { label: "Bounce Rate", value: "32.1%" },
  { label: "Avg. Duration", value: "4m 12s" },
  { label: "Conversions", value: "1,847" },
  { label: "Revenue", value: "$48.2K" },
];

// 圓周長 2πr（r = 80）
const CIRCUMFERENCE = 502.65;
const trafficSources = [
  { label: "Direct", percent: 35, color: 1 },
  { label: "Organic", percent: 28, color: 2 },
  { label: "Referral", percent: 20, color: 3 },
  { label: "Social", percent: 12, color: 4 },
  { label: "Email", percent: 5, color: 5 },
];
let offset = 0;
const donutSegments = trafficSources.map((source) => {
  const length = (source.percent / 100) * CIRCUMFERENCE;
  const segment = { ...source, dasharray: `${length.toFixed(2)} ${CIRCUMFERENCE}`, dashoffset: (-offset).toFixed(2) };
  offset += length;
  return segment;
});

const funnel = [
  { label: "Visitors", value: "100,000", summary: "100K (100%)", width: 100, bar: "bg-primary/10 border-primary/20" },
  { label: "Sign-ups", value: "12,000", summary: "12K (12%)", width: 70, bar: "bg-primary/20 border-primary/30" },
  { label: "Trial Started", value: "4,200", summary: "4.2K (4.2%)", width: 50, bar: "bg-primary/35 border-primary/45" },
  {
    label: "Paid Conversion",
    value: "1,800",
    summary: "1.8K (1.8%)",
    width: 35,
    bar: "bg-primary border-primary text-primary-foreground",
  },
];

const countries = [
  { name: "United States", percent: 42, color: 1 },
  { name: "United Kingdom", percent: 18, color: 2 },
  { name: "Germany", percent: 12, color: 3 },
  { name: "Japan", percent: 8, color: 4 },
  { name: "Brazil", percent: 6, color: 5 },
];

const liveBars = [
  { height: 45, opacity: "bg-primary/40" },
  { height: 62, opacity: "bg-primary/50" },
  { height: 38, opacity: "bg-primary/60" },
  { height: 75, opacity: "bg-primary/70" },
  { height: 88, opacity: "bg-primary/80" },
  { height: 92, opacity: "bg-primary/90" },
  { height: 100, opacity: "bg-primary animate-pulse" },
  { height: 55, opacity: "bg-primary/60" },
];
---

<DashboardV3Layout title="Analytics — Nexus">
  <div class="max-w-7xl mx-auto space-y-8">
    <!-- Page Header -->
    <header class="cu-page-header">
      <div class="cu-page-header-content">
        <h1 class="cu-page-header-title text-2xl md:text-2xl">Analytics</h1>
        <p class="cu-page-header-description">Deep dive into your platform metrics</p>
      </div>
      <div class="cu-page-header-actions">
        <button type="button" class="cu-button cu-button-outline cu-button-md">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
            <line x1="16" x2="16" y1="2" y2="6"></line>
            <line x1="8" x2="8" y1="2" y2="6"></line>
            <line x1="3" x2="21" y1="10" y2="10"></line>
          </svg>
          <span>Jan 1, 2026 — Feb 3, 2026</span>
        </button>
      </div>
    </header>

    <!-- Date Range Presets（radio 版 Segmented Control，純 CSS 切換狀態） -->
    <div class="cu-segmented cu-segmented-sm" role="radiogroup" aria-label="Date range preset">
      {ranges.map((range) => (
        <>
          <input
            type="radio"
            name="analytics-range"
            id={`analytics-range-${range.value}`}
            value={range.value}
            class="cu-segmented-input"
            checked={range.checked}
          />
          <label for={`analytics-range-${range.value}`} class="cu-segmented-item">
            {range.label}
          </label>
        </>
      ))}
    </div>

    <!-- Metrics Overview -->
    <section aria-label="Key metrics" class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-4">
      {metrics.map((metric) => (
        <div class="cu-stat p-4">
          <p class="cu-stat-label text-xs">{metric.label}</p>
          <p class="cu-stat-value mt-1 tabular-nums">{metric.value}</p>
        </div>
      ))}
    </section>

    <!-- Two-Column Grid -->
    <div class="grid lg:grid-cols-2 gap-6">
      <!-- Traffic Source Donut Chart -->
      <section class="cu-chart" aria-labelledby="traffic-sources-title">
        <div class="cu-chart-header">
          <div class="cu-chart-header-content">
            <h2 id="traffic-sources-title" class="cu-chart-title">
              Traffic Sources
            </h2>
            <p class="cu-chart-description">Breakdown of visitor acquisition channels</p>
          </div>
        </div>
        <div class="cu-chart-body cu-chart-body-split">
          <div class="cu-chart-canvas cu-chart-canvas-square w-48">
            <svg
              viewBox="0 0 200 200"
              role="img"
              aria-label={`Traffic sources: ${trafficSources.map((s) => `${s.label} ${s.percent}%`).join(", ")}`}
            >
              <circle
                cx="100"
                cy="100"
                r="80"
                fill="none"
                stroke="currentColor"
                stroke-width="32"
                class="text-muted"
              ></circle>
              <g transform="rotate(-90 100 100)">
                {donutSegments.map((segment) => (
                  <circle
                    cx="100"
                    cy="100"
                    r="80"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="32"
                    stroke-dasharray={segment.dasharray}
                    stroke-dashoffset={segment.dashoffset}
                    class={`cu-chart-color-${segment.color}`}
                  />
                ))}
              </g>
            </svg>
          </div>

          <ul class="cu-chart-legend cu-chart-legend-vertical text-sm">
            {trafficSources.map((source) => (
              <li class="cu-chart-legend-item">
                <span class={`cu-chart-swatch cu-chart-swatch-dot cu-chart-color-${source.color}`} aria-hidden="true" />
                {source.label}
                <span class="cu-chart-legend-value">{source.percent}%</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Conversion Funnel -->
      <Card>
        <CardHeader>
          <CardTitle>Conversion Funnel</CardTitle>
          <CardDescription>User journey from visit to paid conversion</CardDescription>
        </CardHeader>
        <CardContent>
          <ol class="space-y-4">
            {funnel.map((step) => (
              <li class="space-y-2">
                <div class="flex items-center justify-between text-sm">
                  <span class="font-medium">{step.label}</span>
                  <span class="text-muted-foreground tabular-nums">{step.summary}</span>
                </div>
                <div
                  class:list={["h-12 rounded-lg flex items-center px-4 border", step.bar]}
                  style={`width: ${step.width}%;`}
                >
                  <span class="text-sm font-medium tabular-nums">{step.value}</span>
                </div>
              </li>
            ))}
          </ol>
        </CardContent>
      </Card>
    </div>

    <!-- Geographic Distribution -->
    <Card>
      <CardHeader>
        <CardTitle>Geographic Distribution</CardTitle>
        <CardDescription>Top countries by user traffic</CardDescription>
      </CardHeader>
      <CardContent>
        <div class="grid md:grid-cols-2 gap-8">
          <!-- World Map Placeholder -->
          <div class="flex items-center justify-center p-8 bg-muted/30 rounded-lg border border-border">
            <svg
              class="w-full h-48 cu-chart-color-1"
              viewBox="0 0 400 200"
              fill="none"
              stroke="currentColor"
              role="img"
              aria-label="Simplified world map highlighting regions with the most traffic"
            >
              <path
                d="M50 80 L80 70 L90 80 L100 75 L110 85 L105 95 L95 100 L85 95 L75 100 L65 95 Z"
                fill="currentColor"
                fill-opacity="0.3"
                stroke-width="1.5"
              />
              <path
                d="M150 60 L180 55 L200 65 L195 85 L185 90 L170 85 L160 75 Z"
                fill="currentColor"
                fill-opacity="0.5"
                stroke-width="1.5"
              />
              <path
                d="M250 70 L280 65 L300 75 L295 90 L280 95 L265 90 L255 80 Z"
                fill="currentColor"
                fill-opacity="0.2"
                stroke-width="1.5"
              />
              <path
                d="M90 120 L115 115 L125 125 L120 140 L105 145 L95 135 Z"
                fill="currentColor"
                fill-opacity="0.15"
                stroke-width="1.5"
              />
              <path
                d="M180 130 L210 125 L225 135 L220 150 L200 155 L185 145 Z"
                fill="currentColor"
                fill-opacity="0.1"
                stroke-width="1.5"
              />
              <!-- Dots for major regions -->
              <circle cx="175" cy="70" r="4" fill="currentColor" stroke="none" opacity="0.8" />
              <circle cx="100" cy="85" r="4" fill="currentColor" stroke="none" opacity="0.8" />
              <circle cx="275" cy="80" r="3" fill="currentColor" stroke="none" opacity="0.6" />
              <circle cx="110" cy="130" r="3" fill="currentColor" stroke="none" opacity="0.5" />
              <circle cx="200" cy="140" r="3" fill="currentColor" stroke="none" opacity="0.4" />
            </svg>
          </div>

          <!-- Top Countries Bar Chart -->
          <ul class="space-y-4" aria-label="Top countries by traffic share">
            {countries.map((country) => (
              <li class="space-y-2">
                <div class="flex items-center justify-between text-sm">
                  <span class="font-medium">{country.name}</span>
                  <span class="text-muted-foreground tabular-nums">{country.percent}%</span>
                </div>
                <div class="cu-progress" aria-hidden="true">
                  <div
                    class={`cu-progress-bar bg-current cu-chart-color-${country.color}`}
                    style={`width: ${country.percent}%`}
                  />
                </div>
              </li>
            ))}
          </ul>
        </div>
      </CardContent>
    </Card>

    <!-- Real-time Visitors Counter -->
    <Card>
      <CardHeader>
        <CardTitle class="flex items-center gap-2">
          Real-time Activity
          <span class="relative flex h-3 w-3" aria-hidden="true">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary/60"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-primary"></span>
          </span>
        </CardTitle>
        <CardDescription>Live visitor tracking and activity</CardDescription>
      </CardHeader>
      <CardContent>
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
          <!-- Counter -->
          <div class="text-center md:text-left">
            <div class="text-5xl font-bold text-primary tabular-nums">1,247</div>
            <div class="text-sm text-muted-foreground mt-1">visitors right now</div>
          </div>

          <!-- Mini Live Activity Bar Chart -->
          <div
            class="flex items-end gap-1.5 h-20"
            role="img"
            aria-label="Visitors per minute over the last 8 minutes, peaking in the 7th minute"
          >
            {liveBars.map((bar) => (
              <div class:list={["w-6 rounded-t", bar.opacity]} style={`height: ${bar.height}%`} />
            ))}
          </div>

          <!-- Quick Stats -->
          <div class="flex gap-4 text-sm">
            <div class="text-center">
              <div class="text-2xl font-bold tabular-nums">847</div>
              <div class="text-muted-foreground text-xs">Active sessions</div>
            </div>
            <div class="cu-separator cu-separator-vertical h-auto self-stretch" aria-hidden="true"></div>
            <div class="text-center">
              <div class="text-2xl font-bold tabular-nums">2.4K</div>
              <div class="text-muted-foreground text-xs">Page views/min</div>
            </div>
          </div>
        </div>
      </CardContent>
    </Card>
  </div>
</DashboardV3Layout>
