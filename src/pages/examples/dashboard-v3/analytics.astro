---
import DashboardV3Layout from '../../../layouts/DashboardV3Layout.astro';
import Card from '../../../components/ui/Card.astro';
import CardHeader from '../../../components/ui/CardHeader.astro';
import CardTitle from '../../../components/ui/CardTitle.astro';
import CardDescription from '../../../components/ui/CardDescription.astro';
import CardContent from '../../../components/ui/CardContent.astro';
import Button from '../../../components/ui/Button.astro';
import Badge from '../../../components/ui/Badge.astro';
---

<DashboardV3Layout title="Analytics — Nexus">
  <div class="max-w-7xl mx-auto space-y-8">
    <!-- Page Header -->
    <div>
      <h1 class="cu-heading-1">Analytics</h1>
      <p class="cu-paragraph text-muted-foreground mt-2">
        Deep dive into your platform metrics
      </p>
    </div>

    <!-- Date Range Picker Bar -->
    <div class="flex items-center gap-3 flex-wrap">
      <div class="flex items-center gap-2 px-4 py-2 border border-border rounded-full text-sm">
        <svg class="size-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
          <line x1="16" x2="16" y1="2" y2="6"></line>
          <line x1="8" x2="8" y1="2" y2="6"></line>
          <line x1="3" x2="21" y1="10" y2="10"></line>
        </svg>
        <span class="font-medium">Jan 1, 2026 — Feb 3, 2026</span>
      </div>
      <div class="flex items-center gap-2">
        <Button variant="ghost" size="sm">7D</Button>
        <Button size="sm" class="bg-teal-500/10 text-teal-600 hover:bg-teal-500/20 dark:text-teal-400">30D</Button>
        <Button variant="ghost" size="sm">90D</Button>
        <Button variant="ghost" size="sm">1Y</Button>
        <Button variant="ghost" size="sm">Custom</Button>
      </div>
    </div>

    <!-- Metrics Overview -->
    <div class="flex gap-3 overflow-x-auto pb-2">
      <div class="flex-shrink-0 px-4 py-3 bg-card border border-border rounded-lg min-w-[160px]">
        <div class="text-xs text-muted-foreground mb-1">Page Views</div>
        <div class="text-2xl font-bold">124.5K</div>
      </div>
      <div class="flex-shrink-0 px-4 py-3 bg-card border border-border rounded-lg min-w-[160px]">
        <div class="text-xs text-muted-foreground mb-1">Unique Visitors</div>
        <div class="text-2xl font-bold">48.2K</div>
      </div>
      <div class="flex-shrink-0 px-4 py-3 bg-card border border-border rounded-lg min-w-[160px]">
        <div class="text-xs text-muted-foreground mb-1">Bounce Rate</div>
        <div class="text-2xl font-bold">32.1%</div>
      </div>
      <div class="flex-shrink-0 px-4 py-3 bg-card border border-border rounded-lg min-w-[160px]">
        <div class="text-xs text-muted-foreground mb-1">Avg. Duration</div>
        <div class="text-2xl font-bold">4m 12s</div>
      </div>
      <div class="flex-shrink-0 px-4 py-3 bg-card border border-border rounded-lg min-w-[160px]">
        <div class="text-xs text-muted-foreground mb-1">Conversions</div>
        <div class="text-2xl font-bold">1,847</div>
      </div>
      <div class="flex-shrink-0 px-4 py-3 bg-card border border-border rounded-lg min-w-[160px]">
        <div class="text-xs text-muted-foreground mb-1">Revenue</div>
        <div class="text-2xl font-bold">$48.2K</div>
      </div>
    </div>

    <!-- Two-Column Grid -->
    <div class="grid lg:grid-cols-2 gap-6">
      <!-- Traffic Source Donut Chart -->
      <Card>
        <CardHeader>
          <CardTitle>Traffic Sources</CardTitle>
          <CardDescription>Breakdown of visitor acquisition channels</CardDescription>
        </CardHeader>
        <CardContent>
          <div class="flex flex-col items-center gap-6">
            <!-- SVG Donut Chart -->
            <svg class="w-48 h-48 -rotate-90" viewBox="0 0 200 200">
              <circle cx="100" cy="100" r="80" fill="none" stroke="hsl(var(--color-muted))" stroke-width="32" opacity="0.2"></circle>
              <!-- Direct: 35% (teal) -->
              <circle
                cx="100"
                cy="100"
                r="80"
                fill="none"
                stroke="hsl(173 80% 40%)"
                stroke-width="32"
                stroke-dasharray="175.93 502.65"
                stroke-dashoffset="0"
                class="transition-all duration-300"
              ></circle>
              <!-- Organic: 28% (emerald) -->
              <circle
                cx="100"
                cy="100"
                r="80"
                fill="none"
                stroke="hsl(142 76% 36%)"
                stroke-width="32"
                stroke-dasharray="140.74 502.65"
                stroke-dashoffset="-175.93"
                class="transition-all duration-300"
              ></circle>
              <!-- Referral: 20% (blue) -->
              <circle
                cx="100"
                cy="100"
                r="80"
                fill="none"
                stroke="hsl(217 91% 60%)"
                stroke-width="32"
                stroke-dasharray="100.53 502.65"
                stroke-dashoffset="-316.67"
                class="transition-all duration-300"
              ></circle>
              <!-- Social: 12% (violet) -->
              <circle
                cx="100"
                cy="100"
                r="80"
                fill="none"
                stroke="hsl(263 70% 50%)"
                stroke-width="32"
                stroke-dasharray="60.32 502.65"
                stroke-dashoffset="-417.20"
                class="transition-all duration-300"
              ></circle>
              <!-- Email: 5% (amber) -->
              <circle
                cx="100"
                cy="100"
                r="80"
                fill="none"
                stroke="hsl(38 92% 50%)"
                stroke-width="32"
                stroke-dasharray="25.13 502.65"
                stroke-dashoffset="-477.52"
                class="transition-all duration-300"
              ></circle>
            </svg>

            <!-- Legend -->
            <div class="w-full space-y-2">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 rounded-full" style="background: hsl(173 80% 40%)"></div>
                  <span class="text-sm">Direct</span>
                </div>
                <span class="text-sm font-medium">35%</span>
              </div>
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 rounded-full" style="background: hsl(142 76% 36%)"></div>
                  <span class="text-sm">Organic</span>
                </div>
                <span class="text-sm font-medium">28%</span>
              </div>
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 rounded-full" style="background: hsl(217 91% 60%)"></div>
                  <span class="text-sm">Referral</span>
                </div>
                <span class="text-sm font-medium">20%</span>
              </div>
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 rounded-full" style="background: hsl(263 70% 50%)"></div>
                  <span class="text-sm">Social</span>
                </div>
                <span class="text-sm font-medium">12%</span>
              </div>
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 rounded-full" style="background: hsl(38 92% 50%)"></div>
                  <span class="text-sm">Email</span>
                </div>
                <span class="text-sm font-medium">5%</span>
              </div>
            </div>
          </div>
        </CardContent>
      </Card>

      <!-- Conversion Funnel -->
      <Card>
        <CardHeader>
          <CardTitle>Conversion Funnel</CardTitle>
          <CardDescription>User journey from visit to paid conversion</CardDescription>
        </CardHeader>
        <CardContent>
          <div class="space-y-4">
            <!-- Visitors -->
            <div class="space-y-2">
              <div class="flex items-center justify-between text-sm">
                <span class="font-medium">Visitors</span>
                <span class="text-muted-foreground">100K (100%)</span>
              </div>
              <div class="h-12 bg-teal-500/20 rounded-lg flex items-center px-4 border border-teal-500/30">
                <div class="text-sm font-medium text-teal-700 dark:text-teal-300">100,000</div>
              </div>
            </div>

            <!-- Sign-ups -->
            <div class="space-y-2">
              <div class="flex items-center justify-between text-sm">
                <span class="font-medium">Sign-ups</span>
                <span class="text-muted-foreground">12K (12%)</span>
              </div>
              <div class="h-12 bg-teal-500/30 rounded-lg flex items-center px-4 border border-teal-500/40" style="width: 70%;">
                <div class="text-sm font-medium text-teal-700 dark:text-teal-300">12,000</div>
              </div>
            </div>

            <!-- Trial -->
            <div class="space-y-2">
              <div class="flex items-center justify-between text-sm">
                <span class="font-medium">Trial Started</span>
                <span class="text-muted-foreground">4.2K (4.2%)</span>
              </div>
              <div class="h-12 bg-teal-500/50 rounded-lg flex items-center px-4 border border-teal-500/60" style="width: 50%;">
                <div class="text-sm font-medium text-teal-700 dark:text-teal-200">4,200</div>
              </div>
            </div>

            <!-- Paid -->
            <div class="space-y-2">
              <div class="flex items-center justify-between text-sm">
                <span class="font-medium">Paid Conversion</span>
                <span class="text-muted-foreground">1.8K (1.8%)</span>
              </div>
              <div class="h-12 bg-teal-500/70 rounded-lg flex items-center px-4 border border-teal-500/80" style="width: 35%;">
                <div class="text-sm font-medium text-teal-800 dark:text-teal-100">1,800</div>
              </div>
            </div>
          </div>
        </CardContent>
      </Card>
    </div>

    <!-- Geographic Distribution -->
    <Card>
      <CardHeader>
        <CardTitle>Geographic Distribution</CardTitle>
        <CardDescription>Top countries by user traffic</CardDescription>
      </CardHeader>
      <CardContent>
        <div class="grid md:grid-cols-2 gap-8">
          <!-- World Map Placeholder -->
          <div class="flex items-center justify-center p-8 bg-muted/30 rounded-lg border border-border">
            <svg class="w-full h-48 text-muted-foreground/40" viewBox="0 0 400 200" fill="none" stroke="currentColor">
              <!-- Simplified world map outline -->
              <path d="M50 80 L80 70 L90 80 L100 75 L110 85 L105 95 L95 100 L85 95 L75 100 L65 95 Z" fill="hsl(173 80% 40% / 0.3)" stroke="hsl(173 80% 40%)" stroke-width="1.5"/>
              <path d="M150 60 L180 55 L200 65 L195 85 L185 90 L170 85 L160 75 Z" fill="hsl(173 80% 40% / 0.5)" stroke="hsl(173 80% 40%)" stroke-width="1.5"/>
              <path d="M250 70 L280 65 L300 75 L295 90 L280 95 L265 90 L255 80 Z" fill="hsl(173 80% 40% / 0.2)" stroke="hsl(173 80% 40%)" stroke-width="1.5"/>
              <path d="M90 120 L115 115 L125 125 L120 140 L105 145 L95 135 Z" fill="hsl(173 80% 40% / 0.15)" stroke="hsl(173 80% 40%)" stroke-width="1.5"/>
              <path d="M180 130 L210 125 L225 135 L220 150 L200 155 L185 145 Z" fill="hsl(173 80% 40% / 0.1)" stroke="hsl(173 80% 40%)" stroke-width="1.5"/>
              <!-- Dots for major regions -->
              <circle cx="175" cy="70" r="4" fill="hsl(173 80% 40%)" opacity="0.8"/>
              <circle cx="100" cy="85" r="4" fill="hsl(173 80% 40%)" opacity="0.8"/>
              <circle cx="275" cy="80" r="3" fill="hsl(173 80% 40%)" opacity="0.6"/>
              <circle cx="110" cy="130" r="3" fill="hsl(173 80% 40%)" opacity="0.5"/>
              <circle cx="200" cy="140" r="3" fill="hsl(173 80% 40%)" opacity="0.4"/>
            </svg>
          </div>

          <!-- Top Countries Bar Chart -->
          <div class="space-y-4">
            <div class="space-y-2">
              <div class="flex items-center justify-between text-sm">
                <span class="font-medium">United States</span>
                <span class="text-muted-foreground">42%</span>
              </div>
              <div class="h-3 bg-muted rounded-full overflow-hidden">
                <div class="h-full bg-teal-500" style="width: 42%"></div>
              </div>
            </div>

            <div class="space-y-2">
              <div class="flex items-center justify-between text-sm">
                <span class="font-medium">United Kingdom</span>
                <span class="text-muted-foreground">18%</span>
              </div>
              <div class="h-3 bg-muted rounded-full overflow-hidden">
                <div class="h-full bg-emerald-500" style="width: 18%"></div>
              </div>
            </div>

            <div class="space-y-2">
              <div class="flex items-center justify-between text-sm">
                <span class="font-medium">Germany</span>
                <span class="text-muted-foreground">12%</span>
              </div>
              <div class="h-3 bg-muted rounded-full overflow-hidden">
                <div class="h-full bg-blue-500" style="width: 12%"></div>
              </div>
            </div>

            <div class="space-y-2">
              <div class="flex items-center justify-between text-sm">
                <span class="font-medium">Japan</span>
                <span class="text-muted-foreground">8%</span>
              </div>
              <div class="h-3 bg-muted rounded-full overflow-hidden">
                <div class="h-full bg-violet-500" style="width: 8%"></div>
              </div>
            </div>

            <div class="space-y-2">
              <div class="flex items-center justify-between text-sm">
                <span class="font-medium">Brazil</span>
                <span class="text-muted-foreground">6%</span>
              </div>
              <div class="h-3 bg-muted rounded-full overflow-hidden">
                <div class="h-full bg-amber-500" style="width: 6%"></div>
              </div>
            </div>
          </div>
        </div>
      </CardContent>
    </Card>

    <!-- Real-time Visitors Counter -->
    <Card>
      <CardHeader>
        <CardTitle class="flex items-center gap-2">
          Real-time Activity
          <span class="relative flex h-3 w-3">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-teal-500"></span>
          </span>
        </CardTitle>
        <CardDescription>Live visitor tracking and activity</CardDescription>
      </CardHeader>
      <CardContent>
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
          <!-- Counter -->
          <div class="text-center md:text-left">
            <div class="text-5xl font-bold text-teal-600 dark:text-teal-400">1,247</div>
            <div class="text-sm text-muted-foreground mt-1">visitors right now</div>
          </div>

          <!-- Mini Live Activity Bar Chart -->
          <div class="flex items-end gap-1.5 h-20">
            <div class="w-6 bg-teal-500/60 rounded-t transition-all duration-300" style="height: 45%"></div>
            <div class="w-6 bg-teal-500/70 rounded-t transition-all duration-300" style="height: 62%"></div>
            <div class="w-6 bg-teal-500/80 rounded-t transition-all duration-300" style="height: 38%"></div>
            <div class="w-6 bg-teal-500/90 rounded-t transition-all duration-300" style="height: 75%"></div>
            <div class="w-6 bg-teal-500 rounded-t transition-all duration-300" style="height: 88%"></div>
            <div class="w-6 bg-teal-500 rounded-t transition-all duration-300" style="height: 92%"></div>
            <div class="w-6 bg-teal-500/95 rounded-t transition-all duration-300 animate-pulse" style="height: 100%"></div>
            <div class="w-6 bg-teal-500/70 rounded-t transition-all duration-300" style="height: 55%"></div>
          </div>

          <!-- Quick Stats -->
          <div class="flex gap-4 text-sm">
            <div class="text-center">
              <div class="text-2xl font-bold">847</div>
              <div class="text-muted-foreground text-xs">Active sessions</div>
            </div>
            <div class="w-px bg-border"></div>
            <div class="text-center">
              <div class="text-2xl font-bold">2.4K</div>
              <div class="text-muted-foreground text-xs">Page views/min</div>
            </div>
          </div>
        </div>
      </CardContent>
    </Card>
  </div>
</DashboardV3Layout>
