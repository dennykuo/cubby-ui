---
import DashboardV3Layout from "../../../layouts/DashboardV3Layout.astro";
import Card from "../../../components/ui/Card.astro";
import CardHeader from "../../../components/ui/CardHeader.astro";
import CardTitle from "../../../components/ui/CardTitle.astro";
import CardDescription from "../../../components/ui/CardDescription.astro";
import CardContent from "../../../components/ui/CardContent.astro";
import CardFooter from "../../../components/ui/CardFooter.astro";
import Button from "../../../components/ui/Button.astro";
import Badge from "../../../components/ui/Badge.astro";
import Avatar from "../../../components/ui/Avatar.astro";
import AvatarFallback from "../../../components/ui/AvatarFallback.astro";
import Stat from "../../../components/ui/Stat.astro";
import StatHeader from "../../../components/ui/StatHeader.astro";
import StatLabel from "../../../components/ui/StatLabel.astro";
import StatValue from "../../../components/ui/StatValue.astro";
import StatDescription from "../../../components/ui/StatDescription.astro";
import StatTrend from "../../../components/ui/StatTrend.astro";
import Separator from "../../../components/ui/Separator.astro";
---

<DashboardV3Layout title="Overview — Nexus">
  <div class="max-w-7xl mx-auto space-y-8">
    <!-- Welcome Banner -->
    <Card class="bg-gradient-to-br from-teal-600 to-emerald-600 border-0 text-white">
      <CardContent class="py-8">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
          <div class="space-y-2">
            <h1 class="text-3xl font-bold">Good morning, Jane</h1>
            <p class="text-white/90 text-lg">Tuesday, Feb 3, 2026</p>
          </div>
          <div class="flex flex-wrap gap-3">
            <Button variant="outline" class="bg-white text-teal-700 border-white hover:bg-white/90">
              Generate Report
            </Button>
            <Button variant="outline" class="bg-white text-teal-700 border-white hover:bg-white/90">
              View Analytics
            </Button>
          </div>
        </div>
      </CardContent>
    </Card>

    <!-- Bento Grid KPI Section -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      <!-- Total Revenue -->
      <Card class="bg-white/70 backdrop-blur-sm border border-white/50 shadow-sm">
        <CardContent class="pt-6 space-y-3">
          <div class="flex items-start justify-between">
            <div class="space-y-1">
              <p class="text-sm text-muted-foreground">Total Revenue</p>
              <p class="text-3xl font-bold">$48,250</p>
            </div>
            <Badge class="bg-emerald-100 text-emerald-700 border-emerald-200">
              +12.5%
            </Badge>
          </div>
          <svg viewBox="0 0 80 32" class="w-full h-8" preserveAspectRatio="none">
            <polyline
              points="0,28 10,24 20,26 30,20 40,22 50,16 60,18 70,12 80,8"
              fill="none"
              stroke="rgb(20, 184, 166)"
              stroke-width="2"
              vector-effect="non-scaling-stroke"
            />
            <polyline
              points="0,28 10,24 20,26 30,20 40,22 50,16 60,18 70,12 80,8 80,32 0,32"
              fill="rgb(20, 184, 166)"
              fill-opacity="0.2"
            />
          </svg>
        </CardContent>
      </Card>

      <!-- Active Users -->
      <Card class="bg-white/70 backdrop-blur-sm border border-white/50 shadow-sm">
        <CardContent class="pt-6 space-y-3">
          <div class="flex items-start justify-between">
            <div class="space-y-1">
              <p class="text-sm text-muted-foreground">Active Users</p>
              <p class="text-3xl font-bold">2,847</p>
            </div>
            <Badge class="bg-emerald-100 text-emerald-700 border-emerald-200">
              +8.2%
            </Badge>
          </div>
          <svg viewBox="0 0 80 32" class="w-full h-8" preserveAspectRatio="none">
            <polyline
              points="0,24 10,20 20,22 30,18 40,14 50,16 60,10 70,12 80,6"
              fill="none"
              stroke="rgb(16, 185, 129)"
              stroke-width="2"
              vector-effect="non-scaling-stroke"
            />
            <polyline
              points="0,24 10,20 20,22 30,18 40,14 50,16 60,10 70,12 80,6 80,32 0,32"
              fill="rgb(16, 185, 129)"
              fill-opacity="0.2"
            />
          </svg>
        </CardContent>
      </Card>

      <!-- Conversion Rate -->
      <Card class="bg-white/70 backdrop-blur-sm border border-white/50 shadow-sm">
        <CardContent class="pt-6 space-y-3">
          <div class="flex items-start justify-between">
            <div class="space-y-1">
              <p class="text-sm text-muted-foreground">Conversion Rate</p>
              <p class="text-3xl font-bold">3.24%</p>
            </div>
            <Badge class="bg-rose-100 text-rose-700 border-rose-200">
              -0.4%
            </Badge>
          </div>
          <svg viewBox="0 0 80 32" class="w-full h-8" preserveAspectRatio="none">
            <polyline
              points="0,12 10,14 20,10 30,16 40,14 50,18 60,16 70,20 80,24"
              fill="none"
              stroke="rgb(244, 63, 94)"
              stroke-width="2"
              vector-effect="non-scaling-stroke"
            />
            <polyline
              points="0,12 10,14 20,10 30,16 40,14 50,18 60,16 70,20 80,24 80,32 0,32"
              fill="rgb(244, 63, 94)"
              fill-opacity="0.2"
            />
          </svg>
        </CardContent>
      </Card>

      <!-- Avg Session -->
      <Card class="bg-white/70 backdrop-blur-sm border border-white/50 shadow-sm">
        <CardContent class="pt-6 space-y-3">
          <div class="flex items-start justify-between">
            <div class="space-y-1">
              <p class="text-sm text-muted-foreground">Avg. Session</p>
              <p class="text-3xl font-bold">4m 32s</p>
            </div>
            <Badge class="bg-emerald-100 text-emerald-700 border-emerald-200">
              +15.1%
            </Badge>
          </div>
          <svg viewBox="0 0 80 32" class="w-full h-8" preserveAspectRatio="none">
            <polyline
              points="0,26 10,24 20,28 30,22 40,20 50,24 60,18 70,16 80,10"
              fill="none"
              stroke="rgb(59, 130, 246)"
              stroke-width="2"
              vector-effect="non-scaling-stroke"
            />
            <polyline
              points="0,26 10,24 20,28 30,22 40,20 50,24 60,18 70,16 80,10 80,32 0,32"
              fill="rgb(59, 130, 246)"
              fill-opacity="0.2"
            />
          </svg>
        </CardContent>
      </Card>
    </div>

    <!-- Revenue Chart & Recent Activity -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Revenue Overview -->
      <Card class="lg:col-span-2">
        <CardHeader>
          <div class="flex items-center justify-between">
            <CardTitle>Revenue Overview</CardTitle>
            <div class="flex gap-2">
              <Button size="sm" variant="ghost" class="h-8 px-3">7D</Button>
              <Button size="sm" variant="ghost" class="h-8 px-3">30D</Button>
              <Button size="sm" class="h-8 px-3">90D</Button>
              <Button size="sm" variant="ghost" class="h-8 px-3">1Y</Button>
            </div>
          </div>
        </CardHeader>
        <CardContent>
          <svg viewBox="0 0 400 200" class="w-full" preserveAspectRatio="none">
            <!-- Grid lines -->
            <line x1="0" y1="40" x2="400" y2="40" stroke="currentColor" stroke-opacity="0.1" />
            <line x1="0" y1="80" x2="400" y2="80" stroke="currentColor" stroke-opacity="0.1" />
            <line x1="0" y1="120" x2="400" y2="120" stroke="currentColor" stroke-opacity="0.1" />
            <line x1="0" y1="160" x2="400" y2="160" stroke="currentColor" stroke-opacity="0.1" />

            <!-- Area chart -->
            <polyline
              points="0,180 40,160 80,140 120,130 160,110 200,100 240,90 280,70 320,60 360,40 400,30"
              fill="none"
              stroke="rgb(20, 184, 166)"
              stroke-width="2"
              vector-effect="non-scaling-stroke"
            />
            <polyline
              points="0,180 40,160 80,140 120,130 160,110 200,100 240,90 280,70 320,60 360,40 400,30 400,200 0,200"
              fill="url(#gradient)"
            />

            <defs>
              <linearGradient id="gradient" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" style="stop-color:rgb(20, 184, 166);stop-opacity:0.4" />
                <stop offset="100%" style="stop-color:rgb(20, 184, 166);stop-opacity:0.05" />
              </linearGradient>
            </defs>
          </svg>
        </CardContent>
      </Card>

      <!-- Recent Activity -->
      <Card>
        <CardHeader>
          <CardTitle>Recent Activity</CardTitle>
        </CardHeader>
        <CardContent>
          <div class="space-y-6">
            <!-- Activity Item 1 -->
            <div class="flex gap-3">
              <div class="relative flex flex-col items-center">
                <div class="w-2 h-2 rounded-full bg-emerald-500"></div>
                <div class="w-px h-full bg-border mt-1"></div>
              </div>
              <div class="flex-1 pb-2">
                <p class="text-sm font-medium">New enterprise deal closed</p>
                <p class="text-xs text-muted-foreground mt-1">2h ago</p>
              </div>
            </div>

            <!-- Activity Item 2 -->
            <div class="flex gap-3">
              <div class="relative flex flex-col items-center">
                <div class="w-2 h-2 rounded-full bg-blue-500"></div>
                <div class="w-px h-full bg-border mt-1"></div>
              </div>
              <div class="flex-1 pb-2">
                <p class="text-sm font-medium">AI model retrained</p>
                <p class="text-xs text-muted-foreground mt-1">4h ago</p>
              </div>
            </div>

            <!-- Activity Item 3 -->
            <div class="flex gap-3">
              <div class="relative flex flex-col items-center">
                <div class="w-2 h-2 rounded-full bg-rose-500"></div>
                <div class="w-px h-full bg-border mt-1"></div>
              </div>
              <div class="flex-1 pb-2">
                <p class="text-sm font-medium">Payment failed for user #4821</p>
                <p class="text-xs text-muted-foreground mt-1">6h ago</p>
              </div>
            </div>

            <!-- Activity Item 4 -->
            <div class="flex gap-3">
              <div class="relative flex flex-col items-center">
                <div class="w-2 h-2 rounded-full bg-amber-500"></div>
              </div>
              <div class="flex-1">
                <p class="text-sm font-medium">New feature deployed</p>
                <p class="text-xs text-muted-foreground mt-1">8h ago</p>
              </div>
            </div>
          </div>
        </CardContent>
      </Card>
    </div>

    <!-- Top Products Table -->
    <Card>
      <CardHeader>
        <CardTitle>Top Products</CardTitle>
        <CardDescription>Performance overview of your best-selling products</CardDescription>
      </CardHeader>
      <CardContent>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b">
                <th class="text-left py-3 px-4 text-sm font-medium text-muted-foreground">Product</th>
                <th class="text-left py-3 px-4 text-sm font-medium text-muted-foreground">Revenue</th>
                <th class="text-left py-3 px-4 text-sm font-medium text-muted-foreground">Growth</th>
                <th class="text-left py-3 px-4 text-sm font-medium text-muted-foreground">Progress</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b">
                <td class="py-4 px-4 font-medium">NexusAI Pro</td>
                <td class="py-4 px-4">$24,580</td>
                <td class="py-4 px-4">
                  <Badge class="bg-emerald-100 text-emerald-700 border-emerald-200">+18.2%</Badge>
                </td>
                <td class="py-4 px-4">
                  <div class="w-full bg-muted rounded-full h-2">
                    <div class="bg-teal-500 h-2 rounded-full" style="width: 85%"></div>
                  </div>
                </td>
              </tr>
              <tr class="border-b">
                <td class="py-4 px-4 font-medium">Data Pipeline</td>
                <td class="py-4 px-4">$18,240</td>
                <td class="py-4 px-4">
                  <Badge class="bg-emerald-100 text-emerald-700 border-emerald-200">+12.5%</Badge>
                </td>
                <td class="py-4 px-4">
                  <div class="w-full bg-muted rounded-full h-2">
                    <div class="bg-teal-500 h-2 rounded-full" style="width: 72%"></div>
                  </div>
                </td>
              </tr>
              <tr class="border-b">
                <td class="py-4 px-4 font-medium">AutoML Suite</td>
                <td class="py-4 px-4">$15,680</td>
                <td class="py-4 px-4">
                  <Badge class="bg-emerald-100 text-emerald-700 border-emerald-200">+8.4%</Badge>
                </td>
                <td class="py-4 px-4">
                  <div class="w-full bg-muted rounded-full h-2">
                    <div class="bg-teal-500 h-2 rounded-full" style="width: 64%"></div>
                  </div>
                </td>
              </tr>
              <tr class="border-b">
                <td class="py-4 px-4 font-medium">API Gateway</td>
                <td class="py-4 px-4">$12,450</td>
                <td class="py-4 px-4">
                  <Badge class="bg-emerald-100 text-emerald-700 border-emerald-200">+5.2%</Badge>
                </td>
                <td class="py-4 px-4">
                  <div class="w-full bg-muted rounded-full h-2">
                    <div class="bg-teal-500 h-2 rounded-full" style="width: 48%"></div>
                  </div>
                </td>
              </tr>
              <tr>
                <td class="py-4 px-4 font-medium">Edge Computing</td>
                <td class="py-4 px-4">$9,820</td>
                <td class="py-4 px-4">
                  <Badge class="bg-rose-100 text-rose-700 border-rose-200">-2.1%</Badge>
                </td>
                <td class="py-4 px-4">
                  <div class="w-full bg-muted rounded-full h-2">
                    <div class="bg-teal-500 h-2 rounded-full" style="width: 35%"></div>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </CardContent>
    </Card>

    <!-- Quick Actions Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Create Report -->
      <Card class="hover:shadow-md hover:border-teal-200 transition-all duration-200 cursor-pointer">
        <CardContent class="pt-6 space-y-3">
          <div class="w-12 h-12 rounded-lg bg-teal-100 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <div>
            <h3 class="font-semibold">Create Report</h3>
            <p class="text-sm text-muted-foreground mt-1">Generate custom analytics reports</p>
          </div>
        </CardContent>
      </Card>

      <!-- Invite Team -->
      <Card class="hover:shadow-md hover:border-teal-200 transition-all duration-200 cursor-pointer">
        <CardContent class="pt-6 space-y-3">
          <div class="w-12 h-12 rounded-lg bg-emerald-100 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
          </div>
          <div>
            <h3 class="font-semibold">Invite Team</h3>
            <p class="text-sm text-muted-foreground mt-1">Add new members to workspace</p>
          </div>
        </CardContent>
      </Card>

      <!-- Configure AI -->
      <Card class="hover:shadow-md hover:border-teal-200 transition-all duration-200 cursor-pointer">
        <CardContent class="pt-6 space-y-3">
          <div class="w-12 h-12 rounded-lg bg-blue-100 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <h3 class="font-semibold">Configure AI</h3>
            <p class="text-sm text-muted-foreground mt-1">Tune model parameters</p>
          </div>
        </CardContent>
      </Card>

      <!-- View Logs -->
      <Card class="hover:shadow-md hover:border-teal-200 transition-all duration-200 cursor-pointer">
        <CardContent class="pt-6 space-y-3">
          <div class="w-12 h-12 rounded-lg bg-purple-100 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <div>
            <h3 class="font-semibold">View Logs</h3>
            <p class="text-sm text-muted-foreground mt-1">Monitor system activity</p>
          </div>
        </CardContent>
      </Card>
    </div>
  </div>
</DashboardV3Layout>
