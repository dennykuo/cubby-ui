---
import { withBase } from "@/utils/paths";
import "@/styles/global.css";
---

<!doctype html>
<html lang="en" data-theme-nexus>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Reset Password — Nexus" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>Reset Password — Nexus</title>
    <style>
      body {
        font-family: "Inter", system-ui, sans-serif;
      }
    </style>
    <style is:global>
      /* Nexus 品牌色：與 DashboardV3Layout 相同，覆寫 primary / ring / chart-1 為 teal，語意 token 自動跟隨 */
      html[data-theme-nexus] {
        --color-primary: hsl(175 84% 32%);
        --color-primary-foreground: hsl(0 0% 100%);
        --color-ring: hsl(175 84% 32%);
        --color-chart-1: hsl(175 84% 32%);
      }

      html.dark[data-theme-nexus] {
        --color-primary: hsl(172 66% 50%);
        --color-primary-foreground: hsl(222 47% 11%);
        --color-ring: hsl(175 60% 28%);
        --color-chart-1: hsl(172 66% 50%);
      }
    </style>
  </head>
  <body class="min-h-screen antialiased bg-background text-foreground">
    <div class="grid min-h-screen lg:grid-cols-2">
      <!-- Left: Brand Panel with Gradient -->
      <div class="hidden lg:flex flex-col justify-between bg-gradient-to-br from-teal-600 to-emerald-600 p-10 text-white relative overflow-hidden">
        <!-- Background Pattern -->
        <div class="absolute inset-0 opacity-10" aria-hidden="true">
          <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
            <defs>
              <pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse">
                <circle cx="1" cy="1" r="1" fill="white" />
              </pattern>
            </defs>
            <rect width="100" height="100" fill="url(#grid)" />
          </svg>
        </div>
        <div class="relative flex items-center gap-2.5">
          <div class="flex items-center justify-center w-9 h-9 rounded-xl bg-white/20 backdrop-blur-sm">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polygon points="12 2 2 7 12 12 22 7 12 2" />
              <polyline points="2 17 12 22 22 17" />
              <polyline points="2 12 12 17 22 12" />
            </svg>
          </div>
          <span class="text-xl font-bold tracking-tight">Nexus</span>
        </div>
        <div class="relative space-y-6">
          <div class="p-8 rounded-2xl bg-white/10 backdrop-blur-sm border border-white/20">
            <div class="flex items-center justify-center w-16 h-16 rounded-full bg-white/20 mb-6">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect width="20" height="16" x="2" y="4" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
            </div>
            <p class="text-xl font-semibold mb-3">Check your inbox</p>
            <p class="text-white/80 text-sm leading-relaxed">
              We'll send you a secure link to reset your password. The link will expire in 1 hour for security purposes.
            </p>
          </div>
        </div>
        <p class="relative text-xs text-white/50">© 2026 Nexus Technologies. All rights reserved.</p>
      </div>

      <!-- Right: Forgot Password Form -->
      <div class="flex items-center justify-center p-8">
        <div class="w-full max-w-sm space-y-6">
          <!-- Mobile Logo -->
          <div class="flex items-center gap-2.5 lg:hidden mb-8">
            <div class="flex items-center justify-center w-9 h-9 rounded-xl bg-primary text-primary-foreground">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polygon points="12 2 2 7 12 12 22 7 12 2" />
                <polyline points="2 17 12 22 22 17" />
                <polyline points="2 12 12 17 22 12" />
              </svg>
            </div>
            <span class="text-xl font-bold tracking-tight">Nexus</span>
          </div>

          <div class="space-y-2">
            <h1 class="text-2xl font-bold tracking-tight">Forgot password?</h1>
            <p class="text-sm text-muted-foreground">No worries, we'll send you reset instructions</p>
          </div>

          <form class="space-y-4" action={withBase("/examples/dashboard-v3/login")}>
            <div class="cu-form-group">
              <label class="cu-label" for="email">
                Email
              </label>
              <input
                class="cu-input"
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="jane@company.com"
                required
                aria-required="true"
              />
            </div>
            <button type="submit" class="cu-button cu-button-default cu-button-md w-full">
              Send reset link
            </button>
          </form>

          <p class="text-center text-sm text-muted-foreground">
            Remember your password?{" "}
            <a href={withBase("/examples/dashboard-v3/login")} class="cu-link-plain">
              Back to login
            </a>
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
