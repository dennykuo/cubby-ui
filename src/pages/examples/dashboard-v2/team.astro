---
import DashboardV2Layout from "../../../layouts/DashboardV2Layout.astro";
import Button from "../../../components/ui/Button.astro";
import Card from "../../../components/ui/Card.astro";
import CardContent from "../../../components/ui/CardContent.astro";
import Table from "../../../components/ui/Table.astro";
import TableHeader from "../../../components/ui/TableHeader.astro";
import TableBody from "../../../components/ui/TableBody.astro";
import TableRow from "../../../components/ui/TableRow.astro";
import TableHead from "../../../components/ui/TableHead.astro";
import TableCell from "../../../components/ui/TableCell.astro";
import Badge from "../../../components/ui/Badge.astro";
import Avatar from "../../../components/ui/Avatar.astro";
import AvatarFallback from "../../../components/ui/AvatarFallback.astro";
import Input from "../../../components/ui/Input.astro";
import Select from "../../../components/ui/Select.astro";

const users = [
    {
        name: "Denny Kuo",
        email: "denny@example.com",
        role: "Admin",
        status: "Active",
        lastActive: "Just now",
        department: "Engineering",
    },
    {
        name: "Alex Brown",
        email: "alex@example.com",
        role: "Manager",
        status: "Active",
        lastActive: "5 mins ago",
        department: "Product",
    },
    {
        name: "Sarah Connor",
        email: "sarah@example.com",
        role: "Editor",
        status: "Offline",
        lastActive: "1 day ago",
        department: "Marketing",
    },
    {
        name: "John Wick",
        email: "john@example.com",
        role: "Member",
        status: "Suspended",
        lastActive: "1 week ago",
        department: "Operations",
    },
    {
        name: "Emily Watson",
        email: "emily@example.com",
        role: "Editor",
        status: "Active",
        lastActive: "12 mins ago",
        department: "Design",
    },
    {
        name: "Michael Chang",
        email: "michael@example.com",
        role: "Member",
        status: "Active",
        lastActive: "1 hour ago",
        department: "Sales",
    },
    {
        name: "Jessica Lee",
        email: "jessica@example.com",
        role: "Member",
        status: "Offline",
        lastActive: "Yesterday",
        department: "Support",
    },
];
---

<DashboardV2Layout title="團隊成員 — CubbyPro">
    <div class="space-y-6 max-w-7xl mx-auto">
        <!-- Header -->
        <div
            class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
        >
            <div>
                <h1 class="text-2xl font-bold tracking-tight">團隊成員</h1>
                <p class="text-muted-foreground mt-1">
                    管理組織內的成員權限與狀態。
                </p>
            </div>
            <div class="flex gap-2">
                <Button variant="outline" class="gap-2">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="shrink-0"
                        ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
                        ></path><polyline points="7 10 12 15 17 10"
                        ></polyline><line x1="12" x2="12" y1="15" y2="3"
                        ></line></svg
                    >
                    匯出 CSV
                </Button>
                <Button
                    class="bg-indigo-600 hover:bg-indigo-700 text-white gap-2"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="shrink-0"
                        ><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"
                        ></path><circle cx="9" cy="7" r="4"></circle><line
                            x1="19"
                            x2="19"
                            y1="8"
                            y2="14"></line><line x1="22" x2="16" y1="11" y2="11"
                        ></line></svg
                    >
                    新增成員
                </Button>
            </div>
        </div>

        <!-- Toolbar -->
        <Card class="p-1 border shadow-sm rounded-lg">
            <CardContent
                class="p-0 flex flex-col sm:flex-row items-center gap-4 p-4"
            >
                <div class="relative w-full sm:w-96">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground shrink-0"
                        ><circle cx="11" cy="11" r="8"></circle><path
                            d="m21 21-4.3-4.3"></path></svg
                    >
                    <Input placeholder="搜尋姓名、Email..." class="pl-9" />
                </div>
                <div class="flex items-center gap-2 w-full sm:w-auto">
                    <Select class="w-full sm:w-[150px]">
                        <option>所有部門</option>
                        <option>Engineering</option>
                        <option>Marketing</option>
                        <option>Product</option>
                    </Select>
                    <Select class="w-full sm:w-[150px]">
                        <option>所有狀態</option>
                        <option>Active</option>
                        <option>Offline</option>
                        <option>Suspended</option>
                    </Select>
                </div>
            </CardContent>
        </Card>

        <!-- Users Table -->
        <Card class="overflow-hidden border shadow-sm">
            <div class="overflow-x-auto">
                <Table>
                    <TableHeader class="bg-slate-50">
                        <TableRow>
                            <TableHead class="w-[50px] pl-6">
                                <input
                                    type="checkbox"
                                    class="w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 rounded"
                                />
                            </TableHead>
                            <TableHead>成員資訊</TableHead>
                            <TableHead>部門</TableHead>
                            <TableHead>權限角色</TableHead>
                            <TableHead>狀態</TableHead>
                            <TableHead>最後活躍</TableHead>
                            <TableHead class="text-right pr-6">操作</TableHead>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        {
                            users.map((user) => (
                                <TableRow class="hover:bg-slate-50/50">
                                    <TableCell class="pl-6">
                                        <input
                                            type="checkbox"
                                            class="w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 rounded"
                                        />
                                    </TableCell>
                                    <TableCell>
                                        <div class="flex items-center gap-3">
                                            <Avatar class="h-10 w-10 border border-slate-200">
                                                <AvatarFallback class="bg-indigo-50 text-indigo-600 font-medium">
                                                    {user.name
                                                        .split(" ")
                                                        .map((n) => n[0])
                                                        .join("")}
                                                </AvatarFallback>
                                            </Avatar>
                                            <div class="flex flex-col">
                                                <span class="text-sm font-semibold text-foreground">
                                                    {user.name}
                                                </span>
                                                <span class="text-xs text-muted-foreground">
                                                    {user.email}
                                                </span>
                                            </div>
                                        </div>
                                    </TableCell>
                                    <TableCell>
                                        <span class="inline-flex items-center rounded-md bg-slate-100 px-2 py-1 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-500/10">
                                            {user.department}
                                        </span>
                                    </TableCell>
                                    <TableCell class="text-sm">
                                        {user.role}
                                    </TableCell>
                                    <TableCell>
                                        {user.status === "Active" && (
                                            <Badge
                                                variant="soft"
                                                class="bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-600/20"
                                            >
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5" />
                                                Active
                                            </Badge>
                                        )}
                                        {user.status === "Offline" && (
                                            <Badge
                                                variant="soft"
                                                class="bg-slate-100 text-slate-600 ring-1 ring-inset ring-slate-500/10"
                                            >
                                                <span class="w-1.5 h-1.5 rounded-full bg-slate-400 mr-1.5" />
                                                Offline
                                            </Badge>
                                        )}
                                        {user.status === "Suspended" && (
                                            <Badge
                                                variant="soft"
                                                class="bg-rose-50 text-rose-700 ring-1 ring-inset ring-rose-600/20"
                                            >
                                                <span class="w-1.5 h-1.5 rounded-full bg-rose-500 mr-1.5" />
                                                Suspended
                                            </Badge>
                                        )}
                                    </TableCell>
                                    <TableCell class="text-sm text-muted-foreground">
                                        {user.lastActive}
                                    </TableCell>
                                    <TableCell class="text-right pr-6">
                                        <Button
                                            variant="ghost"
                                            size="icon"
                                            class="h-8 w-8 text-slate-400 hover:text-indigo-600"
                                        >
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="16"
                                                height="16"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                class="shrink-0"
                                            >
                                                <>
                                                    <path d="M12 20h9" />
                                                    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                                                </>
                                            </svg>
                                        </Button>
                                        <Button
                                            variant="ghost"
                                            size="icon"
                                            class="h-8 w-8 text-slate-400 hover:text-rose-600"
                                        >
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="16"
                                                height="16"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                class="shrink-0"
                                            >
                                                <>
                                                    <path d="M3 6h18" />
                                                    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                                                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                                                </>
                                            </svg>
                                        </Button>
                                    </TableCell>
                                </TableRow>
                            ))
                        }
                    </TableBody>
                </Table>
            </div>
            <!-- Pagination -->
            <div
                class="flex items-center justify-between border-t px-6 py-4 bg-slate-50/50"
            >
                <div class="text-xs text-muted-foreground">
                    第 <span class="font-medium text-foreground">1</span> 頁，共 <span
                        class="font-medium text-foreground">5</span
                    > 頁 (78 位成員)
                </div>
                <div class="flex gap-2">
                    <Button variant="outline" size="sm" disabled>上一頁</Button>
                    <Button variant="outline" size="sm" class="bg-white"
                        >下一頁</Button
                    >
                </div>
            </div>
        </Card>
    </div>
</DashboardV2Layout>
