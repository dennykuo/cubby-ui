---
import DashboardV2Layout from "@/layouts/DashboardV2Layout.astro";
import Button from "@/components/ui/Button.astro";
import Avatar from "@/components/ui/Avatar.astro";
import AvatarFallback from "@/components/ui/AvatarFallback.astro";

const users = [
  {
    name: "Denny Kuo",
    email: "denny@example.com",
    role: "Admin",
    status: "Active",
    lastActive: "剛剛",
    department: "Engineering",
  },
  {
    name: "Alex Brown",
    email: "alex@example.com",
    role: "Manager",
    status: "Active",
    lastActive: "5 分鐘前",
    department: "Product",
  },
  {
    name: "Sarah Connor",
    email: "sarah@example.com",
    role: "Editor",
    status: "Offline",
    lastActive: "1 天前",
    department: "Marketing",
  },
  {
    name: "John Wick",
    email: "john@example.com",
    role: "Member",
    status: "Suspended",
    lastActive: "1 週前",
    department: "Operations",
  },
  {
    name: "Emily Watson",
    email: "emily@example.com",
    role: "Editor",
    status: "Active",
    lastActive: "12 分鐘前",
    department: "Design",
  },
  {
    name: "Michael Chang",
    email: "michael@example.com",
    role: "Member",
    status: "Active",
    lastActive: "1 小時前",
    department: "Sales",
  },
  {
    name: "Jessica Lee",
    email: "jessica@example.com",
    role: "Member",
    status: "Offline",
    lastActive: "昨天",
    department: "Support",
  },
];

const statusMap: Record<string, { label: string; badge: string }> = {
  Active: { label: "啟用中", badge: "cu-badge-soft-success" },
  Offline: { label: "離線", badge: "cu-badge-soft-secondary" },
  Suspended: { label: "已停權", badge: "cu-badge-soft-destructive" },
};

const initials = (name: string) =>
  name
    .split(" ")
    .map((n) => n[0])
    .join("");
---

<DashboardV2Layout title="團隊成員 — CubbyPro">
  <div class="space-y-6 max-w-7xl mx-auto">
    <!-- Page Header -->
    <div class="cu-page-header">
      <div class="cu-page-header-content">
        <h1 class="cu-page-header-title text-2xl md:text-2xl">團隊成員</h1>
        <p class="cu-page-header-description">管理組織內的成員權限與狀態。</p>
      </div>
      <div class="cu-page-header-actions">
        <Button type="button" variant="outline">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" x2="12" y1="15" y2="3"></line>
          </svg>
          匯出 CSV
        </Button>
        <Button type="button">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <line x1="19" x2="19" y1="8" y2="14"></line>
            <line x1="22" x2="16" y1="11" y2="11"></line>
          </svg>
          新增成員
        </Button>
      </div>
    </div>

    <!-- Filter Bar -->
    <div class="cu-filter-bar">
      <div class="cu-filter-bar-inner">
        <div class="cu-filter-bar-search">
          <div class="cu-input-search w-full sm:max-w-96" role="search">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="cu-input-search-icon"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
            <input type="search" class="cu-input-search-field" placeholder="搜尋姓名、Email..." aria-label="搜尋成員" />
          </div>
        </div>
        <div class="cu-filter-bar-filters">
          <div class="cu-select-wrapper min-w-0 flex-1 sm:w-[150px] sm:flex-none">
            <select class="cu-select" aria-label="部門篩選">
              <option value="">所有部門</option>
              <option value="Engineering">Engineering</option>
              <option value="Marketing">Marketing</option>
              <option value="Product">Product</option>
            </select>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="cu-select-icon"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </div>
          <div class="cu-select-wrapper min-w-0 flex-1 sm:w-[150px] sm:flex-none">
            <select class="cu-select" aria-label="狀態篩選">
              <option value="">所有狀態</option>
              <option value="Active">啟用中</option>
              <option value="Offline">離線</option>
              <option value="Suspended">已停權</option>
            </select>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="cu-select-icon"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Users Table -->
    <div class="cu-card overflow-hidden">
      <div class="cu-table-wrapper" role="region" aria-label="團隊成員列表" tabindex="0">
        <table class="cu-table">
          <thead class="cu-table-header">
            <tr class="cu-table-row hover:bg-transparent">
              <th scope="col" class="cu-table-head w-12 pl-6">
                <input
                  type="checkbox"
                  class="cu-checkbox align-middle"
                  aria-label="選取全部成員"
                  data-team-select-all
                />
              </th>
              <th scope="col" class="cu-table-head">
                成員資訊
              </th>
              <th scope="col" class="cu-table-head">
                部門
              </th>
              <th scope="col" class="cu-table-head">
                權限角色
              </th>
              <th scope="col" class="cu-table-head">
                狀態
              </th>
              <th scope="col" class="cu-table-head">
                最後活躍
              </th>
              <th scope="col" class="cu-table-head pr-6 text-right">
                操作
              </th>
            </tr>
          </thead>
          <tbody class="cu-table-body">
            {users.map((user) => (
              <tr class="cu-table-row">
                <td class="cu-table-cell pl-6">
                  <input
                    type="checkbox"
                    class="cu-checkbox align-middle"
                    aria-label={`選取 ${user.name}`}
                    data-team-select-row
                  />
                </td>
                <td class="cu-table-cell">
                  <div class="flex items-center gap-3">
                    <Avatar>
                      <AvatarFallback class="bg-primary/10 text-primary">{initials(user.name)}</AvatarFallback>
                    </Avatar>
                    <div class="flex min-w-0 flex-col">
                      <span class="text-sm font-semibold text-foreground">{user.name}</span>
                      <span class="text-xs text-muted-foreground">{user.email}</span>
                    </div>
                  </div>
                </td>
                <td class="cu-table-cell">
                  <span class="cu-badge cu-badge-outline font-medium">{user.department}</span>
                </td>
                <td class="cu-table-cell">{user.role}</td>
                <td class="cu-table-cell">
                  <span class:list={["cu-badge cu-badge-dot", statusMap[user.status].badge]}>
                    {statusMap[user.status].label}
                  </span>
                </td>
                <td class="cu-table-cell whitespace-nowrap text-muted-foreground">{user.lastActive}</td>
                <td class="cu-table-cell pr-6">
                  <div class="cu-table-actions">
                    <button
                      type="button"
                      class="cu-button cu-button-ghost cu-button-icon-sm"
                      aria-label={`編輯 ${user.name}`}
                      title="編輯"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M12 20h9" />
                        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                      </svg>
                    </button>
                    <button
                      type="button"
                      class="cu-button cu-button-ghost cu-button-icon-sm hover:bg-destructive/10 hover:text-destructive"
                      aria-label={`移除 ${user.name}`}
                      title="移除"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M3 6h18" />
                        <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                        <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="flex flex-col gap-3 border-t border-border px-6 py-4 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-muted-foreground">
          第 <span class="font-medium text-foreground">1</span> 頁，共
          <span class="font-medium text-foreground">5</span> 頁（78 位成員）
        </p>
        <nav class="cu-pagination" aria-label="成員列表分頁">
          <button type="button" class="cu-pagination-prev" aria-label="上一頁" disabled>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m15 18-6-6 6-6"></path>
            </svg>
          </button>
          <button
            type="button"
            class="cu-pagination-item cu-pagination-item-active"
            aria-label="第 1 頁"
            aria-current="page"
          >
            1
          </button>
          <button type="button" class="cu-pagination-item" aria-label="第 2 頁">
            2
          </button>
          <button type="button" class="cu-pagination-item" aria-label="第 3 頁">
            3
          </button>
          <button type="button" class="cu-pagination-item" aria-label="第 4 頁">
            4
          </button>
          <button type="button" class="cu-pagination-item" aria-label="第 5 頁">
            5
          </button>
          <button type="button" class="cu-pagination-next" aria-label="下一頁">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </button>
        </nav>
      </div>
    </div>
  </div>

  <script>
    // 全選 / 單列選取同步（含部分選取的 indeterminate 狀態）
    const selectAll = document.querySelector<HTMLInputElement>("[data-team-select-all]");
    const rows = Array.from(document.querySelectorAll<HTMLInputElement>("[data-team-select-row]"));

    function syncSelectAll() {
      if (!selectAll) return;
      const checked = rows.filter((row) => row.checked).length;
      selectAll.checked = checked === rows.length;
      selectAll.indeterminate = checked > 0 && checked < rows.length;
    }

    selectAll?.addEventListener("change", () => {
      rows.forEach((row) => {
        row.checked = selectAll?.checked ?? false;
      });
    });
    rows.forEach((row) => row.addEventListener("change", syncSelectAll));
  </script>
</DashboardV2Layout>
