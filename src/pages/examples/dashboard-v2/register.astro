---
import "../../../styles/global.css";
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Register — CubbyPro" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>註冊 — CubbyPro</title>
		<style>
			body { font-family: 'Onest', system-ui, sans-serif; }
		</style>
	</head>
	<body class="min-h-screen antialiased">
		<div class="grid min-h-screen lg:grid-cols-2">
			<!-- Left: Brand Panel (Dark) -->
			<div class="hidden lg:flex flex-col justify-between bg-[#0F172A] p-10 text-white">
				<div class="flex items-center gap-2.5">
					<div class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
						</svg>
					</div>
					<span class="text-lg font-bold tracking-tight">Cubby<span class="text-indigo-400">Pro</span></span>
				</div>
				<div class="space-y-4 max-w-md">
					<h2 class="text-3xl font-bold leading-tight">開始您的免費試用</h2>
					<p class="text-slate-400 leading-relaxed">
						14 天免費試用，無需信用卡。體驗企業級的數據管理平台，提升您的工作效率。
					</p>
					<ul class="space-y-3 text-sm text-slate-300">
						<li class="flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-400"><path d="M20 6 9 17l-5-5"/></svg>
							無限制的資料儲存空間
						</li>
						<li class="flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-400"><path d="M20 6 9 17l-5-5"/></svg>
							即時協作功能
						</li>
						<li class="flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-400"><path d="M20 6 9 17l-5-5"/></svg>
							進階分析報表
						</li>
						<li class="flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-400"><path d="M20 6 9 17l-5-5"/></svg>
							24/7 客戶支援
						</li>
					</ul>
				</div>
				<p class="text-xs text-slate-500">© 2026 CubbyPro. All rights reserved.</p>
			</div>

			<!-- Right: Register Form -->
			<div class="flex items-center justify-center p-8 bg-gray-50/50">
				<div class="w-full max-w-sm space-y-6">
					<!-- Mobile Logo -->
					<div class="flex items-center gap-2.5 lg:hidden mb-8">
						<div class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
							</svg>
						</div>
						<span class="text-lg font-bold tracking-tight">Cubby<span class="text-indigo-500">Pro</span></span>
					</div>

					<div class="space-y-2">
						<h1 class="text-2xl font-bold tracking-tight">建立帳號</h1>
						<p class="text-sm text-muted-foreground">填寫以下資訊以開始使用</p>
					</div>

					<form class="space-y-4" action="/examples/dashboard-v2">
						<div class="grid grid-cols-2 gap-3">
							<div class="cu-form-group">
								<label class="cu-label" for="first-name">姓</label>
								<input class="cu-input" id="first-name" type="text" placeholder="王" required aria-required="true" />
							</div>
							<div class="cu-form-group">
								<label class="cu-label" for="last-name">名</label>
								<input class="cu-input" id="last-name" type="text" placeholder="小明" required aria-required="true" />
							</div>
						</div>
						<div class="cu-form-group">
							<label class="cu-label" for="email">Email</label>
							<input class="cu-input" id="email" type="email" placeholder="name@company.com" required aria-required="true" />
						</div>
						<div class="cu-form-group">
							<label class="cu-label" for="company">公司名稱</label>
							<input class="cu-input" id="company" type="text" placeholder="您的公司" />
						</div>
						<div class="cu-form-group">
							<label class="cu-label" for="password">密碼</label>
							<input class="cu-input" id="password" type="password" placeholder="至少 8 個字元" required aria-required="true" />
						</div>
						<label class="cu-checkbox-wrapper">
							<input type="checkbox" class="cu-checkbox" required />
							<span class="text-sm">我同意<a href="#" class="cu-link text-indigo-600">服務條款</a>與<a href="#" class="cu-link text-indigo-600">隱私政策</a></span>
						</label>
						<button type="submit" class="cu-button cu-button-md w-full bg-indigo-600 hover:bg-indigo-700 text-white border-0">建立帳號</button>
					</form>

					<div class="relative">
						<div class="absolute inset-0 flex items-center"><div class="cu-separator"></div></div>
						<div class="relative flex justify-center"><span class="bg-gray-50/50 px-3 text-xs text-muted-foreground">或</span></div>
					</div>

					<div class="grid grid-cols-2 gap-3">
						<button type="button" class="cu-button cu-button-outline cu-button-md">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" class="mr-2"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
							Google
						</button>
						<button type="button" class="cu-button cu-button-outline cu-button-md">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="mr-2"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
							GitHub
						</button>
					</div>

					<p class="text-center text-sm text-muted-foreground">
						已經有帳號？
						<a href="/examples/dashboard-v2/login" class="cu-link text-indigo-600 hover:text-indigo-700">立即登入</a>
					</p>
				</div>
			</div>
		</div>
	</body>
</html>
