---
import "../../../styles/global.css";
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Forgot Password — CubbyPro" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>重設密碼 — CubbyPro</title>
		<style>
			body { font-family: 'Onest', system-ui, sans-serif; }
		</style>
	</head>
	<body class="min-h-screen antialiased">
		<div class="grid min-h-screen lg:grid-cols-2">
			<!-- Left: Brand Panel (Dark) -->
			<div class="hidden lg:flex flex-col justify-between bg-[#0F172A] p-10 text-white">
				<div class="flex items-center gap-2.5">
					<div class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
						</svg>
					</div>
					<span class="text-lg font-bold tracking-tight">Cubby<span class="text-indigo-400">Pro</span></span>
				</div>
				<div class="space-y-6">
					<div class="p-6 rounded-2xl bg-gradient-to-br from-indigo-500/20 to-indigo-600/10 border border-indigo-500/20">
						<div class="flex items-center justify-center w-16 h-16 rounded-full bg-indigo-500/20 mb-4">
							<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-400">
								<rect width="20" height="16" x="2" y="4" rx="2"/>
								<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
							</svg>
						</div>
						<h3 class="text-xl font-semibold mb-2">檢查您的信箱</h3>
						<p class="text-slate-400 text-sm leading-relaxed">
							我們將發送一封包含重設密碼連結的郵件到您的信箱。請確認您輸入的是註冊時使用的 Email 地址。
						</p>
					</div>
				</div>
				<p class="text-xs text-slate-500">© 2026 CubbyPro. All rights reserved.</p>
			</div>

			<!-- Right: Forgot Password Form -->
			<div class="flex items-center justify-center p-8 bg-gray-50/50">
				<div class="w-full max-w-sm space-y-6">
					<!-- Mobile Logo -->
					<div class="flex items-center gap-2.5 lg:hidden mb-8">
						<div class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
							</svg>
						</div>
						<span class="text-lg font-bold tracking-tight">Cubby<span class="text-indigo-500">Pro</span></span>
					</div>

					<div class="space-y-2">
						<h1 class="text-2xl font-bold tracking-tight">忘記密碼？</h1>
						<p class="text-sm text-muted-foreground">輸入您的 Email，我們將發送重設密碼的連結</p>
					</div>

					<form class="space-y-4" action="/examples/dashboard-v2/login">
						<div class="cu-form-group">
							<label class="cu-label" for="email">Email</label>
							<input class="cu-input" id="email" type="email" placeholder="name@company.com" required aria-required="true" />
						</div>
						<button type="submit" class="cu-button cu-button-md w-full bg-indigo-600 hover:bg-indigo-700 text-white border-0">發送重設連結</button>
					</form>

					<p class="text-center text-sm text-muted-foreground">
						想起密碼了？
						<a href="/examples/dashboard-v2/login" class="cu-link text-indigo-600 hover:text-indigo-700">返回登入</a>
					</p>
				</div>
			</div>
		</div>
	</body>
</html>
