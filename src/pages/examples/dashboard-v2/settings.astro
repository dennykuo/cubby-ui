---
import DashboardV2Layout from "@/layouts/DashboardV2Layout.astro";
import Button from "@/components/ui/Button.astro";
import Card from "@/components/ui/Card.astro";
import CardHeader from "@/components/ui/CardHeader.astro";
import CardDescription from "@/components/ui/CardDescription.astro";
import CardContent from "@/components/ui/CardContent.astro";
import CardFooter from "@/components/ui/CardFooter.astro";
import Input from "@/components/ui/Input.astro";
import Label from "@/components/ui/Label.astro";
import Avatar from "@/components/ui/Avatar.astro";
import AvatarFallback from "@/components/ui/AvatarFallback.astro";
import Toggle from "@/components/ui/Toggle.astro";
import Tabs from "@/components/ui/Tabs.astro";
import TabsList from "@/components/ui/TabsList.astro";
import TabsTrigger from "@/components/ui/TabsTrigger.astro";
import TabsContent from "@/components/ui/TabsContent.astro";

const bio = "Senior Frontend Developer based in Taipei. Loves building UI components and exploring new tech.";

const notifications = [
  { id: "notify-product", label: "產品更新", description: "收到我們最新的功能發布與改進通知。", checked: true },
  {
    id: "notify-security",
    label: "安全性警示",
    description: "當偵測到異常登入活動時通知我（必要通知，無法關閉）。",
    checked: true,
    disabled: true,
  },
  { id: "notify-weekly", label: "每週週報", description: "每週一收到專案進度與團隊活動摘要。", checked: false },
  { id: "notify-marketing", label: "行銷推廣", description: "收到關於新產品與優惠活動的資訊。", checked: false },
];
---

<DashboardV2Layout title="帳號設定 — CubbyPro">
  <div class="max-w-4xl mx-auto space-y-8">
    <div class="cu-page-header">
      <div class="cu-page-header-content">
        <h1 class="cu-page-header-title text-2xl md:text-2xl">帳號設定</h1>
        <p class="cu-page-header-description">管理您的個人資料、通知偏好與安全設定。</p>
      </div>
    </div>

    <Tabs data-cu-tabs>
      <TabsList class="cu-tabs-list-underline flex w-full overflow-x-auto" aria-label="帳號設定分類">
        <TabsTrigger type="button" data-cu-tabs-trigger="profile" active>
          個人資料
        </TabsTrigger>
        <TabsTrigger type="button" data-cu-tabs-trigger="notifications">
          通知設定
        </TabsTrigger>
        <TabsTrigger type="button" data-cu-tabs-trigger="security">
          登入與安全
        </TabsTrigger>
        <TabsTrigger type="button" data-cu-tabs-trigger="billing">
          訂閱方案
        </TabsTrigger>
      </TabsList>

      <!-- Profile Tab -->
      <TabsContent data-cu-tabs-content="profile" class="mt-6 space-y-6">
        <Card>
          <CardHeader>
            <h2 class="cu-card-title">公開資訊</h2>
            <CardDescription>這些資訊將會顯示在您的公開個人頁面上。</CardDescription>
          </CardHeader>
          <CardContent class="space-y-6">
            <div class="flex items-center gap-6">
              <Avatar class="h-20 w-20">
                <AvatarFallback class="text-2xl bg-primary/10 text-primary">DK</AvatarFallback>
              </Avatar>
              <div class="space-y-2">
                <Button type="button" variant="outline" size="sm">
                  更換頭像
                </Button>
                <p class="text-xs text-muted-foreground">支援 JPG、GIF 或 PNG，最大 1 MB。</p>
              </div>
            </div>

            <div class="grid gap-4 md:grid-cols-2">
              <div class="cu-form-group">
                <Label for="fullName">顯示名稱</Label>
                <Input id="fullName" name="fullName" autocomplete="name" value="Denny Kuo" />
              </div>
              <div class="cu-form-group">
                <Label for="username">使用者名稱</Label>
                <Input id="username" name="username" autocomplete="username" value="dennykuo" />
              </div>
            </div>

            <div class="cu-form-group">
              <Label for="bio">個人簡介</Label>
              <textarea
                id="bio"
                name="bio"
                placeholder="寫一些關於您自己的介紹..."
                class="cu-textarea min-h-[100px]"
                aria-describedby="bio-hint"
                set:text={bio}
              />
              <p id="bio-hint" class="cu-form-description">
                簡短的介紹您自己，支援 Markdown 語法。
              </p>
            </div>

            <div class="cu-form-group">
              <Label for="website">個人網站 / Blog</Label>
              <div class="cu-input-group">
                <span class="cu-input-group-text" aria-hidden="true">
                  https://
                </span>
                <Input id="website" name="website" inputmode="url" value="denny.io" />
              </div>
            </div>
          </CardContent>
          <CardFooter class="justify-end border-t border-border bg-muted/30 px-6 py-4">
            <Button type="button">儲存變更</Button>
          </CardFooter>
        </Card>
      </TabsContent>

      <!-- Notifications Tab -->
      <TabsContent data-cu-tabs-content="notifications" class="mt-6 space-y-6" hidden>
        <Card>
          <CardHeader>
            <h2 class="cu-card-title">Email 通知</h2>
            <CardDescription>選擇您希望收到哪些類型的 Email 通知。</CardDescription>
          </CardHeader>
          <div class="divide-y divide-border border-t border-border">
            {notifications.map((item) => (
              <div class="cu-setting-item">
                <div class="cu-setting-item-content">
                  <label for={item.id} class="cu-setting-item-label block">
                    {item.label}
                  </label>
                  <p id={`${item.id}-desc`} class="cu-setting-item-description">
                    {item.description}
                  </p>
                </div>
                <div class="cu-setting-item-action">
                  <Toggle
                    id={item.id}
                    checked={item.checked}
                    disabled={item.disabled}
                    aria-describedby={`${item.id}-desc`}
                  />
                </div>
              </div>
            ))}
          </div>
          <CardFooter class="justify-end gap-2 border-t border-border bg-muted/30 px-6 py-4">
            <Button type="button" variant="outline">
              取消
            </Button>
            <Button type="button">更新偏好設定</Button>
          </CardFooter>
        </Card>
      </TabsContent>

      <!-- Security Tab -->
      <TabsContent data-cu-tabs-content="security" class="mt-6 space-y-6" hidden>
        <Card>
          <CardHeader>
            <h2 class="cu-card-title">修改密碼</h2>
            <CardDescription>為了您的帳號安全，建議定期更換密碼。</CardDescription>
          </CardHeader>
          <CardContent class="space-y-4">
            <div class="cu-form-group">
              <Label for="current_password">目前密碼</Label>
              <Input id="current_password" name="current_password" type="password" autocomplete="current-password" />
            </div>
            <div class="cu-form-group">
              <Label for="new_password">新密碼</Label>
              <Input
                id="new_password"
                name="new_password"
                type="password"
                autocomplete="new-password"
                aria-describedby="new_password_hint"
              />
              <p id="new_password_hint" class="cu-form-description">
                至少 8 個字元，建議混合英文字母與數字。
              </p>
            </div>
            <div class="cu-form-group">
              <Label for="confirm_password">確認新密碼</Label>
              <Input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" />
            </div>
          </CardContent>
          <CardFooter class="justify-end border-t border-border bg-muted/30 px-6 py-4">
            <Button type="button">更新密碼</Button>
          </CardFooter>
        </Card>

        <Card class="border-destructive/30">
          <CardHeader>
            <h2 class="cu-card-title text-destructive">危險區域</h2>
            <CardDescription>這些操作無法復原，請謹慎使用。</CardDescription>
          </CardHeader>
          <CardContent>
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="text-sm font-medium">刪除帳號</p>
                <p class="text-sm text-muted-foreground">永久刪除您的帳號及所有相關資料。</p>
              </div>
              <Button type="button" variant="destructive" data-cu-alert-dialog-trigger="delete-account-dialog">
                刪除帳號
              </Button>
            </div>
          </CardContent>
        </Card>
      </TabsContent>

      <!-- Billing Tab -->
      <TabsContent data-cu-tabs-content="billing" class="mt-6 space-y-6" hidden>
        <Card>
          <CardHeader>
            <h2 class="cu-card-title">訂閱方案</h2>
            <CardDescription>管理您的方案與付款方式。</CardDescription>
          </CardHeader>
          <CardContent>
            <div class="flex flex-col gap-4 rounded-lg border border-border bg-muted/30 p-4 sm:flex-row sm:items-center sm:justify-between">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <p class="text-sm font-medium">免費方案</p>
                  <span class="cu-badge cu-badge-soft-secondary">目前方案</span>
                </div>
                <p class="text-sm text-muted-foreground">目前使用免費方案。</p>
              </div>
              <Button type="button" variant="outline" size="sm">
                查看方案
              </Button>
            </div>
          </CardContent>
        </Card>
      </TabsContent>
    </Tabs>
  </div>

  <!-- Delete Account Confirmation（cubby-ui.js 由 layout 載入） -->
  <dialog id="delete-account-dialog" class="cu-alert-dialog cu-alert-dialog-sm" data-cu-alert-dialog>
    <div class="cu-alert-dialog-header">
      <h2 class="cu-alert-dialog-title">確定要刪除帳號嗎？</h2>
      <p class="cu-alert-dialog-description">此操作無法復原，您的帳號及所有相關資料將會被永久刪除。</p>
    </div>
    <div class="cu-alert-dialog-footer">
      <button type="button" class="cu-button cu-button-outline cu-button-md" data-cu-alert-dialog-cancel autofocus>
        取消
      </button>
      <button type="button" class="cu-button cu-button-destructive cu-button-md" data-cu-alert-dialog-action>
        確認刪除
      </button>
    </div>
  </dialog>
</DashboardV2Layout>
