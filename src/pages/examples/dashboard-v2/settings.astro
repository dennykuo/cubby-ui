---
import DashboardV2Layout from "../../../layouts/DashboardV2Layout.astro";
import Button from "../../../components/ui/Button.astro";
import Card from "../../../components/ui/Card.astro";
import CardHeader from "../../../components/ui/CardHeader.astro";
import CardTitle from "../../../components/ui/CardTitle.astro";
import CardDescription from "../../../components/ui/CardDescription.astro";
import CardContent from "../../../components/ui/CardContent.astro";
import CardFooter from "../../../components/ui/CardFooter.astro";
import Input from "../../../components/ui/Input.astro";
import Label from "../../../components/ui/Label.astro";
import Textarea from "../../../components/ui/Textarea.astro";
import Avatar from "../../../components/ui/Avatar.astro";
import AvatarFallback from "../../../components/ui/AvatarFallback.astro";
import Separator from "../../../components/ui/Separator.astro";
import Toggle from "../../../components/ui/Toggle.astro";
import Tabs from "../../../components/ui/Tabs.astro";
import TabsList from "../../../components/ui/TabsList.astro";
import TabsTrigger from "../../../components/ui/TabsTrigger.astro";
import TabsContent from "../../../components/ui/TabsContent.astro";
---

<DashboardV2Layout title="帳號設定 — CubbyPro">
    <div class="max-w-4xl mx-auto space-y-8">
        <div>
            <h1 class="text-2xl font-bold tracking-tight">帳號設定</h1>
            <p class="text-muted-foreground mt-1">
                管理您的個人資料、通知偏好與安全設定。
            </p>
        </div>

        <Tabs defaultValue="profile" class="space-y-6">
            <TabsList
                class="bg-transparent border-b w-full justify-start rounded-none h-auto p-0 space-x-6"
            >
                <TabsTrigger
                    value="profile"
                    class="rounded-none border-b-2 border-transparent data-[state=active]:border-indigo-600 data-[state=active]:bg-transparent px-0 py-2"
                    >個人資料</TabsTrigger
                >
                <TabsTrigger
                    value="notifications"
                    class="rounded-none border-b-2 border-transparent data-[state=active]:border-indigo-600 data-[state=active]:bg-transparent px-0 py-2"
                    >通知設定</TabsTrigger
                >
                <TabsTrigger
                    value="security"
                    class="rounded-none border-b-2 border-transparent data-[state=active]:border-indigo-600 data-[state=active]:bg-transparent px-0 py-2"
                    >登入與安全</TabsTrigger
                >
                <TabsTrigger
                    value="billing"
                    class="rounded-none border-b-2 border-transparent data-[state=active]:border-indigo-600 data-[state=active]:bg-transparent px-0 py-2"
                    >訂閱方案</TabsTrigger
                >
            </TabsList>

            <!-- Profile Tab -->
            <TabsContent value="profile" class="space-y-6">
                <Card class="bg-white border shadow-sm rounded-xl">
                    <CardHeader>
                        <CardTitle>公開資訊</CardTitle>
                        <CardDescription
                            >這些資訊將會顯示在您的公開個人頁面上。</CardDescription
                        >
                    </CardHeader>
                    <CardContent class="space-y-6">
                        <div class="flex items-center gap-6">
                            <Avatar class="h-24 w-24">
                                <AvatarFallback
                                    class="text-2xl bg-indigo-100 text-indigo-600"
                                    >DK</AvatarFallback
                                >
                            </Avatar>
                            <div class="space-y-2">
                                <Button variant="outline" size="sm"
                                    >更換頭像</Button
                                >
                                <p class="text-xs text-muted-foreground">
                                    支援 JPG, GIF 或 PNG。最大 1MB。
                                </p>
                            </div>
                        </div>

                        <div class="grid gap-4 md:grid-cols-2">
                            <div class="space-y-2">
                                <Label htmlFor="fullName">顯示名稱</Label>
                                <Input id="fullName" defaultValue="Denny Kuo" />
                            </div>
                            <div class="space-y-2">
                                <Label htmlFor="username">使用者名稱</Label>
                                <Input id="username" defaultValue="dennykuo" />
                            </div>
                        </div>

                        <div class="space-y-2">
                            <Label htmlFor="bio">個人簡介</Label>
                            <Textarea
                                id="bio"
                                placeholder="寫一些關於您自己的介紹..."
                                class="min-h-[100px]"
                                >Senior Frontend Developer based in Taipei.
                                Loves building UI components and exploring new
                                tech.</Textarea
                            >
                            <p class="text-[13px] text-muted-foreground">
                                簡短的介紹您自己。支援 Markdown 語法。
                            </p>
                        </div>

                        <div class="space-y-2">
                            <Label htmlFor="website">個人網站 / Blog</Label>
                            <div class="relative">
                                <span
                                    class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground text-sm"
                                    >https://</span
                                >
                                <Input
                                    id="website"
                                    className="pl-16"
                                    defaultValue="denny.io"
                                />
                            </div>
                        </div>
                    </CardContent>
                    <CardFooter
                        class="border-t bg-slate-50/50 px-6 py-4 flex justify-end"
                    >
                        <Button>儲存變更</Button>
                    </CardFooter>
                </Card>
            </TabsContent>

            <!-- Notifications Tab -->
            <TabsContent value="notifications" class="space-y-6">
                <Card class="bg-white border shadow-sm rounded-xl">
                    <CardHeader>
                        <CardTitle>Email 通知</CardTitle>
                        <CardDescription
                            >選擇您希望收到哪些類型的 Email 通知。</CardDescription
                        >
                    </CardHeader>
                    <CardContent class="space-y-6 divide-y">
                        <div
                            class="flex items-center justify-between pt-0 pb-4"
                        >
                            <div class="space-y-0.5">
                                <Label class="text-base">產品更新</Label>
                                <p class="text-sm text-muted-foreground">
                                    收到我們最新的功能發布與改進通知。
                                </p>
                            </div>
                            <Toggle defaultChecked />
                        </div>
                        <div class="flex items-center justify-between py-4">
                            <div class="space-y-0.5">
                                <Label class="text-base">安全性警示</Label>
                                <p class="text-sm text-muted-foreground">
                                    當偵測到異常登入活動時通知我。
                                </p>
                            </div>
                            <Toggle defaultChecked disabled />
                        </div>
                        <div class="flex items-center justify-between py-4">
                            <div class="space-y-0.5">
                                <Label class="text-base">每週週報</Label>
                                <p class="text-sm text-muted-foreground">
                                    每週一收到專案進度與團隊活動摘要。
                                </p>
                            </div>
                            <Toggle />
                        </div>
                        <div class="flex items-center justify-between py-4">
                            <div class="space-y-0.5">
                                <Label class="text-base">行銷推廣</Label>
                                <p class="text-sm text-muted-foreground">
                                    收到關於新產品與優惠活動的資訊。
                                </p>
                            </div>
                            <Toggle />
                        </div>
                    </CardContent>
                    <CardFooter
                        class="border-t bg-slate-50/50 px-6 py-4 flex justify-end"
                    >
                        <Button variant="outline" class="mr-2">取消</Button>
                        <Button>更新偏好設定</Button>
                    </CardFooter>
                </Card>
            </TabsContent>

            <!-- Security Tab -->
            <TabsContent value="security" class="space-y-6">
                <Card class="bg-white border shadow-sm rounded-xl">
                    <CardHeader>
                        <CardTitle>修改密碼</CardTitle>
                        <CardDescription
                            >為了您的帳號安全，建議定期更換密碼。</CardDescription
                        >
                    </CardHeader>
                    <CardContent class="space-y-4">
                        <div class="space-y-2">
                            <Label htmlFor="current_password">目前密碼</Label>
                            <Input id="current_password" type="password" />
                        </div>
                        <div class="space-y-2">
                            <Label htmlFor="new_password">新密碼</Label>
                            <Input id="new_password" type="password" />
                        </div>
                        <div class="space-y-2">
                            <Label htmlFor="confirm_password">確認新密碼</Label>
                            <Input id="confirm_password" type="password" />
                        </div>
                    </CardContent>
                    <CardFooter
                        class="border-t bg-slate-50/50 px-6 py-4 flex justify-end"
                    >
                        <Button>更新密碼</Button>
                    </CardFooter>
                </Card>

                <Card
                    class="bg-white border-rose-200 border shadow-sm rounded-xl"
                >
                    <CardHeader>
                        <CardTitle class="text-rose-600">危險區域</CardTitle>
                        <CardDescription
                            >這些操作無法復原，請謹慎使用。</CardDescription
                        >
                    </CardHeader>
                    <CardContent>
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="font-medium">刪除帳號</p>
                                <p class="text-sm text-muted-foreground">
                                    永久刪除您的帳號及所有相關資料。
                                </p>
                            </div>
                            <Button variant="destructive">刪除帳號</Button>
                        </div>
                    </CardContent>
                </Card>
            </TabsContent>
        </Tabs>
    </div>
</DashboardV2Layout>
