---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
---

<Layout title="Cubby UI — Elegant Tailwind CSS Components">
    <div class="space-y-3">
        <h1 class="text-3xl font-bold tracking-tight">
            Introduction
        </h1>
        <p class="text-base text-muted-foreground leading-relaxed">
            Beautifully designed components built with pure HTML and Tailwind
            CSS. No framework required.
        </p>
        <p class="text-base text-muted-foreground leading-relaxed">
            This is NOT a component library. It's a collection of re-usable
            components that you can copy and paste into your apps.
        </p>
    </div>

    <div class="mt-8">
        <div class="flex gap-3">
            <a href="/components/button">
                <Button>Browse Components</Button>
            </a>
            <a href="https://github.com" target="_blank" rel="noreferrer">
                <Button variant="outline">GitHub</Button>
            </a>
        </div>
    </div>
</Layout>
