---
import Layout from "@/layouts/Layout.astro";
import Blockquote from "@/components/ui/Blockquote.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { blockquotePage } from "@/i18n/pages/components/blockquote";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(blockquotePage, locale);

const usageCode = `<blockquote class="cu-blockquote">
  "After all," he said, "everyone enjoys a good joke, so it's only fair that
  they should pay for the privilege."
</blockquote>`.trim();

const withCitationCode = `<figure>
  <blockquote class="cu-blockquote">
    "The only way to do great work is to love what you do."
  </blockquote>
  <figcaption class="mt-2 pl-6 text-sm text-muted-foreground">
    — Steve Jobs
  </figcaption>
</figure>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Blockquote">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Blockquote</h1>
          <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
              <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-lg">
                    <Blockquote>
                        "After all," he said, "everyone enjoys a good joke, so it's only fair that
                        they should pay for the privilege."
                    </Blockquote>
                </div>
            </ComponentPreview>
        </section>

    <!-- Classes Reference -->
    <section class="space-y-3">
      <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
        <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        {t.sections.classes.title}
      </h2>
      <div class="cu-table-wrapper rounded-lg border border-border">
        <table class="cu-table">
          <thead class="cu-table-header">
            <tr class="cu-table-row">
              <th class="cu-table-head">{t.sections.classes.classLabel}</th>
              <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
            </tr>
          </thead>
          <tbody class="cu-table-body">
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-blockquote</code></td>
              <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-blockquote']}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>


        <!-- With Citation -->
        <section class="space-y-3">
            <h2 id="with-citation" class="text-lg font-semibold tracking-tight relative group">
              <a href="#with-citation" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.withCitation.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withCitation.description} />
            <ComponentPreview code={withCitationCode}>
                <div class="w-full max-w-lg">
                    <figure>
                        <Blockquote>
                            "The only way to do great work is to love what you do."
                        </Blockquote>
                        <figcaption class="mt-2 pl-6 text-sm text-muted-foreground">
                            — Steve Jobs
                        </figcaption>
                    </figure>
                </div>
            </ComponentPreview>
        </section>
    </div>

</Layout>
