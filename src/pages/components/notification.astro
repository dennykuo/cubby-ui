---
import Layout from "@/layouts/Layout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { notificationPage } from "@/i18n/pages/components/notification";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(notificationPage, locale);

const bellSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>`;
const closeSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>`;
const checkSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>`;
const warnSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>`;
const infoSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>`;
const xCircleSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>`;

const usageCode = `<div class="cu-notification">
  <div class="cu-notification-icon">${bellSvg}</div>
  <div class="cu-notification-content">
    <p class="cu-notification-title">New Message</p>
    <p class="cu-notification-description">You have a new message from Alex.</p>
    <p class="cu-notification-time">2 minutes ago</p>
  </div>
  <button class="cu-notification-close">${closeSvg}</button>
</div>`.trim();

const unreadCode = `<div class="cu-notification cu-notification-unread">
  <div class="cu-notification-icon">${bellSvg}</div>
  <div class="cu-notification-content">
    <p class="cu-notification-title">Deployment Complete</p>
    <p class="cu-notification-description">Your app has been successfully deployed to production.</p>
    <p class="cu-notification-time">5 minutes ago</p>
  </div>
  <button class="cu-notification-close">${closeSvg}</button>
</div>`.trim();

const variantsCode = `<!-- Info -->
<div class="cu-notification cu-notification-info">
  <div class="cu-notification-icon">${infoSvg}</div>
  <div class="cu-notification-content">
    <p class="cu-notification-title">System Update</p>
    <p class="cu-notification-description">A new version is available for download.</p>
    <p class="cu-notification-time">10 minutes ago</p>
  </div>
</div>

<!-- Success -->
<div class="cu-notification cu-notification-success">
  <div class="cu-notification-icon">${checkSvg}</div>
  <div class="cu-notification-content">
    <p class="cu-notification-title">Payment Received</p>
    <p class="cu-notification-description">Your payment of $49.99 has been processed.</p>
    <p class="cu-notification-time">1 hour ago</p>
  </div>
</div>

<!-- Warning -->
<div class="cu-notification cu-notification-warning">
  <div class="cu-notification-icon">${warnSvg}</div>
  <div class="cu-notification-content">
    <p class="cu-notification-title">Storage Almost Full</p>
    <p class="cu-notification-description">You've used 90% of your storage quota.</p>
    <p class="cu-notification-time">3 hours ago</p>
  </div>
</div>

<!-- Destructive -->
<div class="cu-notification cu-notification-destructive">
  <div class="cu-notification-icon">${xCircleSvg}</div>
  <div class="cu-notification-content">
    <p class="cu-notification-title">Build Failed</p>
    <p class="cu-notification-description">The CI pipeline failed at the test stage.</p>
    <p class="cu-notification-time">30 minutes ago</p>
  </div>
</div>`.trim();

const withActionsCode = `<div class="cu-notification cu-notification-unread">
  <div class="cu-notification-icon">${bellSvg}</div>
  <div class="cu-notification-content">
    <p class="cu-notification-title">Friend Request</p>
    <p class="cu-notification-description">Sarah would like to connect with you.</p>
    <p class="cu-notification-time">Just now</p>
    <div class="cu-notification-actions">
      <button class="cu-button cu-button-sm">Accept</button>
      <button class="cu-button cu-button-outline cu-button-sm">Decline</button>
    </div>
  </div>
</div>`.trim();

const listCode = `<div class="cu-notification-list">
  <div class="cu-notification cu-notification-unread">
    <div class="cu-notification-icon">${bellSvg}</div>
    <div class="cu-notification-content">
      <p class="cu-notification-title">New Comment</p>
      <p class="cu-notification-description">Mike commented on your post.</p>
      <p class="cu-notification-time">2 minutes ago</p>
    </div>
    <button class="cu-notification-close">${closeSvg}</button>
  </div>
  <div class="cu-notification cu-notification-unread">
    <div class="cu-notification-icon">${checkSvg}</div>
    <div class="cu-notification-content">
      <p class="cu-notification-title">Task Completed</p>
      <p class="cu-notification-description">Design review has been approved.</p>
      <p class="cu-notification-time">1 hour ago</p>
    </div>
    <button class="cu-notification-close">${closeSvg}</button>
  </div>
  <div class="cu-notification">
    <div class="cu-notification-icon">${infoSvg}</div>
    <div class="cu-notification-content">
      <p class="cu-notification-title">Reminder</p>
      <p class="cu-notification-description">Team standup in 15 minutes.</p>
      <p class="cu-notification-time">Yesterday</p>
    </div>
    <button class="cu-notification-close">${closeSvg}</button>
  </div>
</div>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Notification">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Notification</h1>
            <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <section class="space-y-3">
            <SectionHeading id="usage" title={t.sections.usage.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="classes" title={t.sections.classes.title} />
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        {Object.entries(t.classDescriptions).map(([cls, desc]) => (
                            <tr class="cu-table-row">
                                <td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
                                <td class="cu-table-cell text-muted-foreground">{desc}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>

        <section class="space-y-3">
            <SectionHeading id="unread" title={t.sections.unread.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.unread.description} />
            <ComponentPreview code={unreadCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="variants" title={t.sections.variants.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.variants.description} />
            <ComponentPreview code={variantsCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="with-actions" title={t.sections.withActions.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withActions.description} />
            <ComponentPreview code={withActionsCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="list" title={t.sections.list.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.list.description} />
            <ComponentPreview code={listCode} />
        </section>
    </div>
</Layout>
