---
import Layout from "@/layouts/Layout.astro";
import HoverCard from "@/components/ui/HoverCard.astro";
import HoverCardContent from "@/components/ui/HoverCardContent.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { hoverCardPage } from "@/i18n/pages/components/hover-card";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(hoverCardPage, locale);

const usageCode = `<div class="cu-hover-card">
  <a href="#" class="text-sm font-medium underline underline-offset-4">@nextjs</a>
  <div class="cu-hover-card-content">
    <div class="flex gap-4">
      <div class="cu-avatar cu-avatar-sm">
        <div class="cu-avatar-fallback">N</div>
      </div>
      <div class="space-y-1">
        <h4 class="text-sm font-semibold">@nextjs</h4>
        <p class="text-sm text-muted-foreground">The React Framework – created and maintained by @vercel.</p>
        <div class="flex items-center gap-2 pt-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          <span class="text-xs text-muted-foreground">Joined December 2021</span>
        </div>
      </div>
    </div>
  </div>
</div>`.trim();

const simpleCode = `<div class="cu-hover-card">
  <a href="#" class="cu-link">Terms of Service</a>
  <div class="cu-hover-card-content">
    <p class="text-sm text-muted-foreground">By using our service, you agree to our terms. We collect minimal data and respect your privacy.</p>
  </div>
</div>`.trim();

const topCode = `<div class="cu-hover-card">
  <a href="#" class="text-sm font-medium underline underline-offset-4">@cubby-ui</a>
  <div class="cu-hover-card-content cu-hover-card-content-top">
    <div class="space-y-1">
      <h4 class="text-sm font-semibold">@cubby-ui</h4>
      <p class="text-sm text-muted-foreground">A framework-agnostic UI component library built with pure HTML and Tailwind CSS.</p>
    </div>
  </div>
</div>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Hover Card">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Hover Card</h1>
            <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            {t.description}
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <HoverCard>
                    <a href="#" class="text-sm font-medium underline underline-offset-4">@nextjs</a>
                    <HoverCardContent>
                        <div class="flex gap-4">
                            <div class="cu-avatar cu-avatar-sm">
                                <div class="cu-avatar-fallback">N</div>
                            </div>
                            <div class="space-y-1">
                                <h4 class="text-sm font-semibold">@nextjs</h4>
                                <p class="text-sm text-muted-foreground">The React Framework – created and maintained by @vercel.</p>
                                <div class="flex items-center gap-2 pt-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                                    <span class="text-xs text-muted-foreground">Joined December 2021</span>
                                </div>
                            </div>
                        </div>
                    </HoverCardContent>
                </HoverCard>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.classes.title}
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-hover-card</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-hover-card']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-hover-card-content</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-hover-card-content']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-hover-card-content-top</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-hover-card-content-top']}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>


        <!-- Top Position -->
        <section class="space-y-3">
            <h2 id="top-position" class="text-lg font-semibold tracking-tight relative group">
                <a href="#top-position" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.topPosition.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.topPosition.description} />
            <ComponentPreview code={topCode}>
                <HoverCard>
                    <a href="#" class="text-sm font-medium underline underline-offset-4">@cubby-ui</a>
                    <HoverCardContent class="cu-hover-card-content-top">
                        <div class="space-y-1">
                            <h4 class="text-sm font-semibold">@cubby-ui</h4>
                            <p class="text-sm text-muted-foreground">A framework-agnostic UI component library built with pure HTML and Tailwind CSS.</p>
                        </div>
                    </HoverCardContent>
                </HoverCard>
            </ComponentPreview>
        </section>

        <!-- Simple -->
        <section class="space-y-3">
            <h2 id="simple" class="text-lg font-semibold tracking-tight relative group">
                <a href="#simple" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.simple.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                {t.sections.simple.description}
            </p>
            <ComponentPreview code={simpleCode}>
                <div class="cu-hover-card">
                    <a href="#" class="cu-link">Terms of Service</a>
                    <div class="cu-hover-card-content">
                        <p class="text-sm text-muted-foreground">By using our service, you agree to our terms. We collect minimal data and respect your privacy.</p>
                    </div>
                </div>
            </ComponentPreview>
        </section>

    </div>
</Layout>
