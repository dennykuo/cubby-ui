---
import Layout from "@/layouts/Layout.astro";
import PasswordInput from "@/components/ui/PasswordInput.astro";
import Label from "@/components/ui/Label.astro";
import FormGroup from "@/components/ui/FormGroup.astro";
import FormDescription from "@/components/ui/FormDescription.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { passwordInputPage } from "@/i18n/pages/components/password-input";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(passwordInputPage, locale);

const usageCode = `<div class="cu-password-input" data-cu-password-input>
  <input class="cu-password-input-field" type="password" placeholder="Enter password..." />
  <button type="button" class="cu-password-input-toggle" data-cu-password-toggle aria-label="Toggle password visibility">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-cu-password-icon-show>
      <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
      <circle cx="12" cy="12" r="3"></circle>
    </svg>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-cu-password-icon-hide style="display:none">
      <path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path>
      <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path>
      <path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path>
      <path d="m2 2 20 20"></path>
    </svg>
  </button>
</div>`.trim();

const withLabelCode = `<div class="cu-form-group">
  <label class="cu-label" for="password">Password</label>
  <div class="cu-password-input" data-cu-password-input>
    <input class="cu-password-input-field" type="password" id="password" placeholder="••••••••" />
    <button type="button" class="cu-password-input-toggle" data-cu-password-toggle aria-label="Toggle password visibility">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-cu-password-icon-show>
        <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-cu-password-icon-hide style="display:none">
        <path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path>
        <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path>
        <path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path>
        <path d="m2 2 20 20"></path>
      </svg>
    </button>
  </div>
  <p class="cu-form-description">Must be at least 8 characters.</p>
</div>`.trim();

const disabledCode = `<div class="cu-password-input" data-cu-password-input>
  <input class="cu-password-input-field" type="password" placeholder="••••••••" disabled />
  <button type="button" class="cu-password-input-toggle" data-cu-password-toggle aria-label="Toggle password visibility" disabled>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-cu-password-icon-show>
      <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
      <circle cx="12" cy="12" r="3"></circle>
    </svg>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-cu-password-icon-hide style="display:none">
      <path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path>
      <path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path>
      <path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path>
      <path d="m2 2 20 20"></path>
    </svg>
  </button>
</div>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Password Input">
  <div class="space-y-3">
    <div class="flex items-center gap-3">
      <h1 class="text-3xl font-bold tracking-tight">Password Input</h1>
      <span class="cu-badge cu-badge-secondary">{t.category}</span>
    </div>
    <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
  </div>

  <div class="mt-10 space-y-10">
    <!-- Usage -->
    <section class="space-y-3">
      <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
        <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        {t.sections.usage.title}
      </h2>
      <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
      <ComponentPreview code={usageCode}>
        <div class="w-full max-w-sm">
          <PasswordInput placeholder="Enter password..." />
        </div>
      </ComponentPreview>
    </section>

    <!-- With Label -->
    <section class="space-y-3">
      <h2 id="with-label" class="text-lg font-semibold tracking-tight relative group">
        <a href="#with-label" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        {t.sections.withLabel.title}
      </h2>
      <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withLabel.description} />
      <ComponentPreview code={withLabelCode}>
        <div class="w-full max-w-sm">
          <FormGroup>
            <Label for="password">Password</Label>
            <PasswordInput id="password" placeholder="••••••••" />
            <FormDescription>Must be at least 8 characters.</FormDescription>
          </FormGroup>
        </div>
      </ComponentPreview>
    </section>

    <!-- Disabled -->
    <section class="space-y-3">
      <h2 id="disabled" class="text-lg font-semibold tracking-tight relative group">
        <a href="#disabled" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        {t.sections.disabled.title}
      </h2>
      <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.disabled.description} />
      <ComponentPreview code={disabledCode}>
        <div class="w-full max-w-sm">
          <PasswordInput placeholder="••••••••" disabled />
        </div>
      </ComponentPreview>
    </section>

    <!-- Classes Reference -->
    <section class="space-y-3">
      <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
        <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        {t.sections.classes.title}
      </h2>
      <div class="cu-table-wrapper rounded-lg border border-border">
        <table class="cu-table">
          <thead class="cu-table-header">
            <tr class="cu-table-row">
              <th class="cu-table-head">{t.sections.classes.classLabel}</th>
              <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
            </tr>
          </thead>
          <tbody class="cu-table-body">
            {Object.entries(t.classDescriptions).map(([cls, desc]) => (
              <tr class="cu-table-row">
                <td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
                <td class="cu-table-cell text-muted-foreground">{desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Layout>
