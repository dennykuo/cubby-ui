---
import Layout from "@/layouts/Layout.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { chatTypingPage } from "@/i18n/pages/components/chat-typing";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(chatTypingPage, locale);

const usageCode = `<div class="cu-chat-typing">
  <span class="cu-chat-typing-dot"></span>
  <span class="cu-chat-typing-dot"></span>
  <span class="cu-chat-typing-dot"></span>
</div>`.trim();

const withAvatarCode = `<div class="cu-chat-bubble cu-chat-bubble-assistant">
  <div class="cu-chat-bubble-avatar">
    <img src="https://api.dicebear.com/9.x/bottts/svg?seed=cubby" alt="AI" />
  </div>
  <div class="cu-chat-bubble-content">
    <span class="cu-chat-bubble-name">Cubby AI</span>
    <div class="cu-chat-typing">
      <span class="cu-chat-typing-dot"></span>
      <span class="cu-chat-typing-dot"></span>
      <span class="cu-chat-typing-dot"></span>
    </div>
  </div>
</div>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Chat Typing">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Chat Typing</h1>
            <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            {t.description}
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-lg">
                    <div class="cu-chat-typing">
                        <span class="cu-chat-typing-dot"></span>
                        <span class="cu-chat-typing-dot"></span>
                        <span class="cu-chat-typing-dot"></span>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.classes.title}
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        {Object.entries(t.classDescriptions).map(([cls, desc]) => (
                            <tr class="cu-table-row">
                                <td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
                                <td class="cu-table-cell text-muted-foreground">{desc}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>

        <!-- With Avatar -->
        <section class="space-y-3">
            <h2 id="with-avatar" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-avatar" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.withAvatar.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withAvatar.description} />
            <ComponentPreview code={withAvatarCode}>
                <div class="w-full max-w-lg">
                    <div class="cu-chat-bubble cu-chat-bubble-assistant">
                        <div class="cu-chat-bubble-avatar">
                            <img src="https://api.dicebear.com/9.x/bottts/svg?seed=cubby" alt="AI" />
                        </div>
                        <div class="cu-chat-bubble-content">
                            <span class="cu-chat-bubble-name">Cubby AI</span>
                            <div class="cu-chat-typing">
                                <span class="cu-chat-typing-dot"></span>
                                <span class="cu-chat-typing-dot"></span>
                                <span class="cu-chat-typing-dot"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>
