---
import Layout from "@/layouts/Layout.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { settingItemPage } from "@/i18n/pages/components/setting-item";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(settingItemPage, locale);

const usageCode = `<div class="cu-card">
  <div class="cu-card-content-flush">
    <div class="divide-y divide-border">
      <div class="cu-setting-item">
        <div class="cu-setting-item-content">
          <p class="cu-setting-item-label">Email notifications</p>
          <p class="cu-setting-item-description">Receive email about your account activity.</p>
        </div>
        <div class="cu-setting-item-action">
          <label class="cu-toggle-wrapper">
            <input type="checkbox" class="peer sr-only" checked />
            <span class="cu-toggle"></span>
          </label>
        </div>
      </div>
      <div class="cu-setting-item">
        <div class="cu-setting-item-content">
          <p class="cu-setting-item-label">Push notifications</p>
          <p class="cu-setting-item-description">Receive push notifications on your device.</p>
        </div>
        <div class="cu-setting-item-action">
          <label class="cu-toggle-wrapper">
            <input type="checkbox" class="peer sr-only" checked />
            <span class="cu-toggle"></span>
          </label>
        </div>
      </div>
      <div class="cu-setting-item">
        <div class="cu-setting-item-content">
          <p class="cu-setting-item-label">Weekly digest</p>
          <p class="cu-setting-item-description">Get a weekly summary of your activity.</p>
        </div>
        <div class="cu-setting-item-action">
          <label class="cu-toggle-wrapper">
            <input type="checkbox" class="peer sr-only" />
            <span class="cu-toggle"></span>
          </label>
        </div>
      </div>
    </div>
  </div>
</div>`.trim();

const withButtonCode = `<div class="cu-card">
  <div class="cu-card-content-flush">
    <div class="divide-y divide-border">
      <div class="cu-setting-item">
        <div class="cu-setting-item-content">
          <p class="cu-setting-item-label">Two-factor authentication</p>
          <p class="cu-setting-item-description">Add an extra layer of security to your account.</p>
        </div>
        <div class="cu-setting-item-action">
          <button class="cu-button cu-button-outline cu-button-sm">Enable</button>
        </div>
      </div>
      <div class="cu-setting-item">
        <div class="cu-setting-item-content">
          <p class="cu-setting-item-label">Connected accounts</p>
          <p class="cu-setting-item-description">Manage your linked social accounts.</p>
        </div>
        <div class="cu-setting-item-action">
          <button class="cu-button cu-button-outline cu-button-sm">Manage</button>
        </div>
      </div>
    </div>
  </div>
</div>`.trim();

const withToggleCode = `<div class="cu-card w-full max-w-lg">
  <div class="cu-setting-item">
    <div class="cu-setting-item-content">
      <p class="cu-setting-item-label">Push Notifications</p>
      <p class="cu-setting-item-description">Receive push notifications on your device.</p>
    </div>
    <div class="cu-setting-item-action">
      <label class="cu-toggle-wrapper">
        <input type="checkbox" class="peer sr-only" checked />
        <span class="cu-toggle"></span>
      </label>
    </div>
  </div>
</div>`.trim();

const groupedCode = `<div class="cu-card w-full max-w-lg">
  <div class="cu-card-header">
    <h3 class="cu-card-title">Notifications</h3>
    <p class="cu-card-description">Manage how you receive notifications.</p>
  </div>
  <div class="cu-card-content-flush">
    <div class="cu-setting-item">
      <div class="cu-setting-item-content">
        <p class="cu-setting-item-label">Email Notifications</p>
        <p class="cu-setting-item-description">Receive email about account activity.</p>
      </div>
      <div class="cu-setting-item-action">
        <label class="cu-toggle-wrapper">
          <input type="checkbox" class="peer sr-only" checked />
          <span class="cu-toggle"></span>
        </label>
      </div>
    </div>
    <div class="cu-separator cu-separator-horizontal"></div>
    <div class="cu-setting-item">
      <div class="cu-setting-item-content">
        <p class="cu-setting-item-label">Marketing Emails</p>
        <p class="cu-setting-item-description">Receive emails about new products and features.</p>
      </div>
      <div class="cu-setting-item-action">
        <label class="cu-toggle-wrapper">
          <input type="checkbox" class="peer sr-only" />
          <span class="cu-toggle"></span>
        </label>
      </div>
    </div>
    <div class="cu-separator cu-separator-horizontal"></div>
    <div class="cu-setting-item">
      <div class="cu-setting-item-content">
        <p class="cu-setting-item-label">Security Alerts</p>
        <p class="cu-setting-item-description">Get notified about unusual sign-in activity.</p>
      </div>
      <div class="cu-setting-item-action">
        <label class="cu-toggle-wrapper">
          <input type="checkbox" class="peer sr-only" checked />
          <span class="cu-toggle"></span>
        </label>
      </div>
    </div>
  </div>
</div>`.trim();

const withSelectCode = `<div class="cu-card">
  <div class="cu-card-content-flush">
    <div class="divide-y divide-border">
      <div class="cu-setting-item">
        <div class="cu-setting-item-content">
          <p class="cu-setting-item-label">Language</p>
          <p class="cu-setting-item-description">Select your preferred language.</p>
        </div>
        <div class="cu-setting-item-action">
          <div class="cu-select-wrapper">
            <select class="cu-select">
              <option value="en">English</option>
              <option value="zh-TW">繁體中文</option>
              <option value="ja">日本語</option>
            </select>
            <svg class="cu-select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </div>
        </div>
      </div>
      <div class="cu-setting-item">
        <div class="cu-setting-item-content">
          <p class="cu-setting-item-label">Timezone</p>
          <p class="cu-setting-item-description">Set your local timezone.</p>
        </div>
        <div class="cu-setting-item-action">
          <div class="cu-select-wrapper">
            <select class="cu-select">
              <option value="utc+8">UTC+8 (Taipei)</option>
              <option value="utc+9">UTC+9 (Tokyo)</option>
              <option value="utc-8">UTC-8 (PST)</option>
            </select>
            <svg class="cu-select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Setting Item">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Setting Item</h1>
            <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">{t.description}</p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-xl">
                    <div class="cu-card">
                        <div class="cu-card-content-flush">
                            <div class="divide-y divide-border">
                                <div class="cu-setting-item">
                                    <div class="cu-setting-item-content">
                                        <p class="cu-setting-item-label">Email notifications</p>
                                        <p class="cu-setting-item-description">Receive email about your account activity.</p>
                                    </div>
                                    <div class="cu-setting-item-action">
                                        <label class="cu-toggle-wrapper">
                                            <input type="checkbox" class="peer sr-only" checked />
                                            <span class="cu-toggle"></span>
                                        </label>
                                    </div>
                                </div>
                                <div class="cu-setting-item">
                                    <div class="cu-setting-item-content">
                                        <p class="cu-setting-item-label">Push notifications</p>
                                        <p class="cu-setting-item-description">Receive push notifications on your device.</p>
                                    </div>
                                    <div class="cu-setting-item-action">
                                        <label class="cu-toggle-wrapper">
                                            <input type="checkbox" class="peer sr-only" checked />
                                            <span class="cu-toggle"></span>
                                        </label>
                                    </div>
                                </div>
                                <div class="cu-setting-item">
                                    <div class="cu-setting-item-content">
                                        <p class="cu-setting-item-label">Weekly digest</p>
                                        <p class="cu-setting-item-description">Get a weekly summary of your activity.</p>
                                    </div>
                                    <div class="cu-setting-item-action">
                                        <label class="cu-toggle-wrapper">
                                            <input type="checkbox" class="peer sr-only" />
                                            <span class="cu-toggle"></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.classes.title}
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-setting-item</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-setting-item']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-setting-item-content</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-setting-item-content']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-setting-item-label</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-setting-item-label']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-setting-item-description</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-setting-item-description']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-setting-item-action</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-setting-item-action']}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>


        <!-- With Button -->
        <section class="space-y-3">
            <h2 id="with-button" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-button" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.withButton.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">{t.sections.withButton.description}</p>
            <ComponentPreview code={withButtonCode}>
                <div class="w-full max-w-xl">
                    <div class="cu-card">
                        <div class="cu-card-content-flush">
                            <div class="divide-y divide-border">
                                <div class="cu-setting-item">
                                    <div class="cu-setting-item-content">
                                        <p class="cu-setting-item-label">Two-factor authentication</p>
                                        <p class="cu-setting-item-description">Add an extra layer of security to your account.</p>
                                    </div>
                                    <div class="cu-setting-item-action">
                                        <button class="cu-button cu-button-outline cu-button-sm">Enable</button>
                                    </div>
                                </div>
                                <div class="cu-setting-item">
                                    <div class="cu-setting-item-content">
                                        <p class="cu-setting-item-label">Connected accounts</p>
                                        <p class="cu-setting-item-description">Manage your linked social accounts.</p>
                                    </div>
                                    <div class="cu-setting-item-action">
                                        <button class="cu-button cu-button-outline cu-button-sm">Manage</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Select -->
        <section class="space-y-3">
            <h2 id="with-select" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-select" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.withSelect.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">{t.sections.withSelect.description}</p>
            <ComponentPreview code={withSelectCode}>
                <div class="w-full max-w-xl">
                    <div class="cu-card">
                        <div class="cu-card-content-flush">
                            <div class="divide-y divide-border">
                                <div class="cu-setting-item">
                                    <div class="cu-setting-item-content">
                                        <p class="cu-setting-item-label">Language</p>
                                        <p class="cu-setting-item-description">Select your preferred language.</p>
                                    </div>
                                    <div class="cu-setting-item-action">
                                        <div class="cu-select-wrapper">
                                            <select class="cu-select">
                                                <option value="en">English</option>
                                                <option value="zh-TW">繁體中文</option>
                                                <option value="ja">日本語</option>
                                            </select>
                                            <svg class="cu-select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                                        </div>
                                    </div>
                                </div>
                                <div class="cu-setting-item">
                                    <div class="cu-setting-item-content">
                                        <p class="cu-setting-item-label">Timezone</p>
                                        <p class="cu-setting-item-description">Set your local timezone.</p>
                                    </div>
                                    <div class="cu-setting-item-action">
                                        <div class="cu-select-wrapper">
                                            <select class="cu-select">
                                                <option value="utc+8">UTC+8 (Taipei)</option>
                                                <option value="utc+9">UTC+9 (Tokyo)</option>
                                                <option value="utc-8">UTC-8 (PST)</option>
                                            </select>
                                            <svg class="cu-select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Toggle -->
        <section class="space-y-3">
            <h2 id="with-toggle" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-toggle" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.withToggle.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">{t.sections.withToggle.description}</p>
            <ComponentPreview code={withToggleCode}>
                <div class="w-full max-w-lg">
                    <div class="cu-card">
                        <div class="cu-setting-item">
                            <div class="cu-setting-item-content">
                                <p class="cu-setting-item-label">Push Notifications</p>
                                <p class="cu-setting-item-description">Receive push notifications on your device.</p>
                            </div>
                            <div class="cu-setting-item-action">
                                <label class="cu-toggle-wrapper">
                                    <input type="checkbox" class="peer sr-only" checked />
                                    <span class="cu-toggle"></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Grouped Settings -->
        <section class="space-y-3">
            <h2 id="grouped" class="text-lg font-semibold tracking-tight relative group">
                <a href="#grouped" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.grouped.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">{t.sections.grouped.description}</p>
            <ComponentPreview code={groupedCode}>
                <div class="w-full max-w-lg">
                    <div class="cu-card">
                        <div class="cu-card-header">
                            <h3 class="cu-card-title">Notifications</h3>
                            <p class="cu-card-description">Manage how you receive notifications.</p>
                        </div>
                        <div class="cu-card-content-flush">
                            <div class="cu-setting-item">
                                <div class="cu-setting-item-content">
                                    <p class="cu-setting-item-label">Email Notifications</p>
                                    <p class="cu-setting-item-description">Receive email about account activity.</p>
                                </div>
                                <div class="cu-setting-item-action">
                                    <label class="cu-toggle-wrapper">
                                        <input type="checkbox" class="peer sr-only" checked />
                                        <span class="cu-toggle"></span>
                                    </label>
                                </div>
                            </div>
                            <div class="cu-separator cu-separator-horizontal"></div>
                            <div class="cu-setting-item">
                                <div class="cu-setting-item-content">
                                    <p class="cu-setting-item-label">Marketing Emails</p>
                                    <p class="cu-setting-item-description">Receive emails about new products and features.</p>
                                </div>
                                <div class="cu-setting-item-action">
                                    <label class="cu-toggle-wrapper">
                                        <input type="checkbox" class="peer sr-only" />
                                        <span class="cu-toggle"></span>
                                    </label>
                                </div>
                            </div>
                            <div class="cu-separator cu-separator-horizontal"></div>
                            <div class="cu-setting-item">
                                <div class="cu-setting-item-content">
                                    <p class="cu-setting-item-label">Security Alerts</p>
                                    <p class="cu-setting-item-description">Get notified about unusual sign-in activity.</p>
                                </div>
                                <div class="cu-setting-item-action">
                                    <label class="cu-toggle-wrapper">
                                        <input type="checkbox" class="peer sr-only" checked />
                                        <span class="cu-toggle"></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

    </div>
</Layout>
