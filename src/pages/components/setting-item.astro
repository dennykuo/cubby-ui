        </div>
        <div class="cu-setting-item-action">
          <label class="cu-toggle-wrapper">
            <input type="checkbox" class="cu-toggle-input" checked />
            <span class="cu-toggle"><span class="cu-toggle-thumb"></span></span>
          </label>
        </div>
      </div>
