---

<Layout title={t.title} category={t.category} componentName="Setting Item">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Setting Item</h1>
            <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">{t.description}</p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-xl">
                    <div class="cu-card">
                        <div class="cu-card-content-flush">
                            <div class="divide-y divide-border">
                                <div class="cu-setting-item">
                                    <div class="cu-setting-item-content">
                                        <p class="cu-setting-item-label">Email notifications</p>
                                        <p class="cu-setting-item-description">Receive email about your account activity.</p>
                                    </div>
                                    <div class="cu-setting-item-action">
                                        <label class="cu-toggle-wrapper">
                                            <input type="checkbox" class="cu-toggle-input" checked />
                                            <span class="cu-toggle"><span class="cu-toggle-thumb"></span></span>
                                        </label>
                                    </div>
                                </div>
                                <div class="cu-setting-item">
                                    <div class="cu-setting-item-content">
                                        <p class="cu-setting-item-label">Push notifications</p>
                                    </div>
                                    <div class="cu-setting-item-action">
                                        <label class="cu-toggle-wrapper">
                                            <input type="checkbox" class="cu-toggle-input" checked />
                                            <span class="cu-toggle"><span class="cu-toggle-thumb"></span></span>
                                        </label>
                                    </div>
                                </div>
                                <div class="cu-setting-item">
                                    <div class="cu-setting-item-content">
                                        <p class="cu-setting-item-label">Language</p>
                                    </div>
                                    <div class="cu-setting-item-action">
                                        <div class="cu-select-wrapper">
                                            <select class="cu-select">
                                                <option value="en">English</option>
                                                <option value="zh-TW">繁體中文</option>
                                                <option value="ja">日本語</option>
                                            </select>
                                            <svg class="cu-select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.classes.title}
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-setting-item</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-setting-item']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-setting-item-content</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-setting-item-content']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-setting-item-label</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-setting-item-label']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-setting-item-description</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-setting-item-description']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-setting-item-action</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-setting-item-action']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-setting-item-icon</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-setting-item-icon']}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- With Icon -->
        <section class="space-y-3">
            <h2 id="with-icon" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-icon" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.withIcon.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withIcon.description} />
            <ComponentPreview code={withIconCode}>
                <div class="w-full max-w-xl">
                    <div class="cu-card">
                        <div class="cu-card-content-flush">
                            <div class="divide-y divide-border">
                                <div class="cu-setting-item">
                                    <div class="flex items-center gap-3">
                                        <div class="cu-setting-item-icon">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
                                        </div>
                                        <div class="cu-setting-item-content">
                                            <p class="cu-setting-item-label">Notifications</p>
                                            <p class="cu-setting-item-description">Push and email alerts.</p>
                                        </div>
                                    </div>
                                    <div class="cu-setting-item-action">
                                        <label class="cu-toggle-wrapper">
                                            <input type="checkbox" class="cu-toggle-input" checked />
