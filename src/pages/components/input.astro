---
import Layout from "@/layouts/Layout.astro";
import Input from "@/components/ui/Input.astro";
import Label from "@/components/ui/Label.astro";
import FormGroup from "@/components/ui/FormGroup.astro";
import FormDescription from "@/components/ui/FormDescription.astro";
import FormError from "@/components/ui/FormError.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { inputPage } from "@/i18n/pages/components/input";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(inputPage, locale);

const usageCode = `<input class="cu-input" type="text" placeholder="Enter text..." />`.trim();

const withLabelCode = `<div class="cu-form-group">
  <label class="cu-label" for="email">Email</label>
  <input class="cu-input" type="email" id="email" placeholder="you@example.com" />
</div>`.trim();

const typesCode = `<div class="cu-form-group">
  <label class="cu-label" for="email-input">Email</label>
  <input class="cu-input" type="email" id="email-input" placeholder="you@example.com" />
</div>

<div class="cu-form-group">
  <label class="cu-label" for="password-input">Password</label>
  <input class="cu-input" type="password" id="password-input" placeholder="••••••••" />
</div>

<div class="cu-form-group">
  <label class="cu-label" for="number-input">Number</label>
  <input class="cu-input" type="number" id="number-input" placeholder="0" />
</div>`.trim();

const disabledCode = `<input class="cu-input" type="text" placeholder="Disabled input" disabled />`.trim();

const formGroupCode = `<div class="cu-form-group">
  <label class="cu-label" for="username">Username</label>
  <input class="cu-input" type="text" id="username" placeholder="johndoe" />
  <p class="cu-form-description">This is your public display name.</p>
</div>

<div class="cu-form-group">
  <label class="cu-label" for="email-err">Email</label>
  <input class="cu-input border-destructive" type="email" id="email-err" placeholder="you@example.com" />
  <p class="cu-form-error">Please enter a valid email address.</p>
</div>`.trim();
---

<Layout category={t.category} componentName="Input" title={t.title}>
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Input</h1>
          <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
              <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-sm">
                    <Input type="text" placeholder="Enter text..." />
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
          <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
            <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
            {t.sections.classes.title}
          </h2>
          <div class="cu-table-wrapper rounded-lg border border-border">
            <table class="cu-table">
              <thead class="cu-table-header">
                <tr class="cu-table-row">
                  <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                  <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                </tr>
              </thead>
              <tbody class="cu-table-body">
                <tr class="cu-table-row">
                  <td class="cu-table-cell"><code class="cu-code">cu-input</code></td>
                  <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-input']}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>


        <!-- With Label -->
        <section class="space-y-3">
            <h2 id="with-label" class="text-lg font-semibold tracking-tight relative group">
              <a href="#with-label" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.withLabel.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withLabel.description} />
            <ComponentPreview code={withLabelCode}>
                <div class="w-full max-w-sm">
                    <FormGroup>
                        <Label for="email">Email</Label>
                        <Input type="email" id="email" placeholder="you@example.com" />
                    </FormGroup>
                </div>
            </ComponentPreview>
        </section>

        <!-- Input Types -->
        <section class="space-y-3">
            <h2 id="input-types" class="text-lg font-semibold tracking-tight relative group">
              <a href="#input-types" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.inputTypes.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.inputTypes.description} />
            <ComponentPreview code={typesCode}>
                <div class="w-full max-w-sm space-y-4">
                    <FormGroup>
                        <Label for="email-input">Email</Label>
                        <Input type="email" id="email-input" placeholder="you@example.com" />
                    </FormGroup>
                    <FormGroup>
                        <Label for="password-input">Password</Label>
                        <Input type="password" id="password-input" placeholder="••••••••" />
                    </FormGroup>
                    <FormGroup>
                        <Label for="number-input">Number</Label>
                        <Input type="number" id="number-input" placeholder="0" />
                    </FormGroup>
                </div>
            </ComponentPreview>
        </section>

        <!-- Disabled -->
        <section class="space-y-3">
            <h2 id="disabled" class="text-lg font-semibold tracking-tight relative group">
              <a href="#disabled" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.disabled.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.disabled.description} />
            <ComponentPreview code={disabledCode}>
                <div class="w-full max-w-sm">
                    <Input type="text" placeholder="Disabled input" disabled />
                </div>
            </ComponentPreview>
        </section>

        <!-- With Form Group -->
        <section class="space-y-3">
            <h2 id="with-form-group" class="text-lg font-semibold tracking-tight relative group">
              <a href="#with-form-group" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.withFormGroup.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withFormGroup.description} />
            <ComponentPreview code={formGroupCode}>
                <div class="w-full max-w-sm space-y-4">
                    <FormGroup>
                        <Label for="username">Username</Label>
                        <Input type="text" id="username" placeholder="johndoe" />
                        <FormDescription>This is your public display name.</FormDescription>
                    </FormGroup>
                    <FormGroup>
                        <Label for="email-err">Email</Label>
                        <Input type="email" id="email-err" placeholder="you@example.com" class="border-destructive" />
                        <FormError>Please enter a valid email address.</FormError>
                    </FormGroup>
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>
