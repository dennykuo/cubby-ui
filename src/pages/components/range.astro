---
import Layout from "@/layouts/Layout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
// @ts-ignore - Astro component used in template
import Range from "@/components/ui/Range.astro";
import Label from "@/components/ui/Label.astro";
import FormGroup from "@/components/ui/FormGroup.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { rangePage } from "@/i18n/pages/components/range";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(rangePage, locale);

const usageCode = `<input type="range" class="cu-range" />`.trim();

const withLabelCode = `<div class="cu-form-group">
  <label class="cu-label" for="volume">Volume</label>
  <input type="range" class="cu-range" id="volume" />
</div>`.trim();

const minMaxCode = `<div class="cu-form-group">
  <label class="cu-label" for="price">Price range</label>
  <input type="range" class="cu-range" id="price" min="0" max="1000" step="50" value="500" />
</div>

<div class="cu-form-group">
  <label class="cu-label" for="opacity">Opacity</label>
  <input type="range" class="cu-range" id="opacity" min="0" max="1" step="0.1" value="0.5" />
</div>`.trim();

const disabledCode = `<input type="range" class="cu-range" disabled />`.trim();
---

<Layout category={t.category} componentName="Range" title={t.title}>
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Range</h1>
          <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <SectionHeading id="usage" title={t.sections.usage.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-sm">
                    <Range />
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
          <SectionHeading id="classes" title={t.sections.classes.title} />
          <div class="cu-table-wrapper rounded-lg border border-border">
            <table class="cu-table">
              <thead class="cu-table-header">
                <tr class="cu-table-row">
                  <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                  <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                </tr>
              </thead>
              <tbody class="cu-table-body">
                <tr class="cu-table-row">
                  <td class="cu-table-cell"><code class="cu-code">cu-range</code></td>
                  <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-range']}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>


        <!-- With Label -->
        <section class="space-y-3">
            <SectionHeading id="with-label" title={t.sections.withLabel.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withLabel.description} />
            <ComponentPreview code={withLabelCode}>
                <div class="w-full max-w-sm">
                    <FormGroup>
                        <Label for="volume">Volume</Label>
                        <Range id="volume" />
                    </FormGroup>
                </div>
            </ComponentPreview>
        </section>

        <!-- Min / Max / Step -->
        <section class="space-y-3">
            <SectionHeading id="min-max-step" title={t.sections.minMaxStep.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.minMaxStep.description} />
            <ComponentPreview code={minMaxCode}>
                <div class="w-full max-w-sm space-y-4">
                    <FormGroup>
                        <Label for="price">Price range</Label>
                        <Range id="price" min="0" max="1000" step="50" value="500" />
                    </FormGroup>
                    <FormGroup>
                        <Label for="opacity">Opacity</Label>
                        <Range id="opacity" min="0" max="1" step="0.1" value="0.5" />
                    </FormGroup>
                </div>
            </ComponentPreview>
        </section>

        <!-- Disabled -->
        <section class="space-y-3">
            <SectionHeading id="disabled" title={t.sections.disabled.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.disabled.description} />
            <ComponentPreview code={disabledCode}>
                <div class="w-full max-w-sm">
                    <Range disabled />
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>
