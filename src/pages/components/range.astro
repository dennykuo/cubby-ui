---
import Layout from "../../layouts/Layout.astro";
import Range from "../../components/ui/Range.astro";
import Label from "../../components/ui/Label.astro";
import FormGroup from "../../components/ui/FormGroup.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<input type="range" class="cu-range" />`.trim();

const withLabelCode = `<div class="cu-form-group">
  <label class="cu-label" for="volume">Volume</label>
  <input type="range" class="cu-range" id="volume" />
</div>`.trim();

const minMaxCode = `<div class="cu-form-group">
  <label class="cu-label" for="price">Price range</label>
  <input type="range" class="cu-range" id="price" min="0" max="1000" step="50" value="500" />
</div>

<div class="cu-form-group">
  <label class="cu-label" for="opacity">Opacity</label>
  <input type="range" class="cu-range" id="opacity" min="0" max="1" step="0.1" value="0.5" />
</div>`.trim();

const disabledCode = `<input type="range" class="cu-range" disabled />`.trim();
---

<Layout category="Forms" componentName="Range" title="Range — Cubby UI">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Range</h1>
          <span class="cu-badge cu-badge-secondary">Forms</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            Displays a range slider for selecting a numeric value within a range.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight flex items-center gap-2 group">
              <a href="#usage" class="text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Usage
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Apply <code class="cu-code">cu-range</code> to an <code class="cu-code">&lt;input type="range"&gt;</code> element.
            </p>
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-sm">
                    <Range />
                </div>
            </ComponentPreview>
        </section>

        <!-- With Label -->
        <section class="space-y-3">
            <h2 id="with-label" class="text-lg font-semibold tracking-tight flex items-center gap-2 group">
              <a href="#with-label" class="text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              With Label
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Pair with a <code class="cu-code">cu-label</code> for accessible form fields.
            </p>
            <ComponentPreview code={withLabelCode}>
                <div class="w-full max-w-sm">
                    <FormGroup>
                        <Label for="volume">Volume</Label>
                        <Range id="volume" />
                    </FormGroup>
                </div>
            </ComponentPreview>
        </section>

        <!-- Min / Max / Step -->
        <section class="space-y-3">
            <h2 id="min-max-step" class="text-lg font-semibold tracking-tight flex items-center gap-2 group">
              <a href="#min-max-step" class="text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Min / Max / Step
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Customize the range with <code class="cu-code">min</code>,
                <code class="cu-code">max</code>, and
                <code class="cu-code">step</code> attributes.
            </p>
            <ComponentPreview code={minMaxCode}>
                <div class="w-full max-w-sm space-y-4">
                    <FormGroup>
                        <Label for="price">Price range</Label>
                        <Range id="price" min="0" max="1000" step="50" value="500" />
                    </FormGroup>
                    <FormGroup>
                        <Label for="opacity">Opacity</Label>
                        <Range id="opacity" min="0" max="1" step="0.1" value="0.5" />
                    </FormGroup>
                </div>
            </ComponentPreview>
        </section>

        <!-- Disabled -->
        <section class="space-y-3">
            <h2 id="disabled" class="text-lg font-semibold tracking-tight flex items-center gap-2 group">
              <a href="#disabled" class="text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Disabled
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Add the <code class="cu-code">disabled</code> attribute to prevent interaction.
            </p>
            <ComponentPreview code={disabledCode}>
                <div class="w-full max-w-sm">
                    <Range disabled />
                </div>
            </ComponentPreview>
        </section>
        <!-- Classes Reference -->
        <section class="space-y-3 mt-10">
          <h2 id="classes" class="text-lg font-semibold tracking-tight flex items-center gap-2 group">
            <a href="#classes" class="text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
            CSS Classes
          </h2>
          <div class="cu-table-wrapper rounded-lg border border-border">
            <table class="cu-table">
              <thead class="cu-table-header">
                <tr class="cu-table-row">
                  <th class="cu-table-head">Class</th>
                  <th class="cu-table-head">說明</th>
                </tr>
              </thead>
              <tbody class="cu-table-body">
                <tr class="cu-table-row">
                  <td class="cu-table-cell"><code class="cu-code">cu-range</code></td>
                  <td class="cu-table-cell text-muted-foreground">滑桿樣式，含自訂 thumb 圓點及 hover 光暈效果</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>
    </div>
</Layout>
