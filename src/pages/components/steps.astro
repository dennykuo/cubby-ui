---
import Layout from "@/layouts/Layout.astro";
// @ts-ignore - Astro component used in template
import Steps from "@/components/ui/Steps.astro";
import StepsItem from "@/components/ui/StepsItem.astro";
import StepsSeparator from "@/components/ui/StepsSeparator.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { stepsPage } from "@/i18n/pages/components/steps";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(stepsPage, locale);

const usageCode = `<div class="cu-steps">
  <div class="cu-steps-item cu-steps-item-completed">
    <div class="cu-steps-number">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
    </div>
    <div class="cu-steps-content">
      <div class="cu-steps-title">Account</div>
    </div>
  </div>
  <div class="cu-steps-separator"></div>
  <div class="cu-steps-item cu-steps-item-active">
    <div class="cu-steps-number">2</div>
    <div class="cu-steps-content">
      <div class="cu-steps-title">Profile</div>
    </div>
  </div>
  <div class="cu-steps-separator"></div>
  <div class="cu-steps-item cu-steps-item-upcoming">
    <div class="cu-steps-number">3</div>
    <div class="cu-steps-content">
      <div class="cu-steps-title">Complete</div>
    </div>
  </div>
</div>`.trim();

const withDescCode = `<div class="cu-steps">
  <div class="cu-steps-item cu-steps-item-completed">
    <div class="cu-steps-number">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
    </div>
    <div class="cu-steps-content">
      <div class="cu-steps-title">Account</div>
      <div class="cu-steps-description">Create your account</div>
    </div>
  </div>
  <div class="cu-steps-separator"></div>
  <div class="cu-steps-item cu-steps-item-active">
    <div class="cu-steps-number">2</div>
    <div class="cu-steps-content">
      <div class="cu-steps-title">Profile</div>
      <div class="cu-steps-description">Set up your profile</div>
    </div>
  </div>
  <div class="cu-steps-separator"></div>
  <div class="cu-steps-item cu-steps-item-upcoming">
    <div class="cu-steps-number">3</div>
    <div class="cu-steps-content">
      <div class="cu-steps-title">Complete</div>
      <div class="cu-steps-description">Review and finish</div>
    </div>
  </div>
</div>`.trim();

const verticalCode = `<div class="cu-steps cu-steps-vertical">
  <div class="cu-steps-item cu-steps-item-completed">
    <div class="cu-steps-number">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
    </div>
    <div class="cu-steps-content">
      <div class="cu-steps-title">Order placed</div>
      <div class="cu-steps-description">Your order has been confirmed</div>
    </div>
  </div>
  <div class="cu-steps-separator"></div>
  <div class="cu-steps-item cu-steps-item-completed">
    <div class="cu-steps-number">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
    </div>
    <div class="cu-steps-content">
      <div class="cu-steps-title">Processing</div>
      <div class="cu-steps-description">Your order is being prepared</div>
    </div>
  </div>
  <div class="cu-steps-separator"></div>
  <div class="cu-steps-item cu-steps-item-active">
    <div class="cu-steps-number">3</div>
    <div class="cu-steps-content">
      <div class="cu-steps-title">Shipping</div>
      <div class="cu-steps-description">On its way to you</div>
    </div>
  </div>
  <div class="cu-steps-separator"></div>
  <div class="cu-steps-item cu-steps-item-upcoming">
    <div class="cu-steps-number">4</div>
    <div class="cu-steps-content">
      <div class="cu-steps-title">Delivered</div>
      <div class="cu-steps-description">Package has arrived</div>
    </div>
  </div>
</div>`.trim();

const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>`;

const errorCode = `<div class="cu-steps">
  <div class="cu-steps-item cu-steps-item-completed">
    <div class="cu-steps-number">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
    </div>
    <div class="cu-steps-content">
      <div class="cu-steps-title">Account</div>
    </div>
  </div>
  <div class="cu-steps-separator"></div>
  <div class="cu-steps-item cu-steps-item-error">
    <div class="cu-steps-number">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </div>
    <div class="cu-steps-content">
      <div class="cu-steps-title">Payment Failed</div>
    </div>
  </div>
  <div class="cu-steps-separator"></div>
  <div class="cu-steps-item cu-steps-item-upcoming">
    <div class="cu-steps-number">3</div>
    <div class="cu-steps-content">
      <div class="cu-steps-title">Confirm</div>
    </div>
  </div>
</div>`.trim();

const clickableCode = `<div class="cu-steps">
  <button class="cu-steps-item cu-steps-item-completed cursor-pointer group">
    <div class="cu-steps-number group-hover:shadow-sm transition-shadow duration-150">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
    </div>
    <div class="cu-steps-content">
      <div class="cu-steps-title">Details</div>
    </div>
  </button>
  <div class="cu-steps-separator"></div>
  <button class="cu-steps-item cursor-pointer group">
    <div class="cu-steps-number group-hover:shadow-sm transition-shadow duration-150">2</div>
    <div class="cu-steps-content">
      <div class="cu-steps-title">Address</div>
    </div>
  </button>
  <div class="cu-steps-separator"></div>
  <button class="cu-steps-item cu-steps-item-upcoming cursor-pointer group" disabled>
    <div class="cu-steps-number">3</div>
    <div class="cu-steps-content">
      <div class="cu-steps-title">Payment</div>
    </div>
  </button>
</div>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Steps">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Steps</h1>
          <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            {t.description}
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
              <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-lg">
                    <Steps>
                        <StepsItem status="completed">
                            <div class="cu-steps-number"><Fragment set:html={checkIcon} /></div>
                            <div class="cu-steps-content"><div class="cu-steps-title">Account</div></div>
                        </StepsItem>
                        <StepsSeparator />
                        <StepsItem status="active">
                            <div class="cu-steps-number">2</div>
                            <div class="cu-steps-content"><div class="cu-steps-title">Profile</div></div>
                        </StepsItem>
                        <StepsSeparator />
                        <StepsItem status="upcoming">
                            <div class="cu-steps-number">3</div>
                            <div class="cu-steps-content"><div class="cu-steps-title">Complete</div></div>
                        </StepsItem>
                    </Steps>
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.classes.title}
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-steps</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-steps']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-steps-vertical</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-steps-vertical']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-steps-item</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-steps-item']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-steps-item-completed</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-steps-item-completed']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-steps-item-active</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-steps-item-active']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-steps-item-upcoming</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-steps-item-upcoming']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-steps-item-error</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-steps-item-error']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-steps-number</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-steps-number']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-steps-content</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-steps-content']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-steps-title</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-steps-title']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-steps-description</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-steps-description']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-steps-separator</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-steps-separator']}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>


        <!-- With Descriptions -->
        <section class="space-y-3">
            <h2 id="with-descriptions" class="text-lg font-semibold tracking-tight relative group">
              <a href="#with-descriptions" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.withDescriptions.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withDescriptions.description} />
            <ComponentPreview code={withDescCode}>
                <div class="w-full max-w-lg">
                    <Steps>
                        <StepsItem status="completed">
                            <div class="cu-steps-number"><Fragment set:html={checkIcon} /></div>
                            <div class="cu-steps-content">
                                <div class="cu-steps-title">Account</div>
                                <div class="cu-steps-description">Create your account</div>
                            </div>
                        </StepsItem>
                        <StepsSeparator />
                        <StepsItem status="active">
                            <div class="cu-steps-number">2</div>
                            <div class="cu-steps-content">
                                <div class="cu-steps-title">Profile</div>
                                <div class="cu-steps-description">Set up your profile</div>
                            </div>
                        </StepsItem>
                        <StepsSeparator />
                        <StepsItem status="upcoming">
                            <div class="cu-steps-number">3</div>
                            <div class="cu-steps-content">
                                <div class="cu-steps-title">Complete</div>
                                <div class="cu-steps-description">Review and finish</div>
                            </div>
                        </StepsItem>
                    </Steps>
                </div>
            </ComponentPreview>
        </section>

        <!-- Vertical -->
        <section class="space-y-3">
            <h2 id="vertical" class="text-lg font-semibold tracking-tight relative group">
              <a href="#vertical" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.vertical.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.vertical.description} />
            <ComponentPreview code={verticalCode}>
                <div class="w-full max-w-sm">
                    <Steps vertical>
                        <StepsItem status="completed">
                            <div class="cu-steps-number"><Fragment set:html={checkIcon} /></div>
                            <div class="cu-steps-content">
                                <div class="cu-steps-title">Order placed</div>
                                <div class="cu-steps-description">Your order has been confirmed</div>
                            </div>
                        </StepsItem>
                        <StepsSeparator />
                        <StepsItem status="completed">
                            <div class="cu-steps-number"><Fragment set:html={checkIcon} /></div>
                            <div class="cu-steps-content">
                                <div class="cu-steps-title">Processing</div>
                                <div class="cu-steps-description">Your order is being prepared</div>
                            </div>
                        </StepsItem>
                        <StepsSeparator />
                        <StepsItem status="active">
                            <div class="cu-steps-number">3</div>
                            <div class="cu-steps-content">
                                <div class="cu-steps-title">Shipping</div>
                                <div class="cu-steps-description">On its way to you</div>
                            </div>
                        </StepsItem>
                        <StepsSeparator />
                        <StepsItem status="upcoming">
                            <div class="cu-steps-number">4</div>
                            <div class="cu-steps-content">
                                <div class="cu-steps-title">Delivered</div>
                                <div class="cu-steps-description">Package has arrived</div>
                            </div>
                        </StepsItem>
                    </Steps>
                </div>
            </ComponentPreview>
        </section>

        <!-- Error State -->
        <section class="space-y-3">
            <h2 id="error" class="text-lg font-semibold tracking-tight relative group">
              <a href="#error" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.error.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">{t.sections.error.description}</p>
            <ComponentPreview code={errorCode}>
                <div class="w-full max-w-lg">
                    <Steps>
                        <StepsItem status="completed">
                            <div class="cu-steps-number"><Fragment set:html={checkIcon} /></div>
                            <div class="cu-steps-content"><div class="cu-steps-title">Account</div></div>
                        </StepsItem>
                        <StepsSeparator />
                        <div class="cu-steps-item cu-steps-item-error">
                            <div class="cu-steps-number">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                            </div>
                            <div class="cu-steps-content"><div class="cu-steps-title">Payment Failed</div></div>
                        </div>
                        <StepsSeparator />
                        <StepsItem status="upcoming">
                            <div class="cu-steps-number">3</div>
                            <div class="cu-steps-content"><div class="cu-steps-title">Confirm</div></div>
                        </StepsItem>
                    </Steps>
                </div>
            </ComponentPreview>
        </section>

        <!-- Clickable Steps -->
        <section class="space-y-3">
            <h2 id="clickable" class="text-lg font-semibold tracking-tight relative group">
              <a href="#clickable" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.clickable.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.clickable.description} />
            <ComponentPreview code={clickableCode}>
                <div class="w-full max-w-lg">
                    <Steps>
                        <button class="cu-steps-item cu-steps-item-completed cursor-pointer group">
                            <div class="cu-steps-number group-hover:shadow-sm transition-shadow duration-150"><Fragment set:html={checkIcon} /></div>
                            <div class="cu-steps-content"><div class="cu-steps-title">Details</div></div>
                        </button>
                        <StepsSeparator />
                        <button class="cu-steps-item cursor-pointer group">
                            <div class="cu-steps-number group-hover:shadow-sm transition-shadow duration-150">2</div>
                            <div class="cu-steps-content"><div class="cu-steps-title">Address</div></div>
                        </button>
                        <StepsSeparator />
                        <button class="cu-steps-item cu-steps-item-upcoming cursor-pointer group" disabled>
                            <div class="cu-steps-number">3</div>
                            <div class="cu-steps-content"><div class="cu-steps-title">Payment</div></div>
                        </button>
                    </Steps>
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>
