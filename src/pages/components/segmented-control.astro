---
import Layout from "@/layouts/Layout.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { segmentedControlPage } from "@/i18n/pages/components/segmented-control";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(segmentedControlPage, locale);

const usageCode = `<div class="cu-segmented">
  <button class="cu-segmented-item cu-segmented-item-active">List</button>
  <button class="cu-segmented-item">Grid</button>
  <button class="cu-segmented-item">Board</button>
</div>`.trim();

const sizesCode = `<!-- Small -->
<div class="cu-segmented cu-segmented-sm">
  <button class="cu-segmented-item cu-segmented-item-active">S</button>
  <button class="cu-segmented-item">M</button>
  <button class="cu-segmented-item">L</button>
</div>

<!-- Default -->
<div class="cu-segmented">
  <button class="cu-segmented-item cu-segmented-item-active">Small</button>
  <button class="cu-segmented-item">Medium</button>
  <button class="cu-segmented-item">Large</button>
</div>

<!-- Large -->
<div class="cu-segmented cu-segmented-lg">
  <button class="cu-segmented-item cu-segmented-item-active">Small</button>
  <button class="cu-segmented-item">Medium</button>
  <button class="cu-segmented-item">Large</button>
</div>`.trim();

const blockCode = `<div class="cu-segmented cu-segmented-block">
  <button class="cu-segmented-item cu-segmented-item-active">Daily</button>
  <button class="cu-segmented-item">Weekly</button>
  <button class="cu-segmented-item">Monthly</button>
  <button class="cu-segmented-item">Yearly</button>
</div>`.trim();

const withIconsCode = `<div class="cu-segmented">
  <button class="cu-segmented-item cu-segmented-item-active">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5"><line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/><line x1="8" x2="21" y1="18" y2="18"/><line x1="3" x2="3.01" y1="6" y2="6"/><line x1="3" x2="3.01" y1="12" y2="12"/><line x1="3" x2="3.01" y1="18" y2="18"/></svg>
    List
  </button>
  <button class="cu-segmented-item">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
    Grid
  </button>
  <button class="cu-segmented-item">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
    Board
  </button>
</div>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Segmented Control">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Segmented Control</h1>
            <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            {t.description}
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <div class="cu-segmented">
                    <button class="cu-segmented-item cu-segmented-item-active">List</button>
                    <button class="cu-segmented-item">Grid</button>
                    <button class="cu-segmented-item">Board</button>
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.classes.title}
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        {Object.entries(t.classDescriptions).map(([cls, desc]) => (
                            <tr class="cu-table-row">
                                <td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
                                <td class="cu-table-cell text-muted-foreground">{desc}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Sizes -->
        <section class="space-y-3">
            <h2 id="sizes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#sizes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.sizes.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.sizes.description} />
            <ComponentPreview code={sizesCode}>
                <div class="flex flex-col items-center gap-4">
                    <div class="cu-segmented cu-segmented-sm">
                        <button class="cu-segmented-item cu-segmented-item-active">S</button>
                        <button class="cu-segmented-item">M</button>
                        <button class="cu-segmented-item">L</button>
                    </div>
                    <div class="cu-segmented">
                        <button class="cu-segmented-item cu-segmented-item-active">Small</button>
                        <button class="cu-segmented-item">Medium</button>
                        <button class="cu-segmented-item">Large</button>
                    </div>
                    <div class="cu-segmented cu-segmented-lg">
                        <button class="cu-segmented-item cu-segmented-item-active">Small</button>
                        <button class="cu-segmented-item">Medium</button>
                        <button class="cu-segmented-item">Large</button>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Block -->
        <section class="space-y-3">
            <h2 id="block" class="text-lg font-semibold tracking-tight relative group">
                <a href="#block" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.block.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.block.description} />
            <ComponentPreview code={blockCode}>
                <div class="w-full max-w-md">
                    <div class="cu-segmented cu-segmented-block">
                        <button class="cu-segmented-item cu-segmented-item-active">Daily</button>
                        <button class="cu-segmented-item">Weekly</button>
                        <button class="cu-segmented-item">Monthly</button>
                        <button class="cu-segmented-item">Yearly</button>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Icons -->
        <section class="space-y-3">
            <h2 id="with-icons" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-icons" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.withIcons.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withIcons.description} />
            <ComponentPreview code={withIconsCode}>
                <div class="cu-segmented">
                    <button class="cu-segmented-item cu-segmented-item-active">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5"><line x1="8" x2="21" y1="6" y2="6"/><line x1="8" x2="21" y1="12" y2="12"/><line x1="8" x2="21" y1="18" y2="18"/><line x1="3" x2="3.01" y1="6" y2="6"/><line x1="3" x2="3.01" y1="12" y2="12"/><line x1="3" x2="3.01" y1="18" y2="18"/></svg>
                        List
                    </button>
                    <button class="cu-segmented-item">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
                        Grid
                    </button>
                    <button class="cu-segmented-item">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
                        Board
                    </button>
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>
