---
import Layout from "../../layouts/Layout.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const largeCode = `<span class="cu-text-large">Large text</span>`.trim();

const smallCode = `<span class="cu-text-small">Small text</span>`.trim();

const mutedCode = `<span class="cu-text-muted">Muted text</span>`.trim();

const inlineCodeExample = `<span class="cu-code">@cubby-ui/core</span>`.trim();
---

<Layout title="Text — Cubby UI" category="Typography" componentName="Text">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Text</h1>
          <span class="cu-badge cu-badge-secondary">Typography</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            Utility classes for common text styles — large, small, muted, and inline code.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Large -->
        <section class="space-y-3">
            <h2 id="large" class="text-lg font-semibold tracking-tight relative group">
              <a href="#large" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Large
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-text-large</code> for emphasized, larger text.
            </p>
            <ComponentPreview code={largeCode}>
                <span class="cu-text-large">Large text</span>
            </ComponentPreview>
        </section>

        <!-- Small -->
        <section class="space-y-3">
            <h2 id="small" class="text-lg font-semibold tracking-tight relative group">
              <a href="#small" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Small
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-text-small</code> for compact, secondary text.
            </p>
            <ComponentPreview code={smallCode}>
                <span class="cu-text-small">Small text</span>
            </ComponentPreview>
        </section>

        <!-- Muted -->
        <section class="space-y-3">
            <h2 id="muted" class="text-lg font-semibold tracking-tight relative group">
              <a href="#muted" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Muted
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-text-muted</code> for
                de-emphasized helper text.
            </p>
            <ComponentPreview code={mutedCode}>
                <span class="cu-text-muted">Muted text</span>
            </ComponentPreview>
        </section>

        <!-- Inline Code -->
        <section class="space-y-3">
            <h2 id="inline-code" class="text-lg font-semibold tracking-tight relative group">
              <a href="#inline-code" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Inline Code
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-code</code> for inline code snippets
                within text content.
            </p>
            <ComponentPreview code={inlineCodeExample}>
                <span class="cu-code">@cubby-ui/core</span>
            </ComponentPreview>
        </section>
    </div>

    <!-- Classes Reference -->
    <section class="space-y-3 mt-10">
      <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
        <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        CSS Classes
      </h2>
      <div class="cu-table-wrapper rounded-lg border border-border">
        <table class="cu-table">
          <thead class="cu-table-header">
            <tr class="cu-table-row">
              <th class="cu-table-head">Class</th>
              <th class="cu-table-head">Description</th>
            </tr>
          </thead>
          <tbody class="cu-table-body">
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-text-large</code></td>
              <td class="cu-table-cell text-muted-foreground">Large text, semi-bold</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-text-small</code></td>
              <td class="cu-table-cell text-muted-foreground">Small text, medium weight</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-text-muted</code></td>
              <td class="cu-table-cell text-muted-foreground">Muted helper text</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
</Layout>
