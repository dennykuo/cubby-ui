---
import Layout from "@/layouts/Layout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { textPage } from "@/i18n/pages/components/text";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(textPage, locale);

const largeCode = `<span class="cu-text-large">Large text</span>`.trim();

const smallCode = `<span class="cu-text-small">Small text</span>`.trim();

const mutedCode = `<span class="cu-text-muted">Muted text</span>`.trim();

const inlineCodeExample = `<span class="cu-code">@cubby-ui/core</span>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Text" description={t.description}>
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Text</h1>
          <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <SectionHeading id="usage" title={t.sections.usage.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={largeCode}>
                <span class="cu-text-large">Large text</span>
            </ComponentPreview>
        </section>

    <!-- Classes Reference -->
    <section class="space-y-3">
      <SectionHeading id="classes" title={t.sections.classes.title} />
      <div class="cu-table-wrapper rounded-lg border border-border">
        <table class="cu-table">
          <thead class="cu-table-header">
            <tr class="cu-table-row">
              <th class="cu-table-head">{t.sections.classes.classLabel}</th>
              <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
            </tr>
          </thead>
          <tbody class="cu-table-body">
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-text-large</code></td>
              <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-text-large']}</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-text-small</code></td>
              <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-text-small']}</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-text-muted</code></td>
              <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-text-muted']}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>


        <!-- Small -->
        <section class="space-y-3">
            <SectionHeading id="small" title={t.sections.small.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.small.description} />
            <ComponentPreview code={smallCode}>
                <span class="cu-text-small">Small text</span>
            </ComponentPreview>
        </section>

        <!-- Muted -->
        <section class="space-y-3">
            <SectionHeading id="muted" title={t.sections.muted.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.muted.description} />
            <ComponentPreview code={mutedCode}>
                <span class="cu-text-muted">Muted text</span>
            </ComponentPreview>
        </section>

        <!-- Inline Code -->
        <section class="space-y-3">
            <SectionHeading id="inline-code" title={t.sections.inlineCode.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.inlineCode.description} />
            <ComponentPreview code={inlineCodeExample}>
                <span class="cu-code">@cubby-ui/core</span>
            </ComponentPreview>
        </section>
    </div>

</Layout>
