---
import Layout from "../../layouts/Layout.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const largeCode = `<span class="cu-text-large">Large text</span>`.trim();

const smallCode = `<span class="cu-text-small">Small text</span>`.trim();

const mutedCode = `<span class="cu-text-muted">Muted text</span>`.trim();

const inlineCodeExample = `<span class="cu-code">@cubby-ui/core</span>`.trim();
---

<Layout title="Text — Cubby UI">
    <div class="space-y-3">
        <h1 class="text-3xl font-bold tracking-tight">Text</h1>
        <p class="text-base text-muted-foreground leading-relaxed">
            Utility classes for common text styles — large, small, muted, and inline code.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Large -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Large</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-text-large</code> for emphasized, larger text.
            </p>
            <ComponentPreview code={largeCode}>
                <span class="cu-text-large">Large text</span>
            </ComponentPreview>
        </section>

        <!-- Small -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Small</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-text-small</code> for compact, secondary text.
            </p>
            <ComponentPreview code={smallCode}>
                <span class="cu-text-small">Small text</span>
            </ComponentPreview>
        </section>

        <!-- Muted -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Muted</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-text-muted</code> for
                de-emphasized helper text.
            </p>
            <ComponentPreview code={mutedCode}>
                <span class="cu-text-muted">Muted text</span>
            </ComponentPreview>
        </section>

        <!-- Inline Code -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Inline Code</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-code</code> for inline code snippets
                within text content.
            </p>
            <ComponentPreview code={inlineCodeExample}>
                <span class="cu-code">@cubby-ui/core</span>
            </ComponentPreview>
        </section>
    </div>
</Layout>
