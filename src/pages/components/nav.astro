---
import Layout from "../../layouts/Layout.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<nav class="cu-nav">
  <a class="cu-nav-item" href="#">Home</a>
  <a class="cu-nav-item" href="#">Products</a>
  <a class="cu-nav-item" href="#">About</a>
  <a class="cu-nav-item" href="#">Contact</a>
</nav>`.trim();

const activeCode = `<nav class="cu-nav">
  <a class="cu-nav-item" href="#">Home</a>
  <a class="cu-nav-item cu-nav-item-active" href="#">Products</a>
  <a class="cu-nav-item" href="#">About</a>
  <a class="cu-nav-item" href="#">Contact</a>
</nav>`.trim();

const verticalCode = `<nav class="cu-nav cu-nav-vertical">
  <a class="cu-nav-item cu-nav-item-active" href="#">Dashboard</a>
  <a class="cu-nav-item" href="#">Projects</a>
  <a class="cu-nav-item" href="#">Tasks</a>
  <a class="cu-nav-item" href="#">Settings</a>
</nav>`.trim();

const withIconsCode = `<nav class="cu-nav">
  <a class="cu-nav-item cu-nav-item-active" href="#">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
    Home
  </a>
  <a class="cu-nav-item" href="#">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/></svg>
    Projects
  </a>
  <a class="cu-nav-item" href="#">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
    Team
  </a>
</nav>`.trim();

const verticalIconsCode = `<nav class="cu-nav cu-nav-vertical" style="width:200px;">
  <a class="cu-nav-item cu-nav-item-active" href="#">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
    Dashboard
  </a>
  <a class="cu-nav-item" href="#">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/></svg>
    Projects
  </a>
  <a class="cu-nav-item" href="#">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
    Settings
  </a>
</nav>`.trim();
---

<Layout title="Nav — Cubby UI" category="Layouts" componentName="Nav">
	<div class="space-y-3">
		<div class="flex items-center gap-3">
		  <h1 class="text-3xl font-bold tracking-tight">Nav</h1>
		  <span class="cu-badge cu-badge-secondary">Layouts</span>
		</div>
		<p class="text-base text-muted-foreground leading-relaxed">
			A navigation menu that can be used horizontally in headers or vertically in sidebars.
		</p>
	</div>

	<div class="mt-10 space-y-10">
		<!-- Usage -->
		<section class="space-y-3">
			<h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
			  <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
			  Usage
			</h2>
			<p class="text-base text-muted-foreground leading-relaxed">
				Use
				<code class="cu-code">cu-nav</code> as the container and
				<code class="cu-code">cu-nav-item</code> for each link.
			</p>
			<ComponentPreview code={usageCode}>
				<nav class="cu-nav">
					<a class="cu-nav-item" href="#">Home</a>
					<a class="cu-nav-item" href="#">Products</a>
					<a class="cu-nav-item" href="#">About</a>
					<a class="cu-nav-item" href="#">Contact</a>
				</nav>
			</ComponentPreview>
		</section>

		<!-- Active Item -->
		<section class="space-y-3">
			<h2 id="active-item" class="text-lg font-semibold tracking-tight relative group">
			  <a href="#active-item" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
			  Active Item
			</h2>
			<p class="text-base text-muted-foreground leading-relaxed">
				Add
				<code class="cu-code">cu-nav-item-active</code> to mark the current page.
			</p>
			<ComponentPreview code={activeCode}>
				<nav class="cu-nav">
					<a class="cu-nav-item" href="#">Home</a>
					<a class="cu-nav-item cu-nav-item-active" href="#">Products</a>
					<a class="cu-nav-item" href="#">About</a>
					<a class="cu-nav-item" href="#">Contact</a>
				</nav>
			</ComponentPreview>
		</section>

		<!-- Vertical -->
		<section class="space-y-3">
			<h2 id="vertical" class="text-lg font-semibold tracking-tight relative group">
			  <a href="#vertical" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
			  Vertical
			</h2>
			<p class="text-base text-muted-foreground leading-relaxed">
				Add
				<code class="cu-code">cu-nav-vertical</code> for vertical layout, suitable for use inside sidebars.
			</p>
			<ComponentPreview code={verticalCode}>
				<nav class="cu-nav cu-nav-vertical" style="width:200px;">
					<a class="cu-nav-item cu-nav-item-active" href="#">Dashboard</a>
					<a class="cu-nav-item" href="#">Projects</a>
					<a class="cu-nav-item" href="#">Tasks</a>
					<a class="cu-nav-item" href="#">Settings</a>
				</nav>
			</ComponentPreview>
		</section>

		<!-- With Icons -->
		<section class="space-y-3">
			<h2 id="with-icons" class="text-lg font-semibold tracking-tight relative group">
			  <a href="#with-icons" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
			  With Icons
			</h2>
			<p class="text-base text-muted-foreground leading-relaxed">
				Items support inline SVG icons. The
				<code class="cu-code">cu-nav-item</code> class includes
				<code class="cu-code">gap-2</code> for icon spacing.
			</p>
			<ComponentPreview code={withIconsCode}>
				<nav class="cu-nav">
					<a class="cu-nav-item cu-nav-item-active" href="#">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
						Home
					</a>
					<a class="cu-nav-item" href="#">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/></svg>
						Projects
					</a>
					<a class="cu-nav-item" href="#">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
						Team
					</a>
				</nav>
			</ComponentPreview>
		</section>

		<!-- Vertical With Icons -->
		<section class="space-y-3">
			<h2 id="vertical-with-icons" class="text-lg font-semibold tracking-tight relative group">
			  <a href="#vertical-with-icons" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
			  Vertical With Icons
			</h2>
			<p class="text-base text-muted-foreground leading-relaxed">
				Combine vertical layout with icons for a sidebar-style navigation.
			</p>
			<ComponentPreview code={verticalIconsCode}>
				<nav class="cu-nav cu-nav-vertical" style="width:200px;">
					<a class="cu-nav-item cu-nav-item-active" href="#">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
						Dashboard
					</a>
					<a class="cu-nav-item" href="#">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/></svg>
						Projects
					</a>
					<a class="cu-nav-item" href="#">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
						Settings
					</a>
				</nav>
			</ComponentPreview>
		</section>
		<!-- Classes Reference -->
		<section class="space-y-3 mt-10">
			<h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
				<a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
				CSS Classes
			</h2>
			<div class="cu-table-wrapper rounded-lg border border-border">
				<table class="cu-table">
					<thead class="cu-table-header">
						<tr class="cu-table-row">
							<th class="cu-table-head">Class</th>
							<th class="cu-table-head">Description</th>
						</tr>
					</thead>
					<tbody class="cu-table-body">
						<tr class="cu-table-row">
							<td class="cu-table-cell"><code class="cu-code">cu-nav</code></td>
							<td class="cu-table-cell text-muted-foreground">Navigation menu container, horizontal layout</td>
						</tr>
						<tr class="cu-table-row">
							<td class="cu-table-cell"><code class="cu-code">cu-nav-vertical</code></td>
							<td class="cu-table-cell text-muted-foreground">Vertical layout modifier</td>
						</tr>
						<tr class="cu-table-row">
							<td class="cu-table-cell"><code class="cu-code">cu-nav-item</code></td>
							<td class="cu-table-cell text-muted-foreground">Navigation item link</td>
						</tr>
						<tr class="cu-table-row">
							<td class="cu-table-cell"><code class="cu-code">cu-nav-item-active</code></td>
							<td class="cu-table-cell text-muted-foreground">Active state with primary background and text</td>
						</tr>
					</tbody>
				</table>
			</div>
		</section>
	</div>
</Layout>
