---
import Layout from "@/layouts/Layout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { navPage } from "@/i18n/pages/components/nav";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(navPage, locale);

const usageCode = `<nav class="cu-nav">
  <a class="cu-nav-item" href="#">Home</a>
  <a class="cu-nav-item" href="#">Products</a>
  <a class="cu-nav-item" href="#">About</a>
  <a class="cu-nav-item" href="#">Contact</a>
</nav>`.trim();

const disabledCode = `<nav class="cu-nav">
  <a class="cu-nav-item" href="#">Home</a>
  <a class="cu-nav-item" href="#">Products</a>
  <a class="cu-nav-item cu-nav-item-disabled" aria-disabled="true">About</a>
  <a class="cu-nav-item" href="#">Contact</a>
</nav>`.trim();

const activeCode = `<nav class="cu-nav">
  <a class="cu-nav-item" href="#">Home</a>
  <a class="cu-nav-item cu-nav-item-active" href="#">Products</a>
  <a class="cu-nav-item" href="#">About</a>
  <a class="cu-nav-item" href="#">Contact</a>
</nav>`.trim();

const verticalCode = `<nav class="cu-nav cu-nav-vertical">
  <a class="cu-nav-item cu-nav-item-active" href="#">Dashboard</a>
  <a class="cu-nav-item" href="#">Projects</a>
  <a class="cu-nav-item" href="#">Tasks</a>
  <a class="cu-nav-item" href="#">Settings</a>
</nav>`.trim();

const withIconsCode = `<nav class="cu-nav">
  <a class="cu-nav-item cu-nav-item-active" href="#">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
    Home
  </a>
  <a class="cu-nav-item" href="#">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/></svg>
    Projects
  </a>
  <a class="cu-nav-item" href="#">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
    Team
  </a>
</nav>`.trim();

const verticalIconsCode = `<nav class="cu-nav cu-nav-vertical" style="width:200px;">
  <a class="cu-nav-item cu-nav-item-active" href="#">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
    Dashboard
  </a>
  <a class="cu-nav-item" href="#">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/></svg>
    Projects
  </a>
  <a class="cu-nav-item" href="#">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
    Settings
  </a>
</nav>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Nav">
	<div class="space-y-3">
		<div class="flex items-center gap-3">
		  <h1 class="text-3xl font-bold tracking-tight">Nav</h1>
		  <span class="cu-badge cu-badge-secondary">{t.category}</span>
		</div>
		<p class="text-base text-muted-foreground leading-relaxed">
			{t.description}
		</p>
	</div>

	<div class="mt-10 space-y-10">
		<!-- Usage -->
		<section class="space-y-3">
			<SectionHeading id="usage" title={t.sections.usage.title} />
			<p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
			<ComponentPreview code={usageCode}>
				<nav class="cu-nav">
					<a class="cu-nav-item" href="#">Home</a>
					<a class="cu-nav-item" href="#">Products</a>
					<a class="cu-nav-item" href="#">About</a>
					<a class="cu-nav-item" href="#">Contact</a>
				</nav>
			</ComponentPreview>
		</section>

		<!-- Classes Reference -->
		<section class="space-y-3">
			<SectionHeading id="classes" title={t.sections.classes.title} />
			<div class="cu-table-wrapper rounded-lg border border-border">
				<table class="cu-table">
					<thead class="cu-table-header">
						<tr class="cu-table-row">
							<th class="cu-table-head">{t.sections.classes.classLabel}</th>
							<th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
						</tr>
					</thead>
					<tbody class="cu-table-body">
						{Object.entries(t.classDescriptions).map(([cls, desc]) => (
							<tr class="cu-table-row">
								<td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
								<td class="cu-table-cell text-muted-foreground">{desc}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>


		<!-- Active Item -->
		<section class="space-y-3">
			<SectionHeading id="active-item" title={t.sections.activeItem.title} />
			<p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.activeItem.description} />
			<ComponentPreview code={activeCode}>
				<nav class="cu-nav">
					<a class="cu-nav-item" href="#">Home</a>
					<a class="cu-nav-item cu-nav-item-active" href="#">Products</a>
					<a class="cu-nav-item" href="#">About</a>
					<a class="cu-nav-item" href="#">Contact</a>
				</nav>
			</ComponentPreview>
		</section>

		<!-- Disabled -->
		<section class="space-y-3">
			<SectionHeading id="disabled" title={t.sections.disabled.title} />
			<p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.disabled.description} />
			<ComponentPreview code={disabledCode}>
				<nav class="cu-nav">
					<a class="cu-nav-item" href="#">Home</a>
					<a class="cu-nav-item" href="#">Products</a>
					<a class="cu-nav-item cu-nav-item-disabled" aria-disabled="true">About</a>
					<a class="cu-nav-item" href="#">Contact</a>
				</nav>
			</ComponentPreview>
		</section>

		<!-- Vertical -->
		<section class="space-y-3">
			<SectionHeading id="vertical" title={t.sections.vertical.title} />
			<p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.vertical.description} />
			<ComponentPreview code={verticalCode}>
				<nav class="cu-nav cu-nav-vertical" style="width:200px;">
					<a class="cu-nav-item cu-nav-item-active" href="#">Dashboard</a>
					<a class="cu-nav-item" href="#">Projects</a>
					<a class="cu-nav-item" href="#">Tasks</a>
					<a class="cu-nav-item" href="#">Settings</a>
				</nav>
			</ComponentPreview>
		</section>

		<!-- With Icons -->
		<section class="space-y-3">
			<SectionHeading id="with-icons" title={t.sections.withIcons.title} />
			<p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withIcons.description} />
			<ComponentPreview code={withIconsCode}>
				<nav class="cu-nav">
					<a class="cu-nav-item cu-nav-item-active" href="#">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
						Home
					</a>
					<a class="cu-nav-item" href="#">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/></svg>
						Projects
					</a>
					<a class="cu-nav-item" href="#">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
						Team
					</a>
				</nav>
			</ComponentPreview>
		</section>

		<!-- Vertical With Icons -->
		<section class="space-y-3">
			<SectionHeading id="vertical-with-icons" title={t.sections.verticalWithIcons.title} />
			<p class="text-base text-muted-foreground leading-relaxed">
				{t.sections.verticalWithIcons.description}
			</p>
			<ComponentPreview code={verticalIconsCode}>
				<nav class="cu-nav cu-nav-vertical" style="width:200px;">
					<a class="cu-nav-item cu-nav-item-active" href="#">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
						Dashboard
					</a>
					<a class="cu-nav-item" href="#">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/></svg>
						Projects
					</a>
					<a class="cu-nav-item" href="#">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
						Settings
					</a>
				</nav>
			</ComponentPreview>
		</section>
	</div>
</Layout>
