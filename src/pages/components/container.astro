---
import Layout from "@/layouts/Layout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { containerPage } from "@/i18n/pages/components/container";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(containerPage, locale);

const usageCode = `<div class="cu-container cu-container-lg">
  <p>Content within a max-w-screen-lg container.</p>
</div>`.trim();

const sizesCode = `<div class="cu-container cu-container-sm">
  <div class="rounded-lg border border-border bg-muted/30 px-4 py-3 text-sm text-center">
    sm — max-w-screen-sm (640px)
  </div>
</div>

<div class="cu-container cu-container-md">
  <div class="rounded-lg border border-border bg-muted/30 px-4 py-3 text-sm text-center">
    md — max-w-screen-md (768px)
  </div>
</div>

<div class="cu-container cu-container-lg">
  <div class="rounded-lg border border-border bg-muted/30 px-4 py-3 text-sm text-center">
    lg — max-w-screen-lg (1024px)
  </div>
</div>

<div class="cu-container cu-container-xl">
  <div class="rounded-lg border border-border bg-muted/30 px-4 py-3 text-sm text-center">
    xl — max-w-screen-xl (1280px)
  </div>
</div>`.trim();

const proseCode = `<div class="cu-container cu-container-prose">
  <h2 class="text-xl font-semibold mb-3">Article Title</h2>
  <p class="text-sm text-muted-foreground leading-relaxed">
    The prose container limits width to 65ch, which is the
    optimal line length for reading. This makes it ideal for
    blog posts, documentation, and any long-form text content
    where readability is a priority.
  </p>
</div>`.trim();

const noMaxWidthCode = `<div class="cu-container">
  <div class="rounded-lg border border-border bg-muted/30 px-4 py-3 text-sm text-center">
    No max-width — full width with responsive horizontal padding
  </div>
</div>`.trim();

const nestedCode = `<div class="cu-container cu-container-xl">
  <div class="flex gap-8">
    <div class="flex-1 rounded-lg border border-border bg-muted/30 px-4 py-3 text-sm text-center">
      Main content
    </div>
    <div class="w-64 shrink-0 rounded-lg border border-border bg-muted/30 px-4 py-3 text-sm text-center">
      Sidebar
    </div>
  </div>
</div>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Container" description={t.description}>
	<div class="space-y-3">
		<div class="flex items-center gap-3">
		  <h1 class="text-3xl font-bold tracking-tight">Container</h1>
		  <span class="cu-badge cu-badge-secondary">{t.category}</span>
		</div>
		<p class="text-base text-muted-foreground leading-relaxed">
			{t.description}
		</p>
	</div>

	<div class="mt-10 space-y-10">
		<!-- Usage -->
		<section class="space-y-3">
			<SectionHeading id="usage" title={t.sections.usage.title} />
			<p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
			<ComponentPreview code={usageCode}>
				<div class="w-full">
					<div class="cu-container cu-container-lg">
						<div class="rounded-lg border border-border bg-muted/30 px-4 py-3 text-sm text-center">
							Content within a max-w-screen-lg container.
						</div>
					</div>
				</div>
			</ComponentPreview>
		</section>

		<!-- Classes Reference -->
		<section class="space-y-3">
			<SectionHeading id="classes" title={t.sections.classes.title} />
			<div class="cu-table-wrapper rounded-lg border border-border">
				<table class="cu-table">
					<thead class="cu-table-header">
						<tr class="cu-table-row">
							<th class="cu-table-head">{t.sections.classes.classLabel}</th>
							<th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
						</tr>
					</thead>
					<tbody class="cu-table-body">
						{Object.entries(t.classDescriptions).map(([cls, desc]) => (
							<tr class="cu-table-row">
								<td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
								<td class="cu-table-cell text-muted-foreground" set:html={desc} />
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>


		<!-- Sizes -->
		<section class="space-y-3">
			<SectionHeading id="sizes" title={t.sections.sizes.title} />
			<p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.sizes.description} />
			<ComponentPreview code={sizesCode}>
				<div class="w-full space-y-3">
					<div class="cu-container cu-container-sm">
						<div class="rounded-lg border border-border bg-muted/30 px-4 py-3 text-sm text-center">
							sm — max-w-screen-sm (640px)
						</div>
					</div>
					<div class="cu-container cu-container-md">
						<div class="rounded-lg border border-border bg-muted/30 px-4 py-3 text-sm text-center">
							md — max-w-screen-md (768px)
						</div>
					</div>
					<div class="cu-container cu-container-lg">
						<div class="rounded-lg border border-border bg-muted/30 px-4 py-3 text-sm text-center">
							lg — max-w-screen-lg (1024px)
						</div>
					</div>
					<div class="cu-container cu-container-xl">
						<div class="rounded-lg border border-border bg-muted/30 px-4 py-3 text-sm text-center">
							xl — max-w-screen-xl (1280px)
						</div>
					</div>
				</div>
			</ComponentPreview>
		</section>

		<!-- Prose -->
		<section class="space-y-3">
			<SectionHeading id="prose" title={t.sections.prose.title} />
			<p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.prose.description} />
			<ComponentPreview code={proseCode}>
				<div class="w-full">
					<div class="cu-container cu-container-prose">
						<h2 class="text-xl font-semibold mb-3">Article Title</h2>
						<p class="text-sm text-muted-foreground leading-relaxed">
							The prose container limits width to 65ch, which is the
							optimal line length for reading. This makes it ideal for
							blog posts, documentation, and any long-form text content
							where readability is a priority.
						</p>
					</div>
				</div>
			</ComponentPreview>
		</section>

		<!-- No Max Width -->
		<section class="space-y-3">
			<SectionHeading id="no-max-width" title={t.sections.noMaxWidth.title} />
			<p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.noMaxWidth.description} />
			<ComponentPreview code={noMaxWidthCode}>
				<div class="w-full">
					<div class="cu-container">
						<div class="rounded-lg border border-border bg-muted/30 px-4 py-3 text-sm text-center">
							No max-width — full width with responsive horizontal padding
						</div>
					</div>
				</div>
			</ComponentPreview>
		</section>

		<!-- With Layout -->
		<section class="space-y-3">
			<SectionHeading id="with-layout" title={t.sections.withLayout.title} />
			<p class="text-base text-muted-foreground leading-relaxed">
				{t.sections.withLayout.description}
			</p>
			<ComponentPreview code={nestedCode}>
				<div class="w-full">
					<div class="cu-container cu-container-xl">
						<div class="flex gap-8">
							<div class="flex-1 rounded-lg border border-border bg-muted/30 px-4 py-3 text-sm text-center">
								Main content
							</div>
							<div class="w-64 shrink-0 rounded-lg border border-border bg-muted/30 px-4 py-3 text-sm text-center">
								Sidebar
							</div>
						</div>
					</div>
				</div>
			</ComponentPreview>
		</section>
	</div>
</Layout>
