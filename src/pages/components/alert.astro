---
import Layout from "../../layouts/Layout.astro";
import Alert from "../../components/ui/Alert.astro";
import AlertTitle from "../../components/ui/AlertTitle.astro";
import AlertDescription from "../../components/ui/AlertDescription.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<div class="cu-alert cu-alert-default" role="alert">
  <div>
    <h5 class="cu-alert-title">Heads up!</h5>
    <div class="cu-alert-description">You can add components to your app using the cli.</div>
  </div>
</div>`.trim();

const variantsCode = `<div class="cu-alert cu-alert-default" role="alert">
  <div>
    <h5 class="cu-alert-title">Default</h5>
    <div class="cu-alert-description">This is a default alert.</div>
  </div>
</div>

<div class="cu-alert cu-alert-destructive" role="alert">
  <div>
    <h5 class="cu-alert-title">Error</h5>
    <div class="cu-alert-description">Something went wrong.</div>
  </div>
</div>

<div class="cu-alert cu-alert-success" role="alert">
  <div>
    <h5 class="cu-alert-title">Success</h5>
    <div class="cu-alert-description">Operation completed.</div>
  </div>
</div>

<div class="cu-alert cu-alert-warning" role="alert">
  <div>
    <h5 class="cu-alert-title">Warning</h5>
    <div class="cu-alert-description">Please review your input.</div>
  </div>
</div>

<div class="cu-alert cu-alert-info" role="alert">
  <div>
    <h5 class="cu-alert-title">Info</h5>
    <div class="cu-alert-description">Here is some information.</div>
  </div>
</div>`.trim();

const withIconCode = `<div class="cu-alert cu-alert-destructive" role="alert">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
  <div>
    <h5 class="cu-alert-title">Error</h5>
    <div class="cu-alert-description">Your session has expired. Please log in again.</div>
  </div>
</div>`.trim();

const allIconsCode = `<div class="cu-alert cu-alert-success" role="alert">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m8 12 3 3 5-6"/></svg>
  <div>
    <h5 class="cu-alert-title">Changes saved</h5>
    <div class="cu-alert-description">Your profile has been updated successfully.</div>
  </div>
</div>

<div class="cu-alert cu-alert-warning" role="alert">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
  <div>
    <h5 class="cu-alert-title">Disk space low</h5>
    <div class="cu-alert-description">You have less than 500 MB of storage remaining. Consider upgrading your plan.</div>
  </div>
</div>

<div class="cu-alert cu-alert-info" role="alert">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
  <div>
    <h5 class="cu-alert-title">Scheduled maintenance</h5>
    <div class="cu-alert-description">The system will be down for maintenance on Saturday, 2:00 AM – 4:00 AM UTC.</div>
  </div>
</div>

<div class="cu-alert cu-alert-destructive" role="alert">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
  <div>
    <h5 class="cu-alert-title">Payment failed</h5>
    <div class="cu-alert-description">We couldn't process your payment. Please update your billing information.</div>
  </div>
</div>`.trim();

const withActionCode = `<div class="cu-alert cu-alert-warning" role="alert">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
  <div>
    <h5 class="cu-alert-title">Update available</h5>
    <div class="cu-alert-description">
      A new version of Cubby UI (v2.4.1) is available.
      <div class="mt-3 flex gap-2">
        <button class="cu-button cu-button-warning cu-button-xs">Update now</button>
        <button class="cu-button cu-button-ghost cu-button-xs">Dismiss</button>
      </div>
    </div>
  </div>
</div>`.trim();

const descOnlyCode = `<div class="cu-alert cu-alert-default" role="alert">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
  <div>
    <div class="cu-alert-description">You can customize these components to fit your design system.</div>
  </div>
</div>`.trim();
---

<Layout title="Alert — Cubby UI" category="Feedback" componentName="Alert">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Alert</h1>
            <span class="cu-badge cu-badge-secondary">Feedback</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            Displays a callout for important information or feedback.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Usage
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-alert</code> as the base class with a variant.
                Add <code class="cu-code">cu-alert-title</code> and <code class="cu-code">cu-alert-description</code> inside.
            </p>
            <ComponentPreview code={usageCode}>
                <Alert class="max-w-lg">
                    <div>
                        <AlertTitle>Heads up!</AlertTitle>
                        <AlertDescription>You can add components to your app using the cli.</AlertDescription>
                    </div>
                </Alert>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                CSS Classes
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">Class</th>
                            <th class="cu-table-head">Description</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-alert</code></td>
                            <td class="cu-table-cell text-muted-foreground">Alert base container with rounded corners, border, and SVG icon positioning</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-alert-default</code></td>
                            <td class="cu-table-cell text-muted-foreground">Default variant style</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-alert-destructive</code></td>
                            <td class="cu-table-cell text-muted-foreground">Destructive / error variant style</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-alert-success</code></td>
                            <td class="cu-table-cell text-muted-foreground">Success variant style</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-alert-warning</code></td>
                            <td class="cu-table-cell text-muted-foreground">Warning variant style</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-alert-info</code></td>
                            <td class="cu-table-cell text-muted-foreground">Info variant style</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-alert-title</code></td>
                            <td class="cu-table-cell text-muted-foreground">Alert title</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-alert-description</code></td>
                            <td class="cu-table-cell text-muted-foreground">Alert description text</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>


        <!-- Variants -->
        <section class="space-y-3">
            <h2 id="variants" class="text-lg font-semibold tracking-tight relative group">
                <a href="#variants" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Variants
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use variant classes to convey different levels of importance.
            </p>
            <ComponentPreview code={variantsCode}>
                <div class="flex flex-col gap-3 w-full max-w-lg">
                    <Alert>
                        <div>
                            <AlertTitle>Default</AlertTitle>
                            <AlertDescription>This is a default alert.</AlertDescription>
                        </div>
                    </Alert>
                    <Alert variant="destructive">
                        <div>
                            <AlertTitle>Error</AlertTitle>
                            <AlertDescription>Something went wrong.</AlertDescription>
                        </div>
                    </Alert>
                    <Alert variant="success">
                        <div>
                            <AlertTitle>Success</AlertTitle>
                            <AlertDescription>Operation completed.</AlertDescription>
                        </div>
                    </Alert>
                    <Alert variant="warning">
                        <div>
                            <AlertTitle>Warning</AlertTitle>
                            <AlertDescription>Please review your input.</AlertDescription>
                        </div>
                    </Alert>
                    <Alert variant="info">
                        <div>
                            <AlertTitle>Info</AlertTitle>
                            <AlertDescription>Here is some information.</AlertDescription>
                        </div>
                    </Alert>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Icon -->
        <section class="space-y-3">
            <h2 id="with-icon" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-icon" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                With Icon
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Place an SVG icon as the first child. The alert will automatically add left padding via <code class="cu-code">[&:has(svg)]:pl-10</code>.
            </p>
            <ComponentPreview code={withIconCode}>
                <Alert variant="destructive" class="max-w-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
                    <div>
                        <AlertTitle>Error</AlertTitle>
                        <AlertDescription>Your session has expired. Please log in again.</AlertDescription>
                    </div>
                </Alert>
            </ComponentPreview>
        </section>

        <!-- All Icons -->
        <section class="space-y-3">
            <h2 id="icons-for-every-variant" class="text-lg font-semibold tracking-tight relative group">
                <a href="#icons-for-every-variant" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Icons for Every Variant
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Each variant pairs well with a matching icon — checkmark for success, triangle for warning, info circle for info, and exclamation for errors.
            </p>
            <ComponentPreview code={allIconsCode}>
                <div class="flex flex-col gap-3 w-full max-w-lg">
                    <Alert variant="success">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m8 12 3 3 5-6"/></svg>
                        <div>
                            <AlertTitle>Changes saved</AlertTitle>
                            <AlertDescription>Your profile has been updated successfully.</AlertDescription>
                        </div>
                    </Alert>
                    <Alert variant="warning">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                        <div>
                            <AlertTitle>Disk space low</AlertTitle>
                            <AlertDescription>You have less than 500 MB of storage remaining. Consider upgrading your plan.</AlertDescription>
                        </div>
                    </Alert>
                    <Alert variant="info">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                        <div>
                            <AlertTitle>Scheduled maintenance</AlertTitle>
                            <AlertDescription>The system will be down for maintenance on Saturday, 2:00 AM – 4:00 AM UTC.</AlertDescription>
                        </div>
                    </Alert>
                    <Alert variant="destructive">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
                        <div>
                            <AlertTitle>Payment failed</AlertTitle>
                            <AlertDescription>We couldn't process your payment. Please update your billing information.</AlertDescription>
                        </div>
                    </Alert>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Action -->
        <section class="space-y-3">
            <h2 id="with-action" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-action" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                With Action
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Embed buttons inside the description for actionable alerts.
            </p>
            <ComponentPreview code={withActionCode}>
                <Alert variant="warning" class="max-w-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                    <div>
                        <AlertTitle>Update available</AlertTitle>
                        <AlertDescription>
                            A new version of Cubby UI (v2.4.1) is available.
                            <div class="mt-3 flex gap-2">
                                <button class="cu-button cu-button-warning cu-button-xs">Update now</button>
                                <button class="cu-button cu-button-ghost cu-button-xs">Dismiss</button>
                            </div>
                        </AlertDescription>
                    </div>
                </Alert>
            </ComponentPreview>
        </section>

        <!-- Description Only -->
        <section class="space-y-3">
            <h2 id="description-only" class="text-lg font-semibold tracking-tight relative group">
                <a href="#description-only" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Description Only
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                The title is optional — use description alone for a compact inline message.
            </p>
            <ComponentPreview code={descOnlyCode}>
                <Alert class="max-w-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                    <div>
                        <AlertDescription>You can customize these components to fit your design system.</AlertDescription>
                    </div>
                </Alert>
            </ComponentPreview>
        </section>

    </div>
</Layout>
