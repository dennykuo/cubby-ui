---
import Layout from "../../layouts/Layout.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<div class="cu-combobox" data-cu-combobox style="width: 200px;">
  <button class="cu-combobox-trigger" data-cu-combobox-trigger>
    <span data-cu-combobox-value class="cu-combobox-trigger-placeholder">Select framework...</span>
    <svg class="cu-combobox-trigger-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
  </button>
  <div class="cu-combobox-content" data-cu-combobox-content hidden>
    <div class="cu-combobox-search">
      <svg class="cu-combobox-search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input class="cu-combobox-input" data-cu-combobox-input placeholder="Search..." />
    </div>
    <div class="cu-combobox-list" data-cu-combobox-list>
      <div class="cu-combobox-empty" data-cu-combobox-empty hidden>No results found.</div>
      <div class="cu-combobox-item" data-cu-combobox-item data-cu-value="next">Next.js</div>
      <div class="cu-combobox-item" data-cu-combobox-item data-cu-value="svelte">SvelteKit</div>
      <div class="cu-combobox-item" data-cu-combobox-item data-cu-value="nuxt">Nuxt.js</div>
      <div class="cu-combobox-item" data-cu-combobox-item data-cu-value="remix">Remix</div>
      <div class="cu-combobox-item" data-cu-combobox-item data-cu-value="astro">Astro</div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll("[data-cu-combobox]").forEach((combobox) => {
    const trigger = combobox.querySelector("[data-cu-combobox-trigger]");
    const content = combobox.querySelector("[data-cu-combobox-content]");
    const input = combobox.querySelector("[data-cu-combobox-input]");
    const list = combobox.querySelector("[data-cu-combobox-list]");
    const items = combobox.querySelectorAll("[data-cu-combobox-item]");
    const empty = combobox.querySelector("[data-cu-combobox-empty]");
    const valueEl = combobox.querySelector("[data-cu-combobox-value]");
    let selected = null;

    trigger?.addEventListener("click", (e) => {
      e.stopPropagation();
      const isHidden = content?.hasAttribute("hidden");
      content?.toggleAttribute("hidden");
      if (isHidden) input?.focus();
    });

    input?.addEventListener("input", () => {
      const query = input.value.toLowerCase();
      let visible = 0;
      items.forEach((item) => {
        const match = item.textContent.toLowerCase().includes(query);
        item.toggleAttribute("hidden", !match);
        if (match) visible++;
      });
      empty?.toggleAttribute("hidden", visible > 0);
    });

    items.forEach((item) => {
      item.addEventListener("click", () => {
        selected = item.dataset.value;
        valueEl.textContent = item.textContent;
        valueEl.classList.remove("cu-combobox-trigger-placeholder");
        items.forEach((i) => i.classList.remove("cu-combobox-item-active"));
        item.classList.add("cu-combobox-item-active");
        content?.setAttribute("hidden", "");
        input.value = "";
        input?.dispatchEvent(new Event("input"));
      });
    });

    document.addEventListener("click", (e) => {
      if (!combobox.contains(e.target)) {
        content?.setAttribute("hidden", "");
        input.value = "";
        input?.dispatchEvent(new Event("input"));
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        content?.setAttribute("hidden", "");
        input.value = "";
        input?.dispatchEvent(new Event("input"));
      }
    });
  });
</script>`.trim();

const withCheckCode = `<div class="cu-combobox" data-cu-combobox style="width: 200px;">
  <button class="cu-combobox-trigger" data-cu-combobox-trigger>
    <span data-cu-combobox-value class="cu-combobox-trigger-placeholder">Select status...</span>
    <svg class="cu-combobox-trigger-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
  </button>
  <div class="cu-combobox-content" data-cu-combobox-content hidden>
    <div class="cu-combobox-search">
      <svg class="cu-combobox-search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input class="cu-combobox-input" data-cu-combobox-input placeholder="Search status..." />
    </div>
    <div class="cu-combobox-list" data-cu-combobox-list>
      <div class="cu-combobox-empty" data-cu-combobox-empty hidden>No results found.</div>
      <div class="cu-combobox-item" data-cu-combobox-item data-cu-value="backlog">Backlog</div>
      <div class="cu-combobox-item" data-cu-combobox-item data-cu-value="todo">Todo</div>
      <div class="cu-combobox-item" data-cu-combobox-item data-cu-value="in-progress">In Progress</div>
      <div class="cu-combobox-item" data-cu-combobox-item data-cu-value="done">Done</div>
      <div class="cu-combobox-item" data-cu-combobox-item data-cu-value="cancelled">Cancelled</div>
    </div>
  </div>
</div>`.trim();
---

<Layout category="Forms" componentName="Combobox" title="Combobox — Cubby UI">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Combobox</h1>
          <span class="cu-badge cu-badge-secondary">Forms</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            A searchable dropdown for selecting a value from a list of options.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
              <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Usage
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">data-cu-combobox</code> on the wrapper,
                <code class="cu-code">data-cu-combobox-trigger</code> on the button,
                <code class="cu-code">data-cu-combobox-content</code> on the dropdown, and
                <code class="cu-code">data-cu-combobox-item</code> on each option.
                The <code class="cu-code">&lt;script&gt;</code> handles search filtering,
                selection, outside click, and Escape key.
            </p>
            <ComponentPreview code={usageCode}>
                <div class="cu-combobox" data-cu-combobox style="width: 200px;">
                    <button class="cu-combobox-trigger" data-cu-combobox-trigger>
                        <span data-cu-combobox-value class="cu-combobox-trigger-placeholder">Select framework...</span>
                        <svg class="cu-combobox-trigger-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
                    </button>
                    <div class="cu-combobox-content" data-cu-combobox-content hidden>
                        <div class="cu-combobox-search">
                            <svg class="cu-combobox-search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                            <input class="cu-combobox-input" data-cu-combobox-input placeholder="Search..." />
                        </div>
                        <div class="cu-combobox-list" data-cu-combobox-list>
                            <div class="cu-combobox-empty" data-cu-combobox-empty hidden>No results found.</div>
                            <div class="cu-combobox-item" data-cu-combobox-item data-cu-value="next">Next.js</div>
                            <div class="cu-combobox-item" data-cu-combobox-item data-cu-value="svelte">SvelteKit</div>
                            <div class="cu-combobox-item" data-cu-combobox-item data-cu-value="nuxt">Nuxt.js</div>
                            <div class="cu-combobox-item" data-cu-combobox-item data-cu-value="remix">Remix</div>
                            <div class="cu-combobox-item" data-cu-combobox-item data-cu-value="astro">Astro</div>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Status Example -->
        <section class="space-y-3">
            <h2 id="status-selector" class="text-lg font-semibold tracking-tight relative group">
              <a href="#status-selector" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Status Selector
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                A common use case for filtering by status in a dashboard.
            </p>
            <ComponentPreview code={withCheckCode}>
                <div class="cu-combobox" data-cu-combobox style="width: 200px;">
                    <button class="cu-combobox-trigger" data-cu-combobox-trigger>
                        <span data-cu-combobox-value class="cu-combobox-trigger-placeholder">Select status...</span>
                        <svg class="cu-combobox-trigger-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
                    </button>
                    <div class="cu-combobox-content" data-cu-combobox-content hidden>
                        <div class="cu-combobox-search">
                            <svg class="cu-combobox-search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                            <input class="cu-combobox-input" data-cu-combobox-input placeholder="Search status..." />
                        </div>
                        <div class="cu-combobox-list" data-cu-combobox-list>
                            <div class="cu-combobox-empty" data-cu-combobox-empty hidden>No results found.</div>
                            <div class="cu-combobox-item" data-cu-combobox-item data-cu-value="backlog">Backlog</div>
                            <div class="cu-combobox-item" data-cu-combobox-item data-cu-value="todo">Todo</div>
                            <div class="cu-combobox-item" data-cu-combobox-item data-cu-value="in-progress">In Progress</div>
                            <div class="cu-combobox-item" data-cu-combobox-item data-cu-value="done">Done</div>
                            <div class="cu-combobox-item" data-cu-combobox-item data-cu-value="cancelled">Cancelled</div>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>
        <!-- Classes Reference -->
        <section class="space-y-3 mt-10">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                CSS Classes
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">Class</th>
                            <th class="cu-table-head">Description</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-combobox</code></td>
                            <td class="cu-table-cell text-muted-foreground">Combobox container, relatively positioned inline-block</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-combobox-trigger</code></td>
                            <td class="cu-table-cell text-muted-foreground">Trigger button with border, rounded corners, and focus ring</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-combobox-trigger-placeholder</code></td>
                            <td class="cu-table-cell text-muted-foreground">Placeholder text in trigger button</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-combobox-trigger-icon</code></td>
                            <td class="cu-table-cell text-muted-foreground">Arrow icon on the right side of trigger</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-combobox-content</code></td>
                            <td class="cu-table-cell text-muted-foreground">Floating dropdown panel with rounded corners and shadow</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-combobox-search</code></td>
                            <td class="cu-table-cell text-muted-foreground">Search bar container with bottom border</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-combobox-search-icon</code></td>
                            <td class="cu-table-cell text-muted-foreground">Search icon in the search bar</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-combobox-input</code></td>
                            <td class="cu-table-cell text-muted-foreground">Search input with transparent background</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-combobox-list</code></td>
                            <td class="cu-table-cell text-muted-foreground">Options list container, scrollable (max height 200px)</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-combobox-empty</code></td>
                            <td class="cu-table-cell text-muted-foreground">Empty state text when no results found</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-combobox-item</code></td>
                            <td class="cu-table-cell text-muted-foreground">Option item with hover background</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-combobox-item-active</code></td>
                            <td class="cu-table-cell text-muted-foreground">Selected option item</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-combobox-item-check</code></td>
                            <td class="cu-table-cell text-muted-foreground">Check icon on the right side of option</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</Layout>
