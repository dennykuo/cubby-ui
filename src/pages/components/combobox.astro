            </div>
        </section>

        <!-- With Icons -->
        <section class="space-y-3">
            <SectionHeading id="with-icons" title={t.sections.withIcons.title} />
            <p class="text-base text-muted-foreground leading-relaxed">{t.sections.withIcons.description}</p>
            <ComponentPreview code={withIconsCode}>
                <div class="cu-combobox" data-cu-combobox style="width: 220px;">
                    <button class="cu-combobox-trigger" data-cu-combobox-trigger>
