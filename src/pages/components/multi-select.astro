                        <div class="cu-multi-select-list" data-cu-multi-select-list>
                            <div class="cu-multi-select-item cu-multi-select-item-active" data-cu-multi-select-item data-cu-value="bug">Bug</div>
                            <div class="cu-multi-select-item cu-multi-select-item-active" data-cu-multi-select-item data-cu-value="feature">Feature</div>
                            <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="docs">Documentation</div>
                            <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="enhancement">Enhancement</div>
                            <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="help">Help Wanted</div>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>
