        <!-- Preset Values -->
        <section class="space-y-3">
            <h2 id="preset-values" class="text-lg font-semibold tracking-tight relative group">
              <a href="#preset-values" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
