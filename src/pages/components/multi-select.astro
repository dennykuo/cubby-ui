                        </div>
                        <svg class="cu-multi-select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
                    </button>
                    <div class="cu-multi-select-content" data-cu-multi-select-content hidden>
                        <div class="cu-multi-select-list" data-cu-multi-select-list>
                            <div class="cu-multi-select-item cu-multi-select-item-active" data-cu-multi-select-item data-cu-value="bug">Bug</div>
                            <div class="cu-multi-select-item cu-multi-select-item-active" data-cu-multi-select-item data-cu-value="feature">Feature</div>
                            <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="docs">Documentation</div>
                            <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="enhancement">Enhancement</div>
                            <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="help">Help Wanted</div>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>

<script>
    function setupMultiSelects() {
        document.querySelectorAll("[data-cu-multi-select]").forEach((ms) => {
            if ((ms as any)._multiSelectInit) return;
            (ms as any)._multiSelectInit = true;

            const trigger = ms.querySelector("[data-cu-multi-select-trigger]") as HTMLButtonElement | null;
            const content = ms.querySelector("[data-cu-multi-select-content]") as HTMLElement | null;
            const input = ms.querySelector("[data-cu-multi-select-input]") as HTMLInputElement | null;
            const items = ms.querySelectorAll("[data-cu-multi-select-item]");
            const empty = ms.querySelector("[data-cu-multi-select-empty]") as HTMLElement | null;
            const tagsEl = ms.querySelector("[data-cu-multi-select-tags]") as HTMLElement | null;
            const placeholder = ms.querySelector("[data-cu-multi-select-placeholder]") as HTMLElement | null;
            const selected = new Set<string>();

            // Init from preset active items
            items.forEach((item) => {
                if (item.classList.contains("cu-multi-select-item-active")) {
                    selected.add((item as HTMLElement).dataset.value || "");
                }
            });

            function renderTags() {
                if (!tagsEl) return;
                tagsEl.querySelectorAll(".cu-multi-select-tag").forEach((t) => t.remove());
                if (selected.size === 0) {
                    if (placeholder) placeholder.hidden = false;
                } else {
                    if (placeholder) placeholder.hidden = true;
                    selected.forEach((val) => {
                        const item = ms.querySelector('[data-cu-value="' + val + '"]');
                        if (!item) return;
                        const tag = document.createElement("span");
                        tag.className = "cu-multi-select-tag";
                        tag.innerHTML = item.textContent + '<button class="cu-multi-select-tag-remove" data-cu-remove="' + val + '">&times;</button>';
                        tag.querySelector("[data-cu-remove]")?.addEventListener("click", (e) => {
                            e.stopPropagation();
                            selected.delete(val);
                            item.classList.remove("cu-multi-select-item-active");
                            renderTags();
                        });
                        tagsEl.appendChild(tag);
                    });
                }
            }

            trigger?.addEventListener("click", (e) => {
                e.stopPropagation();
                const isHidden = content?.hasAttribute("hidden");
                content?.toggleAttribute("hidden");
                if (isHidden && input) input.focus();
            });

            if (input) {
                input.addEventListener("input", () => {
                    const query = (input as HTMLInputElement).value.toLowerCase();
                    let visible = 0;
                    items.forEach((item) => {
                        const match = (item.textContent || "").toLowerCase().includes(query);
                        (item as HTMLElement).toggleAttribute("hidden", !match);
                        if (match) visible++;
                    });
                    empty?.toggleAttribute("hidden", visible > 0);
                });
            }

            items.forEach((item) => {
                item.addEventListener("click", (e) => {
                    e.stopPropagation();
                    const val = (item as HTMLElement).dataset.value || "";
                    if (selected.has(val)) {
                        selected.delete(val);
                        item.classList.remove("cu-multi-select-item-active");
                    } else {
                        selected.add(val);
                        item.classList.add("cu-multi-select-item-active");
                    }
                    renderTags();
                });
            });

            document.addEventListener("click", (e) => {
                if (!ms.contains(e.target as Node)) {
                    content?.setAttribute("hidden", "");
                    if (input) {
                        (input as HTMLInputElement).value = "";
                        input.dispatchEvent(new Event("input"));
                    }
                }
            });

            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape") {
                    content?.setAttribute("hidden", "");
                    if (input) {
                        (input as HTMLInputElement).value = "";
                        input.dispatchEvent(new Event("input"));
                    }
                }
            });
        });
    }

    setupMultiSelects();
    document.addEventListener("astro:page-load", setupMultiSelects);
</script>
