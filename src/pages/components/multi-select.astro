---
import Layout from "../../layouts/Layout.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<div class="cu-multi-select" data-cu-multi-select style="width: 300px;">
  <button class="cu-multi-select-trigger" data-cu-multi-select-trigger>
    <div class="cu-multi-select-tags" data-cu-multi-select-tags>
      <span class="cu-multi-select-placeholder" data-cu-multi-select-placeholder>Select frameworks...</span>
    </div>
    <svg class="cu-multi-select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
  </button>
  <div class="cu-multi-select-content" data-cu-multi-select-content hidden>
    <div class="cu-multi-select-list" data-cu-multi-select-list>
      <div class="cu-multi-select-empty" data-cu-multi-select-empty hidden>No results found.</div>
      <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="react">React</div>
      <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="vue">Vue</div>
      <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="angular">Angular</div>
      <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="svelte">Svelte</div>
      <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="astro">Astro</div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll("[data-cu-multi-select]").forEach((ms) => {
    const trigger = ms.querySelector("[data-cu-multi-select-trigger]");
    const content = ms.querySelector("[data-cu-multi-select-content]");
    const input = ms.querySelector("[data-cu-multi-select-input]");
    const items = ms.querySelectorAll("[data-cu-multi-select-item]");
    const empty = ms.querySelector("[data-cu-multi-select-empty]");
    const tagsEl = ms.querySelector("[data-cu-multi-select-tags]");
    const placeholder = ms.querySelector("[data-cu-multi-select-placeholder]");
    const selected = new Set();

    function renderTags() {
      tagsEl.querySelectorAll(".cu-multi-select-tag").forEach((t) => t.remove());
      if (selected.size === 0) {
        if (placeholder) placeholder.hidden = false;
      } else {
        if (placeholder) placeholder.hidden = true;
        selected.forEach((val) => {
          const item = ms.querySelector('[data-cu-value="' + val + '"]');
          const tag = document.createElement("span");
          tag.className = "cu-multi-select-tag";
          tag.innerHTML = item.textContent + '<button class="cu-multi-select-tag-remove" data-cu-remove="' + val + '">&times;</button>';
          tag.querySelector("[data-cu-remove]").addEventListener("click", (e) => {
            e.stopPropagation();
            selected.delete(val);
            item.classList.remove("cu-multi-select-item-active");
            renderTags();
          });
          tagsEl.appendChild(tag);
        });
      }
    }

    trigger?.addEventListener("click", (e) => {
      e.stopPropagation();
      const isHidden = content?.hasAttribute("hidden");
      content?.toggleAttribute("hidden");
      if (isHidden && input) input.focus();
    });

    if (input) {
      input.addEventListener("input", () => {
        const query = input.value.toLowerCase();
        let visible = 0;
        items.forEach((item) => {
          const match = item.textContent.toLowerCase().includes(query);
          item.toggleAttribute("hidden", !match);
          if (match) visible++;
        });
        empty?.toggleAttribute("hidden", visible > 0);
      });
    }

    items.forEach((item) => {
      item.addEventListener("click", (e) => {
        e.stopPropagation();
        const val = item.dataset.value;
        if (selected.has(val)) {
          selected.delete(val);
          item.classList.remove("cu-multi-select-item-active");
        } else {
          selected.add(val);
          item.classList.add("cu-multi-select-item-active");
        }
        renderTags();
      });
    });

    document.addEventListener("click", (e) => {
      if (!ms.contains(e.target)) {
        content?.setAttribute("hidden", "");
        if (input) { input.value = ""; input.dispatchEvent(new Event("input")); }
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        content?.setAttribute("hidden", "");
        if (input) { input.value = ""; input.dispatchEvent(new Event("input")); }
      }
    });
  });
</script>`.trim();

