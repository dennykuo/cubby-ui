---
import Layout from "@/layouts/Layout.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { multiSelectPage } from "@/i18n/pages/components/multi-select";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(multiSelectPage, locale);
const SO = "<" + "script>";
const SC = "</" + "script>";

const usageCode = `<div class="cu-multi-select" data-cu-multi-select style="width: 300px;">
  <button class="cu-multi-select-trigger" data-cu-multi-select-trigger>
    <div class="cu-multi-select-tags" data-cu-multi-select-tags>
      <span class="cu-multi-select-placeholder" data-cu-multi-select-placeholder>Select frameworks...</span>
    </div>
    <svg class="cu-multi-select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
  </button>
  <div class="cu-multi-select-content" data-cu-multi-select-content hidden>
    <div class="cu-multi-select-list" data-cu-multi-select-list>
      <div class="cu-multi-select-empty" data-cu-multi-select-empty hidden>No results found.</div>
      <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="react">React</div>
      <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="vue">Vue</div>
      <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="angular">Angular</div>
      <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="svelte">Svelte</div>
      <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="astro">Astro</div>
    </div>
  </div>
</div>

${SO}
  document.querySelectorAll("[data-cu-multi-select]").forEach((ms) => {
    const trigger = ms.querySelector("[data-cu-multi-select-trigger]");
    const content = ms.querySelector("[data-cu-multi-select-content]");
    const input = ms.querySelector("[data-cu-multi-select-input]");
    const items = ms.querySelectorAll("[data-cu-multi-select-item]");
    const empty = ms.querySelector("[data-cu-multi-select-empty]");
    const tagsEl = ms.querySelector("[data-cu-multi-select-tags]");
    const placeholder = ms.querySelector("[data-cu-multi-select-placeholder]");
    const selected = new Set();

    function renderTags() {
      tagsEl.querySelectorAll(".cu-multi-select-tag").forEach((t) => t.remove());
      if (selected.size === 0) {
        if (placeholder) placeholder.hidden = false;
      } else {
        if (placeholder) placeholder.hidden = true;
        selected.forEach((val) => {
          const item = ms.querySelector('[data-cu-value="' + val + '"]');
          const tag = document.createElement("span");
          tag.className = "cu-multi-select-tag";
          tag.innerHTML = item.textContent + '<button class="cu-multi-select-tag-remove" data-cu-remove="' + val + '">&times;</button>';
          tag.querySelector("[data-cu-remove]").addEventListener("click", (e) => {
            e.stopPropagation();
            selected.delete(val);
            item.classList.remove("cu-multi-select-item-active");
            renderTags();
          });
          tagsEl.appendChild(tag);
        });
      }
    }

    trigger?.addEventListener("click", (e) => {
      e.stopPropagation();
      const isHidden = content?.hasAttribute("hidden");
      content?.toggleAttribute("hidden");
      if (isHidden && input) input.focus();
    });

    if (input) {
      input.addEventListener("input", () => {
        const query = input.value.toLowerCase();
        let visible = 0;
        items.forEach((item) => {
          const match = item.textContent.toLowerCase().includes(query);
          item.toggleAttribute("hidden", !match);
          if (match) visible++;
        });
        empty?.toggleAttribute("hidden", visible > 0);
      });
    }

    items.forEach((item) => {
      item.addEventListener("click", (e) => {
        e.stopPropagation();
        const val = item.dataset.value;
        if (selected.has(val)) {
          selected.delete(val);
          item.classList.remove("cu-multi-select-item-active");
        } else {
          selected.add(val);
          item.classList.add("cu-multi-select-item-active");
        }
        renderTags();
      });
    });

    document.addEventListener("click", (e) => {
      if (!ms.contains(e.target)) {
        content?.setAttribute("hidden", "");
        if (input) { input.value = ""; input.dispatchEvent(new Event("input")); }
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        content?.setAttribute("hidden", "");
        if (input) { input.value = ""; input.dispatchEvent(new Event("input")); }
      }
    });
  });
${SC}`.trim();

const withSearchCode = `<div class="cu-multi-select" data-cu-multi-select style="width: 300px;">
  <button class="cu-multi-select-trigger" data-cu-multi-select-trigger>
    <div class="cu-multi-select-tags" data-cu-multi-select-tags>
      <span class="cu-multi-select-placeholder" data-cu-multi-select-placeholder>Select members...</span>
    </div>
    <svg class="cu-multi-select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
  </button>
  <div class="cu-multi-select-content" data-cu-multi-select-content hidden>
    <div class="cu-multi-select-search">
      <svg class="cu-multi-select-search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input class="cu-multi-select-input" data-cu-multi-select-input placeholder="Search members..." />
    </div>
    <div class="cu-multi-select-list" data-cu-multi-select-list>
      <div class="cu-multi-select-empty" data-cu-multi-select-empty hidden>No results found.</div>
      <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="alice">Alice</div>
      <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="bob">Bob</div>
      <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="charlie">Charlie</div>
      <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="diana">Diana</div>
      <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="eve">Eve</div>
    </div>
  </div>
</div>`.trim();

const presetCode = `<div class="cu-multi-select" data-cu-multi-select style="width: 300px;">
  <button class="cu-multi-select-trigger" data-cu-multi-select-trigger>
    <div class="cu-multi-select-tags" data-cu-multi-select-tags>
      <span class="cu-multi-select-placeholder" data-cu-multi-select-placeholder hidden>Select tags...</span>
      <span class="cu-multi-select-tag">Bug<button class="cu-multi-select-tag-remove" data-cu-remove="bug">&times;</button></span>
      <span class="cu-multi-select-tag">Feature<button class="cu-multi-select-tag-remove" data-cu-remove="feature">&times;</button></span>
    </div>
    <svg class="cu-multi-select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
  </button>
  <div class="cu-multi-select-content" data-cu-multi-select-content hidden>
    <div class="cu-multi-select-list" data-cu-multi-select-list>
      <div class="cu-multi-select-item cu-multi-select-item-active" data-cu-multi-select-item data-cu-value="bug">Bug</div>
      <div class="cu-multi-select-item cu-multi-select-item-active" data-cu-multi-select-item data-cu-value="feature">Feature</div>
      <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="docs">Documentation</div>
      <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="enhancement">Enhancement</div>
      <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="help">Help Wanted</div>
    </div>
  </div>
</div>`.trim();
---

<Layout category={t.category} componentName="Multi Select" title={t.title}>
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Multi Select</h1>
          <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
              <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <div class="cu-multi-select" data-cu-multi-select style="width: 300px;">
                    <button class="cu-multi-select-trigger" data-cu-multi-select-trigger>
                        <div class="cu-multi-select-tags" data-cu-multi-select-tags>
                            <span class="cu-multi-select-placeholder" data-cu-multi-select-placeholder>Select frameworks...</span>
                        </div>
                        <svg class="cu-multi-select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
                    </button>
                    <div class="cu-multi-select-content" data-cu-multi-select-content hidden>
                        <div class="cu-multi-select-list" data-cu-multi-select-list>
                            <div class="cu-multi-select-empty" data-cu-multi-select-empty hidden>No results found.</div>
                            <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="react">React</div>
                            <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="vue">Vue</div>
                            <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="angular">Angular</div>
                            <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="svelte">Svelte</div>
                            <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="astro">Astro</div>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.classes.title}
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-multi-select</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-multi-select']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-multi-select-trigger</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-multi-select-trigger']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-multi-select-tags</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-multi-select-tags']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-multi-select-tag</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-multi-select-tag']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-multi-select-tag-remove</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-multi-select-tag-remove']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-multi-select-placeholder</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-multi-select-placeholder']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-multi-select-icon</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-multi-select-icon']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-multi-select-content</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-multi-select-content']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-multi-select-search</code></td>
