<Layout title="Multi Select — Cubby UI">
    <div class="space-y-3">
        <h1 class="text-3xl font-bold tracking-tight">Multi Select</h1>
        <p class="text-base text-muted-foreground leading-relaxed">
            A multi-selection dropdown with tag display, supporting search filtering and removal.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Usage</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Use <code class="cu-code">data-cu-multi-select</code> on the wrapper,
                <code class="cu-code">data-cu-multi-select-trigger</code> on the button,
                <code class="cu-code">data-cu-multi-select-content</code> on the dropdown, and
                <code class="cu-code">data-cu-multi-select-item</code> on each option.
                Selected items appear as removable tags in the trigger area.
            </p>
            <ComponentPreview code={usageCode}>
                <div class="cu-multi-select" data-cu-multi-select style="width: 300px;">
                    <button class="cu-multi-select-trigger" data-cu-multi-select-trigger>
                        <div class="cu-multi-select-tags" data-cu-multi-select-tags>
                            <span class="cu-multi-select-placeholder" data-cu-multi-select-placeholder>Select frameworks...</span>
                        </div>
                        <svg class="cu-multi-select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
                    </button>
                    <div class="cu-multi-select-content" data-cu-multi-select-content hidden>
                        <div class="cu-multi-select-list" data-cu-multi-select-list>
                            <div class="cu-multi-select-empty" data-cu-multi-select-empty hidden>No results found.</div>
                            <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="react">React</div>
                            <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="vue">Vue</div>
                            <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="angular">Angular</div>
                            <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="svelte">Svelte</div>
                            <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="astro">Astro</div>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Search -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">With Search</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Add a search input with <code class="cu-code">cu-multi-select-search</code> to filter options.
            </p>
            <ComponentPreview code={withSearchCode}>
