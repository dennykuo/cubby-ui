                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-multi-select-list']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-multi-select-empty</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-multi-select-empty']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-multi-select-item</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-multi-select-item']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-multi-select-item-active</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-multi-select-item-active']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-multi-select-item-check</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-multi-select-item-check']}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>


        <!-- With Search -->
        <section class="space-y-3">
            <h2 id="with-search" class="text-lg font-semibold tracking-tight relative group">
              <a href="#with-search" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.withSearch.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withSearch.description} />
            <ComponentPreview code={withSearchCode}>
                <div class="cu-multi-select" data-cu-multi-select style="width: 300px;">
                    <button class="cu-multi-select-trigger" data-cu-multi-select-trigger>
                        <div class="cu-multi-select-tags" data-cu-multi-select-tags>
                            <span class="cu-multi-select-placeholder" data-cu-multi-select-placeholder>Select members...</span>
                        </div>
                        <svg class="cu-multi-select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
                    </button>
                    <div class="cu-multi-select-content" data-cu-multi-select-content hidden>
                        <div class="cu-multi-select-search">
                            <svg class="cu-multi-select-search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                            <input class="cu-multi-select-input" data-cu-multi-select-input placeholder="Search members..." />
                        </div>
                        <div class="cu-multi-select-list" data-cu-multi-select-list>
                            <div class="cu-multi-select-empty" data-cu-multi-select-empty hidden>No results found.</div>
                            <div class="cu-multi-select-item" data-cu-multi-select-item data-cu-value="alice">Alice</div>
