---
import Layout from "../../layouts/Layout.astro";
import Skeleton from "../../components/ui/Skeleton.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<div class="cu-skeleton h-4 w-[250px]"></div>`.trim();

const cardSkeletonCode = `<div class="flex items-center space-x-4">
  <div class="cu-skeleton h-12 w-12 rounded-full"></div>
  <div class="space-y-2">
    <div class="cu-skeleton h-4 w-[250px]"></div>
    <div class="cu-skeleton h-4 w-[200px]"></div>
  </div>
</div>`.trim();

const shimmerCode = `<div class="space-y-3">
  <div class="cu-skeleton-shimmer h-5 w-2/5"></div>
  <div class="cu-skeleton-shimmer h-4 w-full"></div>
  <div class="cu-skeleton-shimmer h-4 w-full"></div>
  <div class="cu-skeleton-shimmer h-4 w-4/5"></div>
</div>`.trim();

const contentSkeletonCode = `<div class="space-y-3">
  <div class="cu-skeleton h-5 w-2/5"></div>
  <div class="cu-skeleton h-4 w-full"></div>
  <div class="cu-skeleton h-4 w-full"></div>
  <div class="cu-skeleton h-4 w-4/5"></div>
</div>`.trim();
---

<Layout title="Skeleton — Cubby UI">
    <div class="space-y-3">
        <h1 class="text-3xl font-bold tracking-tight">Skeleton</h1>
        <p class="text-base text-muted-foreground leading-relaxed">
            Use to show a placeholder while content is loading.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Usage</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Apply <code class="cu-code">cu-skeleton</code> to an empty element and set its dimensions with utility classes.
            </p>
            <ComponentPreview code={usageCode}>
                <Skeleton class="h-4 w-[250px]" />
            </ComponentPreview>
        </section>

        <!-- Card Skeleton -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Card Skeleton</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Combine multiple skeletons to mimic a card layout.
            </p>
            <ComponentPreview code={cardSkeletonCode}>
                <div class="flex items-center space-x-4">
                    <Skeleton class="h-12 w-12 rounded-full" />
                    <div class="space-y-2">
                        <Skeleton class="h-4 w-[250px]" />
                        <Skeleton class="h-4 w-[200px]" />
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Content Skeleton -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Content Skeleton</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Simulate text content blocks for article or page loading states.
            </p>
            <ComponentPreview code={contentSkeletonCode}>
                <div class="space-y-3 w-full max-w-md">
                    <Skeleton class="h-5 w-2/5" />
                    <Skeleton class="h-4 w-full" />
                    <Skeleton class="h-4 w-full" />
                    <Skeleton class="h-4 w-4/5" />
                </div>
            </ComponentPreview>
        </section>
        <!-- Shimmer -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Shimmer</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-skeleton-shimmer</code> for a sweeping light effect instead of the default pulse.
            </p>
            <ComponentPreview code={shimmerCode}>
                <div class="space-y-3 w-full max-w-md">
                    <div class="cu-skeleton-shimmer h-5 w-2/5"></div>
                    <div class="cu-skeleton-shimmer h-4 w-full"></div>
                    <div class="cu-skeleton-shimmer h-4 w-full"></div>
                    <div class="cu-skeleton-shimmer h-4 w-4/5"></div>
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>
