---
import Layout from "@/layouts/Layout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { numberInputPage } from "@/i18n/pages/components/number-input";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(numberInputPage, locale);
const SO = "<" + "script>";
const SC = "</" + "script>";

const usageCode = `<div class="cu-number-input" data-cu-number-input>
  <button class="cu-number-input-button" data-cu-number-decrement>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></svg>
  </button>
  <input class="cu-number-input-field" data-cu-number-field type="number" value="0" />
  <button class="cu-number-input-button" data-cu-number-increment>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
  </button>
</div>

${SO}
  document.querySelectorAll("[data-cu-number-input]").forEach((container) => {
    const field = container.querySelector("[data-cu-number-field]");
    const decrement = container.querySelector("[data-cu-number-decrement]");
    const increment = container.querySelector("[data-cu-number-increment]");

    decrement?.addEventListener("click", () => {
      const step = Number(field.step) || 1;
      const min = field.min !== "" ? Number(field.min) : -Infinity;
      const current = Number(field.value) || 0;
      const next = current - step;
      if (next >= min) {
        field.value = next;
        field.dispatchEvent(new Event("input", { bubbles: true }));
      }
    });

    increment?.addEventListener("click", () => {
      const step = Number(field.step) || 1;
      const max = field.max !== "" ? Number(field.max) : Infinity;
      const current = Number(field.value) || 0;
      const next = current + step;
      if (next <= max) {
        field.value = next;
        field.dispatchEvent(new Event("input", { bubbles: true }));
      }
    });
  });
${SC}`.trim();

const minMaxCode = `<div class="cu-number-input" data-cu-number-input>
  <button class="cu-number-input-button" data-cu-number-decrement>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></svg>
  </button>
  <input class="cu-number-input-field" data-cu-number-field type="number" value="1" min="1" max="10" step="1" />
  <button class="cu-number-input-button" data-cu-number-increment>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
  </button>
</div>`.trim();

const disabledCode = `<div class="cu-number-input cu-number-input-disabled" data-cu-number-input>
  <button class="cu-number-input-button" data-cu-number-decrement disabled>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></svg>
  </button>
  <input class="cu-number-input-field" data-cu-number-field type="number" value="5" disabled />
  <button class="cu-number-input-button" data-cu-number-increment disabled>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
  </button>
</div>`.trim();

const withPrefixSuffixCode = `<div class="flex items-center gap-6">
  <div class="space-y-1.5">
    <label class="cu-label text-xs">Weight</label>
    <div class="flex items-center">
      <div class="cu-number-input" data-cu-number-input>
        <button class="cu-number-input-button" data-cu-number-decrement>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></svg>
        </button>
        <input type="number" class="cu-number-input-field" data-cu-number-field value="75" min="0" max="500" />
        <button class="cu-number-input-button" data-cu-number-increment>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        </button>
      </div>
      <span class="ml-2 text-sm text-muted-foreground">kg</span>
    </div>
  </div>
  <div class="space-y-1.5">
    <label class="cu-label text-xs">Opacity</label>
    <div class="flex items-center">
      <div class="cu-number-input" data-cu-number-input>
        <button class="cu-number-input-button" data-cu-number-decrement>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></svg>
        </button>
        <input type="number" class="cu-number-input-field" data-cu-number-field value="80" min="0" max="100" />
        <button class="cu-number-input-button" data-cu-number-increment>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        </button>
      </div>
      <span class="ml-2 text-sm text-muted-foreground">%</span>
    </div>
  </div>
</div>`.trim();

const currencyCode = `<div class="w-[250px]">
  <label class="cu-label" for="cur-amount">Amount</label>
  <div class="flex items-center mt-1.5">
    <span class="flex h-9 items-center rounded-l-lg border border-r-0 border-input bg-muted px-3 text-sm text-muted-foreground">$</span>
    <div class="cu-number-input flex-1" data-cu-number-input>
      <input type="number" id="cur-amount" class="cu-number-input-field !rounded-l-none" data-cu-number-field value="99" min="0" step="0.01" />
    </div>
  </div>
  <p class="mt-1 text-xs text-muted-foreground">Enter the amount in USD</p>
</div>`.trim();
---

<Layout category={t.category} componentName="Number Input" title={t.title}>
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Number Input</h1>
          <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <SectionHeading id="usage" title={t.sections.usage.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <div class="cu-number-input" data-cu-number-input>
                    <button class="cu-number-input-button" data-cu-number-decrement>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></svg>
                    </button>
                    <input class="cu-number-input-field" data-cu-number-field type="number" value="0" />
                    <button class="cu-number-input-button" data-cu-number-increment>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                    </button>
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <SectionHeading id="classes" title={t.sections.classes.title} />
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-number-input</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-number-input']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-number-input-button</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-number-input-button']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-number-input-field</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-number-input-field']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-number-input-disabled</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-number-input-disabled']}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>


        <!-- With Min/Max -->
        <section class="space-y-3">
            <SectionHeading id="with-min-max" title={t.sections.withMinMax.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withMinMax.description} />
            <ComponentPreview code={minMaxCode}>
                <div class="cu-number-input" data-cu-number-input>
                    <button class="cu-number-input-button" data-cu-number-decrement>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></svg>
                    </button>
                    <input class="cu-number-input-field" data-cu-number-field type="number" value="1" min="1" max="10" step="1" />
                    <button class="cu-number-input-button" data-cu-number-increment>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                    </button>
                </div>
            </ComponentPreview>
        </section>

        <!-- Disabled -->
        <section class="space-y-3">
            <SectionHeading id="disabled" title={t.sections.disabled.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.disabled.description} />
            <ComponentPreview code={disabledCode}>
                <div class="cu-number-input cu-number-input-disabled" data-cu-number-input>
                    <button class="cu-number-input-button" data-cu-number-decrement disabled>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></svg>
                    </button>
                    <input class="cu-number-input-field" data-cu-number-field type="number" value="5" disabled />
                    <button class="cu-number-input-button" data-cu-number-increment disabled>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                    </button>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Prefix / Suffix -->
        <section class="space-y-3">
            <SectionHeading id="with-prefix-suffix" title={t.sections.withPrefixSuffix.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withPrefixSuffix.description} />
            <ComponentPreview code={withPrefixSuffixCode}>
                <div class="flex items-center gap-6">
                    <div class="space-y-1.5">
                        <label class="cu-label text-xs">Weight</label>
                        <div class="flex items-center">
                            <div class="cu-number-input" data-cu-number-input>
                                <button class="cu-number-input-button" data-cu-number-decrement>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></svg>
                                </button>
                                <input type="number" class="cu-number-input-field" data-cu-number-field value="75" min="0" max="500" />
                                <button class="cu-number-input-button" data-cu-number-increment>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                                </button>
                            </div>
                            <span class="ml-2 text-sm text-muted-foreground">kg</span>
                        </div>
                    </div>
                    <div class="space-y-1.5">
                        <label class="cu-label text-xs">Opacity</label>
                        <div class="flex items-center">
                            <div class="cu-number-input" data-cu-number-input>
                                <button class="cu-number-input-button" data-cu-number-decrement>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></svg>
                                </button>
                                <input type="number" class="cu-number-input-field" data-cu-number-field value="80" min="0" max="100" />
                                <button class="cu-number-input-button" data-cu-number-increment>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                                </button>
                            </div>
                            <span class="ml-2 text-sm text-muted-foreground">%</span>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Currency Input -->
        <section class="space-y-3">
            <SectionHeading id="currency" title={t.sections.currency.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.currency.description} />
            <ComponentPreview code={currencyCode}>
                <div class="w-[250px]">
                    <label class="cu-label" for="cur-amount">Amount</label>
                    <div class="flex items-center mt-1.5">
                        <span class="flex h-9 items-center rounded-l-lg border border-r-0 border-input bg-muted px-3 text-sm text-muted-foreground">$</span>
                        <div class="cu-number-input flex-1" data-cu-number-input>
                            <input type="number" id="cur-amount" class="cu-number-input-field !rounded-l-none" data-cu-number-field value="99" min="0" step="0.01" />
                        </div>
                    </div>
                    <p class="mt-1 text-xs text-muted-foreground">Enter the amount in USD</p>
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>
