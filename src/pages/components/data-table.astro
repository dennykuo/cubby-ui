<script>
    function setupDataTables() {
        // Select all / individual row selection
        document.querySelectorAll("[data-cu-data-table-select-all]").forEach((selectAll) => {
            const table = selectAll.closest("table");
            const rows = table?.querySelectorAll("[data-cu-data-table-select]") || [];
            const info = table?.closest(".cu-data-table")?.querySelector("[data-cu-data-table-selected]");
            function updateInfo() {
                const checked = table?.querySelectorAll("[data-cu-data-table-select]:checked").length || 0;
                if (info) info.textContent = checked + ' of ' + rows.length + ' row(s) selected.';
                rows.forEach((cb) => {
                    const input = cb as HTMLInputElement;
                    input.closest("tr")?.classList.toggle("cu-data-table-row-selected", input.checked);
                });
            }
            selectAll.addEventListener("change", () => {
                rows.forEach((cb) => { (cb as HTMLInputElement).checked = (selectAll as HTMLInputElement).checked; });
                updateInfo();
            });
            rows.forEach((cb) => cb.addEventListener("change", updateInfo));
        });

        // Filter rows
        document.querySelectorAll("[data-cu-data-table-filter]").forEach((input) => {
            const wrapper = input.closest(".cu-data-table");
            const rows = wrapper?.querySelectorAll("tbody .cu-table-row") || [];
            input.addEventListener("input", () => {
                const v = (input as HTMLInputElement).value.toLowerCase();
                rows.forEach((row) => {
                    const email = row.getAttribute("data-email") || row.textContent || "";
                    (row as HTMLElement).style.display = email.toLowerCase().includes(v) ? "" : "none";
                });
            });
        });
    }

    setupDataTables();
    document.addEventListener("astro:page-load", setupDataTables);
</script>
