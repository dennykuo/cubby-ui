---
import Layout from "../../layouts/Layout.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<button class="cu-button cu-button-outline cu-button-md" data-cu-toast-trigger
  data-cu-toast-title="Event has been created"
  data-cu-toast-description="Sunday, December 03, 2023 at 9:00 AM">
  Show Toast
</button>

<div class="cu-toast-container cu-toast-container-bottom-right" data-cu-toast-container></div>

<script>
  document.querySelectorAll("[data-cu-toast-trigger]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const container = document.querySelector("[data-cu-toast-container]");
      if (!container) return;
      const title = trigger.getAttribute("data-cu-toast-title") || "";
      const desc = trigger.getAttribute("data-cu-toast-description") || "";
      const variant = trigger.getAttribute("data-cu-toast-variant") || "default";
      const toast = document.createElement("div");
      toast.className = "cu-toast cu-toast-" + variant;
      toast.innerHTML =
        '<div class="cu-toast-body">' +
          '<div class="cu-toast-title">' + title + '</div>' +
          (desc ? '<div class="cu-toast-description">' + desc + '</div>' : '') +
        '</div>' +
        '<button class="cu-toast-close" data-cu-toast-close>' +
          '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>' +
        '</button>';
      container.appendChild(toast);
      toast.querySelector("[data-cu-toast-close]")?.addEventListener("click", () => toast.remove());
      setTimeout(() => toast.remove(), 5000);
    });
  });
</script>`.trim();

const variantsCode = `<button class="cu-button cu-button-default cu-button-md" data-cu-toast-trigger
  data-cu-toast-title="Default toast" data-cu-toast-description="This is a default notification." data-cu-toast-variant="default">
  Default
</button>

<button class="cu-button cu-button-destructive cu-button-md" data-cu-toast-trigger
  data-cu-toast-title="Error" data-cu-toast-description="Something went wrong." data-cu-toast-variant="destructive">
  Destructive
</button>

<button class="cu-button cu-button-success cu-button-md" data-cu-toast-trigger
  data-cu-toast-title="Success" data-cu-toast-description="Your changes have been saved." data-cu-toast-variant="success">
  Success
</button>

<button class="cu-button cu-button-warning cu-button-md" data-cu-toast-trigger
  data-cu-toast-title="Warning" data-cu-toast-description="Please review before continuing." data-cu-toast-variant="warning">
  Warning
</button>

<button class="cu-button cu-button-info cu-button-md" data-cu-toast-trigger
  data-cu-toast-title="Info" data-cu-toast-description="A new update is available." data-cu-toast-variant="info">
  Info
</button>`.trim();
---

<Layout title="Toast — Cubby UI" category="Feedback" componentName="Toast">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Toast</h1>
            <span class="cu-badge cu-badge-secondary">Feedback</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            A succinct message that is displayed temporarily. Toasts auto-dismiss after 5 seconds.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Usage
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Add <code class="cu-code">data-cu-toast-trigger</code> on a button with
                <code class="cu-code">data-cu-toast-title</code> and
                <code class="cu-code">data-cu-toast-description</code> attributes.
                Place a <code class="cu-code">cu-toast-container</code> at a fixed position to receive toasts.
            </p>
            <ComponentPreview code={usageCode}>
                <button class="cu-button cu-button-outline cu-button-md" data-cu-toast-trigger
                    data-cu-toast-title="Event has been created"
                    data-cu-toast-description="Sunday, December 03, 2023 at 9:00 AM">
                    Show Toast
                </button>
            </ComponentPreview>
        </section>

        <!-- Variants -->
        <section class="space-y-3">
            <h2 id="variants" class="text-lg font-semibold tracking-tight relative group">
                <a href="#variants" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Variants
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">data-cu-toast-variant</code> to set the visual style:
                <code class="cu-code">default</code>, <code class="cu-code">destructive</code>,
                <code class="cu-code">success</code>, <code class="cu-code">warning</code>,
                <code class="cu-code">info</code>.
            </p>
            <ComponentPreview code={variantsCode}>
                <div class="flex flex-wrap gap-2">
                    <button class="cu-button cu-button-default cu-button-md" data-cu-toast-trigger
                        data-cu-toast-title="Default toast" data-cu-toast-description="This is a default notification." data-cu-toast-variant="default">
                        Default
                    </button>
                    <button class="cu-button cu-button-destructive cu-button-md" data-cu-toast-trigger
                        data-cu-toast-title="Error" data-cu-toast-description="Something went wrong." data-cu-toast-variant="destructive">
                        Destructive
                    </button>
                    <button class="cu-button cu-button-success cu-button-md" data-cu-toast-trigger
                        data-cu-toast-title="Success" data-cu-toast-description="Your changes have been saved." data-cu-toast-variant="success">
                        Success
                    </button>
                    <button class="cu-button cu-button-warning cu-button-md" data-cu-toast-trigger
                        data-cu-toast-title="Warning" data-cu-toast-description="Please review before continuing." data-cu-toast-variant="warning">
                        Warning
                    </button>
                    <button class="cu-button cu-button-info cu-button-md" data-cu-toast-trigger
                        data-cu-toast-title="Info" data-cu-toast-description="A new update is available." data-cu-toast-variant="info">
                        Info
                    </button>
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3 mt-10">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                CSS Classes
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">Class</th>
                            <th class="cu-table-head">說明</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-container</code></td>
                            <td class="cu-table-cell text-muted-foreground">Toast 固定定位容器</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-container-bottom-right</code></td>
                            <td class="cu-table-cell text-muted-foreground">容器位置：右下角</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-container-bottom-left</code></td>
                            <td class="cu-table-cell text-muted-foreground">容器位置：左下角</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-container-top-right</code></td>
                            <td class="cu-table-cell text-muted-foreground">容器位置：右上角</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-container-top-left</code></td>
                            <td class="cu-table-cell text-muted-foreground">容器位置：左上角</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast</code></td>
                            <td class="cu-table-cell text-muted-foreground">Toast 基礎樣式</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-default</code></td>
                            <td class="cu-table-cell text-muted-foreground">預設變體樣式</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-destructive</code></td>
                            <td class="cu-table-cell text-muted-foreground">危險 / 錯誤變體樣式</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-success</code></td>
                            <td class="cu-table-cell text-muted-foreground">成功變體樣式</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-warning</code></td>
                            <td class="cu-table-cell text-muted-foreground">警告變體樣式</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-info</code></td>
                            <td class="cu-table-cell text-muted-foreground">資訊變體樣式</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-body</code></td>
                            <td class="cu-table-cell text-muted-foreground">Toast 內容區域包裝</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-title</code></td>
                            <td class="cu-table-cell text-muted-foreground">Toast 標題</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-description</code></td>
                            <td class="cu-table-cell text-muted-foreground">Toast 描述文字</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-close</code></td>
                            <td class="cu-table-cell text-muted-foreground">Toast 關閉按鈕</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-enter</code></td>
                            <td class="cu-table-cell text-muted-foreground">Toast 進場動畫</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</Layout>

<script>
    function setupToasts() {
        let container = document.querySelector("[data-cu-toast-container]") as HTMLElement | null;
        if (!container) {
            container = document.createElement("div");
            container.className = "cu-toast-container cu-toast-container-bottom-right";
            container.setAttribute("data-cu-toast-container", "");
            document.body.appendChild(container);
        }

        document.querySelectorAll("[data-cu-toast-trigger]").forEach((trigger) => {
            trigger.addEventListener("click", () => {
                const c = document.querySelector("[data-cu-toast-container]");
                if (!c) return;
                const title = trigger.getAttribute("data-cu-toast-title") || "";
                const desc = trigger.getAttribute("data-cu-toast-description") || "";
                const variant = trigger.getAttribute("data-cu-toast-variant") || "default";
                const toast = document.createElement("div");
                toast.className = `cu-toast cu-toast-${variant}`;
                toast.innerHTML = `
                    <div class="cu-toast-body">
                        <div class="cu-toast-title">${title}</div>
                        ${desc ? `<div class="cu-toast-description">${desc}</div>` : ""}
                    </div>
                    <button class="cu-toast-close" data-cu-toast-close>
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                    </button>`;
                c.appendChild(toast);
                toast.querySelector("[data-cu-toast-close]")?.addEventListener("click", () => toast.remove());
                setTimeout(() => toast.remove(), 5000);
            });
        });
    }

    setupToasts();
    document.addEventListener("astro:page-load", setupToasts);
</script>
