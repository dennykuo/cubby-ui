---
import Layout from "@/layouts/Layout.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { toastPage } from "@/i18n/pages/components/toast";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(toastPage, locale);
const SO = "<" + "script>";
const SC = "</" + "script>";

const usageCode = `<button class="cu-button cu-button-outline cu-button-md" data-cu-toast-trigger
  data-cu-toast-title="Event has been created"
  data-cu-toast-description="Sunday, December 03, 2023 at 9:00 AM">
  Show Toast
</button>

<div class="cu-toast-container cu-toast-container-bottom-right" data-cu-toast-container></div>

${SO}
  document.querySelectorAll("[data-cu-toast-trigger]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const container = document.querySelector("[data-cu-toast-container]");
      if (!container) return;
      const title = trigger.getAttribute("data-cu-toast-title") || "";
      const desc = trigger.getAttribute("data-cu-toast-description") || "";
      const variant = trigger.getAttribute("data-cu-toast-variant") || "default";

      const toast = document.createElement("div");
      toast.className = "cu-toast cu-toast-" + variant;

      const body = document.createElement("div");
      body.className = "cu-toast-body";
      const titleEl = document.createElement("div");
      titleEl.className = "cu-toast-title";
      titleEl.textContent = title;
      body.appendChild(titleEl);
      if (desc) {
        const descEl = document.createElement("div");
        descEl.className = "cu-toast-description";
        descEl.textContent = desc;
        body.appendChild(descEl);
      }
      toast.appendChild(body);

      const closeBtn = document.createElement("button");
      closeBtn.className = "cu-toast-close";
      closeBtn.setAttribute("data-cu-toast-close", "");
      closeBtn.textContent = "\\u00d7";
      toast.appendChild(closeBtn);

      container.appendChild(toast);
      closeBtn.addEventListener("click", () => toast.remove());
      setTimeout(() => toast.remove(), 5000);
    });
  });
${SC}`.trim();

const variantsCode = `<button class="cu-button cu-button-default cu-button-md" data-cu-toast-trigger
  data-cu-toast-title="Default toast" data-cu-toast-description="This is a default notification." data-cu-toast-variant="default">
  Default
</button>

<button class="cu-button cu-button-destructive cu-button-md" data-cu-toast-trigger
  data-cu-toast-title="Error" data-cu-toast-description="Something went wrong." data-cu-toast-variant="destructive">
  Destructive
</button>

<button class="cu-button cu-button-success cu-button-md" data-cu-toast-trigger
  data-cu-toast-title="Success" data-cu-toast-description="Your changes have been saved." data-cu-toast-variant="success">
  Success
</button>

<button class="cu-button cu-button-warning cu-button-md" data-cu-toast-trigger
  data-cu-toast-title="Warning" data-cu-toast-description="Please review before continuing." data-cu-toast-variant="warning">
  Warning
</button>

<button class="cu-button cu-button-info cu-button-md" data-cu-toast-trigger
  data-cu-toast-title="Info" data-cu-toast-description="A new update is available." data-cu-toast-variant="info">
  Info
</button>`.trim();

const withActionCode = `<div class="cu-toast cu-toast-default" style="position: relative;">
  <div class="cu-toast-body">
    <div class="cu-toast-title">Event deleted</div>
    <div class="cu-toast-description">The event "Team Meeting" has been removed.</div>
  </div>
  <div class="flex flex-col gap-1">
    <button class="cu-button cu-button-outline cu-button-sm text-xs h-7">Undo</button>
  </div>
  <button class="cu-toast-close">&times;</button>
</div>`.trim();

const customDurationCode = `<button class="cu-button cu-button-outline cu-button-md" data-cu-toast-trigger
  data-cu-toast-title="Quick notice"
  data-cu-toast-description="This toast disappears in 2 seconds."
  data-cu-toast-duration="2000">
  2s Toast
</button>

<button class="cu-button cu-button-outline cu-button-md" data-cu-toast-trigger
  data-cu-toast-title="Persistent notice"
  data-cu-toast-description="This toast stays for 10 seconds."
  data-cu-toast-duration="10000">
  10s Toast
</button>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Toast">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Toast</h1>
            <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            {t.description}
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <button class="cu-button cu-button-outline cu-button-md" data-cu-toast-trigger
                    data-cu-toast-title="Event has been created"
                    data-cu-toast-description="Sunday, December 03, 2023 at 9:00 AM">
                    Show Toast
                </button>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.classes.title}
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-container</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-toast-container']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-container-bottom-right</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-toast-container-bottom-right']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-container-bottom-left</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-toast-container-bottom-left']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-container-top-right</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-toast-container-top-right']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-container-top-left</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-toast-container-top-left']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-toast']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-default</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-toast-default']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-destructive</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-toast-destructive']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-success</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-toast-success']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-warning</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-toast-warning']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-info</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-toast-info']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-body</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-toast-body']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-title</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-toast-title']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-description</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-toast-description']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-close</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-toast-close']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-toast-enter</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-toast-enter']}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>


        <!-- Variants -->
        <section class="space-y-3">
            <h2 id="variants" class="text-lg font-semibold tracking-tight relative group">
                <a href="#variants" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.variants.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.variants.description} />
            <ComponentPreview code={variantsCode}>
                <div class="flex flex-wrap gap-2">
                    <button class="cu-button cu-button-default cu-button-md" data-cu-toast-trigger
                        data-cu-toast-title="Default toast" data-cu-toast-description="This is a default notification." data-cu-toast-variant="default">
                        Default
                    </button>
                    <button class="cu-button cu-button-destructive cu-button-md" data-cu-toast-trigger
                        data-cu-toast-title="Error" data-cu-toast-description="Something went wrong." data-cu-toast-variant="destructive">
                        Destructive
                    </button>
                    <button class="cu-button cu-button-success cu-button-md" data-cu-toast-trigger
                        data-cu-toast-title="Success" data-cu-toast-description="Your changes have been saved." data-cu-toast-variant="success">
                        Success
                    </button>
                    <button class="cu-button cu-button-warning cu-button-md" data-cu-toast-trigger
                        data-cu-toast-title="Warning" data-cu-toast-description="Please review before continuing." data-cu-toast-variant="warning">
                        Warning
                    </button>
                    <button class="cu-button cu-button-info cu-button-md" data-cu-toast-trigger
                        data-cu-toast-title="Info" data-cu-toast-description="A new update is available." data-cu-toast-variant="info">
                        Info
                    </button>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Action -->
        <section class="space-y-3">
            <h2 id="with-action" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-action" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.withAction.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">{t.sections.withAction.description}</p>
            <ComponentPreview code={withActionCode}>
                <div class="cu-toast cu-toast-default" style="position: relative;">
                    <div class="cu-toast-body">
                        <div class="cu-toast-title">Event deleted</div>
                        <div class="cu-toast-description">The event "Team Meeting" has been removed.</div>
                    </div>
                    <div class="flex flex-col gap-1">
                        <button class="cu-button cu-button-outline cu-button-sm text-xs h-7">Undo</button>
                    </div>
                    <button class="cu-toast-close">&times;</button>
                </div>
            </ComponentPreview>
        </section>

        <!-- Custom Duration -->
        <section class="space-y-3">
            <h2 id="custom-duration" class="text-lg font-semibold tracking-tight relative group">
                <a href="#custom-duration" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.customDuration.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.customDuration.description} />
            <ComponentPreview code={customDurationCode}>
                <div class="flex flex-wrap gap-2">
                    <button class="cu-button cu-button-outline cu-button-md" data-cu-toast-trigger
                        data-cu-toast-title="Quick notice"
                        data-cu-toast-description="This toast disappears in 2 seconds."
                        data-cu-toast-duration="2000">
                        2s Toast
                    </button>
                    <button class="cu-button cu-button-outline cu-button-md" data-cu-toast-trigger
                        data-cu-toast-title="Persistent notice"
                        data-cu-toast-description="This toast stays for 10 seconds."
                        data-cu-toast-duration="10000">
                        10s Toast
                    </button>
                </div>
            </ComponentPreview>
        </section>

    </div>
</Layout>
