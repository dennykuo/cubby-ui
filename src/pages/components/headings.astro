---
import Layout from "@/layouts/Layout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Heading from "@/components/ui/Heading.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { headingsPage } from "@/i18n/pages/components/headings";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(headingsPage, locale);

const usageCode = `<h1 class="cu-h1">This is an H1 heading</h1>`.trim();

const allLevelsCode = `<h1 class="cu-h1">This is an H1 heading</h1>
<h2 class="cu-h2">This is an H2 heading</h2>
<h3 class="cu-h3">This is an H3 heading</h3>
<h4 class="cu-h4">This is an H4 heading</h4>
<h5 class="cu-h5">This is an H5 heading</h5>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Headings" description={t.description}>
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Headings</h1>
          <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <SectionHeading id="usage" title={t.sections.usage.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <Heading level={1}>This is an H1 heading</Heading>
            </ComponentPreview>
        </section>

    <!-- Classes Reference -->
    <section class="space-y-3">
      <SectionHeading id="classes" title={t.sections.classes.title} />
      <div class="cu-table-wrapper rounded-lg border border-border">
        <table class="cu-table">
          <thead class="cu-table-header">
            <tr class="cu-table-row">
              <th class="cu-table-head">{t.sections.classes.classLabel}</th>
              <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
            </tr>
          </thead>
          <tbody class="cu-table-body">
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-h1</code></td>
              <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-h1']}</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-h2</code></td>
              <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-h2']}</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-h3</code></td>
              <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-h3']}</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-h4</code></td>
              <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-h4']}</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-h5</code></td>
              <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-h5']}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>


        <!-- All Levels -->
        <section class="space-y-3">
            <SectionHeading id="all-levels" title={t.sections.allLevels.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.allLevels.description} />
            <ComponentPreview code={allLevelsCode}>
                <div class="space-y-6 w-full max-w-2xl">
                    <Heading level={1}>This is an H1 heading</Heading>
                    <Heading level={2}>This is an H2 heading</Heading>
                    <Heading level={3}>This is an H3 heading</Heading>
                    <Heading level={4}>This is an H4 heading</Heading>
                    <Heading level={5}>This is an H5 heading</Heading>
                </div>
            </ComponentPreview>
        </section>
    </div>

</Layout>
