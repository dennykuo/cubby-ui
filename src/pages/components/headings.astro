---
import Layout from "../../layouts/Layout.astro";
import Heading from "../../components/ui/Heading.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<h1 class="cu-h1">This is an H1 heading</h1>`.trim();

const allLevelsCode = `<h1 class="cu-h1">This is an H1 heading</h1>
<h2 class="cu-h2">This is an H2 heading</h2>
<h3 class="cu-h3">This is an H3 heading</h3>
<h4 class="cu-h4">This is an H4 heading</h4>`.trim();
---

<Layout title="Headings — Cubby UI" category="Typography" componentName="Headings">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Headings</h1>
          <span class="cu-badge cu-badge-secondary">Typography</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            Semantic heading styles from H1 to H4 for page titles, section headers, and content hierarchy.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
              <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Usage
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Apply <code class="cu-code">cu-h1</code> through
                <code class="cu-code">cu-h4</code> to heading elements.
            </p>
            <ComponentPreview code={usageCode}>
                <Heading level={1}>This is an H1 heading</Heading>
            </ComponentPreview>
        </section>

        <!-- All Levels -->
        <section class="space-y-3">
            <h2 id="all-levels" class="text-lg font-semibold tracking-tight relative group">
              <a href="#all-levels" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              All Levels
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Four heading levels with progressively decreasing size and weight.
            </p>
            <ComponentPreview code={allLevelsCode}>
                <div class="space-y-6 w-full max-w-2xl">
                    <Heading level={1}>This is an H1 heading</Heading>
                    <Heading level={2}>This is an H2 heading</Heading>
                    <Heading level={3}>This is an H3 heading</Heading>
                    <Heading level={4}>This is an H4 heading</Heading>
                </div>
            </ComponentPreview>
        </section>
    </div>

    <!-- Classes Reference -->
    <section class="space-y-3 mt-10">
      <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
        <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        CSS Classes
      </h2>
      <div class="cu-table-wrapper rounded-lg border border-border">
        <table class="cu-table">
          <thead class="cu-table-header">
            <tr class="cu-table-row">
              <th class="cu-table-head">Class</th>
              <th class="cu-table-head">說明</th>
            </tr>
          </thead>
          <tbody class="cu-table-body">
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-h1</code></td>
              <td class="cu-table-cell text-muted-foreground">一級標題，特大粗體</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-h2</code></td>
              <td class="cu-table-cell text-muted-foreground">二級標題，大號半粗體</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-h3</code></td>
              <td class="cu-table-cell text-muted-foreground">三級標題，中號半粗體</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-h4</code></td>
              <td class="cu-table-cell text-muted-foreground">四級標題，較小半粗體</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
</Layout>
