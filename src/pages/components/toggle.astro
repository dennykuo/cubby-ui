---
import Layout from "../../layouts/Layout.astro";
import Toggle from "../../components/ui/Toggle.astro";
import Label from "../../components/ui/Label.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<label class="cu-toggle-wrapper">
  <input type="checkbox" class="cu-toggle-input" />
  <span class="cu-toggle">
    <span class="cu-toggle-thumb"></span>
  </span>
</label>`.trim();

const withLabelCode = `<label class="cu-toggle-wrapper">
  <input type="checkbox" class="cu-toggle-input" />
  <span class="cu-toggle">
    <span class="cu-toggle-thumb"></span>
  </span>
  <span class="cu-label">Airplane Mode</span>
</label>`.trim();

const sizesCode = `<label class="cu-toggle-wrapper">
  <input type="checkbox" class="cu-toggle-input" checked />
  <span class="cu-toggle cu-toggle-sm">
    <span class="cu-toggle-thumb"></span>
  </span>
  <span class="cu-label">Small</span>
</label>

<label class="cu-toggle-wrapper">
  <input type="checkbox" class="cu-toggle-input" checked />
  <span class="cu-toggle">
    <span class="cu-toggle-thumb"></span>
  </span>
  <span class="cu-label">Default</span>
</label>

<label class="cu-toggle-wrapper">
  <input type="checkbox" class="cu-toggle-input" checked />
  <span class="cu-toggle cu-toggle-lg">
    <span class="cu-toggle-thumb"></span>
  </span>
  <span class="cu-label">Large</span>
</label>`.trim();

const checkedCode = `<label class="cu-toggle-wrapper">
  <input type="checkbox" class="cu-toggle-input" checked />
  <span class="cu-toggle">
    <span class="cu-toggle-thumb"></span>
  </span>
  <span class="cu-label">Enabled by default</span>
</label>`.trim();

const disabledCode = `<label class="cu-toggle-wrapper">
  <input type="checkbox" class="cu-toggle-input" disabled />
  <span class="cu-toggle">
    <span class="cu-toggle-thumb"></span>
  </span>
  <span class="cu-label">Disabled off</span>
</label>

<label class="cu-toggle-wrapper">
  <input type="checkbox" class="cu-toggle-input" disabled checked />
  <span class="cu-toggle">
    <span class="cu-toggle-thumb"></span>
  </span>
  <span class="cu-label">Disabled on</span>
</label>`.trim();
---

<Layout category="Forms" componentName="Toggle" title="Toggle — Cubby UI">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Toggle</h1>
          <span class="cu-badge cu-badge-secondary">Forms</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            Displays a toggle switch for binary on/off options. Pure CSS — no JavaScript required.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
              <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Usage
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                The toggle uses a hidden <code class="cu-code">&lt;input type="checkbox"&gt;</code> with
                <code class="cu-code">cu-toggle-input</code>,
                a visual track with <code class="cu-code">cu-toggle</code>,
                and a thumb with <code class="cu-code">cu-toggle-thumb</code>,
                all inside a <code class="cu-code">cu-toggle-wrapper</code> label.
            </p>
            <ComponentPreview code={usageCode}>
                <Toggle />
            </ComponentPreview>
        </section>

        <!-- With Label -->
        <section class="space-y-3">
            <h2 id="with-label" class="text-lg font-semibold tracking-tight relative group">
              <a href="#with-label" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              With Label
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Add label text as a sibling inside the wrapper. Clicking the text also toggles the switch.
            </p>
            <ComponentPreview code={withLabelCode}>
                <Toggle>
                    <span class="cu-label">Airplane Mode</span>
                </Toggle>
            </ComponentPreview>
        </section>

        <!-- Sizes -->
        <section class="space-y-3">
            <h2 id="sizes" class="text-lg font-semibold tracking-tight relative group">
              <a href="#sizes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Sizes
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Three sizes are available — <code class="cu-code">cu-toggle-sm</code>,
                default, and <code class="cu-code">cu-toggle-lg</code>.
            </p>
            <ComponentPreview code={sizesCode}>
                <div class="flex flex-col gap-4">
                    <Toggle size="sm" checked>
                        <span class="cu-label">Small</span>
                    </Toggle>
                    <Toggle checked>
                        <span class="cu-label">Default</span>
                    </Toggle>
                    <Toggle size="lg" checked>
                        <span class="cu-label">Large</span>
                    </Toggle>
                </div>
            </ComponentPreview>
        </section>

        <!-- Checked by Default -->
        <section class="space-y-3">
            <h2 id="checked-by-default" class="text-lg font-semibold tracking-tight relative group">
              <a href="#checked-by-default" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Checked by Default
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Add the <code class="cu-code">checked</code> attribute to the hidden input for an initial on state.
            </p>
            <ComponentPreview code={checkedCode}>
                <Toggle checked>
                    <span class="cu-label">Enabled by default</span>
                </Toggle>
            </ComponentPreview>
        </section>

        <!-- Disabled -->
        <section class="space-y-3">
            <h2 id="disabled" class="text-lg font-semibold tracking-tight relative group">
              <a href="#disabled" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Disabled
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Add the <code class="cu-code">disabled</code> attribute to prevent interaction.
            </p>
            <ComponentPreview code={disabledCode}>
                <div class="flex flex-col gap-4">
                    <Toggle disabled>
                        <span class="cu-label">Disabled off</span>
                    </Toggle>
                    <Toggle disabled checked>
                        <span class="cu-label">Disabled on</span>
                    </Toggle>
                </div>
            </ComponentPreview>
        </section>
        <!-- Classes Reference -->
        <section class="space-y-3 mt-10">
          <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
            <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
            CSS Classes
          </h2>
          <div class="cu-table-wrapper rounded-lg border border-border">
            <table class="cu-table">
              <thead class="cu-table-header">
                <tr class="cu-table-row">
                  <th class="cu-table-head">Class</th>
                  <th class="cu-table-head">Description</th>
                </tr>
              </thead>
              <tbody class="cu-table-body">
                <tr class="cu-table-row">
                  <td class="cu-table-cell"><code class="cu-code">cu-toggle-wrapper</code></td>
                  <td class="cu-table-cell text-muted-foreground">Flex container for Toggle and Label</td>
                </tr>
                <tr class="cu-table-row">
                  <td class="cu-table-cell"><code class="cu-code">cu-toggle-input</code></td>
                  <td class="cu-table-cell text-muted-foreground">Hidden checkbox input, controls toggle state via sibling selector</td>
                </tr>
                <tr class="cu-table-row">
                  <td class="cu-table-cell"><code class="cu-code">cu-toggle</code></td>
                  <td class="cu-table-cell text-muted-foreground">Toggle track, default size</td>
                </tr>
                <tr class="cu-table-row">
                  <td class="cu-table-cell"><code class="cu-code">cu-toggle-sm</code></td>
                  <td class="cu-table-cell text-muted-foreground">Small toggle track</td>
                </tr>
                <tr class="cu-table-row">
                  <td class="cu-table-cell"><code class="cu-code">cu-toggle-lg</code></td>
                  <td class="cu-table-cell text-muted-foreground">Large toggle track</td>
                </tr>
                <tr class="cu-table-row">
                  <td class="cu-table-cell"><code class="cu-code">cu-toggle-thumb</code></td>
                  <td class="cu-table-cell text-muted-foreground">Toggle sliding dot</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>
    </div>
</Layout>
