			</h2>
			<p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.navStart.description} />
			<ComponentPreview code={navStartCode}>
				<div class="w-full rounded-lg border border-border overflow-hidden">
					<header class="cu-header" style="position:relative;">
						<div class="cu-header-inner">
							<div class="cu-header-brand">
								<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
								<span class="text-base font-semibold tracking-tight">My App</span>
							</div>
							<div class="cu-header-nav cu-header-nav-start">
								<nav class="cu-nav">
									<a class="cu-nav-item cu-nav-item-active" href="#">Home</a>
