---

<Layout title="Header — Cubby UI" category="Layouts" componentName="Header">
	<div class="space-y-3">
		<div class="flex items-center gap-3">
		  <h1 class="text-3xl font-bold tracking-tight">Header</h1>
		  <span class="cu-badge cu-badge-secondary">Layouts</span>
		</div>
		<p class="text-base text-muted-foreground leading-relaxed">
			A top navigation bar with brand, navigation, and actions areas.
		</p>
	</div>

	<div class="mt-10 space-y-10">
		<!-- Usage -->
		<section class="space-y-3">
			<h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
			  <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
			  Usage
			</h2>
			<p class="text-base text-muted-foreground leading-relaxed">
				Compose with
				<code class="cu-code">cu-header</code>,
				<code class="cu-code">cu-header-inner</code>,
				<code class="cu-code">cu-header-brand</code>, and
				<code class="cu-code">cu-header-actions</code>.
				The inner container handles height, flex layout, and responsive padding.
			</p>
			<ComponentPreview code={usageCode}>
				<div class="w-full rounded-lg border border-border overflow-hidden">
					<header class="cu-header" style="position:relative;">
						<div class="cu-header-inner">
							<div class="cu-header-brand">
								<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
								<span class="text-base font-semibold tracking-tight">My App</span>
							</div>
							<div class="cu-header-actions">
								<a href="#" class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:text-foreground">
									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
								</a>
							</div>
						</div>
					</header>
				</div>
			</ComponentPreview>
		</section>

		<!-- Classes Reference -->
		<section class="space-y-3">
			<h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
				<a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
				CSS Classes
			</h2>
			<div class="cu-table-wrapper rounded-lg border border-border">
				<table class="cu-table">
					<thead class="cu-table-header">
						<tr class="cu-table-row">
							<th class="cu-table-head">Class</th>
							<th class="cu-table-head">Description</th>
						</tr>
					</thead>
					<tbody class="cu-table-body">
						<tr class="cu-table-row">
							<td class="cu-table-cell"><code class="cu-code">cu-header</code></td>
							<td class="cu-table-cell text-muted-foreground">Top navigation bar container, sticky with blurred background</td>
						</tr>
						<tr class="cu-table-row">
							<td class="cu-table-cell"><code class="cu-code">cu-header-inner</code></td>
							<td class="cu-table-cell text-muted-foreground">Inner flex container controlling height and horizontal padding</td>
						</tr>
						<tr class="cu-table-row">
							<td class="cu-table-cell"><code class="cu-code">cu-header-brand</code></td>
							<td class="cu-table-cell text-muted-foreground">Left brand / logo area</td>
						</tr>
						<tr class="cu-table-row">
							<td class="cu-table-cell"><code class="cu-code">cu-header-nav</code></td>
							<td class="cu-table-cell text-muted-foreground">Center navigation links, hidden on mobile</td>
						</tr>
						<tr class="cu-table-row">
							<td class="cu-table-cell"><code class="cu-code">cu-header-actions</code></td>
							<td class="cu-table-cell text-muted-foreground">Right action button area</td>
						</tr>
					</tbody>
				</table>
			</div>
		</section>


		<!-- With Navigation -->
		<section class="space-y-3">
			<h2 id="with-navigation" class="text-lg font-semibold tracking-tight relative group">
			  <a href="#with-navigation" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
			  With Navigation
			</h2>
			<p class="text-base text-muted-foreground leading-relaxed">
				Add a
				<code class="cu-code">cu-header-nav</code> section with a
				<code class="cu-code">cu-nav</code> inside.
				The nav area is hidden on mobile and visible from the
				<code class="cu-code">md</code> breakpoint.
			</p>
			<ComponentPreview code={withNavCode}>
				<div class="w-full rounded-lg border border-border overflow-hidden">
					<header class="cu-header" style="position:relative;">
						<div class="cu-header-inner">
							<div class="cu-header-brand">
								<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
								<span class="text-base font-semibold tracking-tight">My App</span>
							</div>
							<div class="cu-header-nav">
								<nav class="cu-nav">
									<a class="cu-nav-item cu-nav-item-active" href="#">Home</a>
									<a class="cu-nav-item" href="#">Products</a>
									<a class="cu-nav-item" href="#">About</a>
									<a class="cu-nav-item" href="#">Contact</a>
								</nav>
							</div>
							<div class="cu-header-actions">
								<button class="cu-button cu-button-default cu-button-sm">Sign in</button>
							</div>
						</div>
					</header>
				</div>
			</ComponentPreview>
		</section>

		<!-- Brand Variations -->
		<section class="space-y-3">
			<h2 id="brand-variations" class="text-lg font-semibold tracking-tight relative group">
			  <a href="#brand-variations" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
			  Brand Variations
			</h2>
			<p class="text-base text-muted-foreground leading-relaxed">
				The brand area accepts any content — text only, icon with text, or a custom logo image.
			</p>
			<ComponentPreview code={brandVariationsCode}>
				<div class="w-full space-y-3">
					<div class="rounded-lg border border-border overflow-hidden">
						<header class="cu-header" style="position:relative;">
							<div class="cu-header-inner">
								<div class="cu-header-brand">
									<span class="text-base font-semibold tracking-tight">Brand</span>
								</div>
							</div>
						</header>
					</div>
					<div class="rounded-lg border border-border overflow-hidden">
						<header class="cu-header" style="position:relative;">
							<div class="cu-header-inner">
								<div class="cu-header-brand">
									<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
									<span class="text-base font-semibold tracking-tight">Dashboard</span>
								</div>
							</div>
						</header>
					</div>
				</div>
			</ComponentPreview>
		</section>

		<!-- Mobile Menu Toggle -->
		<section class="space-y-3">
			<h2 id="mobile-menu-toggle" class="text-lg font-semibold tracking-tight relative group">
			  <a href="#mobile-menu-toggle" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
			  Mobile Menu Toggle
			</h2>
			<p class="text-base text-muted-foreground leading-relaxed">
				For dashboard layouts, add a hamburger button before the brand using
				<code class="cu-code">cu-button cu-button-ghost cu-button-icon-sm</code>.
				Hide it on desktop with <code class="cu-code">md:hidden</code>.
			</p>
			<ComponentPreview code={mobileMenuCode}>
				<div class="w-full rounded-lg border border-border overflow-hidden">
					<header class="cu-header" style="position:relative;">
						<div class="cu-header-inner">
							<div class="flex items-center gap-2">
								<button class="cu-button cu-button-ghost cu-button-icon-sm md:hidden" aria-label="Toggle menu">
									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
								</button>
								<div class="cu-header-brand">
									<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
									<span class="text-base font-semibold tracking-tight">Dashboard</span>
								</div>
							</div>
							<div class="cu-header-nav">
								<nav class="cu-nav">
									<a class="cu-nav-item cu-nav-item-active" href="#">Overview</a>
									<a class="cu-nav-item" href="#">Analytics</a>
									<a class="cu-nav-item" href="#">Settings</a>
								</nav>
							</div>
							<div class="cu-header-actions">
								<button class="cu-button cu-button-ghost cu-button-icon-sm" aria-label="Notifications">
									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
								</button>
								<div class="size-8 rounded-full bg-primary/10 flex items-center justify-center text-xs font-medium text-primary cursor-pointer">A</div>
							</div>
						</div>
					</header>
				</div>
			</ComponentPreview>
		</section>

		<!-- With Actions -->
		<section class="space-y-3">
			<h2 id="with-actions" class="text-lg font-semibold tracking-tight relative group">
			  <a href="#with-actions" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
			  With Actions
			</h2>
			<p class="text-base text-muted-foreground leading-relaxed">
				The actions area supports icon buttons, avatars, or any custom elements.
			</p>
			<ComponentPreview code={withActionsCode}>
				<div class="w-full rounded-lg border border-border overflow-hidden">
					<header class="cu-header" style="position:relative;">
						<div class="cu-header-inner">
							<div class="cu-header-brand">
								<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
								<span class="text-base font-semibold tracking-tight">My App</span>
							</div>
							<div class="cu-header-nav">
								<nav class="cu-nav">
									<a class="cu-nav-item cu-nav-item-active" href="#">Dashboard</a>
									<a class="cu-nav-item" href="#">Projects</a>
									<a class="cu-nav-item" href="#">Team</a>
								</nav>
							</div>
