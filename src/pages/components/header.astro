<script>
	function setupTriggerVisibilityDemo() {
		const targets = document.querySelectorAll('[data-cu-demo-responsive-hide]');
		targets.forEach((target) => {
			const preview = target.closest('[data-cu-component-preview]');
			if (!preview) return;
			const deviceBtns = preview.querySelectorAll('[data-cu-preview-device]');
			const el = target as HTMLElement;

			function sync() {
				const active = preview!.querySelector('.cu-preview-device-btn-active') as HTMLElement | null;
				const device = active?.dataset.cuPreviewDevice || '100%';
				el.style.display = device === '100%' ? 'none' : '';
			}

			sync();
			deviceBtns.forEach((btn) => btn.addEventListener('click', () => requestAnimationFrame(sync)));
		});
	}
	setupTriggerVisibilityDemo();
	document.addEventListener('astro:page-load', setupTriggerVisibilityDemo);
</script>
