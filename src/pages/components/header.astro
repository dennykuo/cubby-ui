const brandVariationsCode = `<!-- Text only -->
<header class="cu-header">
  <div class="cu-header-inner">
    <div class="cu-header-brand">
      <span class="text-base font-semibold tracking-tight">Brand</span>
    </div>
  </div>
</header>

<!-- Icon + text -->
<header class="cu-header">
  <div class="cu-header-inner">
    <div class="cu-header-brand">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
      <span class="text-base font-semibold tracking-tight">Dashboard</span>
    </div>
  </div>
</header>`.trim();

const mobileNavCode = `<header class="cu-header">
  <div class="cu-header-inner">
    <div class="cu-header-brand">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
      <span class="text-base font-semibold tracking-tight">Dashboard</span>
    </div>
    <div class="cu-header-nav cu-header-nav-md">
      <nav class="cu-nav">
        <a class="cu-nav-item cu-nav-item-active" href="#">Overview</a>
        <a class="cu-nav-item" href="#">Analytics</a>
        <a class="cu-nav-item" href="#">Settings</a>
      </nav>
    </div>
    <div class="cu-header-actions">
      <button data-cu-mobile-nav-trigger="main-nav"
              class="cu-button cu-button-ghost cu-button-icon-sm md:hidden"
              aria-label="Open menu" aria-expanded="false">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- Backdrop -->
<div id="main-nav" class="cu-header-mobile-backdrop" data-cu-mobile-nav></div>
<!-- Slide-in panel -->
<nav id="main-nav-panel" class="cu-header-mobile-nav"
     data-cu-mobile-nav-panel="main-nav" data-cu-mobile-nav-clone
     role="dialog" aria-modal="true" aria-label="Navigation menu">
  <div class="cu-header-mobile-header">
    <button data-cu-mobile-nav-close class="cu-header-mobile-close" aria-label="Close menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>
  <div class="cu-header-mobile-content">
    <!-- JS auto-clones desktop nav here -->
  </div>
</nav>`.trim();

const multiplePanelsCode = `<header class="cu-header">
  <div class="cu-header-inner">
    <div class="cu-header-brand">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
      <span class="text-base font-semibold tracking-tight">My App</span>
    </div>
    <div class="cu-header-actions">
      <!-- Trigger A: main-nav -->
      <button data-cu-mobile-nav-trigger="main-nav"
              class="cu-button cu-button-ghost cu-button-icon-sm"
              aria-label="Open menu" aria-expanded="false">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      </button>
      <!-- Trigger B: filter-nav -->
      <button data-cu-mobile-nav-trigger="filter-nav"
              class="cu-button cu-button-ghost cu-button-icon-sm"
              aria-label="Open filters" aria-expanded="false">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- Panel A: main-nav -->
<div id="main-nav" class="cu-header-mobile-backdrop" data-cu-mobile-nav></div>
<nav id="main-nav-panel" class="cu-header-mobile-nav"
     data-cu-mobile-nav-panel="main-nav"
     role="dialog" aria-modal="true" aria-label="Main navigation">
  <div class="cu-header-mobile-header">
    <span class="mr-auto text-base font-semibold tracking-tight">Navigation</span>
    <button data-cu-mobile-nav-close class="cu-header-mobile-close" aria-label="Close menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>
  <div class="cu-header-mobile-content">
    <nav class="cu-nav cu-nav-vertical">
      <a class="cu-nav-item cu-nav-item-active" href="#">Home</a>
      <a class="cu-nav-item" href="#">Products</a>
      <a class="cu-nav-item" href="#">About</a>
    </nav>
  </div>
</nav>

<!-- Panel B: filter-nav -->
<div id="filter-nav" class="cu-header-mobile-backdrop" data-cu-mobile-nav></div>
<nav id="filter-nav-panel" class="cu-header-mobile-nav"
     data-cu-mobile-nav-panel="filter-nav"
     role="dialog" aria-modal="true" aria-label="Filters">
  <div class="cu-header-mobile-header">
    <span class="mr-auto text-base font-semibold tracking-tight">Filters</span>
    <button data-cu-mobile-nav-close class="cu-header-mobile-close" aria-label="Close filters">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
  </div>
  <div class="cu-header-mobile-content">
    <div class="space-y-4">
      <div class="space-y-1.5">
        <label class="cu-label">Category</label>
        <select class="cu-select"><option>All</option><option>Electronics</option><option>Clothing</option></select>
      </div>
      <div class="space-y-1.5">
        <label class="cu-label">Price Range</label>
        <select class="cu-select"><option>Any</option><option>$0 – $50</option><option>$50 – $100</option></select>
      </div>
    </div>
  </div>
</nav>`.trim();

const triggerVisibilityCode = `<!-- Always visible — no breakpoint class -->
<div class="cu-header-actions">
  <button data-cu-mobile-nav-trigger="my-nav"
          class="cu-button cu-button-ghost cu-button-icon-sm"
          aria-label="Open menu" aria-expanded="false">
    <!-- hamburger icon -->
  </button>
</div>

<!-- Hidden above sm — visible on mobile only -->
<div class="cu-header-actions">
  <button data-cu-mobile-nav-trigger="my-nav"
          class="cu-button cu-button-ghost cu-button-icon-sm sm:hidden"
          aria-label="Open menu" aria-expanded="false">
    <!-- hamburger icon -->
  </button>
</div>`.trim();

---

<Layout title={t.title} category={t.category} componentName="Header">
	<div class="space-y-3">
		<div class="flex items-center gap-3">
		  <h1 class="text-3xl font-bold tracking-tight">Header</h1>
		  <span class="cu-badge cu-badge-secondary">{t.category}</span>
		</div>
		<p class="text-base text-muted-foreground leading-relaxed">
			{t.description}
		</p>
	</div>

	<div class="mt-10 space-y-10">
		<!-- Usage -->
		<section class="space-y-3">
			<SectionHeading id="usage" title={t.sections.usage.title} />
			<p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
			<ComponentPreview code={usageCode}>
				<div class="w-full rounded-lg border border-border overflow-hidden">
					<header class="cu-header" style="position:relative;">
						<div class="cu-header-inner">
							<div class="cu-header-brand">
								<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
								<span class="text-base font-semibold tracking-tight">My App</span>
							</div>
							<div class="cu-header-actions">
								<a href="#" class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-muted-foreground transition-colors hover:text-foreground">
									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
								</a>
							</div>
						</div>
					</header>
				</div>
			</ComponentPreview>
		</section>

		<!-- Classes Reference -->
		<section class="space-y-3">
			<SectionHeading id="classes" title={t.sections.classes.title} />
			<div class="cu-table-wrapper rounded-lg border border-border">
				<table class="cu-table">
					<thead class="cu-table-header">
						<tr class="cu-table-row">
							<th class="cu-table-head">{t.sections.classes.classLabel}</th>
							<th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
						</tr>
					</thead>
					<tbody class="cu-table-body">
						{Object.entries(t.classDescriptions).map(([cls, desc]) => (
							<tr class="cu-table-row">
								<td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
								<td class="cu-table-cell text-muted-foreground">{desc}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>


		<!-- Brand Variations -->
		<section class="space-y-3">
			<SectionHeading id="brand-variations" title={t.sections.brandVariations.title} />
			<p class="text-base text-muted-foreground leading-relaxed">
				{t.sections.brandVariations.description}
			</p>
			<ComponentPreview code={brandVariationsCode}>
				<div class="w-full space-y-3">
					<div class="rounded-lg border border-border overflow-hidden">
						<header class="cu-header" style="position:relative;">
							<div class="cu-header-inner">
								<div class="cu-header-brand">
									<span class="text-base font-semibold tracking-tight">Brand</span>
								</div>
							</div>
						</header>
					</div>
					<div class="rounded-lg border border-border overflow-hidden">
						<header class="cu-header" style="position:relative;">
							<div class="cu-header-inner">
								<div class="cu-header-brand">
									<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
									<span class="text-base font-semibold tracking-tight">Dashboard</span>
								</div>
							</div>
						</header>
					</div>
				</div>
			</ComponentPreview>
		</section>

		<!-- Navigation Alignment -->
		<section class="space-y-3">
			<SectionHeading id="nav-alignment" title={t.sections.navAlignment.title} />
			<p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.navAlignment.description} />
			<ComponentPreview code={navAlignmentCode}>
				<div class="w-full space-y-3">
					<!-- Center (default) -->
					<div class="rounded-lg border border-border overflow-hidden">
						<div class="px-3 py-1.5 bg-muted/40 border-b border-border/40 text-xs text-muted-foreground">{t.sections.navAlignment.center}</div>
						<header class="cu-header" style="position:relative;">
