                                        </td>
                                        <td class="cu-table-cell font-medium">Alice Chen</td>
                                        <td class="cu-table-cell">alice@example.com</td>
                                        <td class="cu-table-cell">Admin</td>
                                    </tr>
                                    <tr class="cu-table-row">
                                        <td class="cu-table-cell">
                                            <input type="checkbox" class="cu-checkbox" checked />
                                        </td>
                                        <td class="cu-table-cell font-medium">Bob Smith</td>
                                        <td class="cu-table-cell">bob@example.com</td>
                                        <td class="cu-table-cell">Editor</td>
                                    </tr>
                                    <tr class="cu-table-row">
                                        <td class="cu-table-cell">
                                            <input type="checkbox" class="cu-checkbox" checked />
                                        </td>
                                        <td class="cu-table-cell font-medium">Carol Davis</td>
                                        <td class="cu-table-cell">carol@example.com</td>
                                        <td class="cu-table-cell">Viewer</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Row Actions -->
        <section class="space-y-3">
            <h2 id="with-row-actions" class="text-lg font-semibold tracking-tight relative group">
