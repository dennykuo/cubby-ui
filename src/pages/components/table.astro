                                    <td class="cu-table-cell">Unpaid</td>
                                    <td class="cu-table-cell">Bank Transfer</td>
                                    <td class="cu-table-cell text-right">$350.00</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <SectionHeading id="classes" title={t.sections.classes.title} />
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
