                                <tr class="cu-table-row">
                                    <td class="cu-table-cell font-medium">INV001</td>
                                    <td class="cu-table-cell">Paid</td>
                                    <td class="cu-table-cell text-right">$250.00</td>
                                </tr>
                                <tr class="cu-table-row">
                                    <td class="cu-table-cell font-medium">INV002</td>
                                    <td class="cu-table-cell">Paid</td>
                                    <td class="cu-table-cell text-right">$150.00</td>
                                </tr>
                            </tbody>
                            <tfoot class="cu-table-footer">
                                <tr class="cu-table-row">
                                    <td class="cu-table-cell" colspan="2">Total</td>
                                    <td class="cu-table-cell text-right">$400.00</td>
                                </tr>
                            </tfoot>
                            <caption class="cu-table-caption">A list of recent invoices.</caption>
                        </table>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Toolbar -->
        <section class="space-y-3">
            <h2 id="with-toolbar" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-toolbar" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                With Toolbar
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Add a <code class="cu-code">cu-table-toolbar</code> for batch selection and actions. Use <code class="cu-code">cu-table-toolbar-select</code> for the selection indicator and <code class="cu-code">cu-table-toolbar-actions</code> for action buttons.
            </p>
            <ComponentPreview code={withToolbarCode}>
                <div class="w-full max-w-2xl">
                    <div class="cu-card">
                        <div class="cu-table-toolbar">
                            <div class="cu-table-toolbar-select">
                                <input type="checkbox" class="cu-checkbox" />
                                <span class="text-sm text-muted-foreground">3 selected</span>
                            </div>
                            <div class="cu-table-toolbar-actions">
                                <button class="cu-button cu-button-outline cu-button-sm">Archive</button>
                                <button class="cu-button cu-button-destructive cu-button-sm">Delete</button>
                            </div>
                        </div>
