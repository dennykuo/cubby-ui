---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/ui/Button.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<button class="cu-button cu-button-default cu-button-md">
  Button
</button>`.trim();

const variantsCode = `<button class="cu-button cu-button-default cu-button-md">Default</button>
<button class="cu-button cu-button-secondary cu-button-md">Secondary</button>
<button class="cu-button cu-button-outline cu-button-md">Outline</button>
<button class="cu-button cu-button-ghost cu-button-md">Ghost</button>
<button class="cu-button cu-button-link cu-button-md">Link</button>
<button class="cu-button cu-button-destructive cu-button-md">Destructive</button>
<button class="cu-button cu-button-success cu-button-md">Success</button>
<button class="cu-button cu-button-warning cu-button-md">Warning</button>
<button class="cu-button cu-button-info cu-button-md">Info</button>`.trim();

const sizesCode = `<button class="cu-button cu-button-default cu-button-xs">Extra Small</button>
<button class="cu-button cu-button-default cu-button-sm">Small</button>
<button class="cu-button cu-button-default cu-button-md">Default</button>
<button class="cu-button cu-button-default cu-button-lg">Large</button>
<button class="cu-button cu-button-default cu-button-xl">Extra Large</button>`.trim();

const withIconCode = `<!-- Icon before text -->
<button class="cu-button cu-button-default cu-button-md">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
  Login with Email
</button>

<!-- Icon after text -->
<button class="cu-button cu-button-outline cu-button-md">
  Continue
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
</button>

<!-- Icon only -->
<button class="cu-button cu-button-outline cu-button-icon">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
</button>`.trim();

const disabledCode = `<button class="cu-button cu-button-default cu-button-md" disabled>Default</button>
<button class="cu-button cu-button-secondary cu-button-md" disabled>Secondary</button>
<button class="cu-button cu-button-outline cu-button-md" disabled>Outline</button>`.trim();

const asLinkCode = `<a href="#" class="cu-button cu-button-default cu-button-md">As Link</a>
<a href="#" class="cu-button cu-button-outline cu-button-md">Outline Link</a>
<a href="#" class="cu-button cu-button-ghost cu-button-md">Ghost Link</a>`.trim();

const iconVariantsCode = `<button class="cu-button cu-button-default cu-button-icon">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
</button>
<button class="cu-button cu-button-secondary cu-button-icon">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
</button>
<button class="cu-button cu-button-outline cu-button-icon">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
</button>
<button class="cu-button cu-button-ghost cu-button-icon">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
</button>
<button class="cu-button cu-button-destructive cu-button-icon">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
</button>`.trim();

const loadingCode = `<button class="cu-button cu-button-default cu-button-md" disabled>
  <svg class="animate-spin" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
  Please wait
</button>
<button class="cu-button cu-button-outline cu-button-md" disabled>
  <svg class="animate-spin" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
  Saving...
</button>`.trim();

const groupCode = `<div class="cu-button-group">
  <button class="cu-button cu-button-outline cu-button-md">Left</button>
  <button class="cu-button cu-button-outline cu-button-md">Center</button>
  <button class="cu-button cu-button-outline cu-button-md">Right</button>
</div>`.trim();
---

<Layout title="Button — Cubby UI">
  <div class="space-y-3">
    <h1 class="text-3xl font-bold tracking-tight">Button</h1>
    <p class="text-base text-muted-foreground leading-relaxed">
      Displays a button or a component that looks like a button.
    </p>
  </div>

  <div class="mt-10 space-y-10">
    <!-- Usage -->
    <section class="space-y-3">
      <h2 class="text-lg font-semibold tracking-tight">Usage</h2>
      <p class="text-sm text-muted-foreground leading-relaxed">
        Apply <code class="cu-code">cu-button</code> as the base class, then add a variant and size class.
      </p>
      <ComponentPreview code={usageCode}>
        <Button>Button</Button>
      </ComponentPreview>
    </section>

    <!-- Variants -->
    <section class="space-y-3">
      <h2 class="text-lg font-semibold tracking-tight">Variants</h2>
      <p class="text-sm text-muted-foreground leading-relaxed">
        Use variant classes to change the button's visual style. Each variant conveys a different level of emphasis or intent.
      </p>
      <ComponentPreview code={variantsCode}>
        <div class="flex flex-wrap gap-3 items-center justify-center">
          <Button>Default</Button>
          <Button variant="secondary">Secondary</Button>
          <Button variant="outline">Outline</Button>
          <Button variant="ghost">Ghost</Button>
          <Button variant="link">Link</Button>
          <Button variant="destructive">Destructive</Button>
          <Button variant="success">Success</Button>
          <Button variant="warning">Warning</Button>
          <Button variant="info">Info</Button>
        </div>
      </ComponentPreview>
    </section>

    <!-- Sizes -->
    <section class="space-y-3">
      <h2 class="text-lg font-semibold tracking-tight">Sizes</h2>
      <p class="text-sm text-muted-foreground leading-relaxed">
        Five sizes are available — from
        <code class="cu-code">cu-button-xs</code> to
        <code class="cu-code">cu-button-xl</code>.
        The default size is <code class="cu-code">cu-button-md</code>.
      </p>
      <ComponentPreview code={sizesCode}>
        <div class="flex flex-wrap gap-3 items-end justify-center">
          <Button size="xs">Extra Small</Button>
          <Button size="sm">Small</Button>
          <Button size="default">Default</Button>
          <Button size="lg">Large</Button>
          <Button size="xl">Extra Large</Button>
        </div>
      </ComponentPreview>
    </section>

    <!-- With Icons -->
    <section class="space-y-3">
      <h2 class="text-lg font-semibold tracking-tight">With Icons</h2>
      <p class="text-sm text-muted-foreground leading-relaxed">
        Add inline SVG icons before or after the label text. Use
        <code class="cu-code">cu-button-icon</code>
        for icon-only buttons.
      </p>
      <ComponentPreview code={withIconCode}>
        <div class="flex flex-wrap gap-3 items-center justify-center">
          <Button>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            Login with Email
          </Button>
          <Button variant="outline">
            Continue
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </Button>
          <Button variant="outline" size="icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
          </Button>
        </div>
      </ComponentPreview>
    </section>

    <!-- Icon Variants -->
    <section class="space-y-3">
      <h2 class="text-lg font-semibold tracking-tight">Icon Buttons</h2>
      <p class="text-sm text-muted-foreground leading-relaxed">
        Icon-only buttons across different variants. Ideal for toolbars, actions, and compact UIs.
      </p>
      <ComponentPreview code={iconVariantsCode}>
        <div class="flex flex-wrap gap-3 items-center justify-center">
          <Button size="icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
          </Button>
          <Button variant="secondary" size="icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
          </Button>
          <Button variant="outline" size="icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
          </Button>
          <Button variant="ghost" size="icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
          </Button>
          <Button variant="destructive" size="icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
          </Button>
        </div>
      </ComponentPreview>
    </section>

    <!-- Loading -->
    <section class="space-y-3">
      <h2 class="text-lg font-semibold tracking-tight">Loading</h2>
      <p class="text-sm text-muted-foreground leading-relaxed">
        Combine a spinning icon with <code class="cu-code">disabled</code> to indicate a pending action.
      </p>
      <ComponentPreview code={loadingCode}>
        <div class="flex flex-wrap gap-3 items-center justify-center">
          <Button disabled>
            <svg class="animate-spin" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
            Please wait
          </Button>
          <Button variant="outline" disabled>
            <svg class="animate-spin" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
            Saving...
          </Button>
        </div>
      </ComponentPreview>
    </section>

    <!-- As Link -->
    <section class="space-y-3">
      <h2 class="text-lg font-semibold tracking-tight">As Link</h2>
      <p class="text-sm text-muted-foreground leading-relaxed">
        Apply button classes to an <code class="cu-code">&lt;a&gt;</code> element for link-styled buttons.
      </p>
      <ComponentPreview code={asLinkCode}>
        <div class="flex flex-wrap gap-3 items-center justify-center">
          <a href="#" class="cu-button cu-button-default cu-button-md">As Link</a>
          <a href="#" class="cu-button cu-button-outline cu-button-md">Outline Link</a>
          <a href="#" class="cu-button cu-button-ghost cu-button-md">Ghost Link</a>
        </div>
      </ComponentPreview>
    </section>

    <!-- Button Group -->
    <section class="space-y-3">
      <h2 class="text-lg font-semibold tracking-tight">Button Group</h2>
      <p class="text-sm text-muted-foreground leading-relaxed">
        Wrap buttons in a <code class="cu-code">cu-button-group</code> to join them visually.
        See the <a href="/components/button-group" class="text-primary hover:underline">Button Group</a> page for more options.
      </p>
      <ComponentPreview code={groupCode}>
        <div class="cu-button-group">
          <button class="cu-button cu-button-outline cu-button-md">Left</button>
          <button class="cu-button cu-button-outline cu-button-md">Center</button>
          <button class="cu-button cu-button-outline cu-button-md">Right</button>
        </div>
      </ComponentPreview>
    </section>

    <!-- Disabled -->
    <section class="space-y-3">
      <h2 class="text-lg font-semibold tracking-tight">Disabled</h2>
      <p class="text-sm text-muted-foreground leading-relaxed">
        Add the <code class="cu-code">disabled</code> attribute.
        The button becomes non-interactive with reduced opacity.
      </p>
      <ComponentPreview code={disabledCode}>
        <div class="flex flex-wrap gap-3 items-center justify-center">
          <Button disabled>Default</Button>
          <Button variant="secondary" disabled>Secondary</Button>
          <Button variant="outline" disabled>Outline</Button>
        </div>
      </ComponentPreview>
    </section>
  </div>
</Layout>
