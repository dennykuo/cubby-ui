---
import Layout from "../../layouts/Layout.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<button class="cu-button cu-button-outline cu-button-md" data-sheet-trigger="demo-sheet">
  Open Sheet
</button>

<dialog class="cu-sheet cu-sheet-right" id="demo-sheet" data-sheet>
  <button class="cu-sheet-close" data-sheet-close>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    <span class="sr-only">Close</span>
  </button>
  <div class="cu-sheet-header">
    <h2 class="cu-sheet-title">Edit profile</h2>
    <p class="cu-sheet-description">Make changes to your profile here. Click save when you're done.</p>
  </div>
  <div class="cu-sheet-content">
    <div class="space-y-4">
      <div class="cu-form-group">
        <label class="cu-label" for="sheet-name">Name</label>
        <input class="cu-input" id="sheet-name" value="Pedro Duarte" />
      </div>
      <div class="cu-form-group">
        <label class="cu-label" for="sheet-username">Username</label>
        <input class="cu-input" id="sheet-username" value="@peduarte" />
      </div>
    </div>
  </div>
  <div class="cu-sheet-footer">
    <button class="cu-button cu-button-default cu-button-md">Save changes</button>
  </div>
</dialog>

<script>
  document.querySelectorAll("[data-sheet-trigger]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const id = trigger.getAttribute("data-sheet-trigger");
      document.getElementById(id)?.showModal();
    });
  });
  document.querySelectorAll("[data-sheet]").forEach((dialog) => {
    dialog.querySelectorAll("[data-sheet-close]").forEach((btn) => {
      btn.addEventListener("click", () => dialog.close());
    });
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>`.trim();

const leftCode = `<button class="cu-button cu-button-outline cu-button-md" data-sheet-trigger="left-sheet">
  Open Left Sheet
</button>

<dialog class="cu-sheet cu-sheet-left" id="left-sheet" data-sheet>
  <button class="cu-sheet-close" data-sheet-close>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    <span class="sr-only">Close</span>
  </button>
  <div class="cu-sheet-header">
    <h2 class="cu-sheet-title">Navigation</h2>
    <p class="cu-sheet-description">Browse the sidebar menu.</p>
  </div>
  <div class="cu-sheet-content">
    <nav class="space-y-1">
      <a href="#" class="cu-nav-item cu-nav-item-active block">Dashboard</a>
      <a href="#" class="cu-nav-item block">Settings</a>
      <a href="#" class="cu-nav-item block">Messages</a>
      <a href="#" class="cu-nav-item block">Profile</a>
    </nav>
  </div>
</dialog>`.trim();

const sidesCode = `<button class="cu-button cu-button-outline cu-button-md" data-sheet-trigger="top-sheet">
  Top
</button>

<button class="cu-button cu-button-outline cu-button-md" data-sheet-trigger="bottom-sheet">
  Bottom
</button>

<dialog class="cu-sheet cu-sheet-top" id="top-sheet" data-sheet>
  <button class="cu-sheet-close" data-sheet-close>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    <span class="sr-only">Close</span>
  </button>
  <div class="cu-sheet-header">
    <h2 class="cu-sheet-title">Notifications</h2>
    <p class="cu-sheet-description">You have 3 unread messages.</p>
  </div>
</dialog>

<dialog class="cu-sheet cu-sheet-bottom" id="bottom-sheet" data-sheet>
  <button class="cu-sheet-close" data-sheet-close>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    <span class="sr-only">Close</span>
  </button>
  <div class="cu-sheet-header">
    <h2 class="cu-sheet-title">Cookie Preferences</h2>
    <p class="cu-sheet-description">Manage your cookie settings here.</p>
  </div>
</dialog>`.trim();
---

<Layout title="Sheet — Cubby UI">
    <div class="space-y-3">
        <h1 class="text-3xl font-bold tracking-tight">Sheet</h1>
        <p class="text-base text-muted-foreground leading-relaxed">
            Extends the Dialog component to display content that complements the main content of the screen. Slides in from the edge of the screen.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Usage</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Built with the native <code class="cu-code">&lt;dialog&gt;</code> element.
                Use <code class="cu-code">data-sheet-trigger</code> on buttons to open,
                <code class="cu-code">data-sheet-close</code> to close, and
                <code class="cu-code">data-sheet</code> on the dialog element.
                Add a side class like <code class="cu-code">cu-sheet-right</code> to control the position.
            </p>
            <ComponentPreview code={usageCode}>
                <button class="cu-button cu-button-outline cu-button-md" data-sheet-trigger="demo-sheet">
                    Open Sheet
                </button>
                <dialog class="cu-sheet cu-sheet-right" id="demo-sheet" data-sheet>
                    <button class="cu-sheet-close" data-sheet-close>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                        <span class="sr-only">Close</span>
                    </button>
                    <div class="cu-sheet-header">
                        <h2 class="cu-sheet-title">Edit profile</h2>
                        <p class="cu-sheet-description">Make changes to your profile here. Click save when you're done.</p>
                    </div>
                    <div class="cu-sheet-content">
                        <div class="space-y-4">
                            <div class="cu-form-group">
                                <label class="cu-label" for="sheet-name">Name</label>
                                <input class="cu-input" id="sheet-name" value="Pedro Duarte" />
                            </div>
                            <div class="cu-form-group">
                                <label class="cu-label" for="sheet-username">Username</label>
                                <input class="cu-input" id="sheet-username" value="@peduarte" />
                            </div>
                        </div>
                    </div>
                    <div class="cu-sheet-footer">
                        <button class="cu-button cu-button-default cu-button-md">Save changes</button>
                    </div>
                </dialog>
            </ComponentPreview>
        </section>

        <!-- Left Side -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Left Side</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-sheet-left</code> for a navigation-style drawer.
            </p>
            <ComponentPreview code={leftCode}>
                <button class="cu-button cu-button-outline cu-button-md" data-sheet-trigger="left-sheet">
                    Open Left Sheet
                </button>
                <dialog class="cu-sheet cu-sheet-left" id="left-sheet" data-sheet>
                    <button class="cu-sheet-close" data-sheet-close>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                        <span class="sr-only">Close</span>
                    </button>
                    <div class="cu-sheet-header">
                        <h2 class="cu-sheet-title">Navigation</h2>
                        <p class="cu-sheet-description">Browse the sidebar menu.</p>
                    </div>
                    <div class="cu-sheet-content">
                        <nav class="space-y-1">
                            <a href="#" class="cu-nav-item cu-nav-item-active block">Dashboard</a>
                            <a href="#" class="cu-nav-item block">Settings</a>
                            <a href="#" class="cu-nav-item block">Messages</a>
                            <a href="#" class="cu-nav-item block">Profile</a>
                        </nav>
                    </div>
                </dialog>
            </ComponentPreview>
        </section>

        <!-- Top & Bottom -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Top & Bottom</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-sheet-top</code> or <code class="cu-code">cu-sheet-bottom</code> for horizontal sheets.
            </p>
            <ComponentPreview code={sidesCode}>
                <div class="flex gap-2">
                    <button class="cu-button cu-button-outline cu-button-md" data-sheet-trigger="top-sheet">
                        Top
                    </button>
                    <button class="cu-button cu-button-outline cu-button-md" data-sheet-trigger="bottom-sheet">
                        Bottom
                    </button>
                </div>
                <dialog class="cu-sheet cu-sheet-top" id="top-sheet" data-sheet>
                    <button class="cu-sheet-close" data-sheet-close>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                        <span class="sr-only">Close</span>
                    </button>
                    <div class="cu-sheet-header">
                        <h2 class="cu-sheet-title">Notifications</h2>
                        <p class="cu-sheet-description">You have 3 unread messages.</p>
                    </div>
                </dialog>
                <dialog class="cu-sheet cu-sheet-bottom" id="bottom-sheet" data-sheet>
                    <button class="cu-sheet-close" data-sheet-close>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                        <span class="sr-only">Close</span>
                    </button>
                    <div class="cu-sheet-header">
                        <h2 class="cu-sheet-title">Cookie Preferences</h2>
                        <p class="cu-sheet-description">Manage your cookie settings here.</p>
                    </div>
                </dialog>
            </ComponentPreview>
        </section>
    </div>
</Layout>

<script>
    function setupSheets() {
        document.querySelectorAll("[data-sheet-trigger]").forEach((trigger) => {
            trigger.addEventListener("click", () => {
                const id = trigger.getAttribute("data-sheet-trigger");
                const dialog = document.getElementById(id) as HTMLDialogElement | null;
                dialog?.showModal();
            });
        });
        document.querySelectorAll("[data-sheet]").forEach((dialog) => {
            dialog.querySelectorAll("[data-sheet-close]").forEach((btn) => {
                btn.addEventListener("click", () => (dialog as HTMLDialogElement).close());
            });
            dialog.addEventListener("click", (e) => {
                if (e.target === dialog) (dialog as HTMLDialogElement).close();
            });
        });
    }

    setupSheets();
    document.addEventListener("astro:page-load", setupSheets);
</script>
