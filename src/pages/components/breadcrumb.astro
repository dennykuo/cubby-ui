---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";
import BreadcrumbItem from "../../components/ui/BreadcrumbItem.astro";
import BreadcrumbLink from "../../components/ui/BreadcrumbLink.astro";
import BreadcrumbSeparator from "../../components/ui/BreadcrumbSeparator.astro";
import BreadcrumbCurrent from "../../components/ui/BreadcrumbCurrent.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<nav aria-label="Breadcrumb">
  <ol class="cu-breadcrumb">
    <li class="cu-breadcrumb-item">
      <a class="cu-breadcrumb-link" href="#">Home</a>
    </li>
    <li role="presentation" aria-hidden="true" class="cu-breadcrumb-separator">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </li>
    <li class="cu-breadcrumb-item">
      <a class="cu-breadcrumb-link" href="#">Components</a>
    </li>
    <li role="presentation" aria-hidden="true" class="cu-breadcrumb-separator">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </li>
    <li class="cu-breadcrumb-item">
      <span class="cu-breadcrumb-current" aria-current="page">Breadcrumb</span>
    </li>
  </ol>
</nav>`.trim();

const withIconCode = `<nav aria-label="Breadcrumb">
  <ol class="cu-breadcrumb">
    <li class="cu-breadcrumb-item">
      <a class="cu-breadcrumb-link" href="#">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      </a>
    </li>
    <li role="presentation" aria-hidden="true" class="cu-breadcrumb-separator">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </li>
    <li class="cu-breadcrumb-item">
      <a class="cu-breadcrumb-link" href="#">Components</a>
    </li>
    <li role="presentation" aria-hidden="true" class="cu-breadcrumb-separator">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </li>
    <li class="cu-breadcrumb-item">
      <span class="cu-breadcrumb-current" aria-current="page">Breadcrumb</span>
    </li>
  </ol>
</nav>`.trim();

const customSeparatorCode = `<nav aria-label="Breadcrumb">
  <ol class="cu-breadcrumb">
    <li class="cu-breadcrumb-item">
      <a class="cu-breadcrumb-link" href="#">Home</a>
    </li>
    <li role="presentation" aria-hidden="true" class="cu-breadcrumb-separator">/</li>
    <li class="cu-breadcrumb-item">
      <a class="cu-breadcrumb-link" href="#">Components</a>
    </li>
    <li role="presentation" aria-hidden="true" class="cu-breadcrumb-separator">/</li>
    <li class="cu-breadcrumb-item">
      <span class="cu-breadcrumb-current" aria-current="page">Breadcrumb</span>
    </li>
  </ol>
</nav>`.trim();
---

<Layout title="Breadcrumb — Cubby UI" category="Navigation" componentName="Breadcrumb">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Breadcrumb</h1>
          <span class="cu-badge cu-badge-secondary">Navigation</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            Displays the path to the current resource using a hierarchy of links.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight flex items-center gap-2 group">
              <a href="#usage" class="text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Usage
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-breadcrumb</code> on the <code class="cu-code">&lt;ol&gt;</code>,
                <code class="cu-code">cu-breadcrumb-item</code> on each <code class="cu-code">&lt;li&gt;</code>,
                <code class="cu-code">cu-breadcrumb-link</code> for links, 
                <code class="cu-code">cu-breadcrumb-separator</code> between items, and
                <code class="cu-code">cu-breadcrumb-current</code> for the active page.
            </p>
            <ComponentPreview code={usageCode}>
                <Breadcrumb>
                    <BreadcrumbItem>
                        <BreadcrumbLink href="#">Home</BreadcrumbLink>
                    </BreadcrumbItem>
                    <BreadcrumbSeparator />
                    <BreadcrumbItem>
                        <BreadcrumbLink href="#">Components</BreadcrumbLink>
                    </BreadcrumbItem>
                    <BreadcrumbSeparator />
                    <BreadcrumbCurrent>Breadcrumb</BreadcrumbCurrent>
                </Breadcrumb>
            </ComponentPreview>
        </section>

        <!-- With Icon -->
        <section class="space-y-3">
            <h2 id="with-icon" class="text-lg font-semibold tracking-tight flex items-center gap-2 group">
              <a href="#with-icon" class="text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              With Icon
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use an icon instead of text for the home link.
            </p>
            <ComponentPreview code={withIconCode}>
                <Breadcrumb>
                    <BreadcrumbItem>
                        <BreadcrumbLink href="#">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                        </BreadcrumbLink>
                    </BreadcrumbItem>
                    <BreadcrumbSeparator />
                    <BreadcrumbItem>
                        <BreadcrumbLink href="#">Components</BreadcrumbLink>
                    </BreadcrumbItem>
                    <BreadcrumbSeparator />
                    <BreadcrumbCurrent>Breadcrumb</BreadcrumbCurrent>
                </Breadcrumb>
            </ComponentPreview>
        </section>

        <!-- Custom Separator -->
        <section class="space-y-3">
            <h2 id="custom-separator" class="text-lg font-semibold tracking-tight flex items-center gap-2 group">
              <a href="#custom-separator" class="text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Custom Separator
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Replace the default chevron with any character or element.
            </p>
            <ComponentPreview code={customSeparatorCode}>
                <Breadcrumb>
                    <BreadcrumbItem>
                        <BreadcrumbLink href="#">Home</BreadcrumbLink>
                    </BreadcrumbItem>
                    <BreadcrumbSeparator>/</BreadcrumbSeparator>
                    <BreadcrumbItem>
                        <BreadcrumbLink href="#">Components</BreadcrumbLink>
                    </BreadcrumbItem>
                    <BreadcrumbSeparator>/</BreadcrumbSeparator>
                    <BreadcrumbCurrent>Breadcrumb</BreadcrumbCurrent>
                </Breadcrumb>
            </ComponentPreview>
        </section>
        <!-- Classes Reference -->
        <section class="space-y-3 mt-10">
            <h2 id="classes" class="text-lg font-semibold tracking-tight flex items-center gap-2 group">
                <a href="#classes" class="text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                CSS Classes
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">Class</th>
                            <th class="cu-table-head">說明</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-breadcrumb</code></td>
                            <td class="cu-table-cell text-muted-foreground">麵包屑容器，水平排列項目</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-breadcrumb-item</code></td>
                            <td class="cu-table-cell text-muted-foreground">麵包屑項目，包含連結與分隔符</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-breadcrumb-link</code></td>
                            <td class="cu-table-cell text-muted-foreground">可點擊的導航連結</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-breadcrumb-separator</code></td>
                            <td class="cu-table-cell text-muted-foreground">項目之間的分隔符號</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-breadcrumb-current</code></td>
                            <td class="cu-table-cell text-muted-foreground">目前所在頁面，粗體前景色</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</Layout>
