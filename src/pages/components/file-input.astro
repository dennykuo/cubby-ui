---
import Layout from "../../layouts/Layout.astro";
import FileInput from "../../components/ui/FileInput.astro";
import Label from "../../components/ui/Label.astro";
import FormGroup from "../../components/ui/FormGroup.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<input type="file" class="cu-input-file" />`.trim();

const withLabelCode = `<div class="cu-form-group">
  <label class="cu-label" for="avatar">Avatar</label>
  <input type="file" class="cu-input-file" id="avatar" />
</div>`.trim();

const acceptCode = `<div class="cu-form-group">
  <label class="cu-label" for="image">Image file</label>
  <input type="file" class="cu-input-file" id="image" accept="image/*" />
</div>

<div class="cu-form-group">
  <label class="cu-label" for="document">Document</label>
  <input type="file" class="cu-input-file" id="document" accept=".pdf,.doc,.docx" />
</div>`.trim();

const multipleCode = `<div class="cu-form-group">
  <label class="cu-label" for="files">Upload files</label>
  <input type="file" class="cu-input-file" id="files" multiple />
</div>`.trim();

const disabledCode = `<input type="file" class="cu-input-file" disabled />`.trim();
---

<Layout category="Forms" componentName="File Input" title="File Input — Cubby UI">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">File Input</h1>
          <span class="cu-badge cu-badge-secondary">Forms</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            Displays a file upload input for selecting files from the user's device.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
              <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Usage
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Apply <code class="cu-code">cu-input-file</code> to an <code class="cu-code">&lt;input type="file"&gt;</code> element.
            </p>
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-sm">
                    <FileInput />
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                CSS Classes
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">Class</th>
                            <th class="cu-table-head">Description</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-input-file</code></td>
                            <td class="cu-table-cell text-muted-foreground">File upload input with custom browse button style</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>


        <!-- With Label -->
        <section class="space-y-3">
            <h2 id="with-label" class="text-lg font-semibold tracking-tight relative group">
              <a href="#with-label" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              With Label
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Pair with a <code class="cu-code">cu-label</code> for accessible file uploads.
            </p>
            <ComponentPreview code={withLabelCode}>
                <div class="w-full max-w-sm">
                    <FormGroup>
                        <Label for="avatar">Avatar</Label>
                        <FileInput id="avatar" />
                    </FormGroup>
                </div>
            </ComponentPreview>
        </section>

        <!-- Accept Types -->
        <section class="space-y-3">
            <h2 id="accept-types" class="text-lg font-semibold tracking-tight relative group">
              <a href="#accept-types" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Accept Types
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use the <code class="cu-code">accept</code> attribute to restrict file types.
            </p>
            <ComponentPreview code={acceptCode}>
                <div class="w-full max-w-sm space-y-4">
                    <FormGroup>
                        <Label for="image">Image file</Label>
                        <FileInput id="image" accept="image/*" />
                    </FormGroup>
                    <FormGroup>
                        <Label for="document">Document</Label>
                        <FileInput id="document" accept=".pdf,.doc,.docx" />
                    </FormGroup>
                </div>
            </ComponentPreview>
        </section>

        <!-- Multiple Files -->
        <section class="space-y-3">
            <h2 id="multiple-files" class="text-lg font-semibold tracking-tight relative group">
              <a href="#multiple-files" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Multiple Files
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Add the <code class="cu-code">multiple</code> attribute to allow selecting multiple files.
            </p>
            <ComponentPreview code={multipleCode}>
                <div class="w-full max-w-sm">
                    <FormGroup>
                        <Label for="files">Upload files</Label>
                        <FileInput id="files" multiple />
                    </FormGroup>
                </div>
            </ComponentPreview>
        </section>

        <!-- Disabled -->
        <section class="space-y-3">
            <h2 id="disabled" class="text-lg font-semibold tracking-tight relative group">
              <a href="#disabled" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Disabled
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Add the <code class="cu-code">disabled</code> attribute to prevent file selection.
            </p>
            <ComponentPreview code={disabledCode}>
                <div class="w-full max-w-sm">
                    <FileInput disabled />
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>
