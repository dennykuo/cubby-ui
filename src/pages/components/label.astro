---
import Layout from "@/layouts/Layout.astro";
import Label from "@/components/ui/Label.astro";
import Input from "@/components/ui/Input.astro";
import FormGroup from "@/components/ui/FormGroup.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { labelPage } from "@/i18n/pages/components/label";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(labelPage, locale);

const usageCode = `<label class="cu-label">Email</label>`.trim();

const withInputCode = `<div class="cu-form-group">
  <label class="cu-label" for="email-field">Email</label>
  <input class="cu-input" type="email" id="email-field" placeholder="you@example.com" />
</div>`.trim();

const requiredCode = `<!-- Using cu-label-required (automatic asterisk) -->
<div class="cu-form-group">
  <label class="cu-label cu-label-required" for="name-field">Name</label>
  <input class="cu-input" type="text" id="name-field" placeholder="Your name" required />
</div>

<!-- Manual asterisk -->
<div class="cu-form-group">
  <label class="cu-label" for="email-req">
    Email <span class="text-destructive">*</span>
  </label>
  <input class="cu-input" type="email" id="email-req" placeholder="you@example.com" required />
</div>`.trim();
---

<Layout category={t.category} componentName="Label" title={t.title}>
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Label</h1>
          <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
              <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <Label>Email</Label>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
          <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
            <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
            {t.sections.classes.title}
          </h2>
          <div class="cu-table-wrapper rounded-lg border border-border">
            <table class="cu-table">
              <thead class="cu-table-header">
                <tr class="cu-table-row">
                  <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                  <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                </tr>
              </thead>
              <tbody class="cu-table-body">
                {Object.entries(t.classDescriptions).map(([cls, desc]) => (
                  <tr class="cu-table-row">
                    <td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
                    <td class="cu-table-cell text-muted-foreground">{desc}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>


        <!-- With Input -->
        <section class="space-y-3">
            <h2 id="with-input" class="text-lg font-semibold tracking-tight relative group">
              <a href="#with-input" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.withInput.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withInput.description} />
            <ComponentPreview code={withInputCode}>
                <div class="w-full max-w-sm">
                    <FormGroup>
                        <Label for="email-field">Email</Label>
                        <Input type="email" id="email-field" placeholder="you@example.com" />
                    </FormGroup>
                </div>
            </ComponentPreview>
        </section>

        <!-- Required Indicator -->
        <section class="space-y-3">
            <h2 id="required-indicator" class="text-lg font-semibold tracking-tight relative group">
              <a href="#required-indicator" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.requiredIndicator.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.requiredIndicator.description} />
            <ComponentPreview code={requiredCode}>
                <div class="w-full max-w-sm space-y-4">
                    <FormGroup>
                        <Label for="name-field" class="cu-label-required">Name</Label>
                        <Input type="text" id="name-field" placeholder="Your name" required />
                    </FormGroup>
                    <FormGroup>
                        <Label for="email-req">
                            Email <span class="text-destructive">*</span>
                        </Label>
                        <Input type="email" id="email-req" placeholder="you@example.com" required />
                    </FormGroup>
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>
