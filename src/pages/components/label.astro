---
import Layout from "../../layouts/Layout.astro";
import Label from "../../components/ui/Label.astro";
import Input from "../../components/ui/Input.astro";
import FormGroup from "../../components/ui/FormGroup.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<label class="cu-label">Email</label>`.trim();

const withInputCode = `<div class="cu-form-group">
  <label class="cu-label" for="email-field">Email</label>
  <input class="cu-input" type="email" id="email-field" placeholder="you@example.com" />
</div>`.trim();

const requiredCode = `<div class="cu-form-group">
  <label class="cu-label" for="name-field">
    Name <span class="text-destructive">*</span>
  </label>
  <input class="cu-input" type="text" id="name-field" placeholder="Your name" required />
</div>`.trim();
---

<Layout category="Forms" componentName="Label" title="Label — Cubby UI">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Label</h1>
          <span class="cu-badge cu-badge-secondary">Forms</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            Displays a label for form controls with consistent typography.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
              <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Usage
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Apply <code class="cu-code">cu-label</code> to a <code class="cu-code">&lt;label&gt;</code> element.
            </p>
            <ComponentPreview code={usageCode}>
                <Label>Email</Label>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
          <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
            <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
            CSS Classes
          </h2>
          <div class="cu-table-wrapper rounded-lg border border-border">
            <table class="cu-table">
              <thead class="cu-table-header">
                <tr class="cu-table-row">
                  <th class="cu-table-head">Class</th>
                  <th class="cu-table-head">Description</th>
                </tr>
              </thead>
              <tbody class="cu-table-body">
                <tr class="cu-table-row">
                  <td class="cu-table-cell"><code class="cu-code">cu-label</code></td>
                  <td class="cu-table-cell text-muted-foreground">Form label style with peer-disabled opacity reduction</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>


        <!-- With Input -->
        <section class="space-y-3">
            <h2 id="with-input" class="text-lg font-semibold tracking-tight relative group">
              <a href="#with-input" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              With Input
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Pair with an input using the <code class="cu-code">for</code> and <code class="cu-code">id</code> attributes.
            </p>
            <ComponentPreview code={withInputCode}>
                <div class="w-full max-w-sm">
                    <FormGroup>
                        <Label for="email-field">Email</Label>
                        <Input type="email" id="email-field" placeholder="you@example.com" />
                    </FormGroup>
                </div>
            </ComponentPreview>
        </section>

        <!-- Required Indicator -->
        <section class="space-y-3">
            <h2 id="required-indicator" class="text-lg font-semibold tracking-tight relative group">
              <a href="#required-indicator" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Required Indicator
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Add an asterisk with <code class="cu-code">text-destructive</code> to mark required fields.
            </p>
            <ComponentPreview code={requiredCode}>
                <div class="w-full max-w-sm">
                    <FormGroup>
                        <Label for="name-field">
                            Name <span class="text-destructive">*</span>
                        </Label>
                        <Input type="text" id="name-field" placeholder="Your name" required />
                    </FormGroup>
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>
