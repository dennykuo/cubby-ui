---
import Layout from "@/layouts/Layout.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { imageComparePage } from "@/i18n/pages/components/image-compare";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(imageComparePage, locale);

const gripSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>`;

const usageCode = `<div class="cu-image-compare" data-cu-image-compare>
  <div class="cu-image-compare-after">
    <div style="width:100%;height:300px;background:linear-gradient(135deg,#667eea,#764ba2)"></div>
  </div>
  <div class="cu-image-compare-before">
    <div style="width:100%;height:300px;background:linear-gradient(135deg,#f093fb,#f5576c)"></div>
  </div>
  <div class="cu-image-compare-handle">
    <div class="cu-image-compare-handle-line"></div>
    <div class="cu-image-compare-handle-grip">${gripSvg}</div>
    <div class="cu-image-compare-handle-line"></div>
  </div>
</div>`.trim();

const withLabelsCode = `<div class="cu-image-compare" data-cu-image-compare>
  <div class="cu-image-compare-after">
    <div style="width:100%;height:300px;background:linear-gradient(135deg,#667eea,#764ba2)"></div>
    <span class="cu-image-compare-label">After</span>
  </div>
  <div class="cu-image-compare-before">
    <div style="width:100%;height:300px;background:linear-gradient(135deg,#f093fb,#f5576c)"></div>
    <span class="cu-image-compare-label">Before</span>
  </div>
  <div class="cu-image-compare-handle">
    <div class="cu-image-compare-handle-line"></div>
    <div class="cu-image-compare-handle-grip">${gripSvg}</div>
    <div class="cu-image-compare-handle-line"></div>
  </div>
</div>`.trim();

const verticalCode = `<div class="cu-image-compare cu-image-compare-vertical" data-cu-image-compare>
  <div class="cu-image-compare-after">
    <div style="width:100%;height:300px;background:linear-gradient(135deg,#667eea,#764ba2)"></div>
  </div>
  <div class="cu-image-compare-before">
    <div style="width:100%;height:300px;background:linear-gradient(135deg,#f093fb,#f5576c)"></div>
  </div>
  <div class="cu-image-compare-handle">
    <div class="cu-image-compare-handle-line"></div>
    <div class="cu-image-compare-handle-grip">${gripSvg}</div>
    <div class="cu-image-compare-handle-line"></div>
  </div>
</div>`.trim();

const initialPositionCode = `<div class="cu-image-compare" data-cu-image-compare data-cu-image-compare-position="25">
  <div class="cu-image-compare-after">
    <div style="width:100%;height:300px;background:linear-gradient(135deg,#667eea,#764ba2)"></div>
  </div>
  <div class="cu-image-compare-before">
    <div style="width:100%;height:300px;background:linear-gradient(135deg,#f093fb,#f5576c)"></div>
  </div>
  <div class="cu-image-compare-handle">
    <div class="cu-image-compare-handle-line"></div>
    <div class="cu-image-compare-handle-grip">${gripSvg}</div>
    <div class="cu-image-compare-handle-line"></div>
  </div>
</div>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Image Compare">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Image Compare</h1>
            <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode} />
        </section>

        <section class="space-y-3">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.classes.title}
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        {Object.entries(t.classDescriptions).map(([cls, desc]) => (
                            <tr class="cu-table-row">
                                <td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
                                <td class="cu-table-cell text-muted-foreground">{desc}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>

        <section class="space-y-3">
            <h2 id="with-labels" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-labels" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.withLabels.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withLabels.description} />
            <ComponentPreview code={withLabelsCode} />
        </section>

        <section class="space-y-3">
            <h2 id="vertical" class="text-lg font-semibold tracking-tight relative group">
                <a href="#vertical" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.vertical.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.vertical.description} />
            <ComponentPreview code={verticalCode} />
        </section>

        <section class="space-y-3">
            <h2 id="initial-position" class="text-lg font-semibold tracking-tight relative group">
                <a href="#initial-position" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.initialPosition.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.initialPosition.description} />
            <ComponentPreview code={initialPositionCode} />
        </section>
    </div>
</Layout>
