---
import Layout from "@/layouts/Layout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { floatingLabelPage } from "@/i18n/pages/components/floating-label";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(floatingLabelPage, locale);

const usageCode = `<div class="cu-floating-label">
  <input type="text" class="cu-floating-label-input" placeholder=" " id="fl-name" />
  <label for="fl-name" class="cu-floating-label-text">Full Name</label>
</div>`.trim();

const withValueCode = `<div class="cu-floating-label">
  <input type="text" class="cu-floating-label-input" placeholder=" " id="fl-name-filled" value="John Doe" />
  <label for="fl-name-filled" class="cu-floating-label-text">Full Name</label>
</div>`.trim();

const textareaCode = `<div class="cu-floating-label">
  <textarea class="cu-floating-label-input" placeholder=" " id="fl-message" rows="4"></textarea>
  <label for="fl-message" class="cu-floating-label-text">Message</label>
</div>`.trim();

const validationCode = `<!-- Error -->
<div class="cu-floating-label cu-floating-label-error">
  <input type="email" class="cu-floating-label-input" placeholder=" " id="fl-email-err" value="invalid-email" />
  <label for="fl-email-err" class="cu-floating-label-text">Email</label>
</div>

<!-- Success -->
<div class="cu-floating-label cu-floating-label-success">
  <input type="email" class="cu-floating-label-input" placeholder=" " id="fl-email-ok" value="user@example.com" />
  <label for="fl-email-ok" class="cu-floating-label-text">Email</label>
</div>`.trim();

const disabledCode = `<div class="cu-floating-label">
  <input type="text" class="cu-floating-label-input" placeholder=" " id="fl-disabled" disabled value="Cannot edit" />
  <label for="fl-disabled" class="cu-floating-label-text">Disabled Field</label>
</div>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Floating Label" description={t.description}>
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Floating Label</h1>
            <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <section class="space-y-3">
            <SectionHeading id="usage" title={t.sections.usage.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="classes" title={t.sections.classes.title} />
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        {Object.entries(t.classDescriptions).map(([cls, desc]) => (
                            <tr class="cu-table-row">
                                <td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
                                <td class="cu-table-cell text-muted-foreground">{desc}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>

        <section class="space-y-3">
            <SectionHeading id="with-value" title={t.sections.withValue.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withValue.description} />
            <ComponentPreview code={withValueCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="textarea" title={t.sections.textarea.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.textarea.description} />
            <ComponentPreview code={textareaCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="validation" title={t.sections.validation.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.validation.description} />
            <ComponentPreview code={validationCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="disabled" title={t.sections.disabled.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.disabled.description} />
            <ComponentPreview code={disabledCode} />
        </section>
    </div>
</Layout>
