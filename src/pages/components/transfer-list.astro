---
import Layout from "@/layouts/Layout.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { transferListPage } from "@/i18n/pages/components/transfer-list";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(transferListPage, locale);
const SO = "<" + "script>";
const SC = "</" + "script>";

const usageCode = `<div class="cu-transfer-list" data-cu-transfer-list>
  <!-- Left Panel -->
  <div class="cu-transfer-list-panel" data-cu-transfer-panel="left" style="width: 220px;">
    <div class="cu-transfer-list-header">
      <input type="checkbox" class="cu-checkbox" data-cu-transfer-check-all="left" />
      <span class="cu-transfer-list-header-title">Available</span>
      <span class="cu-transfer-list-header-count" data-cu-transfer-count="left">0/4</span>
    </div>
    <div class="cu-transfer-list-content" style="height: 200px;">
      <label class="cu-transfer-list-item">
        <input type="checkbox" class="cu-checkbox" data-cu-transfer-check />
        <span>HTML</span>
      </label>
      <label class="cu-transfer-list-item">
        <input type="checkbox" class="cu-checkbox" data-cu-transfer-check />
        <span>CSS</span>
      </label>
      <label class="cu-transfer-list-item">
        <input type="checkbox" class="cu-checkbox" data-cu-transfer-check />
        <span>JavaScript</span>
      </label>
      <label class="cu-transfer-list-item">
        <input type="checkbox" class="cu-checkbox" data-cu-transfer-check />
        <span>TypeScript</span>
      </label>
    </div>
  </div>

  <!-- Actions -->
  <div class="cu-transfer-list-actions">
    <button class="cu-transfer-list-actions-button" data-cu-transfer-to-right disabled>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <button class="cu-transfer-list-actions-button" data-cu-transfer-to-left disabled>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
  </div>

  <!-- Right Panel -->
  <div class="cu-transfer-list-panel" data-cu-transfer-panel="right" style="width: 220px;">
    <div class="cu-transfer-list-header">
      <input type="checkbox" class="cu-checkbox" data-cu-transfer-check-all="right" />
      <span class="cu-transfer-list-header-title">Selected</span>
      <span class="cu-transfer-list-header-count" data-cu-transfer-count="right">0/0</span>
    </div>
    <div class="cu-transfer-list-content" style="height: 200px;"></div>
  </div>
</div>

${SO}
  document.querySelectorAll("[data-cu-transfer-list]").forEach((container) => {
    const leftPanel = container.querySelector('[data-cu-transfer-panel="left"]');
    const rightPanel = container.querySelector('[data-cu-transfer-panel="right"]');
    const toRight = container.querySelector("[data-cu-transfer-to-right]");
    const toLeft = container.querySelector("[data-cu-transfer-to-left]");

    function getChecked(panel) {
      return panel.querySelectorAll("[data-cu-transfer-check]:checked");
    }

    function getAllItems(panel) {
      return panel.querySelectorAll(".cu-transfer-list-item");
    }

    function updateCount(panel) {
      const side = panel.dataset.cuTransferPanel;
      const all = getAllItems(panel);
      const checked = getChecked(panel);
      const countEl = container.querySelector('[data-cu-transfer-count="' + side + '"]');
      if (countEl) countEl.textContent = checked.length + '/' + all.length;
    }

    function updateButtons() {
      toRight.disabled = getChecked(leftPanel).length === 0;
      toLeft.disabled = getChecked(rightPanel).length === 0;
    }

    function updateCheckAll(panel) {
      const side = panel.dataset.cuTransferPanel;
      const all = getAllItems(panel);
      const checked = getChecked(panel);
      const checkAll = container.querySelector('[data-cu-transfer-check-all="' + side + '"]');
      if (checkAll) {
        checkAll.checked = all.length > 0 && checked.length === all.length;
        checkAll.indeterminate = checked.length > 0 && checked.length < all.length;
      }
    }

    function bindPanel(panel) {
      panel.addEventListener("change", (e) => {
        if (e.target.matches("[data-cu-transfer-check]")) {
          const item = e.target.closest(".cu-transfer-list-item");
          item?.classList.toggle("cu-transfer-list-item-checked", e.target.checked);
          updateCount(panel);
          updateButtons();
          updateCheckAll(panel);
        }
      });

      const side = panel.dataset.cuTransferPanel;
      const checkAll = container.querySelector('[data-cu-transfer-check-all="' + side + '"]');
      checkAll?.addEventListener("change", () => {
        const items = getAllItems(panel);
        items.forEach((item) => {
          const cb = item.querySelector("[data-cu-transfer-check]");
          if (cb) {
            cb.checked = checkAll.checked;
            item.classList.toggle("cu-transfer-list-item-checked", checkAll.checked);
          }
        });
        updateCount(panel);
        updateButtons();
      });
    }

    function moveItems(fromPanel, toPanel) {
      const checked = getChecked(fromPanel);
      const content = toPanel.querySelector(".cu-transfer-list-content");
      checked.forEach((cb) => {
        const item = cb.closest(".cu-transfer-list-item");
        cb.checked = false;
        item?.classList.remove("cu-transfer-list-item-checked");
        content?.appendChild(item);
      });
      updateCount(fromPanel);
      updateCount(toPanel);
      updateButtons();
      updateCheckAll(fromPanel);
      updateCheckAll(toPanel);
    }

    toRight?.addEventListener("click", () => moveItems(leftPanel, rightPanel));
    toLeft?.addEventListener("click", () => moveItems(rightPanel, leftPanel));

    bindPanel(leftPanel);
    bindPanel(rightPanel);
    updateCount(leftPanel);
    updateCount(rightPanel);
  });
${SC}`.trim();

