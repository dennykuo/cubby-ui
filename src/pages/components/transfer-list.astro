<script>
    function setupTransferLists() {
        document.querySelectorAll("[data-cu-transfer-list]").forEach((container) => {
            const leftPanel = container.querySelector('[data-cu-transfer-panel="left"]') as HTMLElement | null;
            const rightPanel = container.querySelector('[data-cu-transfer-panel="right"]') as HTMLElement | null;
            const toRight = container.querySelector("[data-cu-transfer-to-right]") as HTMLButtonElement | null;
            const toLeft = container.querySelector("[data-cu-transfer-to-left]") as HTMLButtonElement | null;
            if (!leftPanel || !rightPanel) return;

            function getChecked(panel: HTMLElement) {
                return panel.querySelectorAll("[data-cu-transfer-check]:checked") as NodeListOf<HTMLInputElement>;
            }

            function getAllItems(panel: HTMLElement) {
                return panel.querySelectorAll(".cu-transfer-list-item") as NodeListOf<HTMLElement>;
            }

            function getVisibleItems(panel: HTMLElement) {
                return Array.from(getAllItems(panel)).filter((item) => !item.hasAttribute("hidden"));
            }

            function updateCount(panel: HTMLElement) {
                const side = (panel as HTMLElement).dataset.cuTransferPanel;
                const all = getAllItems(panel);
                const checked = getChecked(panel);
                const countEl = container.querySelector('[data-cu-transfer-count="' + side + '"]');
                if (countEl) countEl.textContent = checked.length + '/' + all.length;
            }

            function updateButtons() {
                if (toRight) toRight.disabled = getChecked(leftPanel!).length === 0;
                if (toLeft) toLeft.disabled = getChecked(rightPanel!).length === 0;
            }

            function updateCheckAll(panel: HTMLElement) {
                const side = (panel as HTMLElement).dataset.cuTransferPanel;
                const all = getAllItems(panel);
                const checked = getChecked(panel);
                const checkAll = container.querySelector(`[data-cu-transfer-check-all="${side}"]`) as HTMLInputElement | null;
                if (checkAll) {
                    checkAll.checked = all.length > 0 && checked.length === all.length;
                    checkAll.indeterminate = checked.length > 0 && checked.length < all.length;
                }
            }

            function bindPanel(panel: HTMLElement) {
                panel.addEventListener("change", (e) => {
                    const target = e.target as HTMLElement;
                    if (target.matches("[data-cu-transfer-check]")) {
                        const item = target.closest(".cu-transfer-list-item");
                        item?.classList.toggle("cu-transfer-list-item-checked", (target as HTMLInputElement).checked);
                        updateCount(panel);
                        updateButtons();
                        updateCheckAll(panel);
                    }
                });

                const side = (panel as HTMLElement).dataset.cuTransferPanel;
                const checkAll = container.querySelector(`[data-cu-transfer-check-all="${side}"]`) as HTMLInputElement | null;
                checkAll?.addEventListener("change", () => {
                    const items = getAllItems(panel);
                    items.forEach((item) => {
                        const cb = item.querySelector("[data-cu-transfer-check]") as HTMLInputElement | null;
                        if (cb) {
                            cb.checked = checkAll.checked;
                            item.classList.toggle("cu-transfer-list-item-checked", checkAll.checked);
                        }
                    });
                    updateCount(panel);
                    updateButtons();
                });

                // Search filtering
                const searchInput = container.querySelector(`[data-cu-transfer-search="${side}"]`) as HTMLInputElement | null;
                searchInput?.addEventListener("input", () => {
                    const query = searchInput.value.toLowerCase();
                    const items = getAllItems(panel);
                    items.forEach((item) => {
                        const text = (item.querySelector("span")?.textContent || "").toLowerCase();
                        item.toggleAttribute("hidden", !text.includes(query));
                    });
                });
            }

            function moveItems(fromPanel: HTMLElement, toPanel: HTMLElement) {
                const checked = getChecked(fromPanel);
                const content = toPanel.querySelector(".cu-transfer-list-content");
                checked.forEach((cb) => {
                    const item = cb.closest(".cu-transfer-list-item");
                    cb.checked = false;
                    item?.classList.remove("cu-transfer-list-item-checked");
                    item?.removeAttribute("hidden");
                    content?.appendChild(item!);
                });
                updateCount(fromPanel);
                updateCount(toPanel);
                updateButtons();
                updateCheckAll(fromPanel);
                updateCheckAll(toPanel);
            }

            toRight?.addEventListener("click", () => moveItems(leftPanel!, rightPanel!));
            toLeft?.addEventListener("click", () => moveItems(rightPanel!, leftPanel!));

            bindPanel(leftPanel);
            bindPanel(rightPanel);
            updateCount(leftPanel);
            updateCount(rightPanel);
        });
    }

    setupTransferLists();
    document.addEventListener("astro:page-load", setupTransferLists);
</script>
