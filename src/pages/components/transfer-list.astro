    </button>
  </div>

  <!-- Right Panel -->
  <div class="cu-transfer-list-panel" data-cu-transfer-panel="right" style="width: 240px;">
    <div class="cu-transfer-list-header">
      <input type="checkbox" class="cu-checkbox" data-cu-transfer-check-all="right" />
      <span class="cu-transfer-list-header-title">Selected</span>
