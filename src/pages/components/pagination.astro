---
import Layout from "@/layouts/Layout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
// @ts-ignore - Astro component used in template
import Pagination from "@/components/ui/Pagination.astro";
import PaginationItem from "@/components/ui/PaginationItem.astro";
import PaginationPrev from "@/components/ui/PaginationPrev.astro";
import PaginationNext from "@/components/ui/PaginationNext.astro";
import PaginationEllipsis from "@/components/ui/PaginationEllipsis.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { paginationPage } from "@/i18n/pages/components/pagination";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(paginationPage, locale);

const usageCode = `<nav aria-label="Pagination">
  <ul class="cu-pagination">
    <li><a class="cu-pagination-item" href="#">1</a></li>
    <li><a class="cu-pagination-item cu-pagination-item-active" href="#" aria-current="page">2</a></li>
    <li><a class="cu-pagination-item" href="#">3</a></li>
  </ul>
</nav>`.trim();

const withEllipsisCode = `<nav aria-label="Pagination">
  <ul class="cu-pagination">
    <li><a class="cu-pagination-prev" href="#" aria-label="Go to previous page"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></a></li>
    <li><a class="cu-pagination-item" href="#">1</a></li>
    <li><a class="cu-pagination-item cu-pagination-item-active" href="#" aria-current="page">2</a></li>
    <li><a class="cu-pagination-item" href="#">3</a></li>
    <li><span class="cu-pagination-ellipsis"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg></span></li>
    <li><a class="cu-pagination-item" href="#">10</a></li>
    <li><a class="cu-pagination-next" href="#" aria-label="Go to next page"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></a></li>
  </ul>
</nav>`.trim();

const withPrevNextCode = `<nav aria-label="Pagination">
  <ul class="cu-pagination">
    <li><a class="cu-pagination-prev" href="#" aria-label="Go to previous page"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></a></li>
    <li><a class="cu-pagination-item" href="#">1</a></li>
    <li><a class="cu-pagination-item" href="#">2</a></li>
    <li><a class="cu-pagination-item cu-pagination-item-active" href="#" aria-current="page">3</a></li>
    <li><a class="cu-pagination-item" href="#">4</a></li>
    <li><a class="cu-pagination-item" href="#">5</a></li>
    <li><a class="cu-pagination-next" href="#" aria-label="Go to next page"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></a></li>
  </ul>
</nav>`.trim();

const withInfoTextCode = `<div class="flex items-center justify-between">
  <p class="text-sm text-muted-foreground">Showing 1-10 of 100 results</p>
  <nav aria-label="Pagination">
    <ul class="cu-pagination">
      <li><a class="cu-pagination-prev" href="#" aria-label="Go to previous page"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></a></li>
      <li><a class="cu-pagination-item cu-pagination-item-active" href="#" aria-current="page">1</a></li>
      <li><a class="cu-pagination-item" href="#">2</a></li>
      <li><a class="cu-pagination-item" href="#">3</a></li>
      <li><span class="cu-pagination-ellipsis"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg></span></li>
      <li><a class="cu-pagination-item" href="#">10</a></li>
      <li><a class="cu-pagination-next" href="#" aria-label="Go to next page"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></a></li>
    </ul>
  </nav>
</div>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Pagination" description={t.description}>
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Pagination</h1>
          <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            {t.description}
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <SectionHeading id="usage" title={t.sections.usage.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <Pagination>
                    <PaginationItem href="#">1</PaginationItem>
                    <PaginationItem href="#" active>2</PaginationItem>
                    <PaginationItem href="#">3</PaginationItem>
                </Pagination>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <SectionHeading id="classes" title={t.sections.classes.title} />
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-pagination</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-pagination']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-pagination-item</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-pagination-item']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-pagination-item-active</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-pagination-item-active']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-pagination-ellipsis</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-pagination-ellipsis']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-pagination-prev</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-pagination-prev']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-pagination-next</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-pagination-next']}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>


        <!-- With Ellipsis -->
        <section class="space-y-3">
            <SectionHeading id="with-ellipsis" title={t.sections.withEllipsis.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withEllipsis.description} />
            <ComponentPreview code={withEllipsisCode}>
                <Pagination>
                    <PaginationPrev href="#" />
                    <PaginationItem href="#">1</PaginationItem>
                    <PaginationItem href="#" active>2</PaginationItem>
                    <PaginationItem href="#">3</PaginationItem>
                    <PaginationEllipsis />
                    <PaginationItem href="#">10</PaginationItem>
                    <PaginationNext href="#" />
                </Pagination>
            </ComponentPreview>
        </section>

        <!-- With Prev/Next -->
        <section class="space-y-3">
            <SectionHeading id="with-prev-next" title={t.sections.withPrevNext.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withPrevNext.description} />
            <ComponentPreview code={withPrevNextCode}>
                <Pagination>
                    <PaginationPrev href="#" />
                    <PaginationItem href="#">1</PaginationItem>
                    <PaginationItem href="#">2</PaginationItem>
                    <PaginationItem href="#" active>3</PaginationItem>
                    <PaginationItem href="#">4</PaginationItem>
                    <PaginationItem href="#">5</PaginationItem>
                    <PaginationNext href="#" />
                </Pagination>
            </ComponentPreview>
        </section>

        <!-- With Info Text -->
        <section class="space-y-3">
            <SectionHeading id="with-info-text" title={t.sections.withInfoText.title} />
            <p class="text-base text-muted-foreground leading-relaxed">{t.sections.withInfoText.description}</p>
            <ComponentPreview code={withInfoTextCode}>
                <div class="w-full max-w-xl">
                    <div class="flex items-center justify-between">
                        <p class="text-sm text-muted-foreground">Showing 1-10 of 100 results</p>
                        <Pagination>
                            <PaginationPrev href="#" />
                            <PaginationItem href="#" active>1</PaginationItem>
                            <PaginationItem href="#">2</PaginationItem>
                            <PaginationItem href="#">3</PaginationItem>
                            <PaginationEllipsis />
                            <PaginationItem href="#">10</PaginationItem>
                            <PaginationNext href="#" />
                        </Pagination>
                    </div>
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>
