---
import Layout from "../../layouts/Layout.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<header class="cu-page-header">
  <div class="cu-page-header-content">
    <h1 class="cu-page-header-title">Page Title</h1>
    <p class="cu-page-header-description">A brief description of this page.</p>
  </div>
  <div class="cu-page-header-actions">
    <button class="cu-button cu-button-outline cu-button-md">Secondary</button>
    <button class="cu-button cu-button-default cu-button-md">Primary</button>
  </div>
</header>`.trim();

const withIconCode = `<header class="cu-page-header">
  <div class="cu-page-header-content">
    <h1 class="cu-page-header-title">Products</h1>
    <p class="cu-page-header-description">Manage your product catalog and inventory.</p>
  </div>
  <div class="cu-page-header-actions">
    <button class="cu-button cu-button-outline cu-button-md">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
      Export
    </button>
    <button class="cu-button cu-button-default cu-button-md">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="5" y2="19"/><line x1="5" x2="19" y1="12" y2="12"/></svg>
      Add Product
    </button>
  </div>
</header>`.trim();

const minimalCode = `<header class="cu-page-header">
  <div class="cu-page-header-content">
    <h1 class="cu-page-header-title">Settings</h1>
    <p class="cu-page-header-description">Manage your account and preferences.</p>
  </div>
</header>`.trim();
---

<Layout title="Page Header — Cubby UI" category="Layouts" componentName="Page Header">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Page Header</h1>
            <span class="cu-badge cu-badge-secondary">Layouts</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            A consistent header layout for dashboard pages with title, description, and action buttons.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Usage
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                The page header component provides a responsive layout that stacks vertically on mobile and aligns horizontally on larger screens.
            </p>
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-3xl">
                    <header class="cu-page-header">
                        <div class="cu-page-header-content">
                            <h1 class="cu-page-header-title">Page Title</h1>
                            <p class="cu-page-header-description">A brief description of this page.</p>
                        </div>
                        <div class="cu-page-header-actions">
                            <button class="cu-button cu-button-outline cu-button-md">Secondary</button>
                            <button class="cu-button cu-button-default cu-button-md">Primary</button>
                        </div>
                    </header>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Icons -->
        <section class="space-y-3">
            <h2 id="with-icons" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-icons" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                With Icons
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Action buttons can include icons for better visual clarity.
            </p>
            <ComponentPreview code={withIconCode}>
                <div class="w-full max-w-3xl">
                    <header class="cu-page-header">
                        <div class="cu-page-header-content">
                            <h1 class="cu-page-header-title">Products</h1>
                            <p class="cu-page-header-description">Manage your product catalog and inventory.</p>
                        </div>
                        <div class="cu-page-header-actions">
                            <button class="cu-button cu-button-outline cu-button-md">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                                Export
                            </button>
                            <button class="cu-button cu-button-default cu-button-md">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="5" y2="19"/><line x1="5" x2="19" y1="12" y2="12"/></svg>
                                Add Product
                            </button>
                        </div>
                    </header>
                </div>
            </ComponentPreview>
        </section>

        <!-- Minimal -->
        <section class="space-y-3">
            <h2 id="minimal" class="text-lg font-semibold tracking-tight relative group">
                <a href="#minimal" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Minimal
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                For pages without actions, use only the content section.
            </p>
            <ComponentPreview code={minimalCode}>
                <div class="w-full max-w-3xl">
                    <header class="cu-page-header">
                        <div class="cu-page-header-content">
                            <h1 class="cu-page-header-title">Settings</h1>
                            <p class="cu-page-header-description">Manage your account and preferences.</p>
                        </div>
                    </header>
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3 mt-10">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                CSS Classes
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">Class</th>
                            <th class="cu-table-head">Description</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-page-header</code></td>
                            <td class="cu-table-cell text-muted-foreground">Page header container (responsive flex)</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-page-header-content</code></td>
                            <td class="cu-table-cell text-muted-foreground">Title and description wrapper</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-page-header-title</code></td>
                            <td class="cu-table-cell text-muted-foreground">Page title (2xl, bold)</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-page-header-description</code></td>
                            <td class="cu-table-cell text-muted-foreground">Page description text</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-page-header-actions</code></td>
                            <td class="cu-table-cell text-muted-foreground">Action buttons container</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</Layout>
