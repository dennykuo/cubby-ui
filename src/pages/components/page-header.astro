---
import Layout from "@/layouts/Layout.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { pageHeaderPage } from "@/i18n/pages/components/page-header";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(pageHeaderPage, locale);

const usageCode = `<header class="cu-page-header">
  <div class="cu-page-header-content">
    <h1 class="cu-page-header-title">Page Title</h1>
    <p class="cu-page-header-description">A brief description of this page.</p>
  </div>
  <div class="cu-page-header-actions">
    <button class="cu-button cu-button-outline cu-button-md">Secondary</button>
    <button class="cu-button cu-button-default cu-button-md">Primary</button>
  </div>
</header>`.trim();

const withBreadcrumbCode = `<div class="space-y-4">
  <nav aria-label="Breadcrumb">
    <ol class="cu-breadcrumb">
      <li class="cu-breadcrumb-item">
        <a class="cu-breadcrumb-link" href="#">Dashboard</a>
      </li>
      <li role="presentation" aria-hidden="true" class="cu-breadcrumb-separator">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </li>
      <li class="cu-breadcrumb-item">
        <a class="cu-breadcrumb-link" href="#">Products</a>
      </li>
      <li role="presentation" aria-hidden="true" class="cu-breadcrumb-separator">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </li>
      <li class="cu-breadcrumb-item">
        <span class="cu-breadcrumb-current" aria-current="page">Wireless Headphones</span>
      </li>
    </ol>
  </nav>
  <header class="cu-page-header">
    <div class="cu-page-header-content">
      <h1 class="cu-page-header-title">Wireless Headphones</h1>
      <p class="cu-page-header-description">SKU-00482 · Last updated 2 hours ago</p>
    </div>
    <div class="cu-page-header-actions">
      <button class="cu-button cu-button-outline cu-button-md">Discard</button>
      <button class="cu-button cu-button-default cu-button-md">Save Changes</button>
    </div>
  </header>
</div>`.trim();

const withBadgeCode = `<header class="cu-page-header">
  <div class="cu-page-header-content">
    <div class="flex items-center gap-3">
      <h1 class="cu-page-header-title">Orders</h1>
      <span class="cu-badge cu-badge-secondary">128</span>
    </div>
    <p class="cu-page-header-description">View and manage customer orders.</p>
  </div>
  <div class="cu-page-header-actions">
    <button class="cu-button cu-button-outline cu-button-md">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
      Filter
    </button>
    <button class="cu-button cu-button-outline cu-button-md">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
      Export
    </button>
  </div>
</header>`.trim();

const iconActionsCode = `<header class="cu-page-header">
  <div class="cu-page-header-content">
    <h1 class="cu-page-header-title">Notifications</h1>
    <p class="cu-page-header-description">Stay updated with your latest alerts and messages.</p>
  </div>
  <div class="cu-page-header-actions">
    <button class="cu-button cu-button-outline cu-button-icon" aria-label="Mark all as read">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
    </button>
    <button class="cu-button cu-button-ghost cu-button-icon" aria-label="More options">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
    </button>
  </div>
</header>`.trim();

const minimalCode = `<header class="cu-page-header">
  <div class="cu-page-header-content">
    <h1 class="cu-page-header-title">Settings</h1>
    <p class="cu-page-header-description">Manage your account and preferences.</p>
  </div>
</header>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Page Header">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Page Header</h1>
            <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            {t.description}
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                {t.sections.usage.description}
            </p>
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-3xl">
                    <header class="cu-page-header">
                        <div class="cu-page-header-content">
                            <h1 class="cu-page-header-title">Page Title</h1>
                            <p class="cu-page-header-description">A brief description of this page.</p>
                        </div>
                        <div class="cu-page-header-actions">
                            <button class="cu-button cu-button-outline cu-button-md">Secondary</button>
                            <button class="cu-button cu-button-default cu-button-md">Primary</button>
                        </div>
                    </header>
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.classes.title}
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        {Object.entries(t.classDescriptions).map(([cls, desc]) => (
                            <tr class="cu-table-row">
                                <td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
                                <td class="cu-table-cell text-muted-foreground">{desc}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Minimal -->
        <section class="space-y-3">
            <h2 id="minimal" class="text-lg font-semibold tracking-tight relative group">
                <a href="#minimal" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.minimal.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                {t.sections.minimal.description}
            </p>
            <ComponentPreview code={minimalCode}>
                <div class="w-full max-w-3xl">
                    <header class="cu-page-header">
                        <div class="cu-page-header-content">
                            <h1 class="cu-page-header-title">Settings</h1>
                            <p class="cu-page-header-description">Manage your account and preferences.</p>
                        </div>
                    </header>
                </div>
            </ComponentPreview>
        </section>

        <!-- Icon Actions -->
        <section class="space-y-3">
            <h2 id="icon-actions" class="text-lg font-semibold tracking-tight relative group">
                <a href="#icon-actions" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.iconActions.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                {t.sections.iconActions.description}
            </p>
            <ComponentPreview code={iconActionsCode}>
                <div class="w-full max-w-3xl">
                    <header class="cu-page-header">
                        <div class="cu-page-header-content">
                            <h1 class="cu-page-header-title">Notifications</h1>
                            <p class="cu-page-header-description">Stay updated with your latest alerts and messages.</p>
                        </div>
                        <div class="cu-page-header-actions">
                            <button class="cu-button cu-button-outline cu-button-icon" aria-label="Mark all as read">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            </button>
                            <button class="cu-button cu-button-ghost cu-button-icon" aria-label="More options">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                            </button>
                        </div>
                    </header>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Badge -->
        <section class="space-y-3">
            <h2 id="with-badge" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-badge" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.withBadge.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                {t.sections.withBadge.description}
            </p>
            <ComponentPreview code={withBadgeCode}>
                <div class="w-full max-w-3xl">
                    <header class="cu-page-header">
                        <div class="cu-page-header-content">
                            <div class="flex items-center gap-3">
                                <h1 class="cu-page-header-title">Orders</h1>
                                <span class="cu-badge cu-badge-secondary">128</span>
                            </div>
                            <p class="cu-page-header-description">View and manage customer orders.</p>
                        </div>
                        <div class="cu-page-header-actions">
                            <button class="cu-button cu-button-outline cu-button-md">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                                Filter
                            </button>
                            <button class="cu-button cu-button-outline cu-button-md">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                                Export
                            </button>
                        </div>
                    </header>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Breadcrumb -->
        <section class="space-y-3">
            <h2 id="with-breadcrumb" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-breadcrumb" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.withBreadcrumb.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                {t.sections.withBreadcrumb.description}
            </p>
            <ComponentPreview code={withBreadcrumbCode}>
                <div class="w-full max-w-3xl">
                    <div class="space-y-4">
                        <nav aria-label="Breadcrumb">
                            <ol class="cu-breadcrumb">
                                <li class="cu-breadcrumb-item">
                                    <a class="cu-breadcrumb-link" href="#">Dashboard</a>
                                </li>
                                <li role="presentation" aria-hidden="true" class="cu-breadcrumb-separator">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                                </li>
                                <li class="cu-breadcrumb-item">
                                    <a class="cu-breadcrumb-link" href="#">Products</a>
                                </li>
                                <li role="presentation" aria-hidden="true" class="cu-breadcrumb-separator">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                                </li>
                                <li class="cu-breadcrumb-item">
                                    <span class="cu-breadcrumb-current" aria-current="page">Wireless Headphones</span>
                                </li>
                            </ol>
                        </nav>
                        <header class="cu-page-header">
                            <div class="cu-page-header-content">
                                <h1 class="cu-page-header-title">Wireless Headphones</h1>
                                <p class="cu-page-header-description">SKU-00482 · Last updated 2 hours ago</p>
                            </div>
                            <div class="cu-page-header-actions">
                                <button class="cu-button cu-button-outline cu-button-md">Discard</button>
                                <button class="cu-button cu-button-default cu-button-md">Save Changes</button>
                            </div>
                        </header>
                    </div>
                </div>
            </ComponentPreview>
        </section>

    </div>
</Layout>
