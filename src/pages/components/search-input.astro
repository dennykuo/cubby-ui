---
import Layout from "@/layouts/Layout.astro";
import SearchInput from "@/components/ui/SearchInput.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { searchInputPage } from "@/i18n/pages/components/search-input";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(searchInputPage, locale);

const usageCode = `<div class="cu-input-search">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cu-input-search-icon">
    <circle cx="11" cy="11" r="8"></circle>
    <path d="m21 21-4.3-4.3"></path>
  </svg>
  <input class="cu-input-search-field" type="search" placeholder="Search..." />
</div>`.trim();

const clearableCode = `<div class="cu-input-search">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cu-input-search-icon">
    <circle cx="11" cy="11" r="8"></circle>
    <path d="m21 21-4.3-4.3"></path>
  </svg>
  <input class="cu-input-search-field" type="search" placeholder="Search..." />
  <button type="button" class="cu-input-search-clear">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
  </button>
</div>`.trim();

const placeholderCode = `<div class="cu-input-search">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cu-input-search-icon">
    <circle cx="11" cy="11" r="8"></circle>
    <path d="m21 21-4.3-4.3"></path>
  </svg>
  <input class="cu-input-search-field" type="search" placeholder="Search components..." />
</div>`.trim();

const disabledCode = `<div class="cu-input-search">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cu-input-search-icon">
    <circle cx="11" cy="11" r="8"></circle>
    <path d="m21 21-4.3-4.3"></path>
  </svg>
  <input class="cu-input-search-field" type="search" placeholder="Search..." disabled />
</div>`.trim();
---

<Layout category={t.category} componentName="Search Input" title={t.title}>
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Search Input</h1>
          <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
              <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-sm">
                    <SearchInput placeholder="Search..." />
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.classes.title}
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-input-search</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-input-search']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-input-search-icon</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-input-search-icon']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-input-search-field</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-input-search-field']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-input-search-clear</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-input-search-clear']}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>


        <!-- Clearable -->
        <section class="space-y-3">
            <h2 id="clearable" class="text-lg font-semibold tracking-tight relative group">
              <a href="#clearable" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.clearable.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.clearable.description} />
            <ComponentPreview code={clearableCode}>
                <div class="w-full max-w-sm">
                    <SearchInput placeholder="Search..." clearable />
                </div>
            </ComponentPreview>
        </section>

        <!-- With Placeholder -->
        <section class="space-y-3">
            <h2 id="with-placeholder" class="text-lg font-semibold tracking-tight relative group">
              <a href="#with-placeholder" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.withPlaceholder.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withPlaceholder.description} />
            <ComponentPreview code={placeholderCode}>
                <div class="w-full max-w-sm">
                    <SearchInput placeholder="Search components..." />
                </div>
            </ComponentPreview>
        </section>

        <!-- Disabled -->
        <section class="space-y-3">
            <h2 id="disabled" class="text-lg font-semibold tracking-tight relative group">
              <a href="#disabled" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.disabled.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.disabled.description} />
            <ComponentPreview code={disabledCode}>
                <div class="w-full max-w-sm">
                    <SearchInput placeholder="Search..." disabled />
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>

<script>
document.querySelectorAll("[data-cu-search-clear]").forEach(function (btn) {
    btn.addEventListener("click", function () {
        var input = btn.closest(".cu-input-search")?.querySelector(".cu-input-search-field") as HTMLInputElement | null;
        if (input) {
            input.value = "";
            input.focus();
        }
    });
});
</script>
