---
import Layout from "../../layouts/Layout.astro";
import List from "../../components/ui/List.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const unorderedCode = `<ul class="cu-list cu-list-disc">
  <li>Minimal footprint — pure CSS, no runtime dependencies</li>
  <li>Framework agnostic — works with any HTML project</li>
  <li>Semantic color tokens for consistent theming</li>
</ul>`.trim();

const orderedCode = `<ol class="cu-list cu-list-decimal">
  <li>Install the package from npm</li>
  <li>Import the CSS file into your project</li>
  <li>Add component classes to your HTML markup</li>
</ol>`.trim();

const nestedCode = `<ul class="cu-list cu-list-disc">
  <li>Design tokens
    <ul class="cu-list cu-list-disc">
      <li>Semantic colors (primary, secondary, destructive)</li>
      <li>Spacing scale and border radius</li>
    </ul>
  </li>
  <li>Component layers
    <ul class="cu-list cu-list-disc">
      <li>CSS class layer — framework agnostic</li>
      <li>Astro component layer — type-safe wrappers</li>
    </ul>
  </li>
  <li>Accessibility built-in</li>
</ul>`.trim();

const iconListCode = `<ul class="cu-list cu-list-none">
  <li class="flex items-start gap-2">
    <svg class="size-4 mt-0.5 shrink-0 text-success" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
    <span>Fully responsive and mobile-first</span>
  </li>
  <li class="flex items-start gap-2">
    <svg class="size-4 mt-0.5 shrink-0 text-success" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
    <span>Dark mode support out of the box</span>
  </li>
  <li class="flex items-start gap-2">
    <svg class="size-4 mt-0.5 shrink-0 text-success" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
    <span>Accessible with keyboard navigation</span>
  </li>
  <li class="flex items-start gap-2">
    <svg class="size-4 mt-0.5 shrink-0 text-muted-foreground/40" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    <span class="text-muted-foreground">No JavaScript framework required</span>
  </li>
</ul>`.trim();

const borderedCode = `<ul class="cu-list cu-list-bordered">
  <li class="flex items-center justify-between">
    <div>
      <div class="font-medium">Email notifications</div>
      <div class="text-muted-foreground text-xs">Receive emails for new messages</div>
    </div>
    <span class="cu-badge cu-badge-success">Enabled</span>
  </li>
  <li class="flex items-center justify-between">
    <div>
      <div class="font-medium">Push notifications</div>
      <div class="text-muted-foreground text-xs">Receive push notifications on mobile</div>
    </div>
    <span class="cu-badge cu-badge-outline">Disabled</span>
  </li>
  <li class="flex items-center justify-between">
    <div>
      <div class="font-medium">SMS notifications</div>
      <div class="text-muted-foreground text-xs">Receive text messages for alerts</div>
    </div>
    <span class="cu-badge cu-badge-success">Enabled</span>
  </li>
</ul>`.trim();

const inlineCode = `<ul class="cu-list cu-list-inline">
  <li><a class="cu-link" href="#">Home</a></li>
  <li class="text-muted-foreground/40">·</li>
  <li><a class="cu-link" href="#">Features</a></li>
  <li class="text-muted-foreground/40">·</li>
  <li><a class="cu-link" href="#">Pricing</a></li>
  <li class="text-muted-foreground/40">·</li>
  <li><a class="cu-link" href="#">About</a></li>
</ul>`.trim();

const dlVerticalCode = `<dl class="cu-dl">
  <div class="cu-dl-item">
    <dt class="cu-dl-term">Name</dt>
    <dd class="cu-dl-detail">Cubby UI</dd>
  </div>
  <div class="cu-dl-item">
    <dt class="cu-dl-term">Category</dt>
    <dd class="cu-dl-detail">CSS Component Library</dd>
  </div>
  <div class="cu-dl-item">
    <dt class="cu-dl-term">Description</dt>
    <dd class="cu-dl-detail">A framework-agnostic UI library built with pure HTML and Tailwind CSS. Designed for copy-paste usage without any runtime dependencies.</dd>
  </div>
</dl>`.trim();

const dlHorizontalCode = `<dl class="cu-dl cu-dl-horizontal">
  <div class="cu-dl-item">
    <dt class="cu-dl-term">Status</dt>
    <dd class="cu-dl-detail">Active</dd>
  </div>
  <div class="cu-dl-item">
    <dt class="cu-dl-term">License</dt>
    <dd class="cu-dl-detail">MIT</dd>
  </div>
  <div class="cu-dl-item">
    <dt class="cu-dl-term">Last updated</dt>
    <dd class="cu-dl-detail">January 29, 2026</dd>
  </div>
  <div class="cu-dl-item">
    <dt class="cu-dl-term">Dependencies</dt>
    <dd class="cu-dl-detail">None — pure CSS, zero JavaScript runtime</dd>
  </div>
</dl>`.trim();
---

<Layout title="Lists — Cubby UI" category="Typography" componentName="Lists">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Lists</h1>
          <span class="cu-badge cu-badge-secondary">Typography</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            Styled lists with refined marker colors, spacing, and multiple layout variants including bordered, inline, and description lists.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Unordered -->
        <section class="space-y-3">
            <h2 id="unordered" class="text-lg font-semibold tracking-tight flex items-center gap-2 group">
              <a href="#unordered" class="text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Unordered
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-list cu-list-disc</code> for
                bullet-point lists. Markers are styled with a muted color for a subtle look.
            </p>
            <ComponentPreview code={unorderedCode}>
                <div class="w-full max-w-lg">
                    <List>
                        <li>Minimal footprint — pure CSS, no runtime dependencies</li>
                        <li>Framework agnostic — works with any HTML project</li>
                        <li>Semantic color tokens for consistent theming</li>
                    </List>
                </div>
            </ComponentPreview>
        </section>

        <!-- Ordered -->
        <section class="space-y-3">
            <h2 id="ordered" class="text-lg font-semibold tracking-tight flex items-center gap-2 group">
              <a href="#ordered" class="text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Ordered
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-list cu-list-decimal</code> for
                numbered lists. Numbers use a medium font weight with muted color.
            </p>
            <ComponentPreview code={orderedCode}>
                <div class="w-full max-w-lg">
                    <List type="decimal">
                        <li>Install the package from npm</li>
                        <li>Import the CSS file into your project</li>
                        <li>Add component classes to your HTML markup</li>
                    </List>
                </div>
            </ComponentPreview>
        </section>

        <!-- Nested -->
        <section class="space-y-3">
            <h2 id="nested" class="text-lg font-semibold tracking-tight flex items-center gap-2 group">
              <a href="#nested" class="text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Nested
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Lists can be nested by adding another
                <code class="cu-code">cu-list</code> inside a list item.
                Spacing between levels is handled automatically.
            </p>
            <ComponentPreview code={nestedCode}>
                <div class="w-full max-w-lg">
                    <ul class="cu-list cu-list-disc">
                        <li>Design tokens
                            <ul class="cu-list cu-list-disc">
                                <li>Semantic colors (primary, secondary, destructive)</li>
                                <li>Spacing scale and border radius</li>
                            </ul>
                        </li>
                        <li>Component layers
                            <ul class="cu-list cu-list-disc">
                                <li>CSS class layer — framework agnostic</li>
                                <li>Astro component layer — type-safe wrappers</li>
                            </ul>
                        </li>
                        <li>Accessibility built-in</li>
                    </ul>
                </div>
            </ComponentPreview>
        </section>

        <!-- Icon List -->
        <section class="space-y-3">
            <h2 id="icon-list" class="text-lg font-semibold tracking-tight flex items-center gap-2 group">
              <a href="#icon-list" class="text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Icon List
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-list cu-list-none</code> with inline SVG icons
                for check lists, feature lists, or any custom marker.
            </p>
            <ComponentPreview code={iconListCode}>
                <div class="w-full max-w-lg">
                    <List type="none">
                        <li class="flex items-start gap-2">
                            <svg class="size-4 mt-0.5 shrink-0 text-success" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                            <span>Fully responsive and mobile-first</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <svg class="size-4 mt-0.5 shrink-0 text-success" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                            <span>Dark mode support out of the box</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <svg class="size-4 mt-0.5 shrink-0 text-success" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                            <span>Accessible with keyboard navigation</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <svg class="size-4 mt-0.5 shrink-0 text-muted-foreground/40" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            <span class="text-muted-foreground">No JavaScript framework required</span>
                        </li>
                    </List>
                </div>
            </ComponentPreview>
        </section>

        <!-- Bordered -->
        <section class="space-y-3">
            <h2 id="bordered" class="text-lg font-semibold tracking-tight flex items-center gap-2 group">
              <a href="#bordered" class="text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Bordered
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-list cu-list-bordered</code> for
                a clean divider-separated list. Ideal for settings panels, notification preferences, or any key-value layout.
            </p>
            <ComponentPreview code={borderedCode}>
                <div class="w-full max-w-lg">
                    <ul class="cu-list cu-list-bordered">
                        <li class="flex items-center justify-between">
                            <div>
                                <div class="font-medium">Email notifications</div>
                                <div class="text-muted-foreground text-xs">Receive emails for new messages</div>
                            </div>
                            <span class="cu-badge cu-badge-success">Enabled</span>
                        </li>
                        <li class="flex items-center justify-between">
                            <div>
                                <div class="font-medium">Push notifications</div>
                                <div class="text-muted-foreground text-xs">Receive push notifications on mobile</div>
                            </div>
                            <span class="cu-badge cu-badge-outline">Disabled</span>
                        </li>
                        <li class="flex items-center justify-between">
                            <div>
                                <div class="font-medium">SMS notifications</div>
                                <div class="text-muted-foreground text-xs">Receive text messages for alerts</div>
                            </div>
                            <span class="cu-badge cu-badge-success">Enabled</span>
                        </li>
                    </ul>
                </div>
            </ComponentPreview>
        </section>

        <!-- Inline -->
        <section class="space-y-3">
            <h2 id="inline" class="text-lg font-semibold tracking-tight flex items-center gap-2 group">
              <a href="#inline" class="text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Inline
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-list cu-list-inline</code> for
                horizontal lists. Useful for footer links, tags, or breadcrumb-like navigation.
            </p>
            <ComponentPreview code={inlineCode}>
                <div class="w-full max-w-lg">
                    <ul class="cu-list cu-list-inline">
                        <li><a class="cu-link" href="#">Home</a></li>
                        <li class="text-muted-foreground/40">·</li>
                        <li><a class="cu-link" href="#">Features</a></li>
                        <li class="text-muted-foreground/40">·</li>
                        <li><a class="cu-link" href="#">Pricing</a></li>
                        <li class="text-muted-foreground/40">·</li>
                        <li><a class="cu-link" href="#">About</a></li>
                    </ul>
                </div>
            </ComponentPreview>
        </section>

        <!-- Description List -->
        <section class="space-y-3">
            <h2 id="description-list" class="text-lg font-semibold tracking-tight flex items-center gap-2 group">
              <a href="#description-list" class="text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Description List
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-dl</code> with
                <code class="cu-code">cu-dl-item</code>, <code class="cu-code">cu-dl-term</code>,
                and <code class="cu-code">cu-dl-detail</code> for key-value pairs. Defaults to a vertical stacked layout.
            </p>
            <ComponentPreview code={dlVerticalCode}>
                <div class="w-full max-w-lg">
                    <dl class="cu-dl">
                        <div class="cu-dl-item">
                            <dt class="cu-dl-term">Name</dt>
                            <dd class="cu-dl-detail">Cubby UI</dd>
                        </div>
                        <div class="cu-dl-item">
                            <dt class="cu-dl-term">Category</dt>
                            <dd class="cu-dl-detail">CSS Component Library</dd>
                        </div>
                        <div class="cu-dl-item">
                            <dt class="cu-dl-term">Description</dt>
                            <dd class="cu-dl-detail">A framework-agnostic UI library built with pure HTML and Tailwind CSS. Designed for copy-paste usage without any runtime dependencies.</dd>
                        </div>
                    </dl>
                </div>
            </ComponentPreview>
        </section>

        <!-- Horizontal Description List -->
        <section class="space-y-3">
            <h2 id="horizontal-description-list" class="text-lg font-semibold tracking-tight flex items-center gap-2 group">
              <a href="#horizontal-description-list" class="text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Horizontal Description List
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Add <code class="cu-code">cu-dl-horizontal</code> to render terms and details
                side by side. The term column has a fixed width for alignment.
            </p>
            <ComponentPreview code={dlHorizontalCode}>
                <div class="w-full max-w-lg">
                    <dl class="cu-dl cu-dl-horizontal">
                        <div class="cu-dl-item">
                            <dt class="cu-dl-term">Status</dt>
                            <dd class="cu-dl-detail">Active</dd>
                        </div>
                        <div class="cu-dl-item">
                            <dt class="cu-dl-term">License</dt>
                            <dd class="cu-dl-detail">MIT</dd>
                        </div>
                        <div class="cu-dl-item">
                            <dt class="cu-dl-term">Last updated</dt>
                            <dd class="cu-dl-detail">January 29, 2026</dd>
                        </div>
                        <div class="cu-dl-item">
                            <dt class="cu-dl-term">Dependencies</dt>
                            <dd class="cu-dl-detail">None — pure CSS, zero JavaScript runtime</dd>
                        </div>
                    </dl>
                </div>
            </ComponentPreview>
        </section>
    </div>

    <!-- Classes Reference -->
    <section class="space-y-3 mt-10">
      <h2 id="classes" class="text-lg font-semibold tracking-tight flex items-center gap-2 group">
        <a href="#classes" class="text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        CSS Classes
      </h2>
      <div class="cu-table-wrapper rounded-lg border border-border">
        <table class="cu-table">
          <thead class="cu-table-header">
            <tr class="cu-table-row">
              <th class="cu-table-head">Class</th>
              <th class="cu-table-head">說明</th>
            </tr>
          </thead>
          <tbody class="cu-table-body">
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-list</code></td>
              <td class="cu-table-cell text-muted-foreground">列表基礎樣式，統一縮排與間距</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-list-disc</code></td>
              <td class="cu-table-cell text-muted-foreground">無序列表，圓點標記</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-list-decimal</code></td>
              <td class="cu-table-cell text-muted-foreground">有序列表，數字標記</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-list-none</code></td>
              <td class="cu-table-cell text-muted-foreground">無標記列表，適用於圖示列表</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-list-bordered</code></td>
              <td class="cu-table-cell text-muted-foreground">分隔線列表，項目間以邊線分隔</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-list-inline</code></td>
              <td class="cu-table-cell text-muted-foreground">水平排列列表</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-dl</code></td>
              <td class="cu-table-cell text-muted-foreground">描述列表容器</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-dl-item</code></td>
              <td class="cu-table-cell text-muted-foreground">描述列表項目</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-dl-term</code></td>
              <td class="cu-table-cell text-muted-foreground">描述列表術語（標題）</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-dl-detail</code></td>
              <td class="cu-table-cell text-muted-foreground">描述列表詳情（內容）</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-dl-horizontal</code></td>
              <td class="cu-table-cell text-muted-foreground">水平排列描述列表，術語與詳情並排</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
</Layout>
