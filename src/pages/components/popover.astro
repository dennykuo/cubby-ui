---
import Layout from "@/layouts/Layout.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { popoverPage } from "@/i18n/pages/components/popover";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(popoverPage, locale);
const SO = "<" + "script>";
const SC = "</" + "script>";

const usageCode = `<div class="cu-popover" data-cu-popover>
  <button class="cu-button cu-button-outline cu-button-md" data-cu-popover-trigger>
    Open Popover
  </button>
  <div class="cu-popover-content" data-cu-popover-content>
    <div class="space-y-2">
      <h4 class="text-sm font-medium leading-none">Dimensions</h4>
      <p class="text-sm text-muted-foreground">Set the dimensions for the layer.</p>
    </div>
    <div class="mt-4 space-y-3">
      <div class="cu-form-group">
        <label class="cu-label" for="pop-width">Width</label>
        <input class="cu-input" id="pop-width" value="100%" />
      </div>
      <div class="cu-form-group">
        <label class="cu-label" for="pop-height">Height</label>
        <input class="cu-input" id="pop-height" value="25px" />
      </div>
    </div>
  </div>
</div>

${SO}
  document.querySelectorAll("[data-cu-popover]").forEach((popover) => {
    const trigger = popover.querySelector("[data-cu-popover-trigger]");
    const content = popover.querySelector("[data-cu-popover-content]");
    if (!trigger || !content) return;
    content.style.display = "none";
    trigger.addEventListener("click", () => {
      const open = content.style.display !== "none";
      content.style.display = open ? "none" : "";
    });
    document.addEventListener("click", (e) => {
      if (!popover.contains(e.target)) content.style.display = "none";
    });
  });
${SC}`.trim();

const topCode = `<div class="cu-popover" data-cu-popover>
  <button class="cu-button cu-button-outline cu-button-md" data-cu-popover-trigger>
    Top Popover
  </button>
  <div class="cu-popover-content bottom-full mb-2" data-cu-popover-content>
    <p class="text-sm text-muted-foreground">This popover opens above the trigger.</p>
  </div>
</div>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Popover">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Popover</h1>
            <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            {t.description}
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <div class="cu-popover" data-cu-popover>
                    <button class="cu-button cu-button-outline cu-button-md" data-cu-popover-trigger>
                        Open Popover
                    </button>
                    <div class="cu-popover-content" data-cu-popover-content>
                        <div class="space-y-2">
                            <h4 class="text-sm font-medium leading-none">Dimensions</h4>
                            <p class="text-sm text-muted-foreground">Set the dimensions for the layer.</p>
                        </div>
                        <div class="mt-4 space-y-3">
                            <div class="cu-form-group">
                                <label class="cu-label" for="pop-width">Width</label>
                                <input class="cu-input" id="pop-width" value="100%" />
                            </div>
                            <div class="cu-form-group">
                                <label class="cu-label" for="pop-height">Height</label>
                                <input class="cu-input" id="pop-height" value="25px" />
                            </div>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.classes.title}
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-popover</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-popover']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-popover-content</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-popover-content']}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>


        <!-- Top Position -->
        <section class="space-y-3">
            <h2 id="top-position" class="text-lg font-semibold tracking-tight relative group">
                <a href="#top-position" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.topPosition.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.topPosition.description} />
            <ComponentPreview code={topCode}>
                <div class="cu-popover" data-cu-popover>
                    <button class="cu-button cu-button-outline cu-button-md" data-cu-popover-trigger>
                        Top Popover
                    </button>
                    <div class="cu-popover-content bottom-full mb-2" data-cu-popover-content>
                        <p class="text-sm text-muted-foreground">This popover opens above the trigger.</p>
                    </div>
                </div>
            </ComponentPreview>
        </section>

    </div>
</Layout>

<script>
    function setupPopovers() {
        document.querySelectorAll("[data-cu-popover]").forEach((popover) => {
            const trigger = popover.querySelector("[data-cu-popover-trigger]");
            const content = popover.querySelector("[data-cu-popover-content]") as HTMLElement | null;
            if (!trigger || !content) return;
            content.style.display = "none";
            trigger.addEventListener("click", () => {
                const open = content.style.display !== "none";
                content.style.display = open ? "none" : "";
            });
            document.addEventListener("click", (e) => {
                if (!popover.contains(e.target as Node)) content.style.display = "none";
            });
        });
    }

    setupPopovers();
    document.addEventListener("astro:page-load", setupPopovers);
</script>
