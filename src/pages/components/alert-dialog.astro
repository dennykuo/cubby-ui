---
import Layout from "@/layouts/Layout.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { alertDialogPage } from "@/i18n/pages/components/alert-dialog";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(alertDialogPage, locale);
const SO = "<" + "script>";
const SC = "</" + "script>";

const usageCode = `<button class="cu-button cu-button-outline cu-button-md" data-cu-alert-dialog-trigger="demo-alert-dialog">
  Delete Account
</button>

<dialog class="cu-alert-dialog" id="demo-alert-dialog" data-cu-alert-dialog>
  <div class="cu-alert-dialog-header">
    <h2 class="cu-alert-dialog-title">Are you absolutely sure?</h2>
    <p class="cu-alert-dialog-description">This action cannot be undone. This will permanently delete your account and remove your data from our servers.</p>
  </div>
  <div class="cu-alert-dialog-footer">
    <button class="cu-button cu-button-outline cu-button-md" data-cu-alert-dialog-cancel>Cancel</button>
    <button class="cu-button cu-button-destructive cu-button-md" data-cu-alert-dialog-action>Delete</button>
  </div>
</dialog>

${SO}
  document.querySelectorAll("[data-cu-alert-dialog-trigger]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const id = trigger.getAttribute("data-cu-alert-dialog-trigger");
      document.getElementById(id)?.showModal();
    });
  });
  document.querySelectorAll("[data-cu-alert-dialog]").forEach((dialog) => {
    dialog.querySelectorAll("[data-cu-alert-dialog-cancel]").forEach((btn) => {
      btn.addEventListener("click", () => dialog.close());
    });
    dialog.querySelectorAll("[data-cu-alert-dialog-action]").forEach((btn) => {
      btn.addEventListener("click", () => dialog.close());
    });
  });
${SC}`.trim();

const withIconCode = `<button class="cu-button cu-button-outline cu-button-md" data-cu-alert-dialog-trigger="icon-alert-dialog">
  Deactivate Account
</button>

<dialog class="cu-alert-dialog" id="icon-alert-dialog" data-cu-alert-dialog>
  <div class="cu-alert-dialog-header">
    <div class="flex items-center gap-3">
      <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-warning/10">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-warning"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
      </div>
      <div>
        <h2 class="cu-alert-dialog-title">Deactivate account?</h2>
        <p class="cu-alert-dialog-description">Your account will be deactivated and you will lose access to all your data. This can be reversed within 30 days.</p>
      </div>
    </div>
  </div>
  <div class="cu-alert-dialog-footer">
    <button class="cu-button cu-button-outline cu-button-md" data-cu-alert-dialog-cancel>Keep Account</button>
    <button class="cu-button cu-button-warning cu-button-md" data-cu-alert-dialog-action>Deactivate</button>
  </div>
</dialog>`.trim();

const withFormCode = `<button class="cu-button cu-button-outline cu-button-md" data-cu-alert-dialog-trigger="custom-alert-dialog">Transfer Ownership</button>
<dialog id="custom-alert-dialog" class="cu-alert-dialog" data-cu-alert-dialog>
  <div class="cu-alert-dialog-header">
    <h2 class="cu-alert-dialog-title">Transfer Ownership</h2>
    <p class="cu-alert-dialog-description">This will transfer all permissions and data to another user. Type the project name to confirm.</p>
  </div>
  <div class="mt-4">
    <div class="cu-form-group">
      <label class="cu-label" for="confirm-name">Project Name</label>
      <input id="confirm-name" class="cu-input" placeholder="my-project" />
    </div>
  </div>
  <div class="cu-alert-dialog-footer">
    <button class="cu-button cu-button-outline cu-button-md" data-cu-alert-dialog-cancel>Cancel</button>
    <button class="cu-button cu-button-destructive cu-button-md" data-cu-alert-dialog-action>Transfer</button>
  </div>
</dialog>`.trim();

const withLongDescriptionCode = `<button class="cu-button cu-button-outline cu-button-md" data-cu-alert-dialog-trigger="long-alert-dialog">Delete Workspace</button>
<dialog id="long-alert-dialog" class="cu-alert-dialog" data-cu-alert-dialog>
  <div class="cu-alert-dialog-header">
    <h2 class="cu-alert-dialog-title">Delete Workspace?</h2>
    <div class="cu-alert-dialog-description">
      <p>This action will permanently delete the workspace and cannot be undone. The following will be removed:</p>
      <ul class="mt-2 list-disc pl-5 space-y-1">
        <li>All projects and their configurations</li>
        <li>Team member access and permissions</li>
        <li>Deployment history and logs</li>
        <li>Connected integrations and API keys</li>
      </ul>
    </div>
  </div>
  <div class="cu-alert-dialog-footer">
    <button class="cu-button cu-button-outline cu-button-md" data-cu-alert-dialog-cancel>Cancel</button>
    <button class="cu-button cu-button-destructive cu-button-md" data-cu-alert-dialog-action>Delete Workspace</button>
  </div>
</dialog>`.trim();

const destructiveCode = `<button class="cu-button cu-button-destructive cu-button-md" data-cu-alert-dialog-trigger="destructive-alert-dialog">
  Remove Item
</button>

<dialog class="cu-alert-dialog" id="destructive-alert-dialog" data-cu-alert-dialog>
  <div class="cu-alert-dialog-header">
    <h2 class="cu-alert-dialog-title">Remove this item?</h2>
    <p class="cu-alert-dialog-description">This item will be permanently removed from your library. This action is irreversible.</p>
  </div>
  <div class="cu-alert-dialog-footer">
    <button class="cu-button cu-button-outline cu-button-md" data-cu-alert-dialog-cancel>Cancel</button>
    <button class="cu-button cu-button-destructive cu-button-md" data-cu-alert-dialog-action>Remove</button>
  </div>
</dialog>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Alert Dialog">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Alert Dialog</h1>
            <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            {t.description}
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <button class="cu-button cu-button-outline cu-button-md" data-cu-alert-dialog-trigger="demo-alert-dialog">
                    Delete Account
                </button>
                <dialog class="cu-alert-dialog" id="demo-alert-dialog" data-cu-alert-dialog>
                    <div class="cu-alert-dialog-header">
                        <h2 class="cu-alert-dialog-title">Are you absolutely sure?</h2>
                        <p class="cu-alert-dialog-description">This action cannot be undone. This will permanently delete your account and remove your data from our servers.</p>
                    </div>
                    <div class="cu-alert-dialog-footer">
                        <button class="cu-button cu-button-outline cu-button-md" data-cu-alert-dialog-cancel>Cancel</button>
                        <button class="cu-button cu-button-destructive cu-button-md" data-cu-alert-dialog-action>Delete</button>
                    </div>
                </dialog>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.classes.title}
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-alert-dialog</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-alert-dialog']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-alert-dialog-header</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-alert-dialog-header']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-alert-dialog-title</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-alert-dialog-title']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-alert-dialog-description</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-alert-dialog-description']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-alert-dialog-footer</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-alert-dialog-footer']}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>


        <!-- Destructive -->
        <section class="space-y-3">
            <h2 id="destructive-action" class="text-lg font-semibold tracking-tight relative group">
                <a href="#destructive-action" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.destructiveAction.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                {t.sections.destructiveAction.description}
            </p>
            <ComponentPreview code={destructiveCode}>
                <button class="cu-button cu-button-destructive cu-button-md" data-cu-alert-dialog-trigger="destructive-alert-dialog">
                    Remove Item
                </button>
                <dialog class="cu-alert-dialog" id="destructive-alert-dialog" data-cu-alert-dialog>
                    <div class="cu-alert-dialog-header">
                        <h2 class="cu-alert-dialog-title">Remove this item?</h2>
                        <p class="cu-alert-dialog-description">This item will be permanently removed from your library. This action is irreversible.</p>
                    </div>
                    <div class="cu-alert-dialog-footer">
                        <button class="cu-button cu-button-outline cu-button-md" data-cu-alert-dialog-cancel>Cancel</button>
                        <button class="cu-button cu-button-destructive cu-button-md" data-cu-alert-dialog-action>Remove</button>
                    </div>
                </dialog>
            </ComponentPreview>
        </section>

        <!-- With Icon -->
        <section class="space-y-3">
            <h2 id="with-icon" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-icon" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.withIcon.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                {t.sections.withIcon.description}
            </p>
            <ComponentPreview code={withIconCode}>
                <button class="cu-button cu-button-outline cu-button-md" data-cu-alert-dialog-trigger="icon-alert-dialog">
                    Deactivate Account
                </button>
                <dialog class="cu-alert-dialog" id="icon-alert-dialog" data-cu-alert-dialog>
                    <div class="cu-alert-dialog-header">
                        <div class="flex items-center gap-3">
                            <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-warning/10">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-warning"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                            </div>
                            <div>
                                <h2 class="cu-alert-dialog-title">Deactivate account?</h2>
                                <p class="cu-alert-dialog-description">Your account will be deactivated and you will lose access to all your data. This can be reversed within 30 days.</p>
                            </div>
                        </div>
                    </div>
                    <div class="cu-alert-dialog-footer">
                        <button class="cu-button cu-button-outline cu-button-md" data-cu-alert-dialog-cancel>Keep Account</button>
                        <button class="cu-button cu-button-warning cu-button-md" data-cu-alert-dialog-action>Deactivate</button>
                    </div>
                </dialog>
            </ComponentPreview>
        </section>

        <!-- With Custom Content -->
        <section class="space-y-3">
            <h2 id="with-form" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-form" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.withForm.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                {t.sections.withForm.description}
            </p>
            <ComponentPreview code={withFormCode}>
                <button class="cu-button cu-button-outline cu-button-md" data-cu-alert-dialog-trigger="custom-alert-dialog">
                    Transfer Ownership
                </button>
                <dialog id="custom-alert-dialog" class="cu-alert-dialog" data-cu-alert-dialog>
                    <div class="cu-alert-dialog-header">
                        <h2 class="cu-alert-dialog-title">Transfer Ownership</h2>
                        <p class="cu-alert-dialog-description">This will transfer all permissions and data to another user. Type the project name to confirm.</p>
                    </div>
                    <div class="mt-4">
                        <div class="cu-form-group">
                            <label class="cu-label" for="confirm-name">Project Name</label>
                            <input id="confirm-name" class="cu-input" placeholder="my-project" />
                        </div>
                    </div>
                    <div class="cu-alert-dialog-footer">
                        <button class="cu-button cu-button-outline cu-button-md" data-cu-alert-dialog-cancel>Cancel</button>
                        <button class="cu-button cu-button-destructive cu-button-md" data-cu-alert-dialog-action>Transfer</button>
                    </div>
                </dialog>
            </ComponentPreview>
        </section>

        <!-- Long Description -->
        <section class="space-y-3">
            <h2 id="with-long-description" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-long-description" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.withLongDescription.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                {t.sections.withLongDescription.description}
            </p>
            <ComponentPreview code={withLongDescriptionCode}>
                <button class="cu-button cu-button-outline cu-button-md" data-cu-alert-dialog-trigger="long-alert-dialog">
                    Delete Workspace
                </button>
                <dialog id="long-alert-dialog" class="cu-alert-dialog" data-cu-alert-dialog>
                    <div class="cu-alert-dialog-header">
                        <h2 class="cu-alert-dialog-title">Delete Workspace?</h2>
                        <div class="cu-alert-dialog-description">
                            <p>This action will permanently delete the workspace and cannot be undone. The following will be removed:</p>
                            <ul class="mt-2 list-disc pl-5 space-y-1">
                                <li>All projects and their configurations</li>
                                <li>Team member access and permissions</li>
                                <li>Deployment history and logs</li>
                                <li>Connected integrations and API keys</li>
                            </ul>
                        </div>
                    </div>
                    <div class="cu-alert-dialog-footer">
                        <button class="cu-button cu-button-outline cu-button-md" data-cu-alert-dialog-cancel>Cancel</button>
                        <button class="cu-button cu-button-destructive cu-button-md" data-cu-alert-dialog-action>Delete Workspace</button>
                    </div>
                </dialog>
            </ComponentPreview>
        </section>

    </div>
</Layout>

<script>
    function setupAlertDialogs() {
        document.querySelectorAll("[data-cu-alert-dialog-trigger]").forEach((trigger) => {
            trigger.addEventListener("click", () => {
                const id = trigger.getAttribute("data-cu-alert-dialog-trigger");
                if (!id) return;
                const dialog = document.getElementById(id) as HTMLDialogElement | null;
                dialog?.showModal();
            });
        });
        document.querySelectorAll("[data-cu-alert-dialog]").forEach((dialog) => {
            dialog.querySelectorAll("[data-cu-alert-dialog-cancel]").forEach((btn) => {
                btn.addEventListener("click", () => (dialog as HTMLDialogElement).close());
            });
            dialog.querySelectorAll("[data-cu-alert-dialog-action]").forEach((btn) => {
                btn.addEventListener("click", () => (dialog as HTMLDialogElement).close());
            });
        });
    }

    setupAlertDialogs();
    document.addEventListener("astro:page-load", setupAlertDialogs);
</script>
