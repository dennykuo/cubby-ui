---
import Layout from "@/layouts/Layout.astro";
// @ts-ignore - Astro component used in template
import Textarea from "@/components/ui/Textarea.astro";
import Label from "@/components/ui/Label.astro";
import FormGroup from "@/components/ui/FormGroup.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { textareaPage } from "@/i18n/pages/components/textarea";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(textareaPage, locale);

const usageCode = `<textarea class="cu-textarea" placeholder="Type your message..."></textarea>`.trim();

const withLabelCode = `<div class="cu-form-group">
  <label class="cu-label" for="message">Message</label>
  <textarea class="cu-textarea" id="message" placeholder="Type your message..."></textarea>
</div>`.trim();

const validationCode = `<!-- Error state -->
<div class="cu-form-group">
  <label class="cu-label cu-label-required" for="bio-err">Bio</label>
  <textarea class="cu-textarea cu-textarea-error" id="bio-err" placeholder="Tell us about yourself..."></textarea>
  <p class="cu-form-error">Bio must be at least 10 characters.</p>
</div>

<!-- Success state -->
<div class="cu-form-group">
  <label class="cu-label" for="bio-ok">Bio</label>
  <textarea class="cu-textarea cu-textarea-success" id="bio-ok">Full-stack developer with 5 years of experience.</textarea>
</div>`.trim();

const autoResizeCode = `<textarea class="cu-textarea cu-textarea-auto" placeholder="Start typing — the textarea will grow automatically..."></textarea>`.trim();

const defaultValueCode = `<textarea class="cu-textarea">This is some default content that appears in the textarea when the page loads.</textarea>`.trim();

const disabledCode = `<textarea class="cu-textarea" placeholder="Disabled textarea" disabled></textarea>`.trim();
---

<Layout category={t.category} componentName="Textarea" title={t.title}>
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Textarea</h1>
          <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
              <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-sm">
                    <Textarea placeholder="Type your message..." />
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
          <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
            <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
            {t.sections.classes.title}
          </h2>
          <div class="cu-table-wrapper rounded-lg border border-border">
            <table class="cu-table">
              <thead class="cu-table-header">
                <tr class="cu-table-row">
                  <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                  <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                </tr>
              </thead>
              <tbody class="cu-table-body">
                {Object.entries(t.classDescriptions).map(([cls, desc]) => (
                  <tr class="cu-table-row">
                    <td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
                    <td class="cu-table-cell text-muted-foreground">{desc}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>


        <!-- With Label -->
        <section class="space-y-3">
            <h2 id="with-label" class="text-lg font-semibold tracking-tight relative group">
              <a href="#with-label" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.withLabel.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withLabel.description} />
            <ComponentPreview code={withLabelCode}>
                <div class="w-full max-w-sm">
                    <FormGroup>
                        <Label for="message">Message</Label>
                        <Textarea id="message" placeholder="Type your message..." />
                    </FormGroup>
                </div>
            </ComponentPreview>
        </section>

        <!-- Validation -->
        <section class="space-y-3">
            <h2 id="validation" class="text-lg font-semibold tracking-tight relative group">
              <a href="#validation" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.validation.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.validation.description} />
            <ComponentPreview code={validationCode}>
                <div class="w-full max-w-sm space-y-4">
                    <div class="cu-form-group">
                        <label class="cu-label cu-label-required" for="bio-err">Bio</label>
                        <textarea class="cu-textarea cu-textarea-error" id="bio-err" placeholder="Tell us about yourself..."></textarea>
                        <p class="cu-form-error">Bio must be at least 10 characters.</p>
                    </div>
                    <div class="cu-form-group">
                        <label class="cu-label" for="bio-ok">Bio</label>
                        <textarea class="cu-textarea cu-textarea-success" id="bio-ok">Full-stack developer with 5 years of experience.</textarea>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Auto Resize -->
        <section class="space-y-3">
            <h2 id="auto-resize" class="text-lg font-semibold tracking-tight relative group">
              <a href="#auto-resize" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.autoResize.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.autoResize.description} />
            <ComponentPreview code={autoResizeCode}>
                <div class="w-full max-w-sm">
                    <textarea class="cu-textarea cu-textarea-auto" placeholder="Start typing — the textarea will grow automatically..."></textarea>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Default Value -->
        <section class="space-y-3">
            <h2 id="with-default-value" class="text-lg font-semibold tracking-tight relative group">
              <a href="#with-default-value" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.withDefaultValue.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withDefaultValue.description} />
            <ComponentPreview code={defaultValueCode}>
                <div class="w-full max-w-sm">
                    <Textarea>This is some default content that appears in the textarea when the page loads.</Textarea>
                </div>
            </ComponentPreview>
        </section>

        <!-- Disabled -->
        <section class="space-y-3">
            <h2 id="disabled" class="text-lg font-semibold tracking-tight relative group">
              <a href="#disabled" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.disabled.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.disabled.description} />
            <ComponentPreview code={disabledCode}>
                <div class="w-full max-w-sm">
                    <Textarea placeholder="Disabled textarea" disabled />
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>
