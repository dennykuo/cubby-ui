---
import Layout from "../../layouts/Layout.astro";
import Textarea from "../../components/ui/Textarea.astro";
import Label from "../../components/ui/Label.astro";
import FormGroup from "../../components/ui/FormGroup.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<textarea class="cu-textarea" placeholder="Type your message..."></textarea>`.trim();

const withLabelCode = `<div class="cu-form-group">
  <label class="cu-label" for="message">Message</label>
  <textarea class="cu-textarea" id="message" placeholder="Type your message..."></textarea>
</div>`.trim();

const defaultValueCode = `<textarea class="cu-textarea">This is some default content that appears in the textarea when the page loads.</textarea>`.trim();

const disabledCode = `<textarea class="cu-textarea" placeholder="Disabled textarea" disabled></textarea>`.trim();
---

<Layout title="Textarea — Cubby UI">
    <div class="space-y-3">
        <h1 class="text-3xl font-bold tracking-tight">Textarea</h1>
        <p class="text-base text-muted-foreground leading-relaxed">
            Displays a multi-line text input for longer form content.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Usage</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Apply <code class="rounded bg-muted px-1.5 py-0.5 text-[13px] font-mono text-foreground">cu-textarea</code> to a <code class="rounded bg-muted px-1.5 py-0.5 text-[13px] font-mono text-foreground">&lt;textarea&gt;</code> element.
            </p>
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-sm">
                    <Textarea placeholder="Type your message..." />
                </div>
            </ComponentPreview>
        </section>

        <!-- With Label -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">With Label</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Pair with a <code class="rounded bg-muted px-1.5 py-0.5 text-[13px] font-mono text-foreground">cu-label</code> for accessible form fields.
            </p>
            <ComponentPreview code={withLabelCode}>
                <div class="w-full max-w-sm">
                    <FormGroup>
                        <Label for="message">Message</Label>
                        <Textarea id="message" placeholder="Type your message..." />
                    </FormGroup>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Default Value -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">With Default Value</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Place default text inside the <code class="rounded bg-muted px-1.5 py-0.5 text-[13px] font-mono text-foreground">&lt;textarea&gt;</code> element.
            </p>
            <ComponentPreview code={defaultValueCode}>
                <div class="w-full max-w-sm">
                    <Textarea>This is some default content that appears in the textarea when the page loads.</Textarea>
                </div>
            </ComponentPreview>
        </section>

        <!-- Disabled -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Disabled</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Add the <code class="rounded bg-muted px-1.5 py-0.5 text-[13px] font-mono text-foreground">disabled</code> attribute to prevent editing.
            </p>
            <ComponentPreview code={disabledCode}>
                <div class="w-full max-w-sm">
                    <Textarea placeholder="Disabled textarea" disabled />
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>
