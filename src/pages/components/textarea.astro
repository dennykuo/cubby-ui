---
import Layout from "../../layouts/Layout.astro";
import Textarea from "../../components/ui/Textarea.astro";
import Label from "../../components/ui/Label.astro";
import FormGroup from "../../components/ui/FormGroup.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<textarea class="cu-textarea" placeholder="Type your message..."></textarea>`.trim();

const withLabelCode = `<div class="cu-form-group">
  <label class="cu-label" for="message">Message</label>
  <textarea class="cu-textarea" id="message" placeholder="Type your message..."></textarea>
</div>`.trim();

const defaultValueCode = `<textarea class="cu-textarea">This is some default content that appears in the textarea when the page loads.</textarea>`.trim();

const disabledCode = `<textarea class="cu-textarea" placeholder="Disabled textarea" disabled></textarea>`.trim();
---

<Layout category="Forms" componentName="Textarea" title="Textarea — Cubby UI">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Textarea</h1>
          <span class="cu-badge cu-badge-secondary">Forms</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            Displays a multi-line text input for longer form content.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
              <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Usage
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Apply <code class="cu-code">cu-textarea</code> to a <code class="cu-code">&lt;textarea&gt;</code> element.
            </p>
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-sm">
                    <Textarea placeholder="Type your message..." />
                </div>
            </ComponentPreview>
        </section>

        <!-- With Label -->
        <section class="space-y-3">
            <h2 id="with-label" class="text-lg font-semibold tracking-tight relative group">
              <a href="#with-label" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              With Label
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Pair with a <code class="cu-code">cu-label</code> for accessible form fields.
            </p>
            <ComponentPreview code={withLabelCode}>
                <div class="w-full max-w-sm">
                    <FormGroup>
                        <Label for="message">Message</Label>
                        <Textarea id="message" placeholder="Type your message..." />
                    </FormGroup>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Default Value -->
        <section class="space-y-3">
            <h2 id="with-default-value" class="text-lg font-semibold tracking-tight relative group">
              <a href="#with-default-value" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              With Default Value
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Place default text inside the <code class="cu-code">&lt;textarea&gt;</code> element.
            </p>
            <ComponentPreview code={defaultValueCode}>
                <div class="w-full max-w-sm">
                    <Textarea>This is some default content that appears in the textarea when the page loads.</Textarea>
                </div>
            </ComponentPreview>
        </section>

        <!-- Disabled -->
        <section class="space-y-3">
            <h2 id="disabled" class="text-lg font-semibold tracking-tight relative group">
              <a href="#disabled" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Disabled
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Add the <code class="cu-code">disabled</code> attribute to prevent editing.
            </p>
            <ComponentPreview code={disabledCode}>
                <div class="w-full max-w-sm">
                    <Textarea placeholder="Disabled textarea" disabled />
                </div>
            </ComponentPreview>
        </section>
        <!-- Classes Reference -->
        <section class="space-y-3 mt-10">
          <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
            <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
            CSS Classes
          </h2>
          <div class="cu-table-wrapper rounded-lg border border-border">
            <table class="cu-table">
              <thead class="cu-table-header">
                <tr class="cu-table-row">
                  <th class="cu-table-head">Class</th>
                  <th class="cu-table-head">Description</th>
                </tr>
              </thead>
              <tbody class="cu-table-body">
                <tr class="cu-table-row">
                  <td class="cu-table-cell"><code class="cu-code">cu-textarea</code></td>
                  <td class="cu-table-cell text-muted-foreground">Multi-line text input with vertical resize, hover border, focus ring, and disabled state</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>
    </div>
</Layout>
