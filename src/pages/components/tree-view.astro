---
import Layout from "@/layouts/Layout.astro";
// @ts-ignore - Astro component used in template
import TreeView from "@/components/ui/TreeView.astro";
import TreeItem from "@/components/ui/TreeItem.astro";
import TreeLeaf from "@/components/ui/TreeLeaf.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { treeViewPage } from "@/i18n/pages/components/tree-view";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(treeViewPage, locale);

const chevronIcon = `<svg class="cu-tree-trigger-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>`;
const folderIcon = `<svg class="size-4 shrink-0 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>`;
const fileIcon = `<svg class="size-4 shrink-0 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>`;

const usageCode = `<div class="cu-tree">
  <details class="cu-tree-item">
    <summary class="cu-tree-trigger">
      <svg class="cu-tree-trigger-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      Getting Started
    </summary>
    <div class="cu-tree-content">
      <div class="cu-tree-leaf">Introduction</div>
      <div class="cu-tree-leaf">Installation</div>
    </div>
  </details>
  <details class="cu-tree-item">
    <summary class="cu-tree-trigger">
      <svg class="cu-tree-trigger-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      Components
    </summary>
    <div class="cu-tree-content">
      <div class="cu-tree-leaf">Button</div>
      <div class="cu-tree-leaf">Input</div>
      <div class="cu-tree-leaf">Card</div>
    </div>
  </details>
  <div class="cu-tree-leaf">Changelog</div>
</div>`.trim();

const fileExplorerCode = `<div class="cu-tree">
  <details class="cu-tree-item" open>
    <summary class="cu-tree-trigger">
      <svg class="cu-tree-trigger-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      <svg class="size-4 shrink-0 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
      src
    </summary>
    <div class="cu-tree-content">
      <details class="cu-tree-item">
        <summary class="cu-tree-trigger">
          <svg class="cu-tree-trigger-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          <svg class="size-4 shrink-0 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/></svg>
          components
        </summary>
        <div class="cu-tree-content">
          <div class="cu-tree-leaf">
            <svg class="size-4 shrink-0 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
            Button.astro
          </div>
          <div class="cu-tree-leaf">
            <svg class="size-4 shrink-0 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
            Card.astro
          </div>
        </div>
      </details>
      <div class="cu-tree-leaf">
        <svg class="size-4 shrink-0 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
        index.ts
      </div>
    </div>
  </details>
  <div class="cu-tree-leaf">
    <svg class="size-4 shrink-0 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
    package.json
  </div>
  <div class="cu-tree-leaf">
    <svg class="size-4 shrink-0 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
    README.md
  </div>
</div>`.trim();

const activeStateCode = `<div class="cu-tree">
  <details class="cu-tree-item" open>
    <summary class="cu-tree-trigger">
      <svg class="cu-tree-trigger-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      Getting Started
    </summary>
    <div class="cu-tree-content">
      <div class="cu-tree-leaf">Introduction</div>
      <div class="cu-tree-leaf cu-tree-leaf-active">Installation</div>
    </div>
  </details>
  <details class="cu-tree-item">
    <summary class="cu-tree-trigger">
      <svg class="cu-tree-trigger-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      Components
    </summary>
    <div class="cu-tree-content">
      <div class="cu-tree-leaf">Button</div>
      <div class="cu-tree-leaf">Input</div>
    </div>
  </details>
</div>`.trim();

const withCheckboxesCode = `<div class="cu-tree">
  <details class="cu-tree-item" open>
    <summary class="cu-tree-trigger">
      <svg class="cu-tree-trigger-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      <input type="checkbox" class="cu-checkbox" />
      Permissions
    </summary>
    <div class="cu-tree-content">
      <div class="cu-tree-leaf">
        <input type="checkbox" class="cu-checkbox" checked />
        Read
      </div>
      <div class="cu-tree-leaf">
        <input type="checkbox" class="cu-checkbox" checked />
        Write
      </div>
      <div class="cu-tree-leaf">
        <input type="checkbox" class="cu-checkbox" />
        Delete
      </div>
    </div>
  </details>
  <details class="cu-tree-item" open>
    <summary class="cu-tree-trigger">
      <svg class="cu-tree-trigger-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      <input type="checkbox" class="cu-checkbox" />
      Settings
    </summary>
    <div class="cu-tree-content">
      <div class="cu-tree-leaf">
        <input type="checkbox" class="cu-checkbox" />
        Profile
      </div>
      <div class="cu-tree-leaf">
        <input type="checkbox" class="cu-checkbox" checked />
        Notifications
      </div>
    </div>
  </details>
</div>`.trim();

const defaultOpenCode = `<div class="cu-tree">
  <details class="cu-tree-item" open>
    <summary class="cu-tree-trigger">
      <svg class="cu-tree-trigger-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      Open by default
    </summary>
    <div class="cu-tree-content">
      <div class="cu-tree-leaf">Child item 1</div>
      <div class="cu-tree-leaf">Child item 2</div>
      <details class="cu-tree-item" open>
        <summary class="cu-tree-trigger">
          <svg class="cu-tree-trigger-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          Nested group
        </summary>
        <div class="cu-tree-content">
          <div class="cu-tree-leaf">Nested item 1</div>
          <div class="cu-tree-leaf">Nested item 2</div>
        </div>
      </details>
    </div>
  </details>
</div>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Tree View">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Tree View</h1>
            <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-xs">
                    <TreeView>
                        <TreeItem>
                            <summary class="cu-tree-trigger">
                                <Fragment set:html={chevronIcon} />
                                Getting Started
                            </summary>
                            <div class="cu-tree-content">
                                <TreeLeaf>Introduction</TreeLeaf>
                                <TreeLeaf>Installation</TreeLeaf>
                            </div>
                        </TreeItem>
                        <TreeItem>
                            <summary class="cu-tree-trigger">
                                <Fragment set:html={chevronIcon} />
                                Components
                            </summary>
                            <div class="cu-tree-content">
                                <TreeLeaf>Button</TreeLeaf>
                                <TreeLeaf>Input</TreeLeaf>
                                <TreeLeaf>Card</TreeLeaf>
                            </div>
                        </TreeItem>
                        <TreeLeaf>Changelog</TreeLeaf>
                    </TreeView>
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.classes.title}
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        {Object.entries(t.classDescriptions).map(([cls, desc]) => (
                            <tr class="cu-table-row">
                                <td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
                                <td class="cu-table-cell text-muted-foreground" set:html={desc} />
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>


        <!-- File Explorer -->
        <section class="space-y-3">
            <h2 id="file-explorer" class="text-lg font-semibold tracking-tight relative group">
                <a href="#file-explorer" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.fileExplorer.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                {t.sections.fileExplorer.description}
            </p>
            <ComponentPreview code={fileExplorerCode}>
                <div class="w-full max-w-xs">
                    <TreeView>
                        <TreeItem open>
                            <summary class="cu-tree-trigger">
                                <Fragment set:html={chevronIcon} />
                                <Fragment set:html={folderIcon} />
                                src
                            </summary>
                            <div class="cu-tree-content">
                                <TreeItem>
                                    <summary class="cu-tree-trigger">
                                        <Fragment set:html={chevronIcon} />
                                        <Fragment set:html={folderIcon} />
                                        components
                                    </summary>
                                    <div class="cu-tree-content">
                                        <TreeLeaf><Fragment set:html={fileIcon} /> Button.astro</TreeLeaf>
                                        <TreeLeaf><Fragment set:html={fileIcon} /> Card.astro</TreeLeaf>
                                    </div>
                                </TreeItem>
                                <TreeLeaf><Fragment set:html={fileIcon} /> index.ts</TreeLeaf>
                            </div>
                        </TreeItem>
                        <TreeLeaf><Fragment set:html={fileIcon} /> package.json</TreeLeaf>
                        <TreeLeaf><Fragment set:html={fileIcon} /> README.md</TreeLeaf>
                    </TreeView>
                </div>
            </ComponentPreview>
        </section>

        <!-- Default Open -->
        <section class="space-y-3">
            <h2 id="default-open" class="text-lg font-semibold tracking-tight relative group">
                <a href="#default-open" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.defaultOpen.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.defaultOpen.description} />
            <ComponentPreview code={defaultOpenCode}>
                <div class="w-full max-w-xs">
                    <TreeView>
                        <TreeItem open>
                            <summary class="cu-tree-trigger">
                                <Fragment set:html={chevronIcon} />
                                Open by default
                            </summary>
                            <div class="cu-tree-content">
                                <TreeLeaf>Child item 1</TreeLeaf>
                                <TreeLeaf>Child item 2</TreeLeaf>
                                <TreeItem open>
                                    <summary class="cu-tree-trigger">
                                        <Fragment set:html={chevronIcon} />
                                        Nested group
                                    </summary>
                                    <div class="cu-tree-content">
                                        <TreeLeaf>Nested item 1</TreeLeaf>
                                        <TreeLeaf>Nested item 2</TreeLeaf>
                                    </div>
                                </TreeItem>
                            </div>
                        </TreeItem>
                    </TreeView>
                </div>
            </ComponentPreview>
        </section>

        <!-- Active / Selected State -->
        <section class="space-y-3">
            <h2 id="active-state" class="text-lg font-semibold tracking-tight relative group">
                <a href="#active-state" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.activeState.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.activeState.description} />
            <ComponentPreview code={activeStateCode}>
                <div class="w-full max-w-xs">
                    <TreeView>
                        <TreeItem open>
                            <summary class="cu-tree-trigger">
                                <Fragment set:html={chevronIcon} />
                                Getting Started
                            </summary>
                            <div class="cu-tree-content">
                                <TreeLeaf>Introduction</TreeLeaf>
                                <TreeLeaf class="cu-tree-leaf-active">Installation</TreeLeaf>
                            </div>
                        </TreeItem>
                        <TreeItem>
                            <summary class="cu-tree-trigger">
                                <Fragment set:html={chevronIcon} />
                                Components
                            </summary>
                            <div class="cu-tree-content">
                                <TreeLeaf>Button</TreeLeaf>
                                <TreeLeaf>Input</TreeLeaf>
                            </div>
                        </TreeItem>
                    </TreeView>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Checkboxes -->
        <section class="space-y-3">
            <h2 id="with-checkboxes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-checkboxes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.withCheckboxes.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withCheckboxes.description} />
            <ComponentPreview code={withCheckboxesCode}>
                <div class="w-full max-w-xs">
                    <TreeView>
                        <TreeItem open>
                            <summary class="cu-tree-trigger">
                                <Fragment set:html={chevronIcon} />
                                <input type="checkbox" class="cu-checkbox" />
                                Permissions
                            </summary>
                            <div class="cu-tree-content">
                                <TreeLeaf><input type="checkbox" class="cu-checkbox" checked /> Read</TreeLeaf>
                                <TreeLeaf><input type="checkbox" class="cu-checkbox" checked /> Write</TreeLeaf>
                                <TreeLeaf><input type="checkbox" class="cu-checkbox" /> Delete</TreeLeaf>
                            </div>
                        </TreeItem>
                        <TreeItem open>
                            <summary class="cu-tree-trigger">
                                <Fragment set:html={chevronIcon} />
                                <input type="checkbox" class="cu-checkbox" />
                                Settings
                            </summary>
                            <div class="cu-tree-content">
                                <TreeLeaf><input type="checkbox" class="cu-checkbox" /> Profile</TreeLeaf>
                                <TreeLeaf><input type="checkbox" class="cu-checkbox" checked /> Notifications</TreeLeaf>
                            </div>
                        </TreeItem>
                    </TreeView>
                </div>
            </ComponentPreview>
        </section>

    </div>
</Layout>
