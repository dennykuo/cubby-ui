        <!-- Scrollable Content -->
        <section class="space-y-3">
            <h2 id="scrollable-content" class="text-lg font-semibold tracking-tight relative group">
                <a href="#scrollable-content" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.scrollableContent.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.scrollableContent.description} />
            <ComponentPreview code={scrollableCode}>
                <button class="cu-button cu-button-outline cu-button-md" data-cu-drawer-trigger="scroll-drawer">
                    Open Scrollable Drawer
                </button>
                <dialog class="cu-drawer cu-drawer-right" id="scroll-drawer" data-cu-drawer>
                    <button class="cu-drawer-close" data-cu-drawer-close>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
