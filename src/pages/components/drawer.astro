---
import Layout from "@/layouts/Layout.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { drawerPage } from "@/i18n/pages/components/drawer";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(drawerPage, locale);
const SO = "<" + "script>";
const SC = "</" + "script>";

const usageCode = `<button class="cu-button cu-button-outline cu-button-md" data-cu-drawer-trigger="demo-drawer">
  Open Drawer
</button>

<dialog class="cu-drawer cu-drawer-right" id="demo-drawer" data-cu-drawer>
  <button class="cu-drawer-close" data-cu-drawer-close>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    <span class="sr-only">Close</span>
  </button>
  <div class="cu-drawer-header">
    <h2 class="cu-drawer-title">Edit profile</h2>
    <p class="cu-drawer-description">Make changes to your profile here. Click save when you're done.</p>
  </div>
  <div class="cu-drawer-content">
    <div class="space-y-4">
      <div class="cu-form-group">
        <label class="cu-label" for="drawer-name">Name</label>
        <input class="cu-input" id="drawer-name" value="Pedro Duarte" />
      </div>
      <div class="cu-form-group">
        <label class="cu-label" for="drawer-username">Username</label>
        <input class="cu-input" id="drawer-username" value="@peduarte" />
      </div>
    </div>
  </div>
  <div class="cu-drawer-footer">
    <button class="cu-button cu-button-default cu-button-md">Save changes</button>
  </div>
</dialog>

${SO}
  document.querySelectorAll("[data-cu-drawer-trigger]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const id = trigger.getAttribute("data-cu-drawer-trigger");
      document.getElementById(id)?.showModal();
    });
  });
  document.querySelectorAll("[data-cu-drawer]").forEach((dialog) => {
    dialog.querySelectorAll("[data-cu-drawer-close]").forEach((btn) => {
      btn.addEventListener("click", () => dialog.close());
    });
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
${SC}`.trim();

const leftCode = `<button class="cu-button cu-button-outline cu-button-md" data-cu-drawer-trigger="left-drawer">
  Open Left Drawer
</button>

<dialog class="cu-drawer cu-drawer-left" id="left-drawer" data-cu-drawer>
  <button class="cu-drawer-close" data-cu-drawer-close>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    <span class="sr-only">Close</span>
  </button>
  <div class="cu-drawer-header">
    <h2 class="cu-drawer-title">Navigation</h2>
    <p class="cu-drawer-description">Browse the sidebar menu.</p>
  </div>
  <div class="cu-drawer-content">
    <nav class="space-y-1">
      <a href="#" class="cu-nav-item cu-nav-item-active block">Dashboard</a>
      <a href="#" class="cu-nav-item block">Settings</a>
      <a href="#" class="cu-nav-item block">Messages</a>
      <a href="#" class="cu-nav-item block">Profile</a>
    </nav>
  </div>
</dialog>`.trim();

const scrollableCode = `<button class="cu-button cu-button-outline cu-button-md" data-cu-drawer-trigger="scroll-drawer">
  Open Scrollable Drawer
</button>

<dialog class="cu-drawer cu-drawer-right" id="scroll-drawer" data-cu-drawer>
  <button class="cu-drawer-close" data-cu-drawer-close>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    <span class="sr-only">Close</span>
  </button>
  <div class="cu-drawer-header">
    <h2 class="cu-drawer-title">Changelog</h2>
    <p class="cu-drawer-description">Recent updates and improvements.</p>
  </div>
  <div class="cu-drawer-content">
    <div class="space-y-6">
      <div class="space-y-2">
        <h3 class="text-sm font-semibold">v2.4.0</h3>
        <p class="text-sm text-muted-foreground">Added new Timeline and Segmented Control components. Improved accessibility across all interactive elements.</p>
      </div>
      <div class="cu-separator cu-separator-horizontal"></div>
      <div class="space-y-2">
        <h3 class="text-sm font-semibold">v2.3.0</h3>
        <p class="text-sm text-muted-foreground">Introduced dark mode shadow enhancements for floating panels. Added button hover shadow effect.</p>
      </div>
      <div class="cu-separator cu-separator-horizontal"></div>
      <div class="space-y-2">
        <h3 class="text-sm font-semibold">v2.2.0</h3>
        <p class="text-sm text-muted-foreground">New form validation variants for Input, Textarea, and Label components. Added auto-resize textarea support.</p>
      </div>
      <div class="cu-separator cu-separator-horizontal"></div>
      <div class="space-y-2">
        <h3 class="text-sm font-semibold">v2.1.0</h3>
        <p class="text-sm text-muted-foreground">Added Kbd component for keyboard shortcut display. Button loading state improvements.</p>
      </div>
      <div class="cu-separator cu-separator-horizontal"></div>
      <div class="space-y-2">
        <h3 class="text-sm font-semibold">v2.0.0</h3>
        <p class="text-sm text-muted-foreground">Major release with Tailwind CSS v4 migration. New design token system with CSS @theme. Breaking changes to color variables.</p>
      </div>
    </div>
  </div>
  <div class="cu-drawer-footer">
    <button class="cu-button cu-button-outline cu-button-md" data-cu-drawer-close>Close</button>
  </div>
</dialog>`.trim();

const sidesCode = `<button class="cu-button cu-button-outline cu-button-md" data-cu-drawer-trigger="top-drawer">
  Top
</button>

<button class="cu-button cu-button-outline cu-button-md" data-cu-drawer-trigger="bottom-drawer">
  Bottom
</button>

<dialog class="cu-drawer cu-drawer-top" id="top-drawer" data-cu-drawer>
  <button class="cu-drawer-close" data-cu-drawer-close>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    <span class="sr-only">Close</span>
  </button>
  <div class="cu-drawer-header">
    <h2 class="cu-drawer-title">Notifications</h2>
