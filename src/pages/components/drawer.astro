            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.leftSide.description} />
            <ComponentPreview code={leftCode}>
                <button class="cu-button cu-button-outline cu-button-md" data-cu-drawer-trigger="left-drawer">
                    Open Left Drawer
                </button>
                <dialog class="cu-drawer cu-drawer-left" id="left-drawer" data-cu-drawer>
                    <button class="cu-drawer-close" data-cu-drawer-close>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                        <span class="sr-only">Close</span>
                    </button>
                    <div class="cu-drawer-header">
                        <h2 class="cu-drawer-title">Navigation</h2>
                        <p class="cu-drawer-description">Browse the sidebar menu.</p>
                    </div>
                    <div class="cu-drawer-content">
                        <nav class="space-y-1">
                            <a href="#" class="cu-nav-item cu-nav-item-active block">Dashboard</a>
                            <a href="#" class="cu-nav-item block">Settings</a>
                            <a href="#" class="cu-nav-item block">Messages</a>
                            <a href="#" class="cu-nav-item block">Profile</a>
                        </nav>
                    </div>
                </dialog>
            </ComponentPreview>
        </section>

        <!-- Top & Bottom -->
        <section class="space-y-3">
            <h2 id="top--bottom" class="text-lg font-semibold tracking-tight relative group">
                <a href="#top--bottom" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.topBottom.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.topBottom.description} />
            <ComponentPreview code={sidesCode}>
                <div class="flex gap-2">
                    <button class="cu-button cu-button-outline cu-button-md" data-cu-drawer-trigger="top-drawer">
                        Top
                    </button>
                    <button class="cu-button cu-button-outline cu-button-md" data-cu-drawer-trigger="bottom-drawer">
                        Bottom
                    </button>
                </div>
                <dialog class="cu-drawer cu-drawer-top" id="top-drawer" data-cu-drawer>
                    <button class="cu-drawer-close" data-cu-drawer-close>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                        <span class="sr-only">Close</span>
                    </button>
                    <div class="cu-drawer-header">
                        <h2 class="cu-drawer-title">Notifications</h2>
                        <p class="cu-drawer-description">You have 3 unread messages.</p>
                    </div>
