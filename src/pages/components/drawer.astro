                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-drawer-bottom</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-drawer-bottom']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-drawer-header</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-drawer-header']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-drawer-title</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-drawer-title']}</td>
