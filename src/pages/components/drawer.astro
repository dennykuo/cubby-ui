                    <div class="cu-drawer-header">
                        <h2 class="cu-drawer-title">Changelog</h2>
                        <p class="cu-drawer-description">Recent updates and improvements.</p>
                    </div>
                    <div class="cu-drawer-content">
                        <div class="space-y-6">
                            <div class="space-y-2">
                                <h3 class="text-sm font-semibold">v2.4.0</h3>
                                <p class="text-sm text-muted-foreground">Added new Timeline and Segmented Control components. Improved accessibility across all interactive elements.</p>
                            </div>
                            <div class="cu-separator cu-separator-horizontal"></div>
                            <div class="space-y-2">
                                <h3 class="text-sm font-semibold">v2.3.0</h3>
                                <p class="text-sm text-muted-foreground">Introduced dark mode shadow enhancements for floating panels. Added button hover shadow effect.</p>
                            </div>
                            <div class="cu-separator cu-separator-horizontal"></div>
                            <div class="space-y-2">
                                <h3 class="text-sm font-semibold">v2.2.0</h3>
                                <p class="text-sm text-muted-foreground">New form validation variants for Input, Textarea, and Label components. Added auto-resize textarea support.</p>
                            </div>
                            <div class="cu-separator cu-separator-horizontal"></div>
                            <div class="space-y-2">
                                <h3 class="text-sm font-semibold">v2.1.0</h3>
                                <p class="text-sm text-muted-foreground">Added Kbd component for keyboard shortcut display. Button loading state improvements.</p>
                            </div>
                            <div class="cu-separator cu-separator-horizontal"></div>
                            <div class="space-y-2">
                                <h3 class="text-sm font-semibold">v2.0.0</h3>
                                <p class="text-sm text-muted-foreground">Major release with Tailwind CSS v4 migration. New design token system with CSS @theme. Breaking changes to color variables.</p>
                            </div>
                        </div>
                    </div>
                    <div class="cu-drawer-footer">
                        <button class="cu-button cu-button-outline cu-button-md" data-cu-drawer-close>Close</button>
                    </div>
                </dialog>
            </ComponentPreview>
        </section>

    </div>
</Layout>

<script>
    function setupDrawers() {
        document.querySelectorAll("[data-cu-drawer-trigger]").forEach((trigger) => {
            trigger.addEventListener("click", () => {
                const id = trigger.getAttribute("data-cu-drawer-trigger");
                const dialog = document.getElementById(id) as HTMLDialogElement | null;
                dialog?.showModal();
            });
        });
        document.querySelectorAll("[data-cu-drawer]").forEach((dialog) => {
            dialog.querySelectorAll("[data-cu-drawer-close]").forEach((btn) => {
                btn.addEventListener("click", () => (dialog as HTMLDialogElement).close());
            });
            dialog.addEventListener("click", (e) => {
                if (e.target === dialog) (dialog as HTMLDialogElement).close();
            });
        });
    }

    setupDrawers();
    document.addEventListener("astro:page-load", setupDrawers);
</script>
