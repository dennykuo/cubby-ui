---
import Layout from "../../layouts/Layout.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<button class="cu-button cu-button-outline cu-button-md" data-cu-drawer-trigger="demo-drawer">
  Open Drawer
</button>

<dialog class="cu-drawer cu-drawer-right" id="demo-drawer" data-cu-drawer>
  <button class="cu-drawer-close" data-cu-drawer-close>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    <span class="sr-only">Close</span>
  </button>
  <div class="cu-drawer-header">
    <h2 class="cu-drawer-title">Edit profile</h2>
    <p class="cu-drawer-description">Make changes to your profile here. Click save when you're done.</p>
  </div>
  <div class="cu-drawer-content">
    <div class="space-y-4">
      <div class="cu-form-group">
        <label class="cu-label" for="drawer-name">Name</label>
        <input class="cu-input" id="drawer-name" value="Pedro Duarte" />
      </div>
      <div class="cu-form-group">
        <label class="cu-label" for="drawer-username">Username</label>
        <input class="cu-input" id="drawer-username" value="@peduarte" />
      </div>
    </div>
  </div>
  <div class="cu-drawer-footer">
    <button class="cu-button cu-button-default cu-button-md">Save changes</button>
  </div>
</dialog>

<script>
  document.querySelectorAll("[data-cu-drawer-trigger]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const id = trigger.getAttribute("data-cu-drawer-trigger");
      document.getElementById(id)?.showModal();
    });
  });
  document.querySelectorAll("[data-cu-drawer]").forEach((dialog) => {
    dialog.querySelectorAll("[data-cu-drawer-close]").forEach((btn) => {
      btn.addEventListener("click", () => dialog.close());
    });
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>`.trim();

const leftCode = `<button class="cu-button cu-button-outline cu-button-md" data-cu-drawer-trigger="left-drawer">
  Open Left Drawer
</button>

<dialog class="cu-drawer cu-drawer-left" id="left-drawer" data-cu-drawer>
  <button class="cu-drawer-close" data-cu-drawer-close>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    <span class="sr-only">Close</span>
  </button>
  <div class="cu-drawer-header">
    <h2 class="cu-drawer-title">Navigation</h2>
    <p class="cu-drawer-description">Browse the sidebar menu.</p>
  </div>
  <div class="cu-drawer-content">
    <nav class="space-y-1">
      <a href="#" class="cu-nav-item cu-nav-item-active block">Dashboard</a>
      <a href="#" class="cu-nav-item block">Settings</a>
      <a href="#" class="cu-nav-item block">Messages</a>
      <a href="#" class="cu-nav-item block">Profile</a>
    </nav>
  </div>
</dialog>`.trim();

const sidesCode = `<button class="cu-button cu-button-outline cu-button-md" data-cu-drawer-trigger="top-drawer">
  Top
</button>

<button class="cu-button cu-button-outline cu-button-md" data-cu-drawer-trigger="bottom-drawer">
  Bottom
</button>

<dialog class="cu-drawer cu-drawer-top" id="top-drawer" data-cu-drawer>
  <button class="cu-drawer-close" data-cu-drawer-close>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    <span class="sr-only">Close</span>
  </button>
  <div class="cu-drawer-header">
    <h2 class="cu-drawer-title">Notifications</h2>
    <p class="cu-drawer-description">You have 3 unread messages.</p>
  </div>
</dialog>

<dialog class="cu-drawer cu-drawer-bottom" id="bottom-drawer" data-cu-drawer>
  <button class="cu-drawer-close" data-cu-drawer-close>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    <span class="sr-only">Close</span>
  </button>
  <div class="cu-drawer-header">
    <h2 class="cu-drawer-title">Cookie Preferences</h2>
    <p class="cu-drawer-description">Manage your cookie settings here.</p>
  </div>
</dialog>`.trim();
---

<Layout title="Drawer — Cubby UI" category="Overlay" componentName="Drawer">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Drawer</h1>
            <span class="cu-badge cu-badge-secondary">Overlay</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            Extends the Dialog component to display content that complements the main content of the screen. Slides in from the edge of the screen.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Usage
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Built with the native <code class="cu-code">&lt;dialog&gt;</code> element.
                Use <code class="cu-code">data-cu-drawer-trigger</code> on buttons to open,
                <code class="cu-code">data-cu-drawer-close</code> to close, and
                <code class="cu-code">data-cu-drawer</code> on the dialog element.
                Add a side class like <code class="cu-code">cu-drawer-right</code> to control the position.
            </p>
            <ComponentPreview code={usageCode}>
                <button class="cu-button cu-button-outline cu-button-md" data-cu-drawer-trigger="demo-drawer">
                    Open Drawer
                </button>
                <dialog class="cu-drawer cu-drawer-right" id="demo-drawer" data-cu-drawer>
                    <button class="cu-drawer-close" data-cu-drawer-close>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                        <span class="sr-only">Close</span>
                    </button>
                    <div class="cu-drawer-header">
                        <h2 class="cu-drawer-title">Edit profile</h2>
                        <p class="cu-drawer-description">Make changes to your profile here. Click save when you're done.</p>
                    </div>
                    <div class="cu-drawer-content">
                        <div class="space-y-4">
                            <div class="cu-form-group">
                                <label class="cu-label" for="drawer-name">Name</label>
                                <input class="cu-input" id="drawer-name" value="Pedro Duarte" />
                            </div>
                            <div class="cu-form-group">
                                <label class="cu-label" for="drawer-username">Username</label>
                                <input class="cu-input" id="drawer-username" value="@peduarte" />
                            </div>
                        </div>
                    </div>
                    <div class="cu-drawer-footer">
                        <button class="cu-button cu-button-default cu-button-md">Save changes</button>
                    </div>
                </dialog>
            </ComponentPreview>
        </section>

        <!-- Left Side -->
        <section class="space-y-3">
            <h2 id="left-side" class="text-lg font-semibold tracking-tight relative group">
                <a href="#left-side" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Left Side
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-drawer-left</code> for a navigation-style drawer.
            </p>
            <ComponentPreview code={leftCode}>
                <button class="cu-button cu-button-outline cu-button-md" data-cu-drawer-trigger="left-drawer">
                    Open Left Drawer
                </button>
                <dialog class="cu-drawer cu-drawer-left" id="left-drawer" data-cu-drawer>
                    <button class="cu-drawer-close" data-cu-drawer-close>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                        <span class="sr-only">Close</span>
                    </button>
                    <div class="cu-drawer-header">
                        <h2 class="cu-drawer-title">Navigation</h2>
                        <p class="cu-drawer-description">Browse the sidebar menu.</p>
                    </div>
                    <div class="cu-drawer-content">
                        <nav class="space-y-1">
                            <a href="#" class="cu-nav-item cu-nav-item-active block">Dashboard</a>
                            <a href="#" class="cu-nav-item block">Settings</a>
                            <a href="#" class="cu-nav-item block">Messages</a>
                            <a href="#" class="cu-nav-item block">Profile</a>
                        </nav>
                    </div>
                </dialog>
            </ComponentPreview>
        </section>

        <!-- Top & Bottom -->
        <section class="space-y-3">
            <h2 id="top--bottom" class="text-lg font-semibold tracking-tight relative group">
                <a href="#top--bottom" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Top & Bottom
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-drawer-top</code> or <code class="cu-code">cu-drawer-bottom</code> for horizontal drawers.
            </p>
            <ComponentPreview code={sidesCode}>
                <div class="flex gap-2">
                    <button class="cu-button cu-button-outline cu-button-md" data-cu-drawer-trigger="top-drawer">
                        Top
                    </button>
                    <button class="cu-button cu-button-outline cu-button-md" data-cu-drawer-trigger="bottom-drawer">
                        Bottom
                    </button>
                </div>
                <dialog class="cu-drawer cu-drawer-top" id="top-drawer" data-cu-drawer>
                    <button class="cu-drawer-close" data-cu-drawer-close>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                        <span class="sr-only">Close</span>
                    </button>
                    <div class="cu-drawer-header">
                        <h2 class="cu-drawer-title">Notifications</h2>
                        <p class="cu-drawer-description">You have 3 unread messages.</p>
                    </div>
                </dialog>
                <dialog class="cu-drawer cu-drawer-bottom" id="bottom-drawer" data-cu-drawer>
                    <button class="cu-drawer-close" data-cu-drawer-close>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                        <span class="sr-only">Close</span>
                    </button>
                    <div class="cu-drawer-header">
                        <h2 class="cu-drawer-title">Cookie Preferences</h2>
                        <p class="cu-drawer-description">Manage your cookie settings here.</p>
                    </div>
                </dialog>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3 mt-10">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                CSS Classes
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">Class</th>
                            <th class="cu-table-head">說明</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-drawer</code></td>
                            <td class="cu-table-cell text-muted-foreground">Drawer 基礎容器，含固定定位與開關動畫</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-drawer-right</code></td>
                            <td class="cu-table-cell text-muted-foreground">從右側滑入</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-drawer-left</code></td>
                            <td class="cu-table-cell text-muted-foreground">從左側滑入</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-drawer-top</code></td>
                            <td class="cu-table-cell text-muted-foreground">從頂部滑入</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-drawer-bottom</code></td>
                            <td class="cu-table-cell text-muted-foreground">從底部滑入</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-drawer-header</code></td>
                            <td class="cu-table-cell text-muted-foreground">Drawer 頭部區域</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-drawer-title</code></td>
                            <td class="cu-table-cell text-muted-foreground">Drawer 標題</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-drawer-description</code></td>
                            <td class="cu-table-cell text-muted-foreground">Drawer 描述文字</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-drawer-content</code></td>
                            <td class="cu-table-cell text-muted-foreground">Drawer 可捲動內容區</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-drawer-footer</code></td>
                            <td class="cu-table-cell text-muted-foreground">底部操作按鈕區域</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-drawer-close</code></td>
                            <td class="cu-table-cell text-muted-foreground">右上角關閉按鈕</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</Layout>

<script>
    function setupDrawers() {
        document.querySelectorAll("[data-cu-drawer-trigger]").forEach((trigger) => {
            trigger.addEventListener("click", () => {
                const id = trigger.getAttribute("data-cu-drawer-trigger");
                const dialog = document.getElementById(id) as HTMLDialogElement | null;
                dialog?.showModal();
            });
        });
        document.querySelectorAll("[data-cu-drawer]").forEach((dialog) => {
            dialog.querySelectorAll("[data-cu-drawer-close]").forEach((btn) => {
                btn.addEventListener("click", () => (dialog as HTMLDialogElement).close());
            });
            dialog.addEventListener("click", (e) => {
                if (e.target === dialog) (dialog as HTMLDialogElement).close();
            });
        });
    }

    setupDrawers();
    document.addEventListener("astro:page-load", setupDrawers);
</script>
