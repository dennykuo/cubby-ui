                        <span class="sr-only">Close</span>
                    </button>
                    <div class="cu-drawer-header">
                        <h2 class="cu-drawer-title">Edit profile</h2>
                        <p class="cu-drawer-description">Make changes to your profile here. Click save when you're done.</p>
                    </div>
                    <div class="cu-drawer-content">
                        <div class="space-y-4">
                            <div class="cu-form-group">
                                <label class="cu-label" for="drawer-name">Name</label>
                                <input class="cu-input" id="drawer-name" value="Pedro Duarte" />
                            </div>
                            <div class="cu-form-group">
                                <label class="cu-label" for="drawer-username">Username</label>
                                <input class="cu-input" id="drawer-username" value="@peduarte" />
                            </div>
                        </div>
                    </div>
                    <div class="cu-drawer-footer">
                        <button class="cu-button cu-button-default cu-button-md">Save changes</button>
                    </div>
                </dialog>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.classes.title}
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-drawer</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-drawer']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-drawer-right</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-drawer-right']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-drawer-left</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-drawer-left']}</td>
                        </tr>
                        <tr class="cu-table-row">
