                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Prose -->
        <section class="space-y-3">
            <SectionHeading id="prose" title={t.sections.prose.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.prose.description} />
            <ComponentPreview code={proseCode}>
