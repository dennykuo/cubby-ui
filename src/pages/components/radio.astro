---
import Layout from "../../layouts/Layout.astro";
import Radio from "../../components/ui/Radio.astro";
import Label from "../../components/ui/Label.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<input type="radio" class="cu-radio" name="example" />`.trim();

const groupCode = `<div class="cu-radio-group">
  <div class="cu-radio-wrapper">
    <input type="radio" class="cu-radio" name="plan" id="free" value="free" checked />
    <label class="cu-label" for="free">Free</label>
  </div>
  <div class="cu-radio-wrapper">
    <input type="radio" class="cu-radio" name="plan" id="pro" value="pro" />
    <label class="cu-label" for="pro">Pro</label>
  </div>
  <div class="cu-radio-wrapper">
    <input type="radio" class="cu-radio" name="plan" id="enterprise" value="enterprise" />
    <label class="cu-label" for="enterprise">Enterprise</label>
  </div>
</div>`.trim();

const defaultCode = `<div class="cu-radio-group">
  <div class="cu-radio-wrapper">
    <input type="radio" class="cu-radio" name="color" id="red" value="red" />
    <label class="cu-label" for="red">Red</label>
  </div>
  <div class="cu-radio-wrapper">
    <input type="radio" class="cu-radio" name="color" id="blue" value="blue" checked />
    <label class="cu-label" for="blue">Blue</label>
  </div>
  <div class="cu-radio-wrapper">
    <input type="radio" class="cu-radio" name="color" id="green" value="green" />
    <label class="cu-label" for="green">Green</label>
  </div>
</div>`.trim();

const disabledCode = `<div class="cu-radio-group">
  <div class="cu-radio-wrapper">
    <input type="radio" class="cu-radio" name="disabled-group" id="opt-a" value="a" disabled />
    <label class="cu-label" for="opt-a">Option A</label>
  </div>
  <div class="cu-radio-wrapper">
    <input type="radio" class="cu-radio" name="disabled-group" id="opt-b" value="b" disabled checked />
    <label class="cu-label" for="opt-b">Option B (checked)</label>
  </div>
</div>`.trim();
---

<Layout category="Forms" componentName="Radio" title="Radio — Cubby UI">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Radio</h1>
          <span class="cu-badge cu-badge-secondary">Forms</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            Displays a radio button for selecting one option from a group.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
              <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Usage
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Apply <code class="cu-code">cu-radio</code> to an <code class="cu-code">&lt;input type="radio"&gt;</code> element.
            </p>
            <ComponentPreview code={usageCode}>
                <Radio name="example" />
            </ComponentPreview>
        </section>

        <!-- Radio Group -->
        <section class="space-y-3">
            <h2 id="radio-group" class="text-lg font-semibold tracking-tight relative group">
              <a href="#radio-group" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Radio Group
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Group radios with the same <code class="cu-code">name</code> attribute inside a
                <code class="cu-code">cu-radio-group</code> container, using
                <code class="cu-code">cu-radio-wrapper</code> for each option.
            </p>
            <ComponentPreview code={groupCode}>
                <div class="cu-radio-group">
                    <div class="cu-radio-wrapper">
                        <Radio name="plan" id="free" value="free" checked />
                        <Label for="free">Free</Label>
                    </div>
                    <div class="cu-radio-wrapper">
                        <Radio name="plan" id="pro" value="pro" />
                        <Label for="pro">Pro</Label>
                    </div>
                    <div class="cu-radio-wrapper">
                        <Radio name="plan" id="enterprise" value="enterprise" />
                        <Label for="enterprise">Enterprise</Label>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Default Selected -->
        <section class="space-y-3">
            <h2 id="default-selected" class="text-lg font-semibold tracking-tight relative group">
              <a href="#default-selected" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Default Selected
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Add the <code class="cu-code">checked</code> attribute to pre-select an option.
            </p>
            <ComponentPreview code={defaultCode}>
                <div class="cu-radio-group">
                    <div class="cu-radio-wrapper">
                        <Radio name="color" id="red" value="red" />
                        <Label for="red">Red</Label>
                    </div>
                    <div class="cu-radio-wrapper">
                        <Radio name="color" id="blue" value="blue" checked />
                        <Label for="blue">Blue</Label>
                    </div>
                    <div class="cu-radio-wrapper">
                        <Radio name="color" id="green" value="green" />
                        <Label for="green">Green</Label>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Disabled -->
        <section class="space-y-3">
            <h2 id="disabled" class="text-lg font-semibold tracking-tight relative group">
              <a href="#disabled" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Disabled
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Add the <code class="cu-code">disabled</code> attribute to prevent interaction.
            </p>
            <ComponentPreview code={disabledCode}>
                <div class="cu-radio-group">
                    <div class="cu-radio-wrapper">
                        <Radio name="disabled-group" id="opt-a" value="a" disabled />
                        <Label for="opt-a">Option A</Label>
                    </div>
                    <div class="cu-radio-wrapper">
                        <Radio name="disabled-group" id="opt-b" value="b" disabled checked />
                        <Label for="opt-b">Option B (checked)</Label>
                    </div>
                </div>
            </ComponentPreview>
        </section>
        <!-- Classes Reference -->
        <section class="space-y-3 mt-10">
          <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
            <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
            CSS Classes
          </h2>
          <div class="cu-table-wrapper rounded-lg border border-border">
            <table class="cu-table">
              <thead class="cu-table-header">
                <tr class="cu-table-row">
                  <th class="cu-table-head">Class</th>
                  <th class="cu-table-head">Description</th>
                </tr>
              </thead>
              <tbody class="cu-table-body">
                <tr class="cu-table-row">
                  <td class="cu-table-cell"><code class="cu-code">cu-radio-group</code></td>
                  <td class="cu-table-cell text-muted-foreground">Vertical container for Radio group</td>
                </tr>
                <tr class="cu-table-row">
                  <td class="cu-table-cell"><code class="cu-code">cu-radio-wrapper</code></td>
                  <td class="cu-table-cell text-muted-foreground">Flex container for Radio and Label</td>
                </tr>
                <tr class="cu-table-row">
                  <td class="cu-table-cell"><code class="cu-code">cu-radio</code></td>
                  <td class="cu-table-cell text-muted-foreground">Radio button style, shows inner dot via thick border when selected</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>
    </div>
</Layout>
