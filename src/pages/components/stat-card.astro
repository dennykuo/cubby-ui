  </div>
</div>`.trim();

const accentCode = `<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <div class="cu-stat cu-stat-accent">
    <span class="cu-stat-label">Total Users</span>
    <div class="cu-stat-value">8,942</div>
    <p class="cu-stat-description">
      <span class="cu-stat-trend cu-stat-trend-up">+4.6%</span> vs last week
    </p>
  </div>
  <div class="cu-stat cu-stat-accent cu-stat-accent-success">
    <span class="cu-stat-label">Conversion Rate</span>
    <div class="cu-stat-value">3.24%</div>
    <p class="cu-stat-description">
      <span class="cu-stat-trend cu-stat-trend-up">+0.5%</span> vs last week
    </p>
  </div>
  <div class="cu-stat cu-stat-accent cu-stat-accent-warning">
    <span class="cu-stat-label">Avg. Response Time</span>
    <div class="cu-stat-value">1.2s</div>
    <p class="cu-stat-description">
      <span class="cu-stat-trend cu-stat-trend-down">+0.3s</span> vs last week
    </p>
  </div>
</div>`.trim();

const withProgressCode = `<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
  <div class="cu-stat">
    <div class="cu-stat-header">
      <span class="cu-stat-label">Storage Used</span>
      <span class="text-xs text-muted-foreground">75%</span>
    </div>
    <div class="cu-stat-value">7.5 GB</div>
    <div class="cu-stat-footer">
      <div class="cu-progress h-1.5">
        <div class="cu-progress-bar" style="width: 75%"></div>
      </div>
      <p class="mt-2 text-xs text-muted-foreground">10 GB total capacity</p>
    </div>
  </div>
  <div class="cu-stat">
    <div class="cu-stat-header">
      <span class="cu-stat-label">Monthly Goal</span>
      <span class="text-xs text-muted-foreground">62%</span>
    </div>
    <div class="cu-stat-value">$31,000</div>
    <div class="cu-stat-footer">
      <div class="cu-progress h-1.5">
        <div class="cu-progress-bar" style="width: 62%"></div>
      </div>
      <p class="mt-2 text-xs text-muted-foreground">$50,000 target</p>
    </div>
  </div>
</div>`.trim();

const hoverCode = `<div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
  <div class="cu-stat cu-stat-hover">
    <div class="cu-stat-header">
      <span class="cu-stat-label">Page Views</span>
      <svg class="cu-stat-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
    </div>
    <div class="cu-stat-value">142.3K</div>
    <p class="cu-stat-description">
      <span class="cu-stat-trend cu-stat-trend-up">+22%</span> vs last period
    </p>
  </div>
  <div class="cu-stat cu-stat-hover">
    <div class="cu-stat-header">
      <span class="cu-stat-label">Bounce Rate</span>
      <svg class="cu-stat-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
    </div>
    <div class="cu-stat-value">38.2%</div>
    <p class="cu-stat-description">
      <span class="cu-stat-trend cu-stat-trend-up">-3.1%</span> improved
    </p>
  </div>
  <div class="cu-stat cu-stat-hover">
    <div class="cu-stat-header">
      <span class="cu-stat-label">Avg. Session</span>
      <svg class="cu-stat-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    </div>
    <div class="cu-stat-value">4m 32s</div>
    <p class="cu-stat-description">
      <span class="cu-stat-trend cu-stat-trend-up">+18s</span> vs last period
    </p>
  </div>
</div>`.trim();
---

<Layout title="Stat Card — Cubby UI" category="Data Display" componentName="Stat Card">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Stat Card</h1>
            <span class="cu-badge cu-badge-secondary">Data Display</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            顯示關鍵指標，包含標籤、數值和可選的趨勢指示器。
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Usage
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                使用 <code class="cu-code">cu-stat</code> 作為容器，搭配
                <code class="cu-code">cu-stat-header</code>、
                <code class="cu-code">cu-stat-value</code> 和
                <code class="cu-code">cu-stat-description</code> 子元素組合。
            </p>
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-xs">
                    <Stat>
                        <StatHeader>
                            <StatLabel>Total Revenue</StatLabel>
                            <svg class="cu-stat-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                        </StatHeader>
                        <StatValue>$45,231.89</StatValue>
                        <StatDescription>
                            <StatTrend direction="up">+20.1%</StatTrend> from last month
                        </StatDescription>
                    </Stat>
                </div>
            </ComponentPreview>
        </section>

        <!-- Dashboard Grid -->
        <section class="space-y-3">
            <h2 id="dashboard-grid" class="text-lg font-semibold tracking-tight relative group">
                <a href="#dashboard-grid" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Dashboard Grid
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                以響應式網格排列，用於儀表板總覽。
            </p>
            <ComponentPreview code={gridCode}>
                <div class="grid w-full grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                    <Stat>
                        <StatHeader>
                            <StatLabel>Total Revenue</StatLabel>
                            <svg class="cu-stat-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                        </StatHeader>
                        <StatValue>$45,231.89</StatValue>
                        <StatDescription>
                            <StatTrend direction="up">+20.1%</StatTrend> from last month
                        </StatDescription>
                    </Stat>
                    <Stat>
                        <StatHeader>
                            <StatLabel>Subscriptions</StatLabel>
                            <svg class="cu-stat-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        </StatHeader>
                        <StatValue>+2,350</StatValue>
                        <StatDescription>
                            <StatTrend direction="up">+180.1%</StatTrend> from last month
                        </StatDescription>
                    </Stat>
                    <Stat>
                        <StatHeader>
                            <StatLabel>Sales</StatLabel>
                            <svg class="cu-stat-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                        </StatHeader>
                        <StatValue>+12,234</StatValue>
                        <StatDescription>
                            <StatTrend direction="up">+19%</StatTrend> from last month
                        </StatDescription>
                    </Stat>
                    <Stat>
                        <StatHeader>
                            <StatLabel>Active Now</StatLabel>
                            <svg class="cu-stat-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                        </StatHeader>
                        <StatValue>+573</StatValue>
                        <StatDescription>
                            <StatTrend direction="down">-201</StatTrend> since last hour
                        </StatDescription>
                    </Stat>
                </div>
            </ComponentPreview>
        </section>

        <!-- Icon Box -->
        <section class="space-y-3">
            <h2 id="icon-box" class="text-lg font-semibold tracking-tight relative group">
                <a href="#icon-box" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Icon Box
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                使用 <code class="cu-code">cu-stat-icon-box</code> 為圖示加上淡色背景，提升視覺層次。
                搭配 <code class="cu-code">cu-stat-icon-box-success</code>、<code class="cu-code">cu-stat-icon-box-warning</code>、<code class="cu-code">cu-stat-icon-box-destructive</code> 等色彩變體。
            </p>
            <ComponentPreview code={iconBoxCode}>
                <div class="grid w-full grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                    <Stat>
                        <StatHeader>
                            <div class="cu-stat-icon-box">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                            </div>
                        </StatHeader>
                        <StatValue>$45,231</StatValue>
                        <StatDescription>
                            <StatTrend direction="up">+20.1%</StatTrend> from last month
                        </StatDescription>
                    </Stat>
                    <Stat>
                        <StatHeader>
                            <div class="cu-stat-icon-box cu-stat-icon-box-success">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            </div>
                        </StatHeader>
                        <StatValue>+2,350</StatValue>
                        <StatDescription>
                            <StatTrend direction="up">+180.1%</StatTrend> from last month
                        </StatDescription>
                    </Stat>
                    <Stat>
                        <StatHeader>
                            <div class="cu-stat-icon-box cu-stat-icon-box-warning">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                            </div>
                        </StatHeader>
                        <StatValue>+12,234</StatValue>
                        <StatDescription>
                            <StatTrend direction="up">+19%</StatTrend> from last month
                        </StatDescription>
                    </Stat>
                    <Stat>
                        <StatHeader>
                            <div class="cu-stat-icon-box cu-stat-icon-box-destructive">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                            </div>
                        </StatHeader>
                        <StatValue>+573</StatValue>
                        <StatDescription>
                            <StatTrend direction="down">-201</StatTrend> since last hour
                        </StatDescription>
                    </Stat>
                </div>
            </ComponentPreview>
        </section>

        <!-- Trend Pill -->
        <section class="space-y-3">
            <h2 id="trend-pill" class="text-lg font-semibold tracking-tight relative group">
                <a href="#trend-pill" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Trend Pill
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                加上 <code class="cu-code">cu-stat-trend-pill</code> 為趨勢指標增加膠囊狀背景，更易於快速辨識。
            </p>
            <ComponentPreview code={trendPillCode}>
                <div class="flex w-full max-w-lg gap-4">
                    <Stat class="flex-1">
                        <StatHeader>
                            <StatLabel>Revenue</StatLabel>
                        </StatHeader>
                        <StatValue>$12,450</StatValue>
                        <StatDescription>
                            <StatTrend direction="up" class="cu-stat-trend-pill">+12.5%</StatTrend> from last month
                        </StatDescription>
                    </Stat>
                    <Stat class="flex-1">
                        <StatHeader>
                            <StatLabel>Churn Rate</StatLabel>
                        </StatHeader>
                        <StatValue>2.4%</StatValue>
                        <StatDescription>
                            <StatTrend direction="down" class="cu-stat-trend-pill">+0.8%</StatTrend> from last month
                        </StatDescription>
                    </Stat>
                </div>
            </ComponentPreview>
        </section>

        <!-- Accent Border -->
        <section class="space-y-3">
            <h2 id="accent-border" class="text-lg font-semibold tracking-tight relative group">
                <a href="#accent-border" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Accent Border
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                使用 <code class="cu-code">cu-stat-accent</code> 在左側添加色彩條紋，強化分類辨識。
                搭配 <code class="cu-code">cu-stat-accent-success</code>、<code class="cu-code">cu-stat-accent-warning</code> 等變體。
            </p>
            <ComponentPreview code={accentCode}>
                <div class="grid w-full grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    <Stat class="cu-stat-accent">
                        <span class="cu-stat-label">Total Users</span>
                        <StatValue>8,942</StatValue>
                        <StatDescription>
                            <StatTrend direction="up">+4.6%</StatTrend> vs last week
                        </StatDescription>
                    </Stat>
                    <Stat class="cu-stat-accent cu-stat-accent-success">
                        <span class="cu-stat-label">Conversion Rate</span>
                        <StatValue>3.24%</StatValue>
                        <StatDescription>
                            <StatTrend direction="up">+0.5%</StatTrend> vs last week
                        </StatDescription>
                    </Stat>
                    <Stat class="cu-stat-accent cu-stat-accent-warning">
                        <span class="cu-stat-label">Avg. Response Time</span>
                        <StatValue>1.2s</StatValue>
                        <StatDescription>
                            <StatTrend direction="down">+0.3s</StatTrend> vs last week
                        </StatDescription>
                    </Stat>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Progress -->
        <section class="space-y-3">
            <h2 id="with-progress" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-progress" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                With Progress
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                使用 <code class="cu-code">cu-stat-footer</code> 搭配進度條，適合顯示配額或目標達成率。
            </p>
            <ComponentPreview code={withProgressCode}>
                <div class="grid w-full grid-cols-1 gap-4 sm:grid-cols-2">
                    <Stat>
                        <StatHeader>
                            <StatLabel>Storage Used</StatLabel>
                            <span class="text-xs text-muted-foreground">75%</span>
                        </StatHeader>
                        <StatValue>7.5 GB</StatValue>
                        <div class="cu-stat-footer">
                            <div class="cu-progress h-1.5">
                                <div class="cu-progress-bar" style="width: 75%"></div>
                            </div>
                            <p class="mt-2 text-xs text-muted-foreground">10 GB total capacity</p>
                        </div>
                    </Stat>
                    <Stat>
                        <StatHeader>
                            <StatLabel>Monthly Goal</StatLabel>
                            <span class="text-xs text-muted-foreground">62%</span>
                        </StatHeader>
                        <StatValue>$31,000</StatValue>
                        <div class="cu-stat-footer">
                            <div class="cu-progress h-1.5">
                                <div class="cu-progress-bar" style="width: 62%"></div>
                            </div>
                            <p class="mt-2 text-xs text-muted-foreground">$50,000 target</p>
                        </div>
                    </Stat>
                </div>
            </ComponentPreview>
        </section>

        <!-- Hover Effect -->
        <section class="space-y-3">
            <h2 id="hover-effect" class="text-lg font-semibold tracking-tight relative group">
                <a href="#hover-effect" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Hover Effect
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                加上 <code class="cu-code">cu-stat-hover</code> 啟用滑鼠懸停時的陰影提升效果，適合可點擊的指標卡片。
            </p>
            <ComponentPreview code={hoverCode}>
                <div class="grid w-full grid-cols-1 gap-4 sm:grid-cols-3">
                    <Stat class="cu-stat-hover">
                        <StatHeader>
                            <StatLabel>Page Views</StatLabel>
                            <svg class="cu-stat-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                        </StatHeader>
                        <StatValue>142.3K</StatValue>
                        <StatDescription>
                            <StatTrend direction="up">+22%</StatTrend> vs last period
                        </StatDescription>
                    </Stat>
                    <Stat class="cu-stat-hover">
                        <StatHeader>
                            <StatLabel>Bounce Rate</StatLabel>
                            <svg class="cu-stat-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
                        </StatHeader>
                        <StatValue>38.2%</StatValue>
                        <StatDescription>
                            <StatTrend direction="up">-3.1%</StatTrend> improved
                        </StatDescription>
                    </Stat>
                    <Stat class="cu-stat-hover">
                        <StatHeader>
                            <StatLabel>Avg. Session</StatLabel>
                            <svg class="cu-stat-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </StatHeader>
                        <StatValue>4m 32s</StatValue>
                        <StatDescription>
                            <StatTrend direction="up">+18s</StatTrend> vs last period
                        </StatDescription>
                    </Stat>
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3 mt-10">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                CSS Classes
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">Class</th>
                            <th class="cu-table-head">說明</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-stat</code></td>
                            <td class="cu-table-cell text-muted-foreground">指標卡容器</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-stat-hover</code></td>
                            <td class="cu-table-cell text-muted-foreground">啟用 hover 陰影效果</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-stat-header</code></td>
                            <td class="cu-table-cell text-muted-foreground">頂部區域（標籤與圖示）</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-stat-label</code></td>
                            <td class="cu-table-cell text-muted-foreground">指標名稱標籤</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-stat-icon</code></td>
                            <td class="cu-table-cell text-muted-foreground">小圖示</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-stat-icon-box</code></td>
                            <td class="cu-table-cell text-muted-foreground">圖示方塊容器（primary 色調）</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-stat-icon-box-*</code></td>
                            <td class="cu-table-cell text-muted-foreground">圖示方塊色彩變體，支援 secondary / success / warning / destructive / info</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-stat-value</code></td>
                            <td class="cu-table-cell text-muted-foreground">主要數值</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-stat-description</code></td>
                            <td class="cu-table-cell text-muted-foreground">描述文字</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-stat-trend</code></td>
                            <td class="cu-table-cell text-muted-foreground">趨勢指示器基礎樣式</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-stat-trend-up</code></td>
                            <td class="cu-table-cell text-muted-foreground">上升趨勢（綠色）</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-stat-trend-down</code></td>
                            <td class="cu-table-cell text-muted-foreground">下降趨勢（紅色）</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-stat-trend-pill</code></td>
                            <td class="cu-table-cell text-muted-foreground">趨勢膠囊樣式（帶背景色）</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-stat-footer</code></td>
                            <td class="cu-table-cell text-muted-foreground">底部區域，帶上邊框</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-stat-accent</code></td>
                            <td class="cu-table-cell text-muted-foreground">左側色條裝飾（primary 色調）</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-stat-accent-*</code></td>
                            <td class="cu-table-cell text-muted-foreground">色條色彩變體，支援 success / warning / destructive / info</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</Layout>
