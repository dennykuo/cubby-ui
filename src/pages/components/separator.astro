---
import Layout from "@/layouts/Layout.astro";
import Separator from "@/components/ui/Separator.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { separatorPage } from "@/i18n/pages/components/separator";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(separatorPage, locale);

const usageCode = `<div class="cu-separator cu-separator-horizontal" role="separator"></div>`.trim();

const withTextCode = `<div class="space-y-1">
  <h4 class="text-sm font-medium leading-none">Cubby UI</h4>
  <p class="text-sm text-muted-foreground">An open-source UI component library.</p>
</div>
<div class="cu-separator cu-separator-horizontal my-4" role="separator"></div>
<div class="flex h-5 items-center gap-4 text-sm">
  <div>Docs</div>
  <div class="cu-separator cu-separator-vertical" role="separator"></div>
  <div>Source</div>
  <div class="cu-separator cu-separator-vertical" role="separator"></div>
  <div>Blog</div>
</div>`.trim();

const verticalCode = `<div class="flex h-5 items-center gap-4 text-sm">
  <div>Docs</div>
  <div class="cu-separator cu-separator-vertical" role="separator"></div>
  <div>Source</div>
  <div class="cu-separator cu-separator-vertical" role="separator"></div>
  <div>Blog</div>
</div>`.trim();

const inToolbarCode = `<div class="flex items-center gap-2 rounded-lg border border-border p-1.5">
  <button class="cu-button cu-button-ghost cu-button-icon-sm">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/></svg>
  </button>
  <button class="cu-button cu-button-ghost cu-button-icon-sm">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" x2="10" y1="4" y2="4"/><line x1="14" x2="5" y1="20" y2="20"/><line x1="15" x2="9" y1="4" y2="20"/></svg>
  </button>
  <button class="cu-button cu-button-ghost cu-button-icon-sm">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4v16"/><path d="M13 4v16"/><path d="M22 4v16"/></svg>
  </button>
  <div class="cu-separator cu-separator-vertical h-6"></div>
  <button class="cu-button cu-button-ghost cu-button-icon-sm">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="21" x2="3" y1="6" y2="6"/><line x1="21" x2="3" y1="12" y2="12"/><line x1="21" x2="3" y1="18" y2="18"/></svg>
  </button>
  <button class="cu-button cu-button-ghost cu-button-icon-sm">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="21" x2="3" y1="6" y2="6"/><line x1="17" x2="3" y1="12" y2="12"/><line x1="13" x2="3" y1="18" y2="18"/></svg>
  </button>
</div>`.trim();

const withIconCode = `<div class="relative flex items-center py-4">
  <div class="cu-separator cu-separator-horizontal flex-1"></div>
  <span class="mx-4 flex items-center gap-2 text-xs text-muted-foreground">
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
    Featured
  </span>
  <div class="cu-separator cu-separator-horizontal flex-1"></div>
</div>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Separator">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Separator</h1>
            <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            {t.description}
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-lg">
                    <Separator />
                </div>
            </ComponentPreview>
        </section>

    <!-- Classes Reference -->
    <section class="space-y-3">
      <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
        <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        {t.sections.classes.title}
      </h2>
      <div class="cu-table-wrapper rounded-lg border border-border">
        <table class="cu-table">
          <thead class="cu-table-header">
            <tr class="cu-table-row">
              <th class="cu-table-head">{t.sections.classes.classLabel}</th>
              <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
            </tr>
          </thead>
          <tbody class="cu-table-body">
            {Object.entries(t.classDescriptions).map(([cls, desc]) => (
              <tr class="cu-table-row">
                <td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
                <td class="cu-table-cell text-muted-foreground">{desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>


        <!-- With Text -->
        <section class="space-y-3">
            <h2 id="with-text" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-text" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.withText.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                {t.sections.withText.description}
            </p>
            <ComponentPreview code={withTextCode}>
                <div class="w-full max-w-lg">
                    <div class="space-y-1">
                        <h4 class="text-sm font-medium leading-none">Cubby UI</h4>
                        <p class="text-sm text-muted-foreground">An open-source UI component library.</p>
                    </div>
                    <Separator class="my-4" />
                    <div class="flex h-5 items-center gap-4 text-sm">
                        <div>Docs</div>
                        <Separator orientation="vertical" />
                        <div>Source</div>
                        <Separator orientation="vertical" />
                        <div>Blog</div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Vertical -->
        <section class="space-y-3">
            <h2 id="vertical" class="text-lg font-semibold tracking-tight relative group">
                <a href="#vertical" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.vertical.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.vertical.description} />
            <ComponentPreview code={verticalCode}>
                <div class="flex h-5 items-center gap-4 text-sm">
                    <div>Docs</div>
                    <Separator orientation="vertical" />
                    <div>Source</div>
                    <Separator orientation="vertical" />
                    <div>Blog</div>
                </div>
            </ComponentPreview>
        </section>

        <!-- In Toolbar -->
        <section class="space-y-3">
            <h2 id="in-toolbar" class="text-lg font-semibold tracking-tight relative group">
                <a href="#in-toolbar" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.inToolbar.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                {t.sections.inToolbar.description}
            </p>
            <ComponentPreview code={inToolbarCode}>
                <div class="flex items-center gap-2 rounded-lg border border-border p-1.5">
                    <button class="cu-button cu-button-ghost cu-button-icon-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"/></svg>
                    </button>
                    <button class="cu-button cu-button-ghost cu-button-icon-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" x2="10" y1="4" y2="4"/><line x1="14" x2="5" y1="20" y2="20"/><line x1="15" x2="9" y1="4" y2="20"/></svg>
                    </button>
                    <button class="cu-button cu-button-ghost cu-button-icon-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4v16"/><path d="M13 4v16"/><path d="M22 4v16"/></svg>
                    </button>
                    <Separator orientation="vertical" class="h-6" />
                    <button class="cu-button cu-button-ghost cu-button-icon-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="21" x2="3" y1="6" y2="6"/><line x1="21" x2="3" y1="12" y2="12"/><line x1="21" x2="3" y1="18" y2="18"/></svg>
                    </button>
                    <button class="cu-button cu-button-ghost cu-button-icon-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="21" x2="3" y1="6" y2="6"/><line x1="17" x2="3" y1="12" y2="12"/><line x1="13" x2="3" y1="18" y2="18"/></svg>
                    </button>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Icon -->
        <section class="space-y-3">
            <h2 id="with-icon" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-icon" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.withIcon.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                {t.sections.withIcon.description}
            </p>
            <ComponentPreview code={withIconCode}>
                <div class="w-full max-w-lg">
                    <div class="relative flex items-center py-4">
                        <Separator class="flex-1" />
                        <span class="mx-4 flex items-center gap-2 text-xs text-muted-foreground">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                            Featured
                        </span>
                        <Separator class="flex-1" />
                    </div>
                </div>
            </ComponentPreview>
        </section>

    </div>
</Layout>
