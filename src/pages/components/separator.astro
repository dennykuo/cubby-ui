---
import Layout from "@/layouts/Layout.astro";
import Separator from "@/components/ui/Separator.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { separatorPage } from "@/i18n/pages/components/separator";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(separatorPage, locale);

const usageCode = `<div class="cu-separator cu-separator-horizontal" role="separator"></div>`.trim();

const withTextCode = `<div class="space-y-1">
  <h4 class="text-sm font-medium leading-none">Cubby UI</h4>
  <p class="text-sm text-muted-foreground">An open-source UI component library.</p>
</div>
<div class="cu-separator cu-separator-horizontal my-4" role="separator"></div>
<div class="flex h-5 items-center gap-4 text-sm">
  <div>Docs</div>
  <div class="cu-separator cu-separator-vertical" role="separator"></div>
  <div>Source</div>
  <div class="cu-separator cu-separator-vertical" role="separator"></div>
  <div>Blog</div>
</div>`.trim();

const verticalCode = `<div class="flex h-5 items-center gap-4 text-sm">
  <div>Docs</div>
  <div class="cu-separator cu-separator-vertical" role="separator"></div>
  <div>Source</div>
  <div class="cu-separator cu-separator-vertical" role="separator"></div>
  <div>Blog</div>
</div>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Separator">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Separator</h1>
            <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            {t.description}
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-lg">
                    <Separator />
                </div>
            </ComponentPreview>
        </section>

    <!-- Classes Reference -->
    <section class="space-y-3">
      <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
        <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        {t.sections.classes.title}
      </h2>
      <div class="cu-table-wrapper rounded-lg border border-border">
        <table class="cu-table">
          <thead class="cu-table-header">
            <tr class="cu-table-row">
              <th class="cu-table-head">{t.sections.classes.classLabel}</th>
              <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
            </tr>
          </thead>
          <tbody class="cu-table-body">
            {Object.entries(t.classDescriptions).map(([cls, desc]) => (
              <tr class="cu-table-row">
                <td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
                <td class="cu-table-cell text-muted-foreground">{desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>


        <!-- With Text -->
        <section class="space-y-3">
            <h2 id="with-text" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-text" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.withText.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                {t.sections.withText.description}
            </p>
            <ComponentPreview code={withTextCode}>
                <div class="w-full max-w-lg">
                    <div class="space-y-1">
                        <h4 class="text-sm font-medium leading-none">Cubby UI</h4>
                        <p class="text-sm text-muted-foreground">An open-source UI component library.</p>
                    </div>
                    <Separator class="my-4" />
                    <div class="flex h-5 items-center gap-4 text-sm">
                        <div>Docs</div>
                        <Separator orientation="vertical" />
                        <div>Source</div>
                        <Separator orientation="vertical" />
                        <div>Blog</div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Vertical -->
        <section class="space-y-3">
            <h2 id="vertical" class="text-lg font-semibold tracking-tight relative group">
                <a href="#vertical" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.vertical.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.vertical.description} />
            <ComponentPreview code={verticalCode}>
                <div class="flex h-5 items-center gap-4 text-sm">
                    <div>Docs</div>
                    <Separator orientation="vertical" />
                    <div>Source</div>
                    <Separator orientation="vertical" />
                    <div>Blog</div>
                </div>
            </ComponentPreview>
        </section>

    </div>
</Layout>
