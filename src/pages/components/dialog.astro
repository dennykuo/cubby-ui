---
import Layout from "../../layouts/Layout.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<button class="cu-button cu-button-outline cu-button-md" data-cu-dialog-trigger="demo-dialog">
  Open Dialog
</button>

<dialog class="cu-dialog" id="demo-dialog" data-cu-dialog>
  <button class="cu-dialog-close" data-cu-dialog-close>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    <span class="sr-only">Close</span>
  </button>
  <div class="cu-dialog-header">
    <h2 class="cu-dialog-title">Are you absolutely sure?</h2>
    <p class="cu-dialog-description">This action cannot be undone. This will permanently delete your account and remove your data from our servers.</p>
  </div>
  <div class="cu-dialog-footer">
    <button class="cu-button cu-button-outline cu-button-md" data-cu-dialog-close>Cancel</button>
    <button class="cu-button cu-button-default cu-button-md">Continue</button>
  </div>
</dialog>`.trim();

const withFormCode = `<button class="cu-button cu-button-outline cu-button-md" data-cu-dialog-trigger="form-dialog">
  Edit Profile
</button>

<dialog class="cu-dialog" id="form-dialog" data-cu-dialog>
  <button class="cu-dialog-close" data-cu-dialog-close>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    <span class="sr-only">Close</span>
  </button>
  <div class="cu-dialog-header">
    <h2 class="cu-dialog-title">Edit profile</h2>
    <p class="cu-dialog-description">Make changes to your profile here. Click save when you're done.</p>
  </div>
  <div class="mt-4 space-y-4">
    <div class="cu-form-group">
      <label class="cu-label" for="dialog-name">Name</label>
      <input class="cu-input" id="dialog-name" value="Pedro Duarte" />
    </div>
    <div class="cu-form-group">
      <label class="cu-label" for="dialog-username">Username</label>
      <input class="cu-input" id="dialog-username" value="@peduarte" />
    </div>
  </div>
  <div class="cu-dialog-footer">
    <button class="cu-button cu-button-default cu-button-md">Save changes</button>
  </div>
</dialog>`.trim();

const deleteCode = `<button class="cu-button cu-button-destructive cu-button-md" data-cu-dialog-trigger="delete-dialog">
  Delete Account
</button>

<dialog class="cu-dialog" id="delete-dialog" data-cu-dialog>
  <button class="cu-dialog-close" data-cu-dialog-close>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    <span class="sr-only">Close</span>
  </button>
  <div class="cu-dialog-header">
    <div class="flex size-10 items-center justify-center rounded-full bg-destructive/10 text-destructive mb-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
    </div>
    <h2 class="cu-dialog-title">Delete account</h2>
    <p class="cu-dialog-description">This will permanently delete your account and all associated data. This action cannot be reversed.</p>
  </div>
  <div class="cu-dialog-footer">
    <button class="cu-button cu-button-outline cu-button-md" data-cu-dialog-close>Cancel</button>
    <button class="cu-button cu-button-destructive cu-button-md">Delete</button>
  </div>
</dialog>`.trim();

const feedbackCode = `<button class="cu-button cu-button-outline cu-button-md" data-cu-dialog-trigger="feedback-dialog">
  Send Feedback
</button>

<dialog class="cu-dialog" id="feedback-dialog" data-cu-dialog>
  <button class="cu-dialog-close" data-cu-dialog-close>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    <span class="sr-only">Close</span>
  </button>
  <div class="cu-dialog-header">
    <h2 class="cu-dialog-title">Send feedback</h2>
    <p class="cu-dialog-description">Help us improve by sharing your thoughts.</p>
  </div>
  <div class="mt-4 space-y-4">
    <div class="cu-form-group">
      <label class="cu-label" for="feedback-subject">Subject</label>
      <div class="cu-select-wrapper">
        <select id="feedback-subject" class="cu-select">
          <option value="">Select a topic</option>
          <option value="bug">Bug report</option>
          <option value="feature">Feature request</option>
          <option value="other">Other</option>
        </select>
      </div>
    </div>
    <div class="cu-form-group">
      <label class="cu-label" for="feedback-message">Message</label>
      <textarea class="cu-textarea" id="feedback-message" rows="4" placeholder="Tell us what's on your mind..."></textarea>
    </div>
  </div>
  <div class="cu-dialog-footer">
    <button class="cu-button cu-button-outline cu-button-md" data-cu-dialog-close>Cancel</button>
    <button class="cu-button cu-button-default cu-button-md">Submit</button>
  </div>
</dialog>`.trim();

const successCode = `<button class="cu-button cu-button-outline cu-button-md" data-cu-dialog-trigger="success-dialog">
  Show Success
</button>

<dialog class="cu-dialog max-w-sm" id="success-dialog" data-cu-dialog>
  <div class="cu-dialog-header items-center text-center">
    <div class="flex size-12 items-center justify-center rounded-full bg-success/10 text-success mb-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m8 12 3 3 5-6"/></svg>
    </div>
    <h2 class="cu-dialog-title">Payment successful</h2>
    <p class="cu-dialog-description">Your payment of $49.00 has been processed. A confirmation email has been sent to your inbox.</p>
  </div>
  <div class="cu-dialog-footer sm:justify-center">
    <button class="cu-button cu-button-default cu-button-md" data-cu-dialog-close>Done</button>
  </div>
</dialog>`.trim();
---

<Layout title="Dialog — Cubby UI" category="Overlay" componentName="Dialog">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Dialog</h1>
            <span class="cu-badge cu-badge-secondary">Overlay</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            A modal dialog that interrupts the user with important content and expects a response.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Usage
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Built with the native <code class="cu-code">&lt;dialog&gt;</code> element.
                Use <code class="cu-code">data-cu-dialog-trigger</code> on buttons to open,
                <code class="cu-code">data-cu-dialog-close</code> to close,
                and <code class="cu-code">data-cu-dialog</code> on the dialog element.
            </p>
            <ComponentPreview code={usageCode}>
                <button class="cu-button cu-button-outline cu-button-md" data-cu-dialog-trigger="demo-dialog">
                    Open Dialog
                </button>
                <dialog class="cu-dialog" id="demo-dialog" data-cu-dialog>
                    <button class="cu-dialog-close" data-cu-dialog-close>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                        <span class="sr-only">Close</span>
                    </button>
                    <div class="cu-dialog-header">
                        <h2 class="cu-dialog-title">Are you absolutely sure?</h2>
                        <p class="cu-dialog-description">This action cannot be undone. This will permanently delete your account and remove your data from our servers.</p>
                    </div>
                    <div class="cu-dialog-footer">
                        <button class="cu-button cu-button-outline cu-button-md" data-cu-dialog-close>Cancel</button>
                        <button class="cu-button cu-button-default cu-button-md">Continue</button>
                    </div>
                </dialog>
            </ComponentPreview>
        </section>

        <!-- With Form -->
        <section class="space-y-3">
            <h2 id="with-form" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-form" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                With Form
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Dialogs can contain forms and other interactive content.
            </p>
            <ComponentPreview code={withFormCode}>
                <button class="cu-button cu-button-outline cu-button-md" data-cu-dialog-trigger="form-dialog">
                    Edit Profile
                </button>
                <dialog class="cu-dialog" id="form-dialog" data-cu-dialog>
                    <button class="cu-dialog-close" data-cu-dialog-close>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                        <span class="sr-only">Close</span>
                    </button>
                    <div class="cu-dialog-header">
                        <h2 class="cu-dialog-title">Edit profile</h2>
                        <p class="cu-dialog-description">Make changes to your profile here. Click save when you're done.</p>
                    </div>
                    <div class="mt-4 space-y-4">
                        <div class="cu-form-group">
                            <label class="cu-label" for="dialog-name">Name</label>
                            <input class="cu-input" id="dialog-name" value="Pedro Duarte" />
                        </div>
                        <div class="cu-form-group">
                            <label class="cu-label" for="dialog-username">Username</label>
                            <input class="cu-input" id="dialog-username" value="@peduarte" />
                        </div>
                    </div>
                    <div class="cu-dialog-footer">
                        <button class="cu-button cu-button-default cu-button-md">Save changes</button>
                    </div>
                </dialog>
            </ComponentPreview>
        </section>

        <!-- Destructive Confirmation -->
        <section class="space-y-3">
            <h2 id="destructive-confirmation" class="text-lg font-semibold tracking-tight relative group">
                <a href="#destructive-confirmation" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Destructive Confirmation
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                A confirmation dialog with a warning icon for dangerous actions like account deletion.
            </p>
            <ComponentPreview code={deleteCode}>
                <button class="cu-button cu-button-destructive cu-button-md" data-cu-dialog-trigger="delete-dialog">
                    Delete Account
                </button>
                <dialog class="cu-dialog" id="delete-dialog" data-cu-dialog>
                    <button class="cu-dialog-close" data-cu-dialog-close>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                        <span class="sr-only">Close</span>
                    </button>
                    <div class="cu-dialog-header">
                        <div class="flex size-10 items-center justify-center rounded-full bg-destructive/10 text-destructive mb-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                        </div>
                        <h2 class="cu-dialog-title">Delete account</h2>
                        <p class="cu-dialog-description">This will permanently delete your account and all associated data. This action cannot be reversed.</p>
                    </div>
                    <div class="cu-dialog-footer">
                        <button class="cu-button cu-button-outline cu-button-md" data-cu-dialog-close>Cancel</button>
                        <button class="cu-button cu-button-destructive cu-button-md">Delete</button>
                    </div>
                </dialog>
            </ComponentPreview>
        </section>

        <!-- Feedback Form -->
        <section class="space-y-3">
            <h2 id="feedback-form" class="text-lg font-semibold tracking-tight relative group">
                <a href="#feedback-form" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Feedback Form
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                A richer form dialog with a select dropdown and textarea.
            </p>
            <ComponentPreview code={feedbackCode}>
                <button class="cu-button cu-button-outline cu-button-md" data-cu-dialog-trigger="feedback-dialog">
                    Send Feedback
                </button>
                <dialog class="cu-dialog" id="feedback-dialog" data-cu-dialog>
                    <button class="cu-dialog-close" data-cu-dialog-close>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                        <span class="sr-only">Close</span>
                    </button>
                    <div class="cu-dialog-header">
                        <h2 class="cu-dialog-title">Send feedback</h2>
                        <p class="cu-dialog-description">Help us improve by sharing your thoughts.</p>
                    </div>
                    <div class="mt-4 space-y-4">
                        <div class="cu-form-group">
                            <label class="cu-label" for="feedback-subject">Subject</label>
                            <div class="cu-select-wrapper">
                                <select id="feedback-subject" class="cu-select">
                                    <option value="">Select a topic</option>
                                    <option value="bug">Bug report</option>
                                    <option value="feature">Feature request</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>
                        </div>
                        <div class="cu-form-group">
                            <label class="cu-label" for="feedback-message">Message</label>
                            <textarea class="cu-textarea" id="feedback-message" rows="4" placeholder="Tell us what's on your mind..."></textarea>
                        </div>
                    </div>
                    <div class="cu-dialog-footer">
                        <button class="cu-button cu-button-outline cu-button-md" data-cu-dialog-close>Cancel</button>
                        <button class="cu-button cu-button-default cu-button-md">Submit</button>
                    </div>
                </dialog>
            </ComponentPreview>
        </section>

        <!-- Success State -->
        <section class="space-y-3">
            <h2 id="success-state" class="text-lg font-semibold tracking-tight relative group">
                <a href="#success-state" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Success State
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                A centered dialog for success confirmations. Use a smaller <code class="cu-code">max-w-sm</code> width.
            </p>
            <ComponentPreview code={successCode}>
                <button class="cu-button cu-button-outline cu-button-md" data-cu-dialog-trigger="success-dialog">
                    Show Success
                </button>
                <dialog class="cu-dialog max-w-sm" id="success-dialog" data-cu-dialog>
                    <div class="cu-dialog-header items-center text-center">
                        <div class="flex size-12 items-center justify-center rounded-full bg-success/10 text-success mb-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m8 12 3 3 5-6"/></svg>
                        </div>
                        <h2 class="cu-dialog-title">Payment successful</h2>
                        <p class="cu-dialog-description">Your payment of $49.00 has been processed. A confirmation email has been sent to your inbox.</p>
                    </div>
                    <div class="cu-dialog-footer sm:justify-center">
                        <button class="cu-button cu-button-default cu-button-md" data-cu-dialog-close>Done</button>
                    </div>
                </dialog>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3 mt-10">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                CSS Classes
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">Class</th>
                            <th class="cu-table-head">說明</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-dialog</code></td>
                            <td class="cu-table-cell text-muted-foreground">Dialog 容器，含置中定位、圓角與開關動畫</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-dialog-header</code></td>
                            <td class="cu-table-cell text-muted-foreground">標題與描述的 flex 容器</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-dialog-title</code></td>
                            <td class="cu-table-cell text-muted-foreground">Dialog 標題</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-dialog-description</code></td>
                            <td class="cu-table-cell text-muted-foreground">Dialog 描述文字</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-dialog-footer</code></td>
                            <td class="cu-table-cell text-muted-foreground">底部操作按鈕區域</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-dialog-close</code></td>
                            <td class="cu-table-cell text-muted-foreground">右上角關閉按鈕</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</Layout>

<script>
    function setupDialogs() {
        document.querySelectorAll("[data-cu-dialog-trigger]").forEach((trigger) => {
            trigger.addEventListener("click", () => {
                const id = trigger.getAttribute("data-cu-dialog-trigger");
                const dialog = document.getElementById(id) as HTMLDialogElement | null;
                dialog?.showModal();
            });
        });
        document.querySelectorAll("[data-cu-dialog]").forEach((dialog) => {
            dialog.querySelectorAll("[data-cu-dialog-close]").forEach((btn) => {
                btn.addEventListener("click", () => (dialog as HTMLDialogElement).close());
            });
            dialog.addEventListener("click", (e) => {
                if (e.target === dialog) (dialog as HTMLDialogElement).close();
            });
        });
    }

    setupDialogs();
    document.addEventListener("astro:page-load", setupDialogs);
</script>
