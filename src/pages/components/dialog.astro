---
import Layout from "../../layouts/Layout.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<button class="cu-button cu-button-outline cu-button-md" data-dialog-trigger="demo-dialog">
  Open Dialog
</button>

<dialog class="cu-dialog" id="demo-dialog" data-dialog>
  <button class="cu-dialog-close" data-dialog-close>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    <span class="sr-only">Close</span>
  </button>
  <div class="cu-dialog-header">
    <h2 class="cu-dialog-title">Are you absolutely sure?</h2>
    <p class="cu-dialog-description">This action cannot be undone. This will permanently delete your account and remove your data from our servers.</p>
  </div>
  <div class="cu-dialog-footer">
    <button class="cu-button cu-button-outline cu-button-md" data-dialog-close>Cancel</button>
    <button class="cu-button cu-button-default cu-button-md">Continue</button>
  </div>
</dialog>

<script>
  document.querySelectorAll("[data-dialog-trigger]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const id = trigger.getAttribute("data-dialog-trigger");
      document.getElementById(id)?.showModal();
    });
  });
  document.querySelectorAll("[data-dialog]").forEach((dialog) => {
    dialog.querySelectorAll("[data-dialog-close]").forEach((btn) => {
      btn.addEventListener("click", () => dialog.close());
    });
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>`.trim();

const withFormCode = `<button class="cu-button cu-button-outline cu-button-md" data-dialog-trigger="form-dialog">
  Edit Profile
</button>

<dialog class="cu-dialog" id="form-dialog" data-dialog>
  <button class="cu-dialog-close" data-dialog-close>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    <span class="sr-only">Close</span>
  </button>
  <div class="cu-dialog-header">
    <h2 class="cu-dialog-title">Edit profile</h2>
    <p class="cu-dialog-description">Make changes to your profile here. Click save when you're done.</p>
  </div>
  <div class="mt-4 space-y-4">
    <div class="cu-form-group">
      <label class="cu-label" for="dialog-name">Name</label>
      <input class="cu-input" id="dialog-name" value="Pedro Duarte" />
    </div>
    <div class="cu-form-group">
      <label class="cu-label" for="dialog-username">Username</label>
      <input class="cu-input" id="dialog-username" value="@peduarte" />
    </div>
  </div>
  <div class="cu-dialog-footer">
    <button class="cu-button cu-button-default cu-button-md">Save changes</button>
  </div>
</dialog>`.trim();
---

<Layout title="Dialog — Cubby UI">
    <div class="space-y-3">
        <h1 class="text-3xl font-bold tracking-tight">Dialog</h1>
        <p class="text-base text-muted-foreground leading-relaxed">
            A modal dialog that interrupts the user with important content and expects a response.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Usage</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Built with the native <code class="cu-code">&lt;dialog&gt;</code> element.
                Use <code class="cu-code">data-dialog-trigger</code> on buttons to open,
                <code class="cu-code">data-dialog-close</code> to close,
                and <code class="cu-code">data-dialog</code> on the dialog element.
            </p>
            <ComponentPreview code={usageCode}>
                <button class="cu-button cu-button-outline cu-button-md" data-dialog-trigger="demo-dialog">
                    Open Dialog
                </button>
                <dialog class="cu-dialog" id="demo-dialog" data-dialog>
                    <button class="cu-dialog-close" data-dialog-close>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                        <span class="sr-only">Close</span>
                    </button>
                    <div class="cu-dialog-header">
                        <h2 class="cu-dialog-title">Are you absolutely sure?</h2>
                        <p class="cu-dialog-description">This action cannot be undone. This will permanently delete your account and remove your data from our servers.</p>
                    </div>
                    <div class="cu-dialog-footer">
                        <button class="cu-button cu-button-outline cu-button-md" data-dialog-close>Cancel</button>
                        <button class="cu-button cu-button-default cu-button-md">Continue</button>
                    </div>
                </dialog>
            </ComponentPreview>
        </section>

        <!-- With Form -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">With Form</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Dialogs can contain forms and other interactive content.
            </p>
            <ComponentPreview code={withFormCode}>
                <button class="cu-button cu-button-outline cu-button-md" data-dialog-trigger="form-dialog">
                    Edit Profile
                </button>
                <dialog class="cu-dialog" id="form-dialog" data-dialog>
                    <button class="cu-dialog-close" data-dialog-close>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                        <span class="sr-only">Close</span>
                    </button>
                    <div class="cu-dialog-header">
                        <h2 class="cu-dialog-title">Edit profile</h2>
                        <p class="cu-dialog-description">Make changes to your profile here. Click save when you're done.</p>
                    </div>
                    <div class="mt-4 space-y-4">
                        <div class="cu-form-group">
                            <label class="cu-label" for="dialog-name">Name</label>
                            <input class="cu-input" id="dialog-name" value="Pedro Duarte" />
                        </div>
                        <div class="cu-form-group">
                            <label class="cu-label" for="dialog-username">Username</label>
                            <input class="cu-input" id="dialog-username" value="@peduarte" />
                        </div>
                    </div>
                    <div class="cu-dialog-footer">
                        <button class="cu-button cu-button-default cu-button-md">Save changes</button>
                    </div>
                </dialog>
            </ComponentPreview>
        </section>
    </div>
</Layout>

<script>
    function setupDialogs() {
        document.querySelectorAll("[data-dialog-trigger]").forEach((trigger) => {
            trigger.addEventListener("click", () => {
                const id = trigger.getAttribute("data-dialog-trigger");
                const dialog = document.getElementById(id) as HTMLDialogElement | null;
                dialog?.showModal();
            });
        });
        document.querySelectorAll("[data-dialog]").forEach((dialog) => {
            dialog.querySelectorAll("[data-dialog-close]").forEach((btn) => {
                btn.addEventListener("click", () => (dialog as HTMLDialogElement).close());
            });
            dialog.addEventListener("click", (e) => {
                if (e.target === dialog) (dialog as HTMLDialogElement).close();
            });
        });
    }

    setupDialogs();
    document.addEventListener("astro:page-load", setupDialogs);
</script>
