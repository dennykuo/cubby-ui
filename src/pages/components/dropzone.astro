---
import Layout from "@/layouts/Layout.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { dropzonePage } from "@/i18n/pages/components/dropzone";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(dropzonePage, locale);
const SO = "<" + "script>";
const SC = "</" + "script>";

const usageCode = `<div class="cu-dropzone" data-cu-dropzone>
  <input type="file" data-cu-dropzone-input hidden />
  <svg class="cu-dropzone-icon" xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
  <p class="cu-dropzone-title">Drag & drop files here, or click to browse</p>
  <p class="cu-dropzone-description">PNG, JPG, PDF up to 10MB</p>
</div>

${SO}
  document.querySelectorAll("[data-cu-dropzone]").forEach((zone) => {
    const input = zone.querySelector("[data-cu-dropzone-input]");

    zone.addEventListener("click", () => input?.click());

    zone.addEventListener("dragenter", (e) => {
      e.preventDefault();
      zone.classList.add("cu-dropzone-active");
    });

    zone.addEventListener("dragover", (e) => {
      e.preventDefault();
      zone.classList.add("cu-dropzone-active");
    });

    zone.addEventListener("dragleave", () => {
      zone.classList.remove("cu-dropzone-active");
    });

    zone.addEventListener("drop", (e) => {
      e.preventDefault();
      zone.classList.remove("cu-dropzone-active");
      const files = e.dataTransfer?.files;
      if (files?.length) {
        input.files = files;
        input.dispatchEvent(new Event("change", { bubbles: true }));
      }
    });
  });
${SC}`.trim();

const fileListCode = `<div>
  <div class="cu-dropzone" data-cu-dropzone id="dropzone-filelist">
    <input type="file" data-cu-dropzone-input hidden multiple />
    <svg class="cu-dropzone-icon" xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
    <p class="cu-dropzone-title">Drag & drop files here, or click to browse</p>
    <p class="cu-dropzone-description">Upload multiple files</p>
  </div>
  <ul data-cu-dropzone-list class="mt-2 space-y-1 text-sm text-muted-foreground"></ul>
</div>`.trim();

const imagePreviewCode = `<div class="space-y-4 w-full max-w-md">
  <div class="cu-dropzone" data-cu-dropzone>
    <input type="file" class="cu-dropzone-input" data-cu-dropzone-input accept="image/*" multiple hidden />
    <div class="cu-dropzone-content">
      <svg class="cu-dropzone-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
      <p class="cu-dropzone-text">Drop images here or click to browse</p>
      <p class="cu-dropzone-hint">PNG, JPG, GIF up to 5MB each</p>
    </div>
  </div>
  <div class="grid grid-cols-4 gap-2">
    <div class="aspect-square rounded-lg bg-muted flex items-center justify-center text-xs text-muted-foreground border border-border">IMG</div>
    <div class="aspect-square rounded-lg bg-muted flex items-center justify-center text-xs text-muted-foreground border border-border">IMG</div>
    <div class="aspect-square rounded-lg bg-muted flex items-center justify-center text-xs text-muted-foreground border border-border">IMG</div>
    <div class="aspect-square rounded-lg bg-muted/50 border-2 border-dashed border-border flex items-center justify-center text-muted-foreground">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
    </div>
  </div>
</div>`.trim();

const acceptedTypesCode = `<div class="cu-dropzone w-full max-w-md" data-cu-dropzone>
  <input type="file" class="cu-dropzone-input" data-cu-dropzone-input accept=".pdf,.doc,.docx,.xls,.xlsx" multiple hidden />
  <div class="cu-dropzone-content">
    <svg class="cu-dropzone-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
    <p class="cu-dropzone-text">Upload documents</p>
    <p class="cu-dropzone-hint">Drag and drop or click to browse</p>
  </div>
  <div class="flex flex-wrap gap-1.5 mt-3 justify-center">
    <span class="cu-badge cu-badge-secondary cu-badge-sm">.pdf</span>
    <span class="cu-badge cu-badge-secondary cu-badge-sm">.doc</span>
    <span class="cu-badge cu-badge-secondary cu-badge-sm">.docx</span>
    <span class="cu-badge cu-badge-secondary cu-badge-sm">.xls</span>
    <span class="cu-badge cu-badge-secondary cu-badge-sm">.xlsx</span>
  </div>
</div>`.trim();

const disabledCode = `<div class="cu-dropzone cu-dropzone-disabled">
  <svg class="cu-dropzone-icon" xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
  <p class="cu-dropzone-title">Upload disabled</p>
  <p class="cu-dropzone-description">File upload is currently unavailable</p>
</div>`.trim();
---

<Layout category={t.category} componentName="Dropzone" title={t.title}>
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Dropzone</h1>
          <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
              <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-md">
                    <div class="cu-dropzone" data-cu-dropzone>
                        <input type="file" data-cu-dropzone-input hidden />
                        <svg class="cu-dropzone-icon" xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                        <p class="cu-dropzone-title">Drag & drop files here, or click to browse</p>
                        <p class="cu-dropzone-description">PNG, JPG, PDF up to 10MB</p>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.classes.title}
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-dropzone</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-dropzone']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-dropzone-active</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-dropzone-active']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-dropzone-icon</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-dropzone-icon']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-dropzone-title</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-dropzone-title']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-dropzone-description</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-dropzone-description']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-dropzone-disabled</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-dropzone-disabled']}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>


        <!-- With File List -->
        <section class="space-y-3">
            <h2 id="with-file-list" class="text-lg font-semibold tracking-tight relative group">
              <a href="#with-file-list" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.withFileList.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withFileList.description} />
            <ComponentPreview code={fileListCode}>
                <div class="w-full max-w-md">
                    <div class="cu-dropzone" data-cu-dropzone id="dropzone-filelist">
                        <input type="file" data-cu-dropzone-input hidden multiple />
                        <svg class="cu-dropzone-icon" xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                        <p class="cu-dropzone-title">Drag & drop files here, or click to browse</p>
                        <p class="cu-dropzone-description">Upload multiple files</p>
                    </div>
                    <ul data-cu-dropzone-list class="mt-2 space-y-1 text-sm text-muted-foreground"></ul>
                </div>
            </ComponentPreview>
        </section>

        <!-- Disabled -->
        <section class="space-y-3">
            <h2 id="disabled" class="text-lg font-semibold tracking-tight relative group">
              <a href="#disabled" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.disabled.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.disabled.description} />
            <ComponentPreview code={disabledCode}>
                <div class="w-full max-w-md">
                    <div class="cu-dropzone cu-dropzone-disabled">
                        <svg class="cu-dropzone-icon" xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                        <p class="cu-dropzone-title">Upload disabled</p>
                        <p class="cu-dropzone-description">File upload is currently unavailable</p>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Image Preview -->
        <section class="space-y-3">
            <h2 id="image-preview" class="text-lg font-semibold tracking-tight relative group">
              <a href="#image-preview" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.imagePreview.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.imagePreview.description} />
            <ComponentPreview code={imagePreviewCode}>
                <div class="space-y-4 w-full max-w-md">
                    <div class="cu-dropzone" data-cu-dropzone>
                        <input type="file" class="cu-dropzone-input" data-cu-dropzone-input accept="image/*" multiple hidden />
                        <div class="cu-dropzone-content">
                            <svg class="cu-dropzone-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                            <p class="cu-dropzone-text">Drop images here or click to browse</p>
                            <p class="cu-dropzone-hint">PNG, JPG, GIF up to 5MB each</p>
                        </div>
                    </div>
                    <div class="grid grid-cols-4 gap-2">
                        <div class="aspect-square rounded-lg bg-muted flex items-center justify-center text-xs text-muted-foreground border border-border">IMG</div>
                        <div class="aspect-square rounded-lg bg-muted flex items-center justify-center text-xs text-muted-foreground border border-border">IMG</div>
                        <div class="aspect-square rounded-lg bg-muted flex items-center justify-center text-xs text-muted-foreground border border-border">IMG</div>
                        <div class="aspect-square rounded-lg bg-muted/50 border-2 border-dashed border-border flex items-center justify-center text-muted-foreground">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Accepted File Types -->
        <section class="space-y-3">
            <h2 id="accepted-types" class="text-lg font-semibold tracking-tight relative group">
              <a href="#accepted-types" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.acceptedTypes.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.acceptedTypes.description} />
            <ComponentPreview code={acceptedTypesCode}>
                <div class="cu-dropzone w-full max-w-md" data-cu-dropzone>
                    <input type="file" class="cu-dropzone-input" data-cu-dropzone-input accept=".pdf,.doc,.docx,.xls,.xlsx" multiple hidden />
                    <div class="cu-dropzone-content">
                        <svg class="cu-dropzone-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
                        <p class="cu-dropzone-text">Upload documents</p>
                        <p class="cu-dropzone-hint">Drag and drop or click to browse</p>
                    </div>
                    <div class="flex flex-wrap gap-1.5 mt-3 justify-center">
                        <span class="cu-badge cu-badge-secondary cu-badge-sm">.pdf</span>
                        <span class="cu-badge cu-badge-secondary cu-badge-sm">.doc</span>
                        <span class="cu-badge cu-badge-secondary cu-badge-sm">.docx</span>
                        <span class="cu-badge cu-badge-secondary cu-badge-sm">.xls</span>
                        <span class="cu-badge cu-badge-secondary cu-badge-sm">.xlsx</span>
                    </div>
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>

<script is:inline>
    // Demo-only: file list display for the "With File List" example
    (function setupFileListDemo() {
        var zone = document.getElementById("dropzone-filelist");
        if (!zone) return;
        var input = zone.querySelector("[data-cu-dropzone-input]");
        var list = zone.parentElement && zone.parentElement.querySelector("[data-cu-dropzone-list]");
        if (!input || !list) return;
        input.addEventListener("change", function () {
            if (!input.files) return;
            list.innerHTML = "";
            Array.from(input.files).forEach(function (file) {
                var li = document.createElement("li");
                li.textContent = file.name + " (" + (file.size / 1024).toFixed(1) + " KB)";
                list.appendChild(li);
            });
        });
    })();
</script>
