---
import Layout from "@/layouts/Layout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
// @ts-ignore - Astro component used in template
import CodeBlock from "@/components/ui/CodeBlock.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { codeBlockPage } from "@/i18n/pages/components/code-block";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(codeBlockPage, locale);

const usageCode = `<div class="cu-code-block" data-cu-code-block>
  <button type="button" class="cu-code-block-copy" data-cu-code-block-copy>
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
    <span data-cu-code-block-label>Copy</span>
  </button>
  <pre class="cu-code-block-pre"><code>npm install cubby-ui</code></pre>
</div>`.trim();

const languageCode = `<div class="cu-code-block" data-cu-code-block>
  <div class="cu-code-block-header">
    <span>JavaScript</span>
    <button type="button" class="cu-code-block-copy" data-cu-code-block-copy>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
      <span data-cu-code-block-label>Copy</span>
    </button>
  </div>
  <pre class="cu-code-block-pre"><code class="language-javascript">function greet(name) {
  return \`Hello, \${name}!\`;
}

console.log(greet("World"));</code></pre>
</div>`.trim();

const filenameCode = `<div class="cu-code-block" data-cu-code-block>
  <div class="cu-code-block-header">
    <span>src/config.ts</span>
    <button type="button" class="cu-code-block-copy" data-cu-code-block-copy>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
      <span data-cu-code-block-label>Copy</span>
    </button>
  </div>
  <pre class="cu-code-block-pre"><code>export const TOP_CLASS = 'cu';
export const VERSION = '1.0.0';</code></pre>
</div>`.trim();

const multilineCode = `<div class="cu-code-block" data-cu-code-block>
  <div class="cu-code-block-header">
    <span>CSS</span>
    <button type="button" class="cu-code-block-copy" data-cu-code-block-copy>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
      <span data-cu-code-block-label>Copy</span>
    </button>
  </div>
  <pre class="cu-code-block-pre"><code class="language-css">.cu-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 0.5rem;
  font-size: 0.875rem;
  font-weight: 500;
  padding: 0.5rem 1rem;
  transition: colors 150ms;
}

.cu-button:hover {
  opacity: 0.9;
}</code></pre>
</div>`.trim();

const lightCode = `<div class="cu-code-block cu-code-block-light" data-cu-code-block>
  <button type="button" class="cu-code-block-copy" data-cu-code-block-copy>
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
    <span data-cu-code-block-label>Copy</span>
  </button>
  <pre class="cu-code-block-pre"><code>npm install cubby-ui</code></pre>
</div>`.trim();

const lightLanguageCode = `<div class="cu-code-block cu-code-block-light" data-cu-code-block>
  <div class="cu-code-block-header">
    <span>TypeScript</span>
    <button type="button" class="cu-code-block-copy" data-cu-code-block-copy>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
      <span data-cu-code-block-label>Copy</span>
    </button>
  </div>
  <pre class="cu-code-block-pre"><code class="language-typescript">interface User {
  id: number;
  name: string;
  email: string;
}

function getUser(id: number): User {
  return { id, name: "Alice", email: "alice@example.com" };
}</code></pre>
</div>`.trim();

const syntaxHighlightingCode = `<!-- Include Prism.js (or Highlight.js) CSS & JS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/prismjs@1/themes/prism-tomorrow.min.css">
<script src="https://cdn.jsdelivr.net/npm/prismjs@1/prism.min.js"><\/script>

<!-- The language-xxx class on <code> enables auto-highlighting -->
<div class="cu-code-block" data-cu-code-block>
  <div class="cu-code-block-header">
    <span>JavaScript</span>
    <button type="button" class="cu-code-block-copy" data-cu-code-block-copy>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
      <span data-cu-code-block-label>Copy</span>
    </button>
  </div>
  <pre class="cu-code-block-pre"><code class="language-javascript">const API_URL = "https://api.example.com";

async function fetchUsers() {
  const response = await fetch(API_URL + "/users");
  const data = await response.json();
  return data.users.filter(u => u.active);
}</code></pre>
</div>`.trim();

const syntaxHighlightingLightCode = `<!-- For light variant, use a light Prism theme -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/prismjs@1/themes/prism.min.css">

<div class="cu-code-block cu-code-block-light" data-cu-code-block>
  <div class="cu-code-block-header">
    <span>JavaScript</span>
    <button type="button" class="cu-code-block-copy" data-cu-code-block-copy>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
      <span data-cu-code-block-label>Copy</span>
    </button>
  </div>
  <pre class="cu-code-block-pre"><code class="language-javascript">const API_URL = "https://api.example.com";

async function fetchUsers() {
  const response = await fetch(API_URL + "/users");
  const data = await response.json();
  return data.users.filter(u => u.active);
}</code></pre>
</div>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Code Block">
  <div class="space-y-3">
    <div class="flex items-center gap-3">
      <h1 class="text-3xl font-bold tracking-tight">Code Block</h1>
      <span class="cu-badge cu-badge-secondary">{t.category}</span>
    </div>
    <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
  </div>

  <div class="mt-10 space-y-10">
    <!-- Usage -->
    <section class="space-y-3">
      <SectionHeading id="usage" title={t.sections.usage.title} />
      <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
      <ComponentPreview code={usageCode}>
        <div class="w-full max-w-lg">
          <CodeBlock>npm install cubby-ui</CodeBlock>
        </div>
      </ComponentPreview>
    </section>

    <!-- With Language Label -->
    <section class="space-y-3">
      <SectionHeading id="language" title={t.sections.language.title} />
      <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.language.description} />
      <ComponentPreview code={languageCode}>
        <div class="w-full max-w-lg">
          <CodeBlock language="JavaScript">{`function greet(name) {
  return \`Hello, \${name}!\`;
}

console.log(greet("World"));`}</CodeBlock>
        </div>
      </ComponentPreview>
    </section>

    <!-- With Filename -->
    <section class="space-y-3">
      <SectionHeading id="filename" title={t.sections.filename.title} />
      <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.filename.description} />
      <ComponentPreview code={filenameCode}>
        <div class="w-full max-w-lg">
          <CodeBlock filename="src/config.ts">{`export const TOP_CLASS = 'cu';
export const VERSION = '1.0.0';`}</CodeBlock>
        </div>
      </ComponentPreview>
    </section>

    <!-- Multiline -->
    <section class="space-y-3">
      <SectionHeading id="multiline" title={t.sections.multiline.title} />
      <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.multiline.description} />
      <ComponentPreview code={multilineCode}>
        <div class="w-full max-w-lg">
          <CodeBlock language="CSS">{`.cu-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 0.5rem;
  font-size: 0.875rem;
  font-weight: 500;
  padding: 0.5rem 1rem;
  transition: colors 150ms;
}

.cu-button:hover {
  opacity: 0.9;
}`}</CodeBlock>
        </div>
      </ComponentPreview>
    </section>

    <!-- Light Variant -->
    <section class="space-y-3">
      <SectionHeading id="light" title={t.sections.light.title} />
      <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.light.description} />
      <ComponentPreview code={lightCode}>
        <div class="w-full max-w-lg">
          <CodeBlock theme="light">npm install cubby-ui</CodeBlock>
        </div>
      </ComponentPreview>
    </section>

    <!-- Light with Language Label -->
    <section class="space-y-3">
      <SectionHeading id="light-language" title={t.sections.lightLanguage.title} />
      <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.lightLanguage.description} />
      <ComponentPreview code={lightLanguageCode}>
        <div class="w-full max-w-lg">
          <CodeBlock theme="light" language="TypeScript">{`interface User {
  id: number;
  name: string;
  email: string;
}

function getUser(id: number): User {
  return { id, name: "Alice", email: "alice@example.com" };
}`}</CodeBlock>
        </div>
      </ComponentPreview>
    </section>

    <!-- Syntax Highlighting -->
    <section class="space-y-3">
      <SectionHeading id="syntax-highlighting" title={t.sections.syntaxHighlighting.title} />
      <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.syntaxHighlighting.description} />
      <ComponentPreview code={syntaxHighlightingCode}>
        <div class="w-full max-w-lg">
          <CodeBlock language="JavaScript">{`const API_URL = "https://api.example.com";

async function fetchUsers() {
  const response = await fetch(API_URL + "/users");
  const data = await response.json();
  return data.users.filter(u => u.active);
}`}</CodeBlock>
        </div>
      </ComponentPreview>
      <ComponentPreview code={syntaxHighlightingLightCode}>
        <div class="w-full max-w-lg">
          <CodeBlock theme="light" language="JavaScript">{`const API_URL = "https://api.example.com";

async function fetchUsers() {
  const response = await fetch(API_URL + "/users");
  const data = await response.json();
  return data.users.filter(u => u.active);
}`}</CodeBlock>
        </div>
      </ComponentPreview>
    </section>

    <!-- Classes Reference -->
    <section class="space-y-3">
      <SectionHeading id="classes" title={t.sections.classes.title} />
      <div class="cu-table-wrapper rounded-lg border border-border">
        <table class="cu-table">
          <thead class="cu-table-header">
            <tr class="cu-table-row">
              <th class="cu-table-head">{t.sections.classes.classLabel}</th>
              <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
            </tr>
          </thead>
          <tbody class="cu-table-body">
            {Object.entries(t.classDescriptions).map(([cls, desc]) => (
              <tr class="cu-table-row">
                <td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
                <td class="cu-table-cell text-muted-foreground">{desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Layout>
