---
import Layout from "../../layouts/Layout.astro";
import Collapsible from "../../components/ui/Collapsible.astro";
import CollapsibleTrigger from "../../components/ui/CollapsibleTrigger.astro";
import CollapsibleContent from "../../components/ui/CollapsibleContent.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<details class="cu-collapsible">
  <summary class="cu-collapsible-trigger">
    Can I use this in my project?
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
  </summary>
  <div class="cu-collapsible-content">
    Yes. Free to use for personal and commercial projects. No attribution required.
  </div>
</details>`.trim();

const borderedCode = `<details class="cu-collapsible cu-collapsible-bordered">
  <summary class="cu-collapsible-trigger">
    @peduarte starred 3 repositories
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
  </summary>
  <div class="cu-collapsible-content space-y-2">
    <div class="rounded-md border border-border px-4 py-2 text-sm">@cubby-ui/primitives</div>
    <div class="rounded-md border border-border px-4 py-2 text-sm">@cubby-ui/colors</div>
    <div class="rounded-md border border-border px-4 py-2 text-sm">@cubby-ui/utils</div>
  </div>
</details>`.trim();

const groupCode = `<div class="cu-collapsible-group">
  <details class="cu-collapsible">
    <summary class="cu-collapsible-trigger">
      What payment methods do you accept?
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
    </summary>
    <div class="cu-collapsible-content">
      We accept all major credit cards (Visa, Mastercard, American Express), PayPal, and bank transfers.
    </div>
  </details>
  <details class="cu-collapsible">
    <summary class="cu-collapsible-trigger">
      How long does shipping take?
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
    </summary>
    <div class="cu-collapsible-content">
      Standard shipping takes 5–7 business days. Express shipping is available for 2–3 business days delivery.
    </div>
  </details>
  <details class="cu-collapsible">
    <summary class="cu-collapsible-trigger">
      Can I return my order?
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
    </summary>
    <div class="cu-collapsible-content">
      Yes, we offer a 30-day return policy for all unused items in their original packaging.
    </div>
  </details>
</div>`.trim();

const withIconCode = `<details class="cu-collapsible cu-collapsible-bordered">
  <summary class="cu-collapsible-trigger">
    <span class="flex items-center gap-2">
      <svg class="size-4 text-info" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
      System Requirements
    </span>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
  </summary>
  <div class="cu-collapsible-content">
    <ul class="list-disc pl-5 space-y-1 text-muted-foreground">
      <li>Node.js 18 or later</li>
      <li>npm 9+ or pnpm 8+</li>
      <li>Modern browser (Chrome 90+, Firefox 90+, Safari 15+)</li>
    </ul>
  </div>
</details>`.trim();

const nestedCode = `<details class="cu-collapsible cu-collapsible-bordered">
  <summary class="cu-collapsible-trigger">
    Project Settings
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
  </summary>
  <div class="cu-collapsible-content space-y-2">
    <details class="cu-collapsible cu-collapsible-bordered">
      <summary class="cu-collapsible-trigger">
        General
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="cu-collapsible-content text-muted-foreground">
        Configure project name, description, and visibility settings.
      </div>
    </details>
    <details class="cu-collapsible cu-collapsible-bordered">
      <summary class="cu-collapsible-trigger">
        Permissions
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="cu-collapsible-content text-muted-foreground">
        Manage team member roles and access levels.
      </div>
    </details>
  </div>
</details>`.trim();

const defaultOpenCode = `<details class="cu-collapsible cu-collapsible-bordered" open>
  <summary class="cu-collapsible-trigger">
    Release Notes — v2.4.0
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
  </summary>
  <div class="cu-collapsible-content space-y-2">
    <div class="flex items-center gap-2">
      <span class="cu-badge cu-badge-success">New</span>
      <span class="text-sm">Added dark mode support</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="cu-badge cu-badge-success">New</span>
      <span class="text-sm">Collapsible group component</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="cu-badge cu-badge-warning">Fix</span>
      <span class="text-sm">Resolved sidebar scroll issue on mobile</span>
    </div>
  </div>
</details>`.trim();
---

<Layout title="Collapsible — Cubby UI">
    <div class="space-y-3">
        <h1 class="text-3xl font-bold tracking-tight">Collapsible</h1>
        <p class="text-base text-muted-foreground leading-relaxed">
            An interactive component which expands/collapses a panel.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Usage</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Built with native <code class="cu-code">&lt;details&gt;</code> and <code class="cu-code">&lt;summary&gt;</code> elements.
                Use <code class="cu-code">cu-collapsible</code> on the wrapper,
                <code class="cu-code">cu-collapsible-trigger</code> on the <code class="cu-code">&lt;summary&gt;</code>,
                and <code class="cu-code">cu-collapsible-content</code> for the body.
            </p>
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-lg">
                    <Collapsible>
                        <CollapsibleTrigger>Can I use this in my project?</CollapsibleTrigger>
                        <CollapsibleContent>
                            Yes. Free to use for personal and commercial projects. No attribution required.
                        </CollapsibleContent>
                    </Collapsible>
                </div>
            </ComponentPreview>
        </section>

        <!-- Bordered -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Bordered</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Add a border and rounded corners with <code class="cu-code">cu-collapsible-bordered</code>. Opens with a subtle background and shadow.
            </p>
            <ComponentPreview code={borderedCode}>
                <div class="w-full max-w-lg">
                    <Collapsible class="cu-collapsible-bordered">
                        <CollapsibleTrigger>@peduarte starred 3 repositories</CollapsibleTrigger>
                        <CollapsibleContent class="space-y-2">
                            <div class="rounded-md border border-border px-4 py-2 text-sm">@cubby-ui/primitives</div>
                            <div class="rounded-md border border-border px-4 py-2 text-sm">@cubby-ui/colors</div>
                            <div class="rounded-md border border-border px-4 py-2 text-sm">@cubby-ui/utils</div>
                        </CollapsibleContent>
                    </Collapsible>
                </div>
            </ComponentPreview>
        </section>

        <!-- Group -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Group</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Stack multiple collapsibles with <code class="cu-code">cu-collapsible-group</code> using dividers. Great for FAQ sections.
            </p>
            <ComponentPreview code={groupCode}>
                <div class="w-full max-w-lg">
                    <div class="cu-collapsible-group">
                        <Collapsible>
                            <CollapsibleTrigger>What payment methods do you accept?</CollapsibleTrigger>
                            <CollapsibleContent>
                                We accept all major credit cards (Visa, Mastercard, American Express), PayPal, and bank transfers.
                            </CollapsibleContent>
                        </Collapsible>
                        <Collapsible>
                            <CollapsibleTrigger>How long does shipping take?</CollapsibleTrigger>
                            <CollapsibleContent>
                                Standard shipping takes 5–7 business days. Express shipping is available for 2–3 business days delivery.
                            </CollapsibleContent>
                        </Collapsible>
                        <Collapsible>
                            <CollapsibleTrigger>Can I return my order?</CollapsibleTrigger>
                            <CollapsibleContent>
                                Yes, we offer a 30-day return policy for all unused items in their original packaging.
                            </CollapsibleContent>
                        </Collapsible>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Icon -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">With Icon</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Add an icon to the trigger for enhanced visual cues.
            </p>
            <ComponentPreview code={withIconCode}>
                <div class="w-full max-w-lg">
                    <Collapsible class="cu-collapsible-bordered">
                        <CollapsibleTrigger>
                            <span class="flex items-center gap-2">
                                <svg class="size-4 text-info" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                                System Requirements
                            </span>
                        </CollapsibleTrigger>
                        <CollapsibleContent>
                            <ul class="list-disc pl-5 space-y-1 text-muted-foreground">
                                <li>Node.js 18 or later</li>
                                <li>npm 9+ or pnpm 8+</li>
                                <li>Modern browser (Chrome 90+, Firefox 90+, Safari 15+)</li>
                            </ul>
                        </CollapsibleContent>
                    </Collapsible>
                </div>
            </ComponentPreview>
        </section>

        <!-- Nested -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Nested</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Supports nesting for multi-level settings or category panels.
            </p>
            <ComponentPreview code={nestedCode}>
                <div class="w-full max-w-lg">
                    <Collapsible class="cu-collapsible-bordered">
                        <CollapsibleTrigger>Project Settings</CollapsibleTrigger>
                        <CollapsibleContent class="space-y-2">
                            <Collapsible class="cu-collapsible-bordered">
                                <CollapsibleTrigger>General</CollapsibleTrigger>
                                <CollapsibleContent class="text-muted-foreground">
                                    Configure project name, description, and visibility settings.
                                </CollapsibleContent>
                            </Collapsible>
                            <Collapsible class="cu-collapsible-bordered">
                                <CollapsibleTrigger>Permissions</CollapsibleTrigger>
                                <CollapsibleContent class="text-muted-foreground">
                                    Manage team member roles and access levels.
                                </CollapsibleContent>
                            </Collapsible>
                        </CollapsibleContent>
                    </Collapsible>
                </div>
            </ComponentPreview>
        </section>

        <!-- Default Open -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Default Open</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Add the <code class="cu-code">open</code> attribute to expand the panel by default. Useful for release notes or important announcements.
            </p>
            <ComponentPreview code={defaultOpenCode}>
                <div class="w-full max-w-lg">
                    <Collapsible class="cu-collapsible-bordered" open>
                        <CollapsibleTrigger>Release Notes — v2.4.0</CollapsibleTrigger>
                        <CollapsibleContent class="space-y-2">
                            <div class="flex items-center gap-2">
                                <span class="cu-badge cu-badge-success">New</span>
                                <span class="text-sm">Added dark mode support</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="cu-badge cu-badge-success">New</span>
                                <span class="text-sm">Collapsible group component</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="cu-badge cu-badge-warning">Fix</span>
                                <span class="text-sm">Resolved sidebar scroll issue on mobile</span>
                            </div>
                        </CollapsibleContent>
                    </Collapsible>
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>
