---
import Layout from "../../layouts/Layout.astro";
import Collapsible from "../../components/ui/Collapsible.astro";
import CollapsibleTrigger from "../../components/ui/CollapsibleTrigger.astro";
import CollapsibleContent from "../../components/ui/CollapsibleContent.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<details class="cu-collapsible">
  <summary class="cu-collapsible-trigger">
    Can I use this in my project?
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
  </summary>
  <div class="cu-collapsible-content">
    Yes. Free to use for personal and commercial projects. No attribution required.
  </div>
</details>`.trim();

const withBorderCode = `<details class="cu-collapsible rounded-lg border border-border px-4 py-3">
  <summary class="cu-collapsible-trigger">
    @peduarte starred 3 repositories
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
  </summary>
  <div class="cu-collapsible-content space-y-2">
    <div class="rounded-md border border-border px-4 py-2 text-sm">@cubby-ui/primitives</div>
    <div class="rounded-md border border-border px-4 py-2 text-sm">@cubby-ui/colors</div>
    <div class="rounded-md border border-border px-4 py-2 text-sm">@cubby-ui/utils</div>
  </div>
</details>`.trim();
---

<Layout title="Collapsible — Cubby UI">
    <div class="space-y-3">
        <h1 class="text-3xl font-bold tracking-tight">Collapsible</h1>
        <p class="text-base text-muted-foreground leading-relaxed">
            An interactive component which expands/collapses a panel.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Usage</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Built with native <code class="cu-code">&lt;details&gt;</code> and <code class="cu-code">&lt;summary&gt;</code> elements.
                Use <code class="cu-code">cu-collapsible</code> on the wrapper,
                <code class="cu-code">cu-collapsible-trigger</code> on the <code class="cu-code">&lt;summary&gt;</code>,
                and <code class="cu-code">cu-collapsible-content</code> for the body.
            </p>
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-lg">
                    <Collapsible>
                        <CollapsibleTrigger>Can I use this in my project?</CollapsibleTrigger>
                        <CollapsibleContent>
                            Yes. Free to use for personal and commercial projects. No attribution required.
                        </CollapsibleContent>
                    </Collapsible>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Border -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">With Border</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Add a border and padding for a card-like collapsible section.
            </p>
            <ComponentPreview code={withBorderCode}>
                <div class="w-full max-w-lg">
                    <Collapsible class="rounded-lg border border-border px-4 py-3">
                        <CollapsibleTrigger>@peduarte starred 3 repositories</CollapsibleTrigger>
                        <CollapsibleContent class="space-y-2">
                            <div class="rounded-md border border-border px-4 py-2 text-sm">@cubby-ui/primitives</div>
                            <div class="rounded-md border border-border px-4 py-2 text-sm">@cubby-ui/colors</div>
                            <div class="rounded-md border border-border px-4 py-2 text-sm">@cubby-ui/utils</div>
                        </CollapsibleContent>
                    </Collapsible>
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>
