---
import Layout from "../../layouts/Layout.astro";
import Progress from "../../components/ui/Progress.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<div class="cu-progress" role="progressbar" aria-valuenow="60" aria-valuemin="0" aria-valuemax="100">
  <div class="cu-progress-bar" style="width: 60%"></div>
</div>`.trim();

const valuesCode = `<div class="cu-progress" role="progressbar" aria-valuenow="20" aria-valuemin="0" aria-valuemax="100">
  <div class="cu-progress-bar" style="width: 20%"></div>
</div>

<div class="cu-progress" role="progressbar" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100">
  <div class="cu-progress-bar" style="width: 50%"></div>
</div>

<div class="cu-progress" role="progressbar" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100">
  <div class="cu-progress-bar" style="width: 80%"></div>
</div>`.trim();

const colorsCode = `<!-- Success -->
<div class="cu-progress" role="progressbar">
  <div class="cu-progress-bar bg-success" style="width: 75%"></div>
</div>

<!-- Warning -->
<div class="cu-progress" role="progressbar">
  <div class="cu-progress-bar bg-warning" style="width: 50%"></div>
</div>

<!-- Destructive -->
<div class="cu-progress" role="progressbar">
  <div class="cu-progress-bar bg-destructive" style="width: 30%"></div>
</div>`.trim();
---

<Layout title="Progress — Cubby UI" category="Feedback" componentName="Progress">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Progress</h1>
            <span class="cu-badge cu-badge-secondary">Feedback</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            Displays an indicator showing the completion progress of a task.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Usage
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-progress</code> as the track and <code class="cu-code">cu-progress-bar</code> as the fill.
                Set the width with an inline style.
            </p>
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-md">
                    <Progress value={60} />
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                CSS Classes
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">Class</th>
                            <th class="cu-table-head">Description</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-progress</code></td>
                            <td class="cu-table-cell text-muted-foreground">Progress bar outer track</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-progress-bar</code></td>
                            <td class="cu-table-cell text-muted-foreground">Progress bar fill, width represents progress</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>


        <!-- Different Values -->
        <section class="space-y-3">
            <h2 id="different-values" class="text-lg font-semibold tracking-tight relative group">
                <a href="#different-values" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Different Values
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Adjust the <code class="cu-code">width</code> percentage to indicate progress.
            </p>
            <ComponentPreview code={valuesCode}>
                <div class="w-full max-w-md space-y-4">
                    <Progress value={20} />
                    <Progress value={50} />
                    <Progress value={80} />
                </div>
            </ComponentPreview>
        </section>

        <!-- Custom Colors -->
        <section class="space-y-3">
            <h2 id="custom-colors" class="text-lg font-semibold tracking-tight relative group">
                <a href="#custom-colors" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Custom Colors
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Override the bar color by adding a background utility class to <code class="cu-code">cu-progress-bar</code>.
            </p>
            <ComponentPreview code={colorsCode}>
                <div class="w-full max-w-md space-y-4">
                    <div class="cu-progress" role="progressbar">
                        <div class="cu-progress-bar bg-success" style="width: 75%"></div>
                    </div>
                    <div class="cu-progress" role="progressbar">
                        <div class="cu-progress-bar bg-warning" style="width: 50%"></div>
                    </div>
                    <div class="cu-progress" role="progressbar">
                        <div class="cu-progress-bar bg-destructive" style="width: 30%"></div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

    </div>
</Layout>
