---
import Layout from "@/layouts/Layout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
// @ts-ignore - Astro component used in template
import Kbd from "@/components/ui/Kbd.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { kbdPage } from "@/i18n/pages/components/kbd";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(kbdPage, locale);

const usageCode = `<kbd class="cu-kbd">⌘</kbd>
<kbd class="cu-kbd">Shift</kbd>
<kbd class="cu-kbd">Enter</kbd>
<kbd class="cu-kbd">K</kbd>`.trim();

const sizesCode = `<kbd class="cu-kbd cu-kbd-sm">⌘</kbd>
<kbd class="cu-kbd">⌘</kbd>
<kbd class="cu-kbd cu-kbd-lg">⌘</kbd>`.trim();

const combinationsCode = `<span class="inline-flex items-center gap-1">
  <kbd class="cu-kbd">⌘</kbd>
  <span class="text-xs text-muted-foreground">+</span>
  <kbd class="cu-kbd">K</kbd>
</span>

<span class="inline-flex items-center gap-1">
  <kbd class="cu-kbd">Ctrl</kbd>
  <span class="text-xs text-muted-foreground">+</span>
  <kbd class="cu-kbd">Shift</kbd>
  <span class="text-xs text-muted-foreground">+</span>
  <kbd class="cu-kbd">P</kbd>
</span>

<span class="inline-flex items-center gap-1">
  <kbd class="cu-kbd">Alt</kbd>
  <span class="text-xs text-muted-foreground">+</span>
  <kbd class="cu-kbd">F4</kbd>
</span>`.trim();

const inContextCode = `<!-- In a menubar item -->
<div class="flex items-center justify-between gap-8 px-2 py-1.5 text-sm">
  <span>New File</span>
  <span class="inline-flex items-center gap-0.5">
    <kbd class="cu-kbd cu-kbd-sm">⌘</kbd>
    <kbd class="cu-kbd cu-kbd-sm">N</kbd>
  </span>
</div>
<div class="flex items-center justify-between gap-8 px-2 py-1.5 text-sm">
  <span>Save</span>
  <span class="inline-flex items-center gap-0.5">
    <kbd class="cu-kbd cu-kbd-sm">⌘</kbd>
    <kbd class="cu-kbd cu-kbd-sm">S</kbd>
  </span>
</div>
<div class="flex items-center justify-between gap-8 px-2 py-1.5 text-sm">
  <span>Find &amp; Replace</span>
  <span class="inline-flex items-center gap-0.5">
    <kbd class="cu-kbd cu-kbd-sm">⌘</kbd>
    <kbd class="cu-kbd cu-kbd-sm">⇧</kbd>
    <kbd class="cu-kbd cu-kbd-sm">H</kbd>
  </span>
</div>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Kbd">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Kbd</h1>
            <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            {t.description}
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <SectionHeading id="usage" title={t.sections.usage.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <div class="flex flex-wrap gap-2 items-center justify-center">
                    <Kbd>⌘</Kbd>
                    <Kbd>Shift</Kbd>
                    <Kbd>Enter</Kbd>
                    <Kbd>K</Kbd>
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <SectionHeading id="classes" title={t.sections.classes.title} />
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        {Object.entries(t.classDescriptions).map(([cls, desc]) => (
                            <tr class="cu-table-row">
                                <td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
                                <td class="cu-table-cell text-muted-foreground">{desc}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Sizes -->
        <section class="space-y-3">
            <SectionHeading id="sizes" title={t.sections.sizes.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.sizes.description} />
            <ComponentPreview code={sizesCode}>
                <div class="flex flex-wrap gap-3 items-end justify-center">
                    <Kbd size="sm">⌘</Kbd>
                    <Kbd>⌘</Kbd>
                    <Kbd size="lg">⌘</Kbd>
                </div>
            </ComponentPreview>
        </section>

        <!-- Combinations -->
        <section class="space-y-3">
            <SectionHeading id="combinations" title={t.sections.combinations.title} />
            <p class="text-base text-muted-foreground leading-relaxed">
                {t.sections.combinations.description}
            </p>
            <ComponentPreview code={combinationsCode}>
                <div class="flex flex-wrap gap-6 items-center justify-center">
                    <span class="inline-flex items-center gap-1">
                        <Kbd>⌘</Kbd>
                        <span class="text-xs text-muted-foreground">+</span>
                        <Kbd>K</Kbd>
                    </span>
                    <span class="inline-flex items-center gap-1">
                        <Kbd>Ctrl</Kbd>
                        <span class="text-xs text-muted-foreground">+</span>
                        <Kbd>Shift</Kbd>
                        <span class="text-xs text-muted-foreground">+</span>
                        <Kbd>P</Kbd>
                    </span>
                    <span class="inline-flex items-center gap-1">
                        <Kbd>Alt</Kbd>
                        <span class="text-xs text-muted-foreground">+</span>
                        <Kbd>F4</Kbd>
                    </span>
                </div>
            </ComponentPreview>
        </section>

        <!-- In Context -->
        <section class="space-y-3">
            <SectionHeading id="in-context" title={t.sections.inContext.title} />
            <p class="text-base text-muted-foreground leading-relaxed">
                {t.sections.inContext.description}
            </p>
            <ComponentPreview code={inContextCode}>
                <div class="w-full max-w-xs rounded-xl border border-border bg-card p-1.5 shadow-md">
                    <div class="flex items-center justify-between gap-8 rounded-md px-2 py-1.5 text-sm hover:bg-muted/60">
                        <span>New File</span>
                        <span class="inline-flex items-center gap-0.5">
                            <Kbd size="sm">⌘</Kbd>
                            <Kbd size="sm">N</Kbd>
                        </span>
                    </div>
                    <div class="flex items-center justify-between gap-8 rounded-md px-2 py-1.5 text-sm hover:bg-muted/60">
                        <span>Save</span>
                        <span class="inline-flex items-center gap-0.5">
                            <Kbd size="sm">⌘</Kbd>
                            <Kbd size="sm">S</Kbd>
                        </span>
                    </div>
                    <div class="flex items-center justify-between gap-8 rounded-md px-2 py-1.5 text-sm hover:bg-muted/60">
                        <span>Find & Replace</span>
                        <span class="inline-flex items-center gap-0.5">
                            <Kbd size="sm">⌘</Kbd>
                            <Kbd size="sm">⇧</Kbd>
                            <Kbd size="sm">H</Kbd>
                        </span>
                    </div>
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>
