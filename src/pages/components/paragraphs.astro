---
import Layout from "@/layouts/Layout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Paragraph from "@/components/ui/Paragraph.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { paragraphsPage } from "@/i18n/pages/components/paragraphs";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(paragraphsPage, locale);

const usageCode = `<p class="cu-p">
  The king, seeing how much happier his subjects were, realized that
  true power lay not in hoeli but in the trust and loyalty of his people.
</p>`.trim();

const leadCode = `<p class="cu-p cu-p-lead">
  A modal dialog that interrupts the user with important content and expects
  a response.
</p>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Paragraphs">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Paragraphs</h1>
          <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <SectionHeading id="usage" title={t.sections.usage.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-lg">
                    <Paragraph>
                        The king, seeing how much happier his subjects were, realized that
                        true power lay not in hoarding wealth but in the trust and loyalty of his people.
                    </Paragraph>
                </div>
            </ComponentPreview>
        </section>

    <!-- Classes Reference -->
    <section class="space-y-3">
      <SectionHeading id="classes" title={t.sections.classes.title} />
      <div class="cu-table-wrapper rounded-lg border border-border">
        <table class="cu-table">
          <thead class="cu-table-header">
            <tr class="cu-table-row">
              <th class="cu-table-head">{t.sections.classes.classLabel}</th>
              <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
            </tr>
          </thead>
          <tbody class="cu-table-body">
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-p</code></td>
              <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-p']}</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-p-lead</code></td>
              <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-p-lead']}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>


        <!-- Lead -->
        <section class="space-y-3">
            <SectionHeading id="lead" title={t.sections.lead.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.lead.description} />
            <ComponentPreview code={leadCode}>
                <div class="w-full max-w-lg">
                    <Paragraph variant="lead">
                        A modal dialog that interrupts the user with important content and expects
                        a response.
                    </Paragraph>
                </div>
            </ComponentPreview>
        </section>
    </div>

</Layout>
