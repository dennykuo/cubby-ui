---
import Layout from "../../layouts/Layout.astro";
import Paragraph from "../../components/ui/Paragraph.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<p class="cu-p">
  The king, seeing how much happier his subjects were, realized that
  true power lay not in hoeli but in the trust and loyalty of his people.
</p>`.trim();

const leadCode = `<p class="cu-p cu-p-lead">
  A modal dialog that interrupts the user with important content and expects
  a response.
</p>`.trim();
---

<Layout title="Paragraphs — Cubby UI" category="Typography" componentName="Paragraphs">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Paragraphs</h1>
          <span class="cu-badge cu-badge-secondary">Typography</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            Paragraph styles for body text and lead introductions.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
              <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Usage
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Apply <code class="cu-code">cu-p</code> to paragraph elements
                for consistent line height and spacing.
            </p>
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-lg">
                    <Paragraph>
                        The king, seeing how much happier his subjects were, realized that
                        true power lay not in hoarding wealth but in the trust and loyalty of his people.
                    </Paragraph>
                </div>
            </ComponentPreview>
        </section>

    <!-- Classes Reference -->
    <section class="space-y-3">
      <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
        <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        CSS Classes
      </h2>
      <div class="cu-table-wrapper rounded-lg border border-border">
        <table class="cu-table">
          <thead class="cu-table-header">
            <tr class="cu-table-row">
              <th class="cu-table-head">Class</th>
              <th class="cu-table-head">Description</th>
            </tr>
          </thead>
          <tbody class="cu-table-body">
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-p</code></td>
              <td class="cu-table-cell text-muted-foreground">Base paragraph style with consistent line height</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-p-lead</code></td>
              <td class="cu-table-cell text-muted-foreground">Lead paragraph with larger font and muted color</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>


        <!-- Lead -->
        <section class="space-y-3">
            <h2 id="lead" class="text-lg font-semibold tracking-tight relative group">
              <a href="#lead" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Lead
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-p-lead</code> for introductory
                paragraphs with larger, muted text.
            </p>
            <ComponentPreview code={leadCode}>
                <div class="w-full max-w-lg">
                    <Paragraph variant="lead">
                        A modal dialog that interrupts the user with important content and expects
                        a response.
                    </Paragraph>
                </div>
            </ComponentPreview>
        </section>
    </div>

</Layout>
