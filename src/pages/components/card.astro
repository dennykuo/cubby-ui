---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/ui/Button.astro";
import Card from "../../components/ui/Card.astro";
import CardHeader from "../../components/ui/CardHeader.astro";
import CardTitle from "../../components/ui/CardTitle.astro";
import CardDescription from "../../components/ui/CardDescription.astro";
import CardContent from "../../components/ui/CardContent.astro";
import CardFooter from "../../components/ui/CardFooter.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<div class="cu-card">
  <div class="cu-card-header">
    <h3 class="cu-card-title">Card Title</h3>
    <p class="cu-card-description">Card description goes here.</p>
  </div>
  <div class="cu-card-content">
    <p>Card content.</p>
  </div>
  <div class="cu-card-footer">
    <button class="cu-button cu-button-default cu-button-md">Action</button>
  </div>
</div>`.trim();

const formCardCode = `<div class="cu-card w-[380px]">
  <div class="cu-card-header">
    <h3 class="cu-card-title">Create project</h3>
    <p class="cu-card-description">Deploy your new project in one-click.</p>
  </div>
  <div class="cu-card-content">
    <form>
      <div class="grid w-full items-center gap-4">
        <div class="cu-form-group">
          <label for="name" class="cu-label">Name</label>
          <input id="name" placeholder="Name of your project" class="cu-input" />
        </div>
      </div>
    </form>
  </div>
  <div class="cu-card-footer flex justify-between">
    <button class="cu-button cu-button-outline cu-button-md">Cancel</button>
    <button class="cu-button cu-button-default cu-button-md">Deploy</button>
  </div>
</div>`.trim();

const notificationCardCode = `<div class="cu-card w-[380px]">
  <div class="cu-card-header">
    <h3 class="cu-card-title">Notifications</h3>
    <p class="cu-card-description">You have 3 unread messages.</p>
  </div>
  <div class="cu-card-content grid gap-3">
    <div class="flex items-center gap-4 rounded-lg border p-3">
      <span class="flex h-2 w-2 rounded-full bg-sky-500"></span>
      <div class="space-y-0.5">
        <p class="text-sm font-medium leading-none">Push notifications</p>
        <p class="text-sm text-muted-foreground">Send to device.</p>
      </div>
    </div>
    <div class="flex items-center gap-4 rounded-lg border p-3">
      <span class="flex h-2 w-2 rounded-full bg-sky-500"></span>
      <div class="space-y-0.5">
        <p class="text-sm font-medium leading-none">Email digest</p>
        <p class="text-sm text-muted-foreground">Weekly summary.</p>
      </div>
    </div>
  </div>
  <div class="cu-card-footer">
    <button class="cu-button cu-button-default cu-button-md w-full">
      Mark all as read
    </button>
  </div>
</div>`.trim();

const simpleCardsCode = `<div class="cu-card">
  <div class="cu-card-header">
    <h3 class="cu-card-title">Total Revenue</h3>
    <p class="cu-card-description">January - June 2024</p>
  </div>
  <div class="cu-card-content">
    <div class="text-3xl font-bold">$45,231.89</div>
    <p class="text-xs text-muted-foreground mt-1">+20.1% from last month</p>
  </div>
</div>`.trim();
---

<Layout title="Card — Cubby UI">
    <div class="space-y-3">
        <h1 class="text-3xl font-bold tracking-tight">Card</h1>
        <p class="text-base text-muted-foreground leading-relaxed">
            Displays a card with header, content, and footer.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Usage</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                A card is composed of
                <code class="cu-code">cu-card</code>,
                <code class="cu-code">cu-card-header</code>,
                <code class="cu-code">cu-card-content</code>, and
                <code class="cu-code">cu-card-footer</code>.
                Each part is optional.
            </p>
            <ComponentPreview code={usageCode}>
                <Card class="w-[380px]">
                    <CardHeader>
                        <CardTitle>Card Title</CardTitle>
                        <CardDescription>Card description goes here.</CardDescription>
                    </CardHeader>
                    <CardContent>
                        <p>Card content.</p>
                    </CardContent>
                    <CardFooter>
                        <Button>Action</Button>
                    </CardFooter>
                </Card>
            </ComponentPreview>
        </section>

        <!-- Form Card -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Form Card</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Cards work well as containers for forms with actions in the footer.
            </p>
            <ComponentPreview code={formCardCode}>
                <Card class="w-[380px]">
                    <CardHeader>
                        <CardTitle>Create project</CardTitle>
                        <CardDescription>Deploy your new project in one-click.</CardDescription>
                    </CardHeader>
                    <CardContent>
                        <form>
                            <div class="grid w-full items-center gap-4">
                                <div class="cu-form-group">
                                    <label for="name" class="cu-label">Name</label>
                                    <input id="name" placeholder="Name of your project" class="cu-input" />
                                </div>
                            </div>
                        </form>
                    </CardContent>
                    <CardFooter class="flex justify-between">
                        <Button variant="outline">Cancel</Button>
                        <Button>Deploy</Button>
                    </CardFooter>
                </Card>
            </ComponentPreview>
        </section>

        <!-- Notification Card -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Notification Card</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Cards can contain lists of items with a full-width action button.
            </p>
            <ComponentPreview code={notificationCardCode}>
                <Card class="w-[380px]">
                    <CardHeader>
                        <CardTitle>Notifications</CardTitle>
                        <CardDescription>You have 3 unread messages.</CardDescription>
                    </CardHeader>
                    <CardContent class="grid gap-3">
                        <div class="flex items-center gap-4 rounded-lg border p-3">
                            <span class="flex h-2 w-2 rounded-full bg-sky-500"></span>
                            <div class="space-y-0.5">
                                <p class="text-sm font-medium leading-none">Push notifications</p>
                                <p class="text-sm text-muted-foreground">Send to device.</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 rounded-lg border p-3">
                            <span class="flex h-2 w-2 rounded-full bg-sky-500"></span>
                            <div class="space-y-0.5">
                                <p class="text-sm font-medium leading-none">Email digest</p>
                                <p class="text-sm text-muted-foreground">Weekly summary.</p>
                            </div>
                        </div>
                    </CardContent>
                    <CardFooter>
                        <Button class="w-full">Mark all as read</Button>
                    </CardFooter>
                </Card>
            </ComponentPreview>
        </section>

        <!-- Metric Card -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Metric Card</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                A minimal card without a footer — useful for dashboards and stats.
            </p>
            <ComponentPreview code={simpleCardsCode}>
                <div class="flex flex-wrap gap-4 justify-center">
                    <Card class="w-[200px]">
                        <CardHeader>
                            <CardTitle class="text-sm font-medium">Total Revenue</CardTitle>
                            <CardDescription>January - June 2024</CardDescription>
                        </CardHeader>
                        <CardContent>
                            <div class="text-3xl font-bold">$45,231.89</div>
                            <p class="text-xs text-muted-foreground mt-1">+20.1% from last month</p>
                        </CardContent>
                    </Card>
                    <Card class="w-[200px]">
                        <CardHeader>
                            <CardTitle class="text-sm font-medium">Subscriptions</CardTitle>
                            <CardDescription>Active plans</CardDescription>
                        </CardHeader>
                        <CardContent>
                            <div class="text-3xl font-bold">+2,350</div>
                            <p class="text-xs text-muted-foreground mt-1">+180.1% from last month</p>
                        </CardContent>
                    </Card>
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>
