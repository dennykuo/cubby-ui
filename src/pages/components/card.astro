</div>`.trim();

const formCardCode = `<div class="cu-card w-[380px]">
  <div class="cu-card-header">
    <h3 class="cu-card-title">Create project</h3>
    <p class="cu-card-description">Deploy your new project in one-click.</p>
  </div>
  <div class="cu-card-content">
    <form>
      <div class="grid w-full items-center gap-4">
        <div class="cu-form-group">
          <label for="name" class="cu-label">Name</label>
          <input id="name" placeholder="Name of your project" class="cu-input" />
        </div>
        <div class="cu-form-group">
          <label for="framework" class="cu-label">Framework</label>
          <div class="cu-select-wrapper">
            <select id="framework" class="cu-select">
              <option value="">Select</option>
              <option value="next">Next.js</option>
              <option value="astro">Astro</option>
              <option value="nuxt">Nuxt</option>
            </select>
          </div>
        </div>
      </div>
    </form>
  </div>
  <div class="cu-card-footer flex justify-between">
    <button class="cu-button cu-button-outline cu-button-md">Cancel</button>
    <button class="cu-button cu-button-default cu-button-md">Deploy</button>
  </div>
</div>`.trim();

