---

<Layout title={t.title} category={t.category} componentName="Card">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Card</h1>
            <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            {t.description}
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <Card class="w-[380px]">
                    <CardHeader>
                        <CardTitle>Project Settings</CardTitle>
                        <CardDescription>Manage your project configuration and preferences.</CardDescription>
                    </CardHeader>
                    <CardContent>
                        <p class="text-sm text-muted-foreground">Configure your project name, description, and visibility settings from this panel.</p>
                    </CardContent>
                    <CardFooter>
                        <Button>Save Changes</Button>
                    </CardFooter>
                </Card>
            </ComponentPreview>
        </section>

    <!-- Classes Reference -->
    <section class="space-y-3">
      <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
        <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        {t.sections.classes.title}
      </h2>
      <div class="cu-table-wrapper rounded-lg border border-border">
        <table class="cu-table">
          <thead class="cu-table-header">
            <tr class="cu-table-row">
              <th class="cu-table-head">{t.sections.classes.classLabel}</th>
              <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
            </tr>
          </thead>
          <tbody class="cu-table-body">
            {Object.entries(t.classDescriptions).map(([cls, desc]) => (
              <tr class="cu-table-row">
                <td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
                <td class="cu-table-cell text-muted-foreground">{desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>


        <!-- Outlined -->
        <section class="space-y-3">
            <h2 id="outlined" class="text-lg font-semibold tracking-tight relative group">
                <a href="#outlined" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.outlined.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.outlined.description} />
            <ComponentPreview code={outlinedCode}>
                <div class="grid w-full grid-cols-1 gap-4 sm:grid-cols-2">
                    <Card>
                        <CardHeader>
                            <CardTitle>Default Card</CardTitle>
                            <CardDescription>With default shadow-xs.</CardDescription>
                        </CardHeader>
                    </Card>
                    <Card class="cu-card-outlined">
                        <CardHeader>
                            <CardTitle>Outlined Card</CardTitle>
                            <CardDescription>Flat with no shadow.</CardDescription>
                        </CardHeader>
                    </Card>
                </div>
            </ComponentPreview>
        </section>

        <!-- Hover Cards -->
        <section class="space-y-3">
            <h2 id="hover-effect" class="text-lg font-semibold tracking-tight relative group">
                <a href="#hover-effect" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.hoverEffect.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.hoverEffect.description} />
            <ComponentPreview code={hoverCode}>
                <div class="grid w-full grid-cols-1 gap-4 sm:grid-cols-3">
                    <Card class="cu-card-hover">
                        <CardHeader>
