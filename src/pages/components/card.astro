---

<Layout title="Card — Cubby UI">
    <div class="space-y-3">
        <h1 class="text-3xl font-bold tracking-tight">Card</h1>
        <p class="text-base text-muted-foreground leading-relaxed">
            Displays a card with header, content, and footer.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Usage</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                A card is composed of
                <code class="cu-code">cu-card</code>,
                <code class="cu-code">cu-card-header</code>,
                <code class="cu-code">cu-card-content</code>, and
                <code class="cu-code">cu-card-footer</code>.
                Each part is optional.
            </p>
            <ComponentPreview code={usageCode}>
                <Card class="w-[380px]">
                    <CardHeader>
                        <CardTitle>Card Title</CardTitle>
                        <CardDescription>Card description goes here.</CardDescription>
                    </CardHeader>
                    <CardContent>
                        <p>Card content.</p>
                    </CardContent>
                    <CardFooter>
                        <Button>Action</Button>
                    </CardFooter>
                </Card>
            </ComponentPreview>
        </section>

        <!-- Form Card -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Form Card</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Cards work well as containers for forms with actions in the footer.
            </p>
            <ComponentPreview code={formCardCode}>
                <Card class="w-[380px]">
                    <CardHeader>
                        <CardTitle>Create project</CardTitle>
                        <CardDescription>Deploy your new project in one-click.</CardDescription>
                    </CardHeader>
                    <CardContent>
                        <form>
                            <div class="grid w-full items-center gap-4">
                                <div class="cu-form-group">
                                    <label for="card-name" class="cu-label">Name</label>
                                    <input id="card-name" placeholder="Name of your project" class="cu-input" />
                                </div>
                                <div class="cu-form-group">
                                    <label for="card-framework" class="cu-label">Framework</label>
                                    <div class="cu-select-wrapper">
                                        <select id="card-framework" class="cu-select">
                                            <option value="">Select</option>
                                            <option value="next">Next.js</option>
                                            <option value="astro">Astro</option>
                                            <option value="nuxt">Nuxt</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </CardContent>
                    <CardFooter class="flex justify-between">
                        <Button variant="outline">Cancel</Button>
                        <Button>Deploy</Button>
                    </CardFooter>
                </Card>
            </ComponentPreview>
        </section>

        <!-- Login Card -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Login Card</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                A sign-in form with social login options and a separator divider.
            </p>
            <ComponentPreview code={loginCardCode}>
                <Card class="w-[380px]">
                    <CardHeader class="items-center text-center">
                        <CardTitle class="text-xl">Welcome back</CardTitle>
                        <CardDescription>Sign in to your account to continue.</CardDescription>
                    </CardHeader>
                    <CardContent>
                        <form class="space-y-4">
                            <div class="cu-form-group">
                                <label for="card-email" class="cu-label">Email</label>
                                <input id="card-email" type="email" placeholder="name@example.com" class="cu-input" />
                            </div>
                            <div class="cu-form-group">
                                <div class="flex items-center justify-between">
                                    <label for="card-password" class="cu-label">Password</label>
                                    <a href="#" class="text-xs text-primary hover:underline">Forgot?</a>
                                </div>
                                <input id="card-password" type="password" placeholder="••••••••" class="cu-input" />
                            </div>
                            <Button class="w-full">Sign In</Button>
                        </form>
                        <div class="relative mt-6">
                            <div class="absolute inset-0 flex items-center"><div class="cu-separator cu-separator-horizontal"></div></div>
                            <div class="relative flex justify-center"><span class="bg-card px-2 text-xs text-muted-foreground">Or continue with</span></div>
                        </div>
                        <div class="mt-4 grid grid-cols-2 gap-2">
                            <Button variant="outline">GitHub</Button>
                            <Button variant="outline">Google</Button>
                        </div>
                    </CardContent>
                </Card>
            </ComponentPreview>
        </section>

        <!-- Notification Card -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Notification Card</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Cards can contain lists of items with timestamps and a full-width action button.
            </p>
            <ComponentPreview code={notificationCardCode}>
                <Card class="w-[380px]">
                    <CardHeader>
                        <CardTitle>Notifications</CardTitle>
                        <CardDescription>You have 3 unread messages.</CardDescription>
                    </CardHeader>
                    <CardContent class="grid gap-3">
                        <div class="flex items-center gap-4 rounded-lg border border-border p-3">
