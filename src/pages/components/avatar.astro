---
import Layout from "../../layouts/Layout.astro";
import Avatar from "../../components/ui/Avatar.astro";
import AvatarImage from "../../components/ui/AvatarImage.astro";
import AvatarFallback from "../../components/ui/AvatarFallback.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<span class="cu-avatar cu-avatar-md">
  <img class="cu-avatar-image" src="https://i.pravatar.cc/80?img=1" alt="Avatar" />
  <span class="cu-avatar-fallback">CN</span>
</span>`.trim();

const sizesCode = `<span class="cu-avatar cu-avatar-sm">
  <img class="cu-avatar-image" src="https://i.pravatar.cc/80?img=2" alt="Avatar" />
  <span class="cu-avatar-fallback">SM</span>
</span>

<span class="cu-avatar cu-avatar-md">
  <img class="cu-avatar-image" src="https://i.pravatar.cc/80?img=3" alt="Avatar" />
  <span class="cu-avatar-fallback">MD</span>
</span>

<span class="cu-avatar cu-avatar-lg">
  <img class="cu-avatar-image" src="https://i.pravatar.cc/80?img=4" alt="Avatar" />
  <span class="cu-avatar-fallback">LG</span>
</span>`.trim();

const fallbackCode = `<span class="cu-avatar cu-avatar-md">
  <span class="cu-avatar-fallback">CN</span>
</span>

<span class="cu-avatar cu-avatar-md">
  <span class="cu-avatar-fallback">AB</span>
</span>`.trim();
---

<Layout title="Avatar — Cubby UI" category="Data Display" componentName="Avatar">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Avatar</h1>
            <span class="cu-badge cu-badge-secondary">Data Display</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            An image element with a fallback for representing the user.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Usage
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-avatar</code> as the container with a size class.
                Inside, place <code class="cu-code">cu-avatar-image</code> and <code class="cu-code">cu-avatar-fallback</code>.
            </p>
            <ComponentPreview code={usageCode}>
                <Avatar>
                    <AvatarImage src="https://i.pravatar.cc/80?img=1" alt="Avatar" />
                    <AvatarFallback>CN</AvatarFallback>
                </Avatar>
            </ComponentPreview>
        </section>

        <!-- Sizes -->
        <section class="space-y-3">
            <h2 id="sizes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#sizes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Sizes
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Three sizes are available —
                <code class="cu-code">cu-avatar-sm</code>,
                <code class="cu-code">cu-avatar-md</code> (default), and
                <code class="cu-code">cu-avatar-lg</code>.
            </p>
            <ComponentPreview code={sizesCode}>
                <div class="flex items-center gap-4 justify-center">
                    <Avatar size="sm">
                        <AvatarImage src="https://i.pravatar.cc/80?img=2" alt="Avatar" />
                        <AvatarFallback>SM</AvatarFallback>
                    </Avatar>
                    <Avatar size="md">
                        <AvatarImage src="https://i.pravatar.cc/80?img=3" alt="Avatar" />
                        <AvatarFallback>MD</AvatarFallback>
                    </Avatar>
                    <Avatar size="lg">
                        <AvatarImage src="https://i.pravatar.cc/80?img=4" alt="Avatar" />
                        <AvatarFallback>LG</AvatarFallback>
                    </Avatar>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Fallback -->
        <section class="space-y-3">
            <h2 id="with-fallback" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-fallback" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                With Fallback
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                When no image is provided, the fallback with initials is displayed.
            </p>
            <ComponentPreview code={fallbackCode}>
                <div class="flex items-center gap-4 justify-center">
                    <Avatar>
                        <AvatarFallback>CN</AvatarFallback>
                    </Avatar>
                    <Avatar>
                        <AvatarFallback>AB</AvatarFallback>
                    </Avatar>
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3 mt-10">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                CSS Classes
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">Class</th>
                            <th class="cu-table-head">說明</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-avatar</code></td>
                            <td class="cu-table-cell text-muted-foreground">頭像容器，圓形裁切</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-avatar-sm</code></td>
                            <td class="cu-table-cell text-muted-foreground">小尺寸（32px）</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-avatar-md</code></td>
                            <td class="cu-table-cell text-muted-foreground">中尺寸（40px，預設）</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-avatar-lg</code></td>
                            <td class="cu-table-cell text-muted-foreground">大尺寸（48px）</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-avatar-image</code></td>
                            <td class="cu-table-cell text-muted-foreground">頭像圖片，等比例填滿</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-avatar-fallback</code></td>
                            <td class="cu-table-cell text-muted-foreground">圖片載入失敗時的替代顯示</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</Layout>
