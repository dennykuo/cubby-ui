---
import Layout from "@/layouts/Layout.astro";
import Checkbox from "@/components/ui/Checkbox.astro";
import Label from "@/components/ui/Label.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { checkboxPage } from "@/i18n/pages/components/checkbox";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(checkboxPage, locale);

const usageCode = `<input type="checkbox" class="cu-checkbox" />`.trim();

const withLabelCode = `<div class="cu-checkbox-wrapper">
  <input type="checkbox" class="cu-checkbox" id="terms" />
  <label class="cu-label" for="terms">Accept terms and conditions</label>
</div>`.trim();

const checkedCode = `<div class="cu-checkbox-wrapper">
  <input type="checkbox" class="cu-checkbox" id="newsletter" checked />
  <label class="cu-label" for="newsletter">Subscribe to newsletter</label>
</div>`.trim();

const disabledCode = `<div class="cu-checkbox-wrapper">
  <input type="checkbox" class="cu-checkbox" id="disabled-cb" disabled />
  <label class="cu-label" for="disabled-cb">Disabled option</label>
</div>

<div class="cu-checkbox-wrapper">
  <input type="checkbox" class="cu-checkbox" id="disabled-checked" disabled checked />
  <label class="cu-label" for="disabled-checked">Disabled checked</label>
</div>`.trim();

const withDescCode = `<div class="cu-checkbox-wrapper items-start">
  <input type="checkbox" class="cu-checkbox mt-0.5" id="marketing" />
  <div>
    <label class="cu-label" for="marketing">Marketing emails</label>
    <p class="text-sm text-muted-foreground">Receive emails about new products, features, and updates.</p>
  </div>
</div>

<div class="cu-checkbox-wrapper items-start">
  <input type="checkbox" class="cu-checkbox mt-0.5" id="security" checked />
  <div>
    <label class="cu-label" for="security">Security alerts</label>
    <p class="text-sm text-muted-foreground">Get notified about unusual account activity.</p>
  </div>
</div>`.trim();

const indeterminateCode = `<div class="cu-checkbox-wrapper">
  <input type="checkbox" class="cu-checkbox" id="select-all" />
  <label class="cu-label font-medium" for="select-all">Select all</label>
</div>
<div class="ml-6 flex flex-col gap-2">
  <div class="cu-checkbox-wrapper">
    <input type="checkbox" class="cu-checkbox" id="item-1" checked />
    <label class="cu-label" for="item-1">Item 1</label>
  </div>
  <div class="cu-checkbox-wrapper">
    <input type="checkbox" class="cu-checkbox" id="item-2" />
    <label class="cu-label" for="item-2">Item 2</label>
  </div>
  <div class="cu-checkbox-wrapper">
    <input type="checkbox" class="cu-checkbox" id="item-3" checked />
    <label class="cu-label" for="item-3">Item 3</label>
  </div>
</div>

<script>
  const selectAll = document.getElementById('select-all');
  const items = document.querySelectorAll('#item-1, #item-2, #item-3');
  function updateSelectAll() {
    const checked = [...items].filter(i => i.checked).length;
    selectAll.checked = checked === items.length;
    selectAll.indeterminate = checked > 0 && checked < items.length;
  }
  items.forEach(i => i.addEventListener('change', updateSelectAll));
  selectAll.addEventListener('change', () => {
    items.forEach(i => { i.checked = selectAll.checked; });
  });
  updateSelectAll();
</script>`.trim();

const inlineCode = `<div class="flex flex-wrap gap-4">
  <div class="cu-checkbox-wrapper">
    <input type="checkbox" class="cu-checkbox" id="opt-a" />
    <label class="cu-label" for="opt-a">Option A</label>
  </div>
  <div class="cu-checkbox-wrapper">
    <input type="checkbox" class="cu-checkbox" id="opt-b" checked />
    <label class="cu-label" for="opt-b">Option B</label>
  </div>
  <div class="cu-checkbox-wrapper">
    <input type="checkbox" class="cu-checkbox" id="opt-c" />
    <label class="cu-label" for="opt-c">Option C</label>
  </div>
</div>`.trim();

const groupCode = `<fieldset>
  <legend class="cu-label mb-2">Notifications</legend>
  <div class="flex flex-col gap-2">
    <div class="cu-checkbox-wrapper">
      <input type="checkbox" class="cu-checkbox" id="email-notif" checked />
      <label class="cu-label" for="email-notif">Email notifications</label>
    </div>
    <div class="cu-checkbox-wrapper">
      <input type="checkbox" class="cu-checkbox" id="sms-notif" />
      <label class="cu-label" for="sms-notif">SMS notifications</label>
    </div>
    <div class="cu-checkbox-wrapper">
      <input type="checkbox" class="cu-checkbox" id="push-notif" checked />
      <label class="cu-label" for="push-notif">Push notifications</label>
    </div>
  </div>
</fieldset>`.trim();
---

<Layout category={t.category} componentName="Checkbox" title={t.title}>
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Checkbox</h1>
          <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
              <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <Checkbox />
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
          <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
            <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
            {t.sections.classes.title}
          </h2>
          <div class="cu-table-wrapper rounded-lg border border-border">
            <table class="cu-table">
              <thead class="cu-table-header">
                <tr class="cu-table-row">
                  <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                  <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                </tr>
              </thead>
              <tbody class="cu-table-body">
                <tr class="cu-table-row">
                  <td class="cu-table-cell"><code class="cu-code">cu-checkbox-wrapper</code></td>
                  <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-checkbox-wrapper']}</td>
                </tr>
                <tr class="cu-table-row">
                  <td class="cu-table-cell"><code class="cu-code">cu-checkbox</code></td>
                  <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-checkbox']}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>


        <!-- With Label -->
        <section class="space-y-3">
            <h2 id="with-label" class="text-lg font-semibold tracking-tight relative group">
              <a href="#with-label" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.withLabel.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withLabel.description} />
            <ComponentPreview code={withLabelCode}>
                <div class="cu-checkbox-wrapper">
                    <Checkbox id="terms" />
                    <Label for="terms">Accept terms and conditions</Label>
                </div>
            </ComponentPreview>
        </section>

        <!-- Checked by Default -->
        <section class="space-y-3">
            <h2 id="checked-by-default" class="text-lg font-semibold tracking-tight relative group">
              <a href="#checked-by-default" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.checkedByDefault.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.checkedByDefault.description} />
            <ComponentPreview code={checkedCode}>
                <div class="cu-checkbox-wrapper">
                    <Checkbox id="newsletter" checked />
                    <Label for="newsletter">Subscribe to newsletter</Label>
                </div>
            </ComponentPreview>
        </section>

        <!-- Disabled -->
        <section class="space-y-3">
            <h2 id="disabled" class="text-lg font-semibold tracking-tight relative group">
              <a href="#disabled" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.disabled.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.disabled.description} />
            <ComponentPreview code={disabledCode}>
                <div class="space-y-2">
                    <div class="cu-checkbox-wrapper">
                        <Checkbox id="disabled-cb" disabled />
                        <Label for="disabled-cb">Disabled option</Label>
                    </div>
                    <div class="cu-checkbox-wrapper">
                        <Checkbox id="disabled-checked" disabled checked />
                        <Label for="disabled-checked">Disabled checked</Label>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Checkbox Group -->
        <section class="space-y-3">
            <h2 id="checkbox-group" class="text-lg font-semibold tracking-tight relative group">
              <a href="#checkbox-group" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.checkboxGroup.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.checkboxGroup.description} />
            <ComponentPreview code={groupCode}>
                <fieldset>
                    <legend class="cu-label mb-2">Notifications</legend>
                    <div class="flex flex-col gap-2">
                        <div class="cu-checkbox-wrapper">
                            <Checkbox id="email-notif" checked />
                            <Label for="email-notif">Email notifications</Label>
                        </div>
                        <div class="cu-checkbox-wrapper">
                            <Checkbox id="sms-notif" />
                            <Label for="sms-notif">SMS notifications</Label>
                        </div>
                        <div class="cu-checkbox-wrapper">
                            <Checkbox id="push-notif" checked />
                            <Label for="push-notif">Push notifications</Label>
                        </div>
                    </div>
                </fieldset>
            </ComponentPreview>
        </section>

        <!-- With Description -->
        <section class="space-y-3">
            <h2 id="with-description" class="text-lg font-semibold tracking-tight relative group">
              <a href="#with-description" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.withDescription.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withDescription.description} />
            <ComponentPreview code={withDescCode}>
                <div class="space-y-2">
                    <div class="cu-checkbox-wrapper items-start">
                        <Checkbox id="marketing-demo" class="mt-0.5" />
                        <div>
                            <Label for="marketing-demo">Marketing emails</Label>
                            <p class="text-sm text-muted-foreground">Receive emails about new products, features, and updates.</p>
                        </div>
                    </div>
                    <div class="cu-checkbox-wrapper items-start">
                        <Checkbox id="security-demo" class="mt-0.5" checked />
                        <div>
                            <Label for="security-demo">Security alerts</Label>
                            <p class="text-sm text-muted-foreground">Get notified about unusual account activity.</p>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Indeterminate -->
        <section class="space-y-3">
            <h2 id="indeterminate" class="text-lg font-semibold tracking-tight relative group">
              <a href="#indeterminate" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.indeterminate.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.indeterminate.description} />
            <ComponentPreview code={indeterminateCode}>
                <div>
                    <div class="cu-checkbox-wrapper">
                        <Checkbox id="select-all-demo" />
                        <Label for="select-all-demo" class="font-medium">Select all</Label>
                    </div>
                    <div class="ml-6 flex flex-col gap-2">
                        <div class="cu-checkbox-wrapper">
                            <Checkbox id="item-demo-1" checked />
                            <Label for="item-demo-1">Item 1</Label>
                        </div>
                        <div class="cu-checkbox-wrapper">
                            <Checkbox id="item-demo-2" />
                            <Label for="item-demo-2">Item 2</Label>
                        </div>
                        <div class="cu-checkbox-wrapper">
                            <Checkbox id="item-demo-3" checked />
                            <Label for="item-demo-3">Item 3</Label>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <script>
            const selectAllDemo = document.getElementById('select-all-demo') as HTMLInputElement;
            const itemDemos = document.querySelectorAll('#item-demo-1, #item-demo-2, #item-demo-3') as NodeListOf<HTMLInputElement>;
            function updateSelectAllDemo() {
                const checked = [...itemDemos].filter(i => i.checked).length;
                selectAllDemo.checked = checked === itemDemos.length;
                selectAllDemo.indeterminate = checked > 0 && checked < itemDemos.length;
            }
            itemDemos.forEach(i => i.addEventListener('change', updateSelectAllDemo));
            selectAllDemo.addEventListener('change', () => {
                itemDemos.forEach(i => { i.checked = selectAllDemo.checked; });
            });
            updateSelectAllDemo();
        </script>

        <!-- Inline Layout -->
        <section class="space-y-3">
            <h2 id="inline-layout" class="text-lg font-semibold tracking-tight relative group">
              <a href="#inline-layout" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.inline.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.inline.description} />
            <ComponentPreview code={inlineCode}>
                <div class="flex flex-wrap gap-4">
                    <div class="cu-checkbox-wrapper">
                        <Checkbox id="opt-a-demo" />
                        <Label for="opt-a-demo">Option A</Label>
                    </div>
                    <div class="cu-checkbox-wrapper">
                        <Checkbox id="opt-b-demo" checked />
                        <Label for="opt-b-demo">Option B</Label>
                    </div>
                    <div class="cu-checkbox-wrapper">
                        <Checkbox id="opt-c-demo" />
                        <Label for="opt-c-demo">Option C</Label>
                    </div>
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>
