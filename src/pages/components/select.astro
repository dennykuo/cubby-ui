---
import Layout from "@/layouts/Layout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
// @ts-ignore - Astro component used in template
import Select from "@/components/ui/Select.astro";
import Label from "@/components/ui/Label.astro";
import FormGroup from "@/components/ui/FormGroup.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { selectPage } from "@/i18n/pages/components/select";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(selectPage, locale);

const usageCode = `<div class="cu-select-wrapper">
  <select class="cu-select">
    <option value="react">React</option>
    <option value="vue">Vue</option>
    <option value="svelte">Svelte</option>
    <option value="angular">Angular</option>
  </select>
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cu-select-icon">
    <path d="m6 9 6 6 6-6"></path>
  </svg>
</div>`.trim();

const withLabelCode = `<div class="cu-form-group">
  <label class="cu-label" for="framework">Framework</label>
  <div class="cu-select-wrapper">
    <select class="cu-select" id="framework">
      <option value="react">React</option>
      <option value="vue">Vue</option>
      <option value="svelte">Svelte</option>
      <option value="angular">Angular</option>
    </select>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cu-select-icon">
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </div>
</div>`.trim();

const placeholderCode = `<div class="cu-select-wrapper">
  <select class="cu-select">
    <option value="" disabled selected>Select a framework...</option>
    <option value="react">React</option>
    <option value="vue">Vue</option>
    <option value="svelte">Svelte</option>
  </select>
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cu-select-icon">
    <path d="m6 9 6 6 6-6"></path>
  </svg>
</div>`.trim();

const disabledCode = `<div class="cu-select-wrapper">
  <select class="cu-select" disabled>
    <option value="react">React</option>
    <option value="vue">Vue</option>
  </select>
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cu-select-icon">
    <path d="m6 9 6 6 6-6"></path>
  </svg>
</div>`.trim();
---

<Layout category={t.category} componentName="Select" title={t.title} description={t.description}>
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Select</h1>
          <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <SectionHeading id="usage" title={t.sections.usage.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-sm">
                    <Select>
                        <option value="react">React</option>
                        <option value="vue">Vue</option>
                        <option value="svelte">Svelte</option>
                        <option value="angular">Angular</option>
                    </Select>
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
          <SectionHeading id="classes" title={t.sections.classes.title} />
          <div class="cu-table-wrapper rounded-lg border border-border">
            <table class="cu-table">
              <thead class="cu-table-header">
                <tr class="cu-table-row">
                  <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                  <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                </tr>
              </thead>
              <tbody class="cu-table-body">
                <tr class="cu-table-row">
                  <td class="cu-table-cell"><code class="cu-code">cu-select-wrapper</code></td>
                  <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-select-wrapper']}</td>
                </tr>
                <tr class="cu-table-row">
                  <td class="cu-table-cell"><code class="cu-code">cu-select</code></td>
                  <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-select']}</td>
                </tr>
                <tr class="cu-table-row">
                  <td class="cu-table-cell"><code class="cu-code">cu-select-icon</code></td>
                  <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-select-icon']}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>


        <!-- With Label -->
        <section class="space-y-3">
            <SectionHeading id="with-label" title={t.sections.withLabel.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withLabel.description} />
            <ComponentPreview code={withLabelCode}>
                <div class="w-full max-w-sm">
                    <FormGroup>
                        <Label for="framework">Framework</Label>
                        <Select id="framework">
                            <option value="react">React</option>
                            <option value="vue">Vue</option>
                            <option value="svelte">Svelte</option>
                            <option value="angular">Angular</option>
                        </Select>
                    </FormGroup>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Placeholder -->
        <section class="space-y-3">
            <SectionHeading id="with-placeholder" title={t.sections.withPlaceholder.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withPlaceholder.description} />
            <ComponentPreview code={placeholderCode}>
                <div class="w-full max-w-sm">
                    <Select>
                        <option value="" disabled selected>Select a framework...</option>
                        <option value="react">React</option>
                        <option value="vue">Vue</option>
                        <option value="svelte">Svelte</option>
                    </Select>
                </div>
            </ComponentPreview>
        </section>

        <!-- Disabled -->
        <section class="space-y-3">
            <SectionHeading id="disabled" title={t.sections.disabled.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.disabled.description} />
            <ComponentPreview code={disabledCode}>
                <div class="w-full max-w-sm">
                    <Select disabled>
                        <option value="react">React</option>
                        <option value="vue">Vue</option>
                    </Select>
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>
