---
import Layout from "../../layouts/Layout.astro";
import Select from "../../components/ui/Select.astro";
import Label from "../../components/ui/Label.astro";
import FormGroup from "../../components/ui/FormGroup.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<div class="cu-select-wrapper">
  <select class="cu-select">
    <option value="react">React</option>
    <option value="vue">Vue</option>
    <option value="svelte">Svelte</option>
    <option value="angular">Angular</option>
  </select>
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cu-select-icon">
    <path d="m6 9 6 6 6-6"></path>
  </svg>
</div>`.trim();

const withLabelCode = `<div class="cu-form-group">
  <label class="cu-label" for="framework">Framework</label>
  <div class="cu-select-wrapper">
    <select class="cu-select" id="framework">
      <option value="react">React</option>
      <option value="vue">Vue</option>
      <option value="svelte">Svelte</option>
      <option value="angular">Angular</option>
    </select>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cu-select-icon">
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </div>
</div>`.trim();

const placeholderCode = `<div class="cu-select-wrapper">
  <select class="cu-select">
    <option value="" disabled selected>Select a framework...</option>
    <option value="react">React</option>
    <option value="vue">Vue</option>
    <option value="svelte">Svelte</option>
  </select>
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cu-select-icon">
    <path d="m6 9 6 6 6-6"></path>
  </svg>
</div>`.trim();

const disabledCode = `<div class="cu-select-wrapper">
  <select class="cu-select" disabled>
    <option value="react">React</option>
    <option value="vue">Vue</option>
  </select>
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cu-select-icon">
    <path d="m6 9 6 6 6-6"></path>
  </svg>
</div>`.trim();
---

<Layout category="Forms" componentName="Select" title="Select — Cubby UI">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Select</h1>
          <span class="cu-badge cu-badge-secondary">Forms</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            Displays a native select dropdown for choosing from a list of options.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
              <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Usage
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Wrap a <code class="cu-code">&lt;select&gt;</code> with <code class="cu-code">cu-select</code> inside a
                <code class="cu-code">cu-select-wrapper</code> container with a chevron icon.
            </p>
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-sm">
                    <Select>
                        <option value="react">React</option>
                        <option value="vue">Vue</option>
                        <option value="svelte">Svelte</option>
                        <option value="angular">Angular</option>
                    </Select>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Label -->
        <section class="space-y-3">
            <h2 id="with-label" class="text-lg font-semibold tracking-tight relative group">
              <a href="#with-label" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              With Label
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Pair with a <code class="cu-code">cu-label</code> for accessible form fields.
            </p>
            <ComponentPreview code={withLabelCode}>
                <div class="w-full max-w-sm">
                    <FormGroup>
                        <Label for="framework">Framework</Label>
                        <Select id="framework">
                            <option value="react">React</option>
                            <option value="vue">Vue</option>
                            <option value="svelte">Svelte</option>
                            <option value="angular">Angular</option>
                        </Select>
                    </FormGroup>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Placeholder -->
        <section class="space-y-3">
            <h2 id="with-placeholder" class="text-lg font-semibold tracking-tight relative group">
              <a href="#with-placeholder" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              With Placeholder
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use a disabled first option as a placeholder prompt.
            </p>
            <ComponentPreview code={placeholderCode}>
                <div class="w-full max-w-sm">
                    <Select>
                        <option value="" disabled selected>Select a framework...</option>
                        <option value="react">React</option>
                        <option value="vue">Vue</option>
                        <option value="svelte">Svelte</option>
                    </Select>
                </div>
            </ComponentPreview>
        </section>

        <!-- Disabled -->
        <section class="space-y-3">
            <h2 id="disabled" class="text-lg font-semibold tracking-tight relative group">
              <a href="#disabled" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Disabled
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Add the <code class="cu-code">disabled</code> attribute to prevent interaction.
            </p>
            <ComponentPreview code={disabledCode}>
                <div class="w-full max-w-sm">
                    <Select disabled>
                        <option value="react">React</option>
                        <option value="vue">Vue</option>
                    </Select>
                </div>
            </ComponentPreview>
        </section>
        <!-- Classes Reference -->
        <section class="space-y-3 mt-10">
          <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
            <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
            CSS Classes
          </h2>
          <div class="cu-table-wrapper rounded-lg border border-border">
            <table class="cu-table">
              <thead class="cu-table-header">
                <tr class="cu-table-row">
                  <th class="cu-table-head">Class</th>
                  <th class="cu-table-head">Description</th>
                </tr>
              </thead>
              <tbody class="cu-table-body">
                <tr class="cu-table-row">
                  <td class="cu-table-cell"><code class="cu-code">cu-select-wrapper</code></td>
                  <td class="cu-table-cell text-muted-foreground">Positioning container for Select and arrow icon</td>
                </tr>
                <tr class="cu-table-row">
                  <td class="cu-table-cell"><code class="cu-code">cu-select</code></td>
                  <td class="cu-table-cell text-muted-foreground">Select style with hover border, focus ring, and disabled state</td>
                </tr>
                <tr class="cu-table-row">
                  <td class="cu-table-cell"><code class="cu-code">cu-select-icon</code></td>
                  <td class="cu-table-cell text-muted-foreground">Right decorative arrow icon, absolutely positioned and non-interactive</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>
    </div>
</Layout>
