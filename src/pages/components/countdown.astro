---
import Layout from "@/layouts/Layout.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { countdownPage } from "@/i18n/pages/components/countdown";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(countdownPage, locale);

const usageCode = `<div class="cu-countdown" data-cu-countdown data-cu-countdown-target="2026-12-31T00:00:00">
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">120</span>
    <span class="cu-countdown-label">Days</span>
  </div>
  <span class="cu-countdown-separator">:</span>
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">08</span>
    <span class="cu-countdown-label">Hours</span>
  </div>
  <span class="cu-countdown-separator">:</span>
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">34</span>
    <span class="cu-countdown-label">Minutes</span>
  </div>
  <span class="cu-countdown-separator">:</span>
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">52</span>
    <span class="cu-countdown-label">Seconds</span>
  </div>
</div>`.trim();

const sizesCode = `<!-- Small -->
<div class="cu-countdown cu-countdown-sm">
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">12</span>
    <span class="cu-countdown-label">Days</span>
  </div>
  <span class="cu-countdown-separator">:</span>
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">05</span>
    <span class="cu-countdown-label">Hours</span>
  </div>
  <span class="cu-countdown-separator">:</span>
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">30</span>
    <span class="cu-countdown-label">Min</span>
  </div>
  <span class="cu-countdown-separator">:</span>
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">15</span>
    <span class="cu-countdown-label">Sec</span>
  </div>
</div>

<!-- Default -->
<div class="cu-countdown">
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">12</span>
    <span class="cu-countdown-label">Days</span>
  </div>
  <span class="cu-countdown-separator">:</span>
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">05</span>
    <span class="cu-countdown-label">Hours</span>
  </div>
  <span class="cu-countdown-separator">:</span>
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">30</span>
    <span class="cu-countdown-label">Min</span>
  </div>
  <span class="cu-countdown-separator">:</span>
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">15</span>
    <span class="cu-countdown-label">Sec</span>
  </div>
</div>

<!-- Large -->
<div class="cu-countdown cu-countdown-lg">
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">12</span>
    <span class="cu-countdown-label">Days</span>
  </div>
  <span class="cu-countdown-separator">:</span>
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">05</span>
    <span class="cu-countdown-label">Hours</span>
  </div>
  <span class="cu-countdown-separator">:</span>
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">30</span>
    <span class="cu-countdown-label">Min</span>
  </div>
  <span class="cu-countdown-separator">:</span>
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">15</span>
    <span class="cu-countdown-label">Sec</span>
  </div>
</div>`.trim();

const flushCode = `<div class="cu-countdown cu-countdown-flush">
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">07</span>
    <span class="cu-countdown-label">Days</span>
  </div>
  <span class="cu-countdown-separator">:</span>
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">14</span>
    <span class="cu-countdown-label">Hours</span>
  </div>
  <span class="cu-countdown-separator">:</span>
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">22</span>
    <span class="cu-countdown-label">Min</span>
  </div>
  <span class="cu-countdown-separator">:</span>
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">48</span>
    <span class="cu-countdown-label">Sec</span>
  </div>
</div>`.trim();

const withSeparatorCode = `<div class="cu-countdown">
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">30</span>
    <span class="cu-countdown-label">Days</span>
  </div>
  <span class="cu-countdown-separator">:</span>
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">12</span>
    <span class="cu-countdown-label">Hours</span>
  </div>
  <span class="cu-countdown-separator">:</span>
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">45</span>
    <span class="cu-countdown-label">Minutes</span>
  </div>
  <span class="cu-countdown-separator">:</span>
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">09</span>
    <span class="cu-countdown-label">Seconds</span>
  </div>
</div>`.trim();

const completeCode = `<div class="cu-countdown">
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">00</span>
    <span class="cu-countdown-label">Days</span>
  </div>
  <span class="cu-countdown-separator">:</span>
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">00</span>
    <span class="cu-countdown-label">Hours</span>
  </div>
  <span class="cu-countdown-separator">:</span>
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">00</span>
    <span class="cu-countdown-label">Min</span>
  </div>
  <span class="cu-countdown-separator">:</span>
  <div class="cu-countdown-segment">
    <span class="cu-countdown-value">00</span>
    <span class="cu-countdown-label">Sec</span>
  </div>
</div>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Countdown">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Countdown</h1>
            <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode} />
        </section>

        <section class="space-y-3">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.classes.title}
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        {Object.entries(t.classDescriptions).map(([cls, desc]) => (
                            <tr class="cu-table-row">
                                <td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
                                <td class="cu-table-cell text-muted-foreground">{desc}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>

        <section class="space-y-3">
            <h2 id="sizes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#sizes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.sizes.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.sizes.description} />
            <ComponentPreview code={sizesCode} />
        </section>

        <section class="space-y-3">
            <h2 id="flush" class="text-lg font-semibold tracking-tight relative group">
                <a href="#flush" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.flush.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.flush.description} />
            <ComponentPreview code={flushCode} />
        </section>

        <section class="space-y-3">
            <h2 id="with-separator" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-separator" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.withSeparator.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withSeparator.description} />
            <ComponentPreview code={withSeparatorCode} />
        </section>

        <section class="space-y-3">
            <h2 id="complete" class="text-lg font-semibold tracking-tight relative group">
                <a href="#complete" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.complete.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.complete.description} />
            <ComponentPreview code={completeCode} />
        </section>
    </div>
</Layout>
