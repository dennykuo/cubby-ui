---
import Layout from "@/layouts/Layout.astro";
// @ts-ignore - Astro component used in template
import CheckboxGroup from "@/components/ui/CheckboxGroup.astro";
import Checkbox from "@/components/ui/Checkbox.astro";
import Label from "@/components/ui/Label.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { checkboxGroupPage } from "@/i18n/pages/components/checkbox-group";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(checkboxGroupPage, locale);

const usageCode = `<div class="cu-checkbox-group" data-cu-checkbox-group>
  <label class="cu-checkbox-group-label">Notifications</label>
  <div class="cu-checkbox-group-items">
    <div class="cu-checkbox-wrapper">
      <input type="checkbox" class="cu-checkbox" id="cg-email" data-cu-checkbox-group-item />
      <label class="cu-label" for="cg-email">Email</label>
    </div>
    <div class="cu-checkbox-wrapper">
      <input type="checkbox" class="cu-checkbox" id="cg-sms" data-cu-checkbox-group-item />
      <label class="cu-label" for="cg-sms">SMS</label>
    </div>
    <div class="cu-checkbox-wrapper">
      <input type="checkbox" class="cu-checkbox" id="cg-push" data-cu-checkbox-group-item />
      <label class="cu-label" for="cg-push">Push</label>
    </div>
  </div>
</div>`.trim();

const selectAllCode = `<div class="cu-checkbox-group" data-cu-checkbox-group>
  <label class="cu-checkbox-group-label">Permissions</label>
  <div class="cu-checkbox-wrapper cu-checkbox-group-selectall">
    <input type="checkbox" class="cu-checkbox" id="cg-all" data-cu-checkbox-group-selectall />
    <label class="cu-label" for="cg-all">Select all</label>
  </div>
  <div class="cu-checkbox-group-items">
    <div class="cu-checkbox-wrapper">
      <input type="checkbox" class="cu-checkbox" id="cg-read" data-cu-checkbox-group-item />
      <label class="cu-label" for="cg-read">Read</label>
    </div>
    <div class="cu-checkbox-wrapper">
      <input type="checkbox" class="cu-checkbox" id="cg-write" data-cu-checkbox-group-item />
      <label class="cu-label" for="cg-write">Write</label>
    </div>
    <div class="cu-checkbox-wrapper">
      <input type="checkbox" class="cu-checkbox" id="cg-delete" data-cu-checkbox-group-item />
      <label class="cu-label" for="cg-delete">Delete</label>
    </div>
  </div>
</div>`.trim();

const preselectedCode = `<div class="cu-checkbox-group" data-cu-checkbox-group>
  <label class="cu-checkbox-group-label">Features</label>
  <div class="cu-checkbox-wrapper cu-checkbox-group-selectall">
    <input type="checkbox" class="cu-checkbox" id="cg-feat-all" data-cu-checkbox-group-selectall />
    <label class="cu-label" for="cg-feat-all">Select all</label>
  </div>
  <div class="cu-checkbox-group-items">
    <div class="cu-checkbox-wrapper">
      <input type="checkbox" class="cu-checkbox" id="cg-analytics" checked data-cu-checkbox-group-item />
      <label class="cu-label" for="cg-analytics">Analytics</label>
    </div>
    <div class="cu-checkbox-wrapper">
      <input type="checkbox" class="cu-checkbox" id="cg-reports" data-cu-checkbox-group-item />
      <label class="cu-label" for="cg-reports">Reports</label>
    </div>
    <div class="cu-checkbox-wrapper">
      <input type="checkbox" class="cu-checkbox" id="cg-export" checked data-cu-checkbox-group-item />
      <label class="cu-label" for="cg-export">Export</label>
    </div>
  </div>
</div>`.trim();

const disabledCode = `<div class="cu-checkbox-group" data-cu-checkbox-group>
  <label class="cu-checkbox-group-label">Options</label>
  <div class="cu-checkbox-wrapper cu-checkbox-group-selectall">
    <input type="checkbox" class="cu-checkbox" id="cg-dis-all" data-cu-checkbox-group-selectall disabled />
    <label class="cu-label" for="cg-dis-all">Select all</label>
  </div>
  <div class="cu-checkbox-group-items">
    <div class="cu-checkbox-wrapper">
      <input type="checkbox" class="cu-checkbox" id="cg-opt1" checked disabled data-cu-checkbox-group-item />
      <label class="cu-label" for="cg-opt1">Option A</label>
    </div>
    <div class="cu-checkbox-wrapper">
      <input type="checkbox" class="cu-checkbox" id="cg-opt2" disabled data-cu-checkbox-group-item />
      <label class="cu-label" for="cg-opt2">Option B</label>
    </div>
  </div>
</div>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Checkbox Group">
  <div class="space-y-3">
    <div class="flex items-center gap-3">
      <h1 class="text-3xl font-bold tracking-tight">Checkbox Group</h1>
      <span class="cu-badge cu-badge-secondary">{t.category}</span>
    </div>
    <p class="text-base text-muted-foreground leading-relaxed">
      {t.description}
    </p>
  </div>

  <div class="mt-10 space-y-10">
    <!-- Usage -->
    <section class="space-y-3">
      <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
        <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        {t.sections.usage.title}
      </h2>
      <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
      <ComponentPreview code={usageCode}>
        <CheckboxGroup>
          <label class="cu-checkbox-group-label">Notifications</label>
          <div class="cu-checkbox-group-items">
            <div class="cu-checkbox-wrapper">
              <Checkbox id="cg-email" data-cu-checkbox-group-item />
              <Label for="cg-email">Email</Label>
            </div>
            <div class="cu-checkbox-wrapper">
              <Checkbox id="cg-sms" data-cu-checkbox-group-item />
              <Label for="cg-sms">SMS</Label>
            </div>
            <div class="cu-checkbox-wrapper">
              <Checkbox id="cg-push" data-cu-checkbox-group-item />
              <Label for="cg-push">Push</Label>
            </div>
          </div>
        </CheckboxGroup>
      </ComponentPreview>
    </section>

    <!-- Select All -->
    <section class="space-y-3">
      <h2 id="select-all" class="text-lg font-semibold tracking-tight relative group">
        <a href="#select-all" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        {t.sections.selectAll.title}
      </h2>
      <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.selectAll.description} />
      <ComponentPreview code={selectAllCode}>
        <CheckboxGroup>
          <label class="cu-checkbox-group-label">Permissions</label>
          <div class="cu-checkbox-wrapper cu-checkbox-group-selectall">
            <Checkbox id="cg-all" data-cu-checkbox-group-selectall />
            <Label for="cg-all">Select all</Label>
          </div>
          <div class="cu-checkbox-group-items">
            <div class="cu-checkbox-wrapper">
              <Checkbox id="cg-read" data-cu-checkbox-group-item />
              <Label for="cg-read">Read</Label>
            </div>
            <div class="cu-checkbox-wrapper">
              <Checkbox id="cg-write" data-cu-checkbox-group-item />
              <Label for="cg-write">Write</Label>
            </div>
            <div class="cu-checkbox-wrapper">
              <Checkbox id="cg-delete" data-cu-checkbox-group-item />
              <Label for="cg-delete">Delete</Label>
            </div>
          </div>
        </CheckboxGroup>
      </ComponentPreview>
    </section>

    <!-- Pre-selected -->
    <section class="space-y-3">
      <h2 id="pre-selected" class="text-lg font-semibold tracking-tight relative group">
        <a href="#pre-selected" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        {t.sections.preSelected.title}
      </h2>
      <p class="text-base text-muted-foreground leading-relaxed">
        {t.sections.preSelected.description}
      </p>
      <ComponentPreview code={preselectedCode}>
        <CheckboxGroup>
          <label class="cu-checkbox-group-label">Features</label>
          <div class="cu-checkbox-wrapper cu-checkbox-group-selectall">
            <Checkbox id="cg-feat-all" data-cu-checkbox-group-selectall />
            <Label for="cg-feat-all">Select all</Label>
          </div>
          <div class="cu-checkbox-group-items">
            <div class="cu-checkbox-wrapper">
              <Checkbox id="cg-analytics" checked data-cu-checkbox-group-item />
              <Label for="cg-analytics">Analytics</Label>
            </div>
            <div class="cu-checkbox-wrapper">
              <Checkbox id="cg-reports" data-cu-checkbox-group-item />
              <Label for="cg-reports">Reports</Label>
            </div>
            <div class="cu-checkbox-wrapper">
              <Checkbox id="cg-export" checked data-cu-checkbox-group-item />
              <Label for="cg-export">Export</Label>
            </div>
          </div>
        </CheckboxGroup>
      </ComponentPreview>
    </section>

    <!-- Disabled -->
    <section class="space-y-3">
      <h2 id="disabled" class="text-lg font-semibold tracking-tight relative group">
        <a href="#disabled" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        {t.sections.disabled.title}
      </h2>
      <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.disabled.description} />
      <ComponentPreview code={disabledCode}>
        <CheckboxGroup>
          <label class="cu-checkbox-group-label">Options</label>
          <div class="cu-checkbox-wrapper cu-checkbox-group-selectall">
            <Checkbox id="cg-dis-all" data-cu-checkbox-group-selectall disabled />
            <Label for="cg-dis-all">Select all</Label>
          </div>
          <div class="cu-checkbox-group-items">
            <div class="cu-checkbox-wrapper">
              <Checkbox id="cg-opt1" checked disabled data-cu-checkbox-group-item />
              <Label for="cg-opt1">Option A</Label>
            </div>
            <div class="cu-checkbox-wrapper">
              <Checkbox id="cg-opt2" disabled data-cu-checkbox-group-item />
              <Label for="cg-opt2">Option B</Label>
            </div>
          </div>
        </CheckboxGroup>
      </ComponentPreview>
    </section>

    <!-- Classes Reference -->
    <section class="space-y-3 mt-10">
      <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
        <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        {t.sections.classes.title}
      </h2>
      <div class="cu-table-wrapper rounded-lg border border-border">
        <table class="cu-table">
          <thead class="cu-table-header">
            <tr class="cu-table-row">
              <th class="cu-table-head">{t.sections.classes.classLabel}</th>
              <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
            </tr>
          </thead>
          <tbody class="cu-table-body">
            {Object.entries(t.classDescriptions).map(([cls, desc]) => (
              <tr class="cu-table-row">
                <td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
                <td class="cu-table-cell text-muted-foreground">{desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Layout>
