const pillsCode = `<div class="cu-tabs" data-cu-tabs>
  <div class="cu-tabs-list-pills">
    <button class="cu-tabs-trigger cu-tabs-trigger-active" data-cu-tabs-trigger="all">All</button>
    <button class="cu-tabs-trigger" data-cu-tabs-trigger="active">Active</button>
    <button class="cu-tabs-trigger" data-cu-tabs-trigger="archived">Archived</button>
  </div>
