---
import Layout from "@/layouts/Layout.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { tabsPage } from "@/i18n/pages/components/tabs";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(tabsPage, locale);

const usageCode = `<div class="cu-tabs" data-cu-tabs>
  <div class="cu-tabs-list">
    <button class="cu-tabs-trigger cu-tabs-trigger-active" data-cu-tabs-trigger="account">Account</button>
    <button class="cu-tabs-trigger" data-cu-tabs-trigger="password">Password</button>
  </div>
  <div class="cu-tabs-content" data-cu-tabs-content="account">
    <p class="text-sm text-muted-foreground">Make changes to your account here.</p>
  </div>
  <div class="cu-tabs-content" data-cu-tabs-content="password" hidden>
    <p class="text-sm text-muted-foreground">Change your password here.</p>
  </div>
</div>

<script>
  document.querySelectorAll("[data-cu-tabs]").forEach((tabs) => {
    const triggers = tabs.querySelectorAll("[data-cu-tabs-trigger]");
    const contents = tabs.querySelectorAll("[data-cu-tabs-content]");
    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const value = trigger.getAttribute("data-cu-tabs-trigger");
        triggers.forEach((t) => t.classList.remove("cu-tabs-trigger-active"));
        trigger.classList.add("cu-tabs-trigger-active");
        contents.forEach((c) => {
          c.hidden = c.getAttribute("data-cu-tabs-content") !== value;
        });
      });
    });
  });
\x3c/script>`.trim();

const withContentCode = `<div class="cu-tabs" data-cu-tabs>
  <div class="cu-tabs-list">
    <button class="cu-tabs-trigger cu-tabs-trigger-active" data-cu-tabs-trigger="overview">Overview</button>
    <button class="cu-tabs-trigger" data-cu-tabs-trigger="analytics">Analytics</button>
    <button class="cu-tabs-trigger" data-cu-tabs-trigger="reports">Reports</button>
  </div>
  <div class="cu-tabs-content" data-cu-tabs-content="overview">
    <div class="cu-card">
      <div class="cu-card-header">
        <h3 class="cu-card-title">Overview</h3>
        <p class="cu-card-description">A summary of your account activity.</p>
      </div>
      <div class="cu-card-content">
        <p class="text-sm">Your account is in good standing.</p>
      </div>
    </div>
  </div>
  <div class="cu-tabs-content" data-cu-tabs-content="analytics" hidden>
    <div class="cu-card">
      <div class="cu-card-header">
        <h3 class="cu-card-title">Analytics</h3>
        <p class="cu-card-description">View your analytics data.</p>
      </div>
      <div class="cu-card-content">
        <p class="text-sm">Analytics content goes here.</p>
      </div>
    </div>
  </div>
  <div class="cu-tabs-content" data-cu-tabs-content="reports" hidden>
    <div class="cu-card">
      <div class="cu-card-header">
        <h3 class="cu-card-title">Reports</h3>
        <p class="cu-card-description">Generate and view reports.</p>
      </div>
      <div class="cu-card-content">
        <p class="text-sm">Reports content goes here.</p>
      </div>
    </div>
  </div>
</div>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Tabs">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Tabs</h1>
          <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            {t.description}
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
              <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-md">
                    <div class="cu-tabs" data-cu-tabs>
                        <div class="cu-tabs-list">
                            <button class="cu-tabs-trigger cu-tabs-trigger-active" data-cu-tabs-trigger="account">Account</button>
                            <button class="cu-tabs-trigger" data-cu-tabs-trigger="password">Password</button>
                        </div>
                        <div class="cu-tabs-content" data-cu-tabs-content="account">
                            <p class="text-sm text-muted-foreground">Make changes to your account here.</p>
                        </div>
                        <div class="cu-tabs-content" data-cu-tabs-content="password" hidden>
                            <p class="text-sm text-muted-foreground">Change your password here.</p>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.classes.title}
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-tabs</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-tabs']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-tabs-list</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-tabs-list']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-tabs-trigger</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-tabs-trigger']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-tabs-trigger-active</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-tabs-trigger-active']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-tabs-content</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-tabs-content']}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>


        <!-- With Content -->
        <section class="space-y-3">
            <h2 id="with-content" class="text-lg font-semibold tracking-tight relative group">
              <a href="#with-content" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.withContent.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                {t.sections.withContent.description}
            </p>
            <ComponentPreview code={withContentCode}>
                <div class="w-full max-w-lg">
                    <div class="cu-tabs" data-cu-tabs>
                        <div class="cu-tabs-list">
                            <button class="cu-tabs-trigger cu-tabs-trigger-active" data-cu-tabs-trigger="overview2">Overview</button>
                            <button class="cu-tabs-trigger" data-cu-tabs-trigger="analytics2">Analytics</button>
                            <button class="cu-tabs-trigger" data-cu-tabs-trigger="reports2">Reports</button>
                        </div>
                        <div class="cu-tabs-content" data-cu-tabs-content="overview2">
                            <div class="cu-card">
                                <div class="cu-card-header">
                                    <h3 class="cu-card-title">Overview</h3>
                                    <p class="cu-card-description">A summary of your account activity.</p>
                                </div>
                                <div class="cu-card-content">
                                    <p class="text-sm">Your account is in good standing.</p>
                                </div>
                            </div>
                        </div>
                        <div class="cu-tabs-content" data-cu-tabs-content="analytics2" hidden>
                            <div class="cu-card">
                                <div class="cu-card-header">
                                    <h3 class="cu-card-title">Analytics</h3>
                                    <p class="cu-card-description">View your analytics data.</p>
                                </div>
                                <div class="cu-card-content">
                                    <p class="text-sm">Analytics content goes here.</p>
                                </div>
                            </div>
                        </div>
                        <div class="cu-tabs-content" data-cu-tabs-content="reports2" hidden>
                            <div class="cu-card">
                                <div class="cu-card-header">
                                    <h3 class="cu-card-title">Reports</h3>
                                    <p class="cu-card-description">Generate and view reports.</p>
                                </div>
                                <div class="cu-card-content">
                                    <p class="text-sm">Reports content goes here.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>
