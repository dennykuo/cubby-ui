---
import Layout from "@/layouts/Layout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { tabsPage } from "@/i18n/pages/components/tabs";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(tabsPage, locale);
const SO = "<" + "script>";
const SC = "</" + "script>";

const usageCode = `<div class="cu-tabs" data-cu-tabs>
  <div class="cu-tabs-list">
    <button class="cu-tabs-trigger cu-tabs-trigger-active" data-cu-tabs-trigger="account">Account</button>
    <button class="cu-tabs-trigger" data-cu-tabs-trigger="password">Password</button>
  </div>
  <div class="cu-tabs-content" data-cu-tabs-content="account">
    <p class="text-sm text-muted-foreground">Make changes to your account here.</p>
  </div>
  <div class="cu-tabs-content" data-cu-tabs-content="password" hidden>
    <p class="text-sm text-muted-foreground">Change your password here.</p>
  </div>
</div>

${SO}
  document.querySelectorAll("[data-cu-tabs]").forEach((tabs) => {
    const triggers = tabs.querySelectorAll("[data-cu-tabs-trigger]");
    const contents = tabs.querySelectorAll("[data-cu-tabs-content]");
    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const value = trigger.getAttribute("data-cu-tabs-trigger");
        triggers.forEach((t) => t.classList.remove("cu-tabs-trigger-active"));
        trigger.classList.add("cu-tabs-trigger-active");
        contents.forEach((c) => {
          c.hidden = c.getAttribute("data-cu-tabs-content") !== value;
        });
      });
    });
  });
${SC}`.trim();

const withContentCode = `<div class="cu-tabs" data-cu-tabs>
  <div class="cu-tabs-list">
    <button class="cu-tabs-trigger cu-tabs-trigger-active" data-cu-tabs-trigger="overview">Overview</button>
    <button class="cu-tabs-trigger" data-cu-tabs-trigger="analytics">Analytics</button>
    <button class="cu-tabs-trigger" data-cu-tabs-trigger="reports">Reports</button>
  </div>
  <div class="cu-tabs-content" data-cu-tabs-content="overview">
    <div class="cu-card">
      <div class="cu-card-header">
        <h3 class="cu-card-title">Overview</h3>
        <p class="cu-card-description">A summary of your account activity.</p>
      </div>
      <div class="cu-card-content">
        <p class="text-sm">Your account is in good standing.</p>
      </div>
    </div>
  </div>
  <div class="cu-tabs-content" data-cu-tabs-content="analytics" hidden>
    <div class="cu-card">
      <div class="cu-card-header">
        <h3 class="cu-card-title">Analytics</h3>
        <p class="cu-card-description">View your analytics data.</p>
      </div>
      <div class="cu-card-content">
        <p class="text-sm">Analytics content goes here.</p>
      </div>
    </div>
  </div>
  <div class="cu-tabs-content" data-cu-tabs-content="reports" hidden>
    <div class="cu-card">
      <div class="cu-card-header">
        <h3 class="cu-card-title">Reports</h3>
        <p class="cu-card-description">Generate and view reports.</p>
      </div>
      <div class="cu-card-content">
        <p class="text-sm">Reports content goes here.</p>
      </div>
    </div>
  </div>
</div>`.trim();

const withIconsCode = `<div class="cu-tabs" data-cu-tabs>
  <div class="cu-tabs-list">
    <button class="cu-tabs-trigger cu-tabs-trigger-active" data-cu-tabs-trigger="profile">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      Profile
    </button>
    <button class="cu-tabs-trigger" data-cu-tabs-trigger="settings">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
      Settings
    </button>
    <button class="cu-tabs-trigger" data-cu-tabs-trigger="notifications">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-1.5"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
      Notifications
    </button>
  </div>
  <div class="cu-tabs-content" data-cu-tabs-content="profile">
    <p class="text-sm text-muted-foreground">Manage your profile information.</p>
  </div>
  <div class="cu-tabs-content" data-cu-tabs-content="settings" hidden>
    <p class="text-sm text-muted-foreground">Configure your application settings.</p>
  </div>
  <div class="cu-tabs-content" data-cu-tabs-content="notifications" hidden>
    <p class="text-sm text-muted-foreground">Set your notification preferences.</p>
  </div>
</div>`.trim();

const underlineCode = `<div class="cu-tabs" data-cu-tabs>
  <div class="cu-tabs-list-underline">
    <button class="cu-tabs-trigger cu-tabs-trigger-active" data-cu-tabs-trigger="general">General</button>
    <button class="cu-tabs-trigger" data-cu-tabs-trigger="billing">Billing</button>
    <button class="cu-tabs-trigger" data-cu-tabs-trigger="team">Team</button>
