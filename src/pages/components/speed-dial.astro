---
import Layout from "@/layouts/Layout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { speedDialPage } from "@/i18n/pages/components/speed-dial";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(speedDialPage, locale);

const plusSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>`;
const editSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>`;
const shareSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>`;
const trashSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>`;

const usageCode = `<div style="display: flex; justify-content: center; align-items: flex-end; height: 120px; padding-bottom: 16px;">
  <div class="cu-speed-dial" style="position: relative;" data-cu-speed-dial>
    <div class="cu-speed-dial-actions" data-cu-speed-dial-actions>
      <div class="cu-speed-dial-action">
        <button class="cu-speed-dial-action-btn" aria-label="Edit">${editSvg}</button>
      </div>
      <div class="cu-speed-dial-action">
        <button class="cu-speed-dial-action-btn" aria-label="Share">${shareSvg}</button>
      </div>
      <div class="cu-speed-dial-action">
        <button class="cu-speed-dial-action-btn" aria-label="Delete">${trashSvg}</button>
      </div>
    </div>
    <button class="cu-speed-dial-trigger" data-cu-speed-dial-trigger aria-label="Actions">${plusSvg}</button>
  </div>
</div>`.trim();

const expandedCode = `<div style="display: flex; justify-content: center; align-items: flex-end; height: 260px; padding-bottom: 16px;">
  <div class="cu-speed-dial" style="position: relative;" data-cu-speed-dial>
    <div class="cu-speed-dial-actions" data-cu-speed-dial-actions data-cu-open>
      <div class="cu-speed-dial-action">
        <button class="cu-speed-dial-action-btn" aria-label="Edit">${editSvg}</button>
      </div>
      <div class="cu-speed-dial-action">
        <button class="cu-speed-dial-action-btn" aria-label="Share">${shareSvg}</button>
      </div>
      <div class="cu-speed-dial-action">
        <button class="cu-speed-dial-action-btn" aria-label="Delete">${trashSvg}</button>
      </div>
    </div>
    <button class="cu-speed-dial-trigger" data-cu-speed-dial-trigger aria-expanded="true" aria-label="Actions">${plusSvg}</button>
  </div>
</div>`.trim();

const positionsCode = `<div style="position: relative; height: 250px;">
  <!-- Bottom Right -->
  <div class="cu-speed-dial cu-speed-dial-bottom-right" style="position: absolute;" data-cu-speed-dial>
    <div class="cu-speed-dial-actions" data-cu-speed-dial-actions>
      <div class="cu-speed-dial-action">
        <button class="cu-speed-dial-action-btn" aria-label="Edit">${editSvg}</button>
      </div>
      <div class="cu-speed-dial-action">
        <button class="cu-speed-dial-action-btn" aria-label="Share">${shareSvg}</button>
      </div>
    </div>
    <button class="cu-speed-dial-trigger" data-cu-speed-dial-trigger aria-label="Actions">${plusSvg}</button>
  </div>

  <!-- Bottom Left -->
  <div class="cu-speed-dial cu-speed-dial-bottom-left" style="position: absolute;" data-cu-speed-dial>
    <div class="cu-speed-dial-actions" data-cu-speed-dial-actions>
      <div class="cu-speed-dial-action">
        <button class="cu-speed-dial-action-btn" aria-label="Edit">${editSvg}</button>
      </div>
      <div class="cu-speed-dial-action">
        <button class="cu-speed-dial-action-btn" aria-label="Share">${shareSvg}</button>
      </div>
    </div>
    <button class="cu-speed-dial-trigger" data-cu-speed-dial-trigger aria-label="Actions">${plusSvg}</button>
  </div>
</div>`.trim();

const withLabelsCode = `<div style="display: flex; justify-content: center; align-items: flex-end; height: 280px; padding-bottom: 16px;">
  <div class="cu-speed-dial" style="position: relative;" data-cu-speed-dial>
    <div class="cu-speed-dial-actions" data-cu-speed-dial-actions data-cu-open>
      <div class="cu-speed-dial-action">
        <span class="cu-speed-dial-action-label">Edit</span>
        <button class="cu-speed-dial-action-btn" aria-label="Edit">${editSvg}</button>
      </div>
      <div class="cu-speed-dial-action">
        <span class="cu-speed-dial-action-label">Share</span>
        <button class="cu-speed-dial-action-btn" aria-label="Share">${shareSvg}</button>
      </div>
      <div class="cu-speed-dial-action">
        <span class="cu-speed-dial-action-label">Delete</span>
        <button class="cu-speed-dial-action-btn" aria-label="Delete">${trashSvg}</button>
      </div>
    </div>
    <button class="cu-speed-dial-trigger" data-cu-speed-dial-trigger aria-expanded="true" aria-label="Actions">${plusSvg}</button>
  </div>
</div>`.trim();

const smallCode = `<div style="display: flex; justify-content: center; align-items: flex-end; height: 120px; padding-bottom: 16px;">
  <div class="cu-speed-dial cu-speed-dial-sm" style="position: relative;" data-cu-speed-dial>
    <div class="cu-speed-dial-actions" data-cu-speed-dial-actions>
      <div class="cu-speed-dial-action">
        <button class="cu-speed-dial-action-btn" aria-label="Edit">${editSvg}</button>
      </div>
      <div class="cu-speed-dial-action">
        <button class="cu-speed-dial-action-btn" aria-label="Share">${shareSvg}</button>
      </div>
      <div class="cu-speed-dial-action">
        <button class="cu-speed-dial-action-btn" aria-label="Delete">${trashSvg}</button>
      </div>
    </div>
    <button class="cu-speed-dial-trigger" data-cu-speed-dial-trigger aria-label="Actions">${plusSvg}</button>
  </div>
</div>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Speed Dial" description={t.description}>
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Speed Dial</h1>
            <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <section class="space-y-3">
            <SectionHeading id="usage" title={t.sections.usage.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="classes" title={t.sections.classes.title} />
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        {Object.entries(t.classDescriptions).map(([cls, desc]) => (
                            <tr class="cu-table-row">
                                <td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
                                <td class="cu-table-cell text-muted-foreground">{desc}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>

        <section class="space-y-3">
            <SectionHeading id="expanded" title={t.sections.expanded.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.expanded.description} />
            <ComponentPreview code={expandedCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="positions" title={t.sections.positions.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.positions.description} />
            <ComponentPreview code={positionsCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="with-labels" title={t.sections.withLabels.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withLabels.description} />
            <ComponentPreview code={withLabelsCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="small" title={t.sections.small.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.small.description} />
            <ComponentPreview code={smallCode} />
        </section>
    </div>
</Layout>
