const userMenuCode = `<div class="cu-dropdown" data-cu-dropdown>
  <button class="flex items-center gap-2 rounded-full border border-border px-1.5 py-1 pr-3 text-sm hover:bg-muted/60 transition-colors" data-cu-dropdown-trigger>
    <div class="cu-avatar cu-avatar-sm">
      <img class="cu-avatar-image" src="https://i.pravatar.cc/32?u=jane" alt="Jane" />
      <span class="cu-avatar-fallback">JD</span>
