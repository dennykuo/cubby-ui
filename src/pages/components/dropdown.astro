---

<Layout title={t.title} category={t.category} componentName="Dropdown Menu">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Dropdown Menu</h1>
            <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            {t.description}
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <SectionHeading id="usage" title={t.sections.usage.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <div class="cu-dropdown" data-cu-dropdown>
                    <button class="cu-button cu-button-outline cu-button-md" data-cu-dropdown-trigger>
                        Open Menu
                    </button>
                    <div class="cu-dropdown-content" data-cu-dropdown-content hidden>
                        <div class="cu-dropdown-item">Profile</div>
                        <div class="cu-dropdown-item">Settings</div>
                        <div class="cu-dropdown-item">Log out</div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3">
            <SectionHeading id="classes" title={t.sections.classes.title} />
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-dropdown</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-dropdown']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-dropdown-content</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-dropdown-content']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-dropdown-content-wide</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-dropdown-content-wide']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-dropdown-item</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-dropdown-item']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-dropdown-item-danger</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-dropdown-item-danger']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-dropdown-label</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-dropdown-label']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-dropdown-separator</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-dropdown-separator']}</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-dropdown-shortcut</code></td>
                            <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-dropdown-shortcut']}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>


        <!-- With Labels and Separators -->
        <section class="space-y-3">
            <SectionHeading id="with-labels-and-separators" title={t.sections.withLabelsAndSeparators.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withLabelsAndSeparators.description} />
            <ComponentPreview code={withLabelsCode}>
                <div class="cu-dropdown" data-cu-dropdown>
                    <button class="cu-button cu-button-outline cu-button-md" data-cu-dropdown-trigger>
                        Options
