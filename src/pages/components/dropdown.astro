<Layout title="Dropdown Menu — Cubby UI" category="Overlay" componentName="Dropdown Menu">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Dropdown Menu</h1>
            <span class="cu-badge cu-badge-secondary">Overlay</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            Displays a menu to the user — such as a set of actions or functions — triggered by a button.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight flex items-center gap-2 group">
                <a href="#usage" class="text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Usage
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">data-cu-dropdown</code> on the wrapper,
                <code class="cu-code">data-cu-dropdown-trigger</code> on the button, and
                <code class="cu-code">data-cu-dropdown-content</code> on the menu.
                The <code class="cu-code">&lt;script&gt;</code> handles click toggle, outside click, and Escape key.
            </p>
            <ComponentPreview code={usageCode}>
                <div class="cu-dropdown" data-cu-dropdown>
                    <button class="cu-button cu-button-outline cu-button-md" data-cu-dropdown-trigger>
                        Open Menu
                    </button>
                    <div class="cu-dropdown-content" data-cu-dropdown-content hidden>
                        <div class="cu-dropdown-item">Profile</div>
                        <div class="cu-dropdown-item">Settings</div>
                        <div class="cu-dropdown-item">Log out</div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Labels and Separators -->
        <section class="space-y-3">
            <h2 id="with-labels-and-separators" class="text-lg font-semibold tracking-tight flex items-center gap-2 group">
                <a href="#with-labels-and-separators" class="text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                With Labels and Separators
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Add <code class="cu-code">cu-dropdown-label</code> for section titles and
                <code class="cu-code">cu-dropdown-separator</code> for dividers.
            </p>
            <ComponentPreview code={withLabelsCode}>
                <div class="cu-dropdown" data-cu-dropdown>
                    <button class="cu-button cu-button-outline cu-button-md" data-cu-dropdown-trigger>
                        Options
