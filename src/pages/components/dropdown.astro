---
import Layout from "../../layouts/Layout.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<div class="cu-dropdown" data-cu-dropdown>
  <button class="cu-button cu-button-outline cu-button-md" data-cu-dropdown-trigger>
    Open Menu
  </button>
  <div class="cu-dropdown-content" data-cu-dropdown-content hidden>
    <div class="cu-dropdown-item">Profile</div>
    <div class="cu-dropdown-item">Settings</div>
    <div class="cu-dropdown-item">Log out</div>
  </div>
</div>

<script>
  document.querySelectorAll("[data-cu-dropdown]").forEach((dropdown) => {
    const trigger = dropdown.querySelector("[data-cu-dropdown-trigger]");
    const content = dropdown.querySelector("[data-cu-dropdown-content]");
    trigger?.addEventListener("click", () => {
      content?.toggleAttribute("hidden");
    });
    document.addEventListener("click", (e) => {
      if (!dropdown.contains(e.target)) content?.setAttribute("hidden", "");
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") content?.setAttribute("hidden", "");
    });
  });
</script>`.trim();

