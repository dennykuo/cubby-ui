                            Profile
                        </div>
                        <div class="cu-dropdown-item">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 opacity-60"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                            Messages
                        </div>
                        <div class="cu-dropdown-item">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 opacity-60"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
                            Settings
                        </div>
                        <div class="cu-dropdown-separator"></div>
                        <div class="cu-dropdown-item">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 opacity-60"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
                            Log out
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Shortcuts -->
        <section class="space-y-3">
            <SectionHeading id="with-shortcuts" title={t.sections.withShortcuts.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withShortcuts.description} />
            <ComponentPreview code={withShortcutsCode}>
                <div class="cu-dropdown" data-cu-dropdown>
                    <button class="cu-button cu-button-outline cu-button-md" data-cu-dropdown-trigger>
                        Edit
                    </button>
                    <div class="cu-dropdown-content cu-dropdown-content-wide" data-cu-dropdown-content hidden>
                        <div class="cu-dropdown-item">
                            Undo
                            <span class="cu-dropdown-shortcut">⌘Z</span>
                        </div>
                        <div class="cu-dropdown-item">
                            Redo
                            <span class="cu-dropdown-shortcut">⇧⌘Z</span>
                        </div>
                        <div class="cu-dropdown-separator"></div>
                        <div class="cu-dropdown-item">
                            Cut
                            <span class="cu-dropdown-shortcut">⌘X</span>
                        </div>
                        <div class="cu-dropdown-item">
                            Copy
                            <span class="cu-dropdown-shortcut">⌘C</span>
                        </div>
                        <div class="cu-dropdown-item">
                            Paste
                            <span class="cu-dropdown-shortcut">⌘V</span>
                        </div>
                        <div class="cu-dropdown-separator"></div>
                        <div class="cu-dropdown-item">
                            Select All
                            <span class="cu-dropdown-shortcut">⌘A</span>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Danger Item -->
        <section class="space-y-3">
            <SectionHeading id="with-danger-item" title={t.sections.withDangerItem.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withDangerItem.description} />
            <ComponentPreview code={withDangerCode}>
                <div class="cu-dropdown" data-cu-dropdown>
                    <button class="cu-button cu-button-outline cu-button-md" data-cu-dropdown-trigger>
                        Manage
