---
import Layout from "../../layouts/Layout.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<div class="cu-filter-bar">
  <div class="cu-filter-bar-inner">
    <div class="cu-filter-bar-search">
      <div class="cu-input-search">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cu-input-search-icon">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input type="text" placeholder="Search..." class="cu-input-search-field" />
      </div>
    </div>
    <div class="cu-filter-bar-filters">
      <div class="cu-select-wrapper">
        <select class="cu-select">
          <option value="">All Status</option>
          <option value="active">Active</option>
          <option value="inactive">Inactive</option>
        </select>
        <svg class="cu-select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
      </div>
      <div class="cu-select-wrapper">
        <select class="cu-select">
          <option value="">All Categories</option>
          <option value="electronics">Electronics</option>
          <option value="clothing">Clothing</option>
        </select>
        <svg class="cu-select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
      </div>
    </div>
  </div>
</div>`.trim();

const withDateCode = `<div class="cu-filter-bar">
  <div class="cu-filter-bar-inner">
    <div class="cu-filter-bar-search">
      <div class="cu-input-search">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cu-input-search-icon">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input type="text" placeholder="Search orders..." class="cu-input-search-field" />
      </div>
    </div>
    <div class="cu-filter-bar-filters">
      <div class="flex items-center gap-2 px-3 h-9 bg-background border border-input rounded-lg">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground">
          <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/>
        </svg>
        <span class="text-sm">2026/02/01 - 2026/02/03</span>
      </div>
      <div class="cu-select-wrapper">
        <select class="cu-select">
          <option value="">All Status</option>
          <option value="pending">Pending</option>
          <option value="completed">Completed</option>
        </select>
        <svg class="cu-select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
      </div>
    </div>
  </div>
</div>`.trim();

const simpleCode = `<div class="cu-filter-bar">
  <div class="cu-filter-bar-inner">
    <div class="cu-filter-bar-search">
      <div class="cu-input-search">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cu-input-search-icon">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input type="text" placeholder="Search customers..." class="cu-input-search-field" />
      </div>
    </div>
  </div>
</div>`.trim();
---

<Layout title="Filter Bar — Cubby UI" category="Layouts" componentName="Filter Bar">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Filter Bar</h1>
            <span class="cu-badge cu-badge-secondary">Layouts</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            A responsive filter bar combining search input and filter controls for data tables.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Usage
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                The filter bar provides a card-like container with search and filter controls. It stacks vertically on mobile and aligns horizontally on larger screens.
            </p>
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-3xl">
                    <div class="cu-filter-bar">
                        <div class="cu-filter-bar-inner">
                            <div class="cu-filter-bar-search">
                                <div class="cu-input-search">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cu-input-search-icon">
                                        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
                                    </svg>
                                    <input type="text" placeholder="Search..." class="cu-input-search-field" />
                                </div>
                            </div>
                            <div class="cu-filter-bar-filters">
                                <div class="cu-select-wrapper">
                                    <select class="cu-select">
                                        <option value="">All Status</option>
                                        <option value="active">Active</option>
                                        <option value="inactive">Inactive</option>
                                    </select>
                                    <svg class="cu-select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                                </div>
                                <div class="cu-select-wrapper">
                                    <select class="cu-select">
                                        <option value="">All Categories</option>
                                        <option value="electronics">Electronics</option>
                                        <option value="clothing">Clothing</option>
                                    </select>
                                    <svg class="cu-select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- With Date Range -->
        <section class="space-y-3">
            <h2 id="with-date" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-date" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                With Date Range
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Combine with date range selectors for time-based filtering.
            </p>
            <ComponentPreview code={withDateCode}>
                <div class="w-full max-w-3xl">
                    <div class="cu-filter-bar">
                        <div class="cu-filter-bar-inner">
                            <div class="cu-filter-bar-search">
                                <div class="cu-input-search">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cu-input-search-icon">
                                        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
                                    </svg>
                                    <input type="text" placeholder="Search orders..." class="cu-input-search-field" />
                                </div>
                            </div>
                            <div class="cu-filter-bar-filters">
                                <div class="flex items-center gap-2 px-3 h-9 bg-background border border-input rounded-lg">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground">
                                        <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/>
                                    </svg>
                                    <span class="text-sm">2026/02/01 - 2026/02/03</span>
                                </div>
                                <div class="cu-select-wrapper">
                                    <select class="cu-select">
                                        <option value="">All Status</option>
                                        <option value="pending">Pending</option>
                                        <option value="completed">Completed</option>
                                    </select>
                                    <svg class="cu-select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Simple Search -->
        <section class="space-y-3">
            <h2 id="simple" class="text-lg font-semibold tracking-tight relative group">
                <a href="#simple" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                Simple Search
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                For simple use cases, use only the search area without filters.
            </p>
            <ComponentPreview code={simpleCode}>
                <div class="w-full max-w-3xl">
                    <div class="cu-filter-bar">
                        <div class="cu-filter-bar-inner">
                            <div class="cu-filter-bar-search">
                                <div class="cu-input-search">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cu-input-search-icon">
                                        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
                                    </svg>
                                    <input type="text" placeholder="Search customers..." class="cu-input-search-field" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </ComponentPreview>
        </section>

        <!-- Classes Reference -->
        <section class="space-y-3 mt-10">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                CSS Classes
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">Class</th>
                            <th class="cu-table-head">Description</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-filter-bar</code></td>
                            <td class="cu-table-cell text-muted-foreground">Filter bar container (card-like)</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-filter-bar-inner</code></td>
                            <td class="cu-table-cell text-muted-foreground">Inner flex container (responsive)</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-filter-bar-search</code></td>
                            <td class="cu-table-cell text-muted-foreground">Search input area (flex-1)</td>
                        </tr>
                        <tr class="cu-table-row">
                            <td class="cu-table-cell"><code class="cu-code">cu-filter-bar-filters</code></td>
                            <td class="cu-table-cell text-muted-foreground">Filter controls area</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</Layout>
