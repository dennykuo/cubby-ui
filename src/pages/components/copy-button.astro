---
import Layout from "@/layouts/Layout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { Code } from "astro-expressive-code/components";
import CopyButton from "@/components/ui/CopyButton.astro";
import CopyField from "@/components/ui/CopyField.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { copyButtonPage } from "@/i18n/pages/components/copy-button";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(copyButtonPage, locale);

const icons = `<svg class="cu-copy-button-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
  <svg class="cu-copy-button-check" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>`;
const indent = (s: string, pad: string) => s.replace(/\n/g, `\n${pad}`);

const usageCode = `<button type="button" class="cu-copy-button" data-cu-copy="usr_8f2a91c4" aria-label="Copy user ID">
  ${icons}
</button>

<button type="button" class="cu-copy-button cu-copy-button-outline" data-cu-copy="usr_8f2a91c4" aria-label="Copy user ID">
  ${icons}
</button>`;

const labelCode = `<button type="button" class="cu-copy-button cu-copy-button-outline" data-cu-copy="https://cubby.dev/invite/7Hk2pQ">
  ${icons}
  <span data-cu-copy-label>Copy link</span>
</button>`;

const targetCode = `<div class="cu-input-group">
  <input id="invite-link" class="cu-input" type="text" value="https://cubby.dev/invite/7Hk2pQ" aria-label="Invite link" />
  <button type="button" class="cu-copy-button cu-copy-button-outline cu-copy-button-lg" data-cu-copy-target="#invite-link">
    ${indent(icons, "  ")}
    <span data-cu-copy-label>Copy</span>
  </button>
</div>`;

const fieldCode = `<!-- ID -->
<div class="cu-copy-field">
  <code id="order-id" class="cu-copy-field-value">ord_01J9ZK4X7M2QH8</code>
  <button type="button" class="cu-copy-button cu-copy-button-sm" data-cu-copy-target="#order-id" aria-label="Copy order ID">
    ${indent(icons, "  ")}
  </button>
</div>

<!-- API key in a readonly input -->
<div class="cu-copy-field">
  <input id="api-key" class="cu-copy-field-value" type="text" value="sk_live_51H8xQ2eZvKYlo2C9nJ4tW" readonly aria-label="API key" />
  <button type="button" class="cu-copy-button cu-copy-button-sm" data-cu-copy-target="#api-key" aria-label="Copy API key">
    ${indent(icons, "  ")}
  </button>
</div>

<!-- Muted command -->
<div class="cu-copy-field cu-copy-field-muted">
  <code id="install-cmd" class="cu-copy-field-value">npm install cubby-ui</code>
  <button type="button" class="cu-copy-button cu-copy-button-sm" data-cu-copy-target="#install-cmd" aria-label="Copy command">
    ${indent(icons, "  ")}
  </button>
</div>`;

const snippet = `import "cubby-ui/css";
import CubbyUI from "cubby-ui";

CubbyUI.init();`;

const multilineCode = `<div class="cu-copy-field cu-copy-field-muted cu-copy-field-multiline">
  <pre id="setup-snippet" class="cu-copy-field-value">${snippet}</pre>
  <button type="button" class="cu-copy-button cu-copy-button-sm" data-cu-copy-target="#setup-snippet" aria-label="Copy snippet">
    ${indent(icons, "  ")}
  </button>
</div>`;

const sizesCode = `<button type="button" class="cu-copy-button cu-copy-button-outline cu-copy-button-sm" data-cu-copy="sm" aria-label="Copy">…</button>
<button type="button" class="cu-copy-button cu-copy-button-outline" data-cu-copy="default" aria-label="Copy">…</button>
<button type="button" class="cu-copy-button cu-copy-button-outline cu-copy-button-lg" data-cu-copy="lg" aria-label="Copy">…</button>`;

const feedbackCode = `<button type="button" class="cu-copy-button cu-copy-button-outline"
  data-cu-copy="0x71C7656EC7ab88b098defB751B7401B5f6d8976F"
  data-cu-copy-success-text="Address copied"
  data-cu-copy-error-text="Press Ctrl+C to copy"
  data-cu-copy-duration="3000">
  ${icons}
  <span data-cu-copy-label>Copy address</span>
</button>

<!-- Styling hooks -->
<style>
  .cu-copy-button[data-cu-copied] { /* success */ }
  .cu-copy-button[data-cu-copy-failed] { /* error */ }
</style>`;

const liveCode = `<!-- Optional: provide your own live region (otherwise one is created automatically) -->
<div data-cu-copy-live role="status" aria-live="polite" aria-atomic="true"
  style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap"></div>`;

const eventsCode = `document.addEventListener("cu:copy-button:copy", (e) => {
  console.log("Copied:", e.detail.text);
});

document.addEventListener("cu:copy-button:error", (e) => {
  console.warn("Copy failed:", e.detail.error);
});

// Buttons added later work without re-init (delegated listener)
container.insertAdjacentHTML("beforeend",
  '<button type="button" class="cu-copy-button" data-cu-copy="new-id" aria-label="Copy">…</button>');`;
---

<Layout title={t.title} description={t.description} category={t.category} componentName="Copy Button">
	<div class="space-y-3">
		<div class="flex items-center gap-3">
			<h1 class="text-3xl font-bold tracking-tight">Copy Button</h1>
			<span class="cu-badge cu-badge-secondary">{t.category}</span>
		</div>
		<p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
	</div>

	<div class="mt-10 space-y-10">
		<!-- Usage -->
		<section class="space-y-3">
			<SectionHeading id="usage" title={t.sections.usage.title} />
			<p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
			<ComponentPreview code={usageCode}>
				<div class="flex items-center gap-3">
					<CopyButton value="usr_8f2a91c4" aria-label="Copy user ID" />
					<CopyButton value="usr_8f2a91c4" variant="outline" aria-label="Copy user ID" />
				</div>
			</ComponentPreview>
		</section>

		<!-- With Label -->
		<section class="space-y-3">
			<SectionHeading id="label" title={t.sections.label.title} />
			<p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.label.description} />
			<ComponentPreview code={labelCode}>
				<CopyButton value="https://cubby.dev/invite/7Hk2pQ" variant="outline">
					<span data-cu-copy-label>Copy link</span>
				</CopyButton>
			</ComponentPreview>
		</section>

		<!-- Target -->
		<section class="space-y-3">
			<SectionHeading id="target" title={t.sections.target.title} />
			<p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.target.description} />
			<ComponentPreview code={targetCode}>
				<div class="w-full max-w-md">
					<div class="cu-input-group">
						<input id="invite-link" class="cu-input" type="text" value="https://cubby.dev/invite/7Hk2pQ" aria-label="Invite link" />
						<CopyButton target="#invite-link" variant="outline" size="lg">
							<span data-cu-copy-label>Copy</span>
						</CopyButton>
					</div>
				</div>
			</ComponentPreview>
		</section>

		<!-- Copy Field -->
		<section class="space-y-3">
			<SectionHeading id="field" title={t.sections.field.title} />
			<p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.field.description} />
			<ComponentPreview code={fieldCode}>
				<div class="w-full max-w-sm space-y-3">
					<CopyField>
						<code id="order-id" class="cu-copy-field-value">ord_01J9ZK4X7M2QH8</code>
						<CopyButton target="#order-id" size="sm" aria-label="Copy order ID" />
					</CopyField>
					<CopyField>
						<input id="api-key" class="cu-copy-field-value" type="text" value="sk_live_51H8xQ2eZvKYlo2C9nJ4tW" readonly aria-label="API key" />
						<CopyButton target="#api-key" size="sm" aria-label="Copy API key" />
					</CopyField>
					<CopyField muted>
						<code id="install-cmd" class="cu-copy-field-value">npm install cubby-ui</code>
						<CopyButton target="#install-cmd" size="sm" aria-label="Copy command" />
					</CopyField>
				</div>
			</ComponentPreview>
		</section>

		<!-- Multiline -->
		<section class="space-y-3">
			<SectionHeading id="multiline" title={t.sections.multiline.title} />
			<p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.multiline.description} />
			<ComponentPreview code={multilineCode}>
				<div class="w-full max-w-md">
					<CopyField muted multiline>
						<pre id="setup-snippet" class="cu-copy-field-value">{snippet}</pre>
						<CopyButton target="#setup-snippet" size="sm" aria-label="Copy snippet" />
					</CopyField>
				</div>
			</ComponentPreview>
		</section>

		<!-- Sizes -->
		<section class="space-y-3">
			<SectionHeading id="sizes" title={t.sections.sizes.title} />
			<p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.sizes.description} />
			<ComponentPreview code={sizesCode}>
				<div class="flex items-center gap-3">
					<CopyButton value="sm" variant="outline" size="sm" aria-label="Copy" />
					<CopyButton value="default" variant="outline" aria-label="Copy" />
					<CopyButton value="lg" variant="outline" size="lg" aria-label="Copy" />
				</div>
			</ComponentPreview>
		</section>

		<!-- Feedback -->
		<section class="space-y-3">
			<SectionHeading id="feedback" title={t.sections.feedback.title} />
			<p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.feedback.description} />
			<ComponentPreview code={feedbackCode}>
				<CopyButton
					value="0x71C7656EC7ab88b098defB751B7401B5f6d8976F"
					variant="outline"
					data-cu-copy-success-text="Address copied"
					data-cu-copy-error-text="Press Ctrl+C to copy"
					data-cu-copy-duration="3000"
				>
					<span data-cu-copy-label>Copy address</span>
				</CopyButton>
			</ComponentPreview>
		</section>

		<!-- Accessibility -->
		<section class="space-y-3">
			<SectionHeading id="accessibility" title={t.sections.accessibility.title} />
			<p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.accessibility.description} />
			<div class="rounded-xl border border-border bg-muted/20 overflow-hidden">
				<div class="flex items-center px-4 py-2.5 border-b border-border/40">
					<span class="text-[11px] font-medium tracking-wider text-muted-foreground/60">HTML</span>
				</div>
				<div class="px-4 py-3">
					<Code code={liveCode} lang="html" />
				</div>
			</div>
		</section>

		<!-- Events -->
		<section class="space-y-3">
			<SectionHeading id="events" title={t.sections.events.title} />
			<p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.events.description} />
			<div class="rounded-xl border border-border bg-muted/20 overflow-hidden">
				<div class="flex items-center px-4 py-2.5 border-b border-border/40">
					<span class="text-[11px] font-medium tracking-wider text-muted-foreground/60">JavaScript</span>
				</div>
				<div class="px-4 py-3">
					<Code code={eventsCode} lang="js" />
				</div>
			</div>
		</section>

		<!-- Data Attributes -->
		<section class="space-y-3">
			<SectionHeading id="attributes" title={t.sections.attributes.title} />
			<div class="cu-table-wrapper rounded-lg border border-border">
				<table class="cu-table">
					<thead class="cu-table-header">
						<tr class="cu-table-row">
							<th class="cu-table-head">{t.sections.attributes.attributeLabel}</th>
							<th class="cu-table-head">{t.sections.attributes.descriptionLabel}</th>
						</tr>
					</thead>
					<tbody class="cu-table-body">
						{Object.entries(t.attributeDescriptions).map(([attr, desc]) => (
							<tr class="cu-table-row">
								<td class="cu-table-cell"><code class="cu-code">{attr}</code></td>
								<td class="cu-table-cell text-muted-foreground">{desc}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>

		<!-- Classes Reference -->
		<section class="space-y-3">
			<SectionHeading id="classes" title={t.sections.classes.title} />
			<div class="cu-table-wrapper rounded-lg border border-border">
				<table class="cu-table">
					<thead class="cu-table-header">
						<tr class="cu-table-row">
							<th class="cu-table-head">{t.sections.classes.classLabel}</th>
							<th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
						</tr>
					</thead>
					<tbody class="cu-table-body">
						{Object.entries(t.classDescriptions).map(([cls, desc]) => (
							<tr class="cu-table-row">
								<td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
								<td class="cu-table-cell text-muted-foreground">{desc}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>
	</div>
</Layout>
