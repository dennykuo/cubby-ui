const compactCode = `<div class="cu-sortable-list cu-sortable-list-compact" data-cu-sortable-list>
  <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
    <span class="cu-sortable-handle" data-cu-sortable-handle>${gripIcon}</span>
