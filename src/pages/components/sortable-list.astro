---
import Layout from "@/layouts/Layout.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { sortableListPage } from "@/i18n/pages/components/sortable-list";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(sortableListPage, locale);

const gripIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="5" r="1"/><circle cx="9" cy="12" r="1"/><circle cx="9" cy="19" r="1"/><circle cx="15" cy="5" r="1"/><circle cx="15" cy="12" r="1"/><circle cx="15" cy="19" r="1"/></svg>`;

const usageCode = `<div class="cu-sortable-list" data-cu-sortable-list>
  <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
    <span class="cu-sortable-handle" data-cu-sortable-handle>${gripIcon}</span>
    <div class="cu-sortable-content">Design mockups</div>
  </div>
  <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
    <span class="cu-sortable-handle" data-cu-sortable-handle>${gripIcon}</span>
    <div class="cu-sortable-content">Write documentation</div>
  </div>
  <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
    <span class="cu-sortable-handle" data-cu-sortable-handle>${gripIcon}</span>
    <div class="cu-sortable-content">Code review</div>
  </div>
  <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
    <span class="cu-sortable-handle" data-cu-sortable-handle>${gripIcon}</span>
    <div class="cu-sortable-content">Deploy to staging</div>
  </div>
</div>`.trim();

const borderedCode = `<div class="cu-sortable-list cu-sortable-list-bordered" data-cu-sortable-list>
  <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
    <span class="cu-sortable-handle" data-cu-sortable-handle>${gripIcon}</span>
    <div class="cu-sortable-content">First item</div>
  </div>
  <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
    <span class="cu-sortable-handle" data-cu-sortable-handle>${gripIcon}</span>
    <div class="cu-sortable-content">Second item</div>
  </div>
  <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
    <span class="cu-sortable-handle" data-cu-sortable-handle>${gripIcon}</span>
    <div class="cu-sortable-content">Third item</div>
  </div>
</div>`.trim();

const compactCode = `<div class="cu-sortable-list cu-sortable-list-compact" data-cu-sortable-list>
  <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
    <span class="cu-sortable-handle" data-cu-sortable-handle>${gripIcon}</span>
    <div class="cu-sortable-content">Compact item 1</div>
  </div>
  <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
    <span class="cu-sortable-handle" data-cu-sortable-handle>${gripIcon}</span>
    <div class="cu-sortable-content">Compact item 2</div>
  </div>
  <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
    <span class="cu-sortable-handle" data-cu-sortable-handle>${gripIcon}</span>
    <div class="cu-sortable-content">Compact item 3</div>
  </div>
</div>`.trim();

const withContentCode = `<div class="cu-sortable-list" data-cu-sortable-list>
  <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
    <span class="cu-sortable-handle" data-cu-sortable-handle>${gripIcon}</span>
    <div class="cu-sortable-content">
      <div class="font-medium">Homepage Redesign</div>
      <div class="text-xs text-muted-foreground mt-0.5">Due: March 15</div>
    </div>
    <span class="cu-badge cu-badge-warning cu-badge-sm ml-auto">In Progress</span>
  </div>
  <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
    <span class="cu-sortable-handle" data-cu-sortable-handle>${gripIcon}</span>
    <div class="cu-sortable-content">
      <div class="font-medium">API Integration</div>
      <div class="text-xs text-muted-foreground mt-0.5">Due: March 20</div>
    </div>
    <span class="cu-badge cu-badge-info cu-badge-sm ml-auto">Planned</span>
  </div>
  <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
    <span class="cu-sortable-handle" data-cu-sortable-handle>${gripIcon}</span>
    <div class="cu-sortable-content">
      <div class="font-medium">User Testing</div>
      <div class="text-xs text-muted-foreground mt-0.5">Due: March 25</div>
    </div>
    <span class="cu-badge cu-badge-success cu-badge-sm ml-auto">Done</span>
  </div>
</div>`.trim();

const disabledCode = `<div class="cu-sortable-list" data-cu-sortable-list>
  <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
    <span class="cu-sortable-handle" data-cu-sortable-handle>${gripIcon}</span>
    <div class="cu-sortable-content">Draggable item</div>
  </div>
  <div class="cu-sortable-item cu-sortable-item-disabled" data-cu-sortable-item>
    <span class="cu-sortable-handle" data-cu-sortable-handle>${gripIcon}</span>
    <div class="cu-sortable-content">Locked item (not draggable)</div>
  </div>
  <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
    <span class="cu-sortable-handle" data-cu-sortable-handle>${gripIcon}</span>
    <div class="cu-sortable-content">Another draggable item</div>
  </div>
</div>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Sortable List">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Sortable List</h1>
            <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
                <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode} />
        </section>

        <section class="space-y-3">
            <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
                <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.classes.title}
            </h2>
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        {Object.entries(t.classDescriptions).map(([cls, desc]) => (
                            <tr class="cu-table-row">
                                <td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
                                <td class="cu-table-cell text-muted-foreground">{desc}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>

        <section class="space-y-3">
            <h2 id="bordered" class="text-lg font-semibold tracking-tight relative group">
                <a href="#bordered" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.bordered.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.bordered.description} />
            <ComponentPreview code={borderedCode} />
        </section>

        <section class="space-y-3">
            <h2 id="compact" class="text-lg font-semibold tracking-tight relative group">
                <a href="#compact" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.compact.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.compact.description} />
            <ComponentPreview code={compactCode} />
        </section>

        <section class="space-y-3">
            <h2 id="with-content" class="text-lg font-semibold tracking-tight relative group">
                <a href="#with-content" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.withContent.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withContent.description} />
            <ComponentPreview code={withContentCode} />
        </section>

        <section class="space-y-3">
            <h2 id="disabled" class="text-lg font-semibold tracking-tight relative group">
                <a href="#disabled" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
                {t.sections.disabled.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.disabled.description} />
            <ComponentPreview code={disabledCode} />
        </section>
    </div>
</Layout>
