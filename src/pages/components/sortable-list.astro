  <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
    <span class="cu-sortable-handle" data-cu-sortable-handle>${gripIcon}</span>
    <div class="cu-sortable-content">
      <div class="font-medium">Homepage Redesign</div>
      <div class="text-xs text-muted-foreground mt-0.5">Due: March 15</div>
    </div>
    <span class="cu-badge cu-badge-warning cu-badge-sm ml-auto">In Progress</span>
  </div>
  <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
    <span class="cu-sortable-handle" data-cu-sortable-handle>${gripIcon}</span>
    <div class="cu-sortable-content">
      <div class="font-medium">API Integration</div>
      <div class="text-xs text-muted-foreground mt-0.5">Due: March 20</div>
    </div>
    <span class="cu-badge cu-badge-info cu-badge-sm ml-auto">Planned</span>
  </div>
  <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
    <span class="cu-sortable-handle" data-cu-sortable-handle>${gripIcon}</span>
    <div class="cu-sortable-content">
      <div class="font-medium">User Testing</div>
      <div class="text-xs text-muted-foreground mt-0.5">Due: March 25</div>
    </div>
