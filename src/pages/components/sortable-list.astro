---

<Layout title={t.title} category={t.category} componentName="Sortable List">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Sortable List</h1>
            <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <section class="space-y-3">
            <SectionHeading id="usage" title={t.sections.usage.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="classes" title={t.sections.classes.title} />
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        {Object.entries(t.classDescriptions).map(([cls, desc]) => (
                            <tr class="cu-table-row">
                                <td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
                                <td class="cu-table-cell text-muted-foreground">{desc}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>

        <section class="space-y-3">
            <SectionHeading id="bordered" title={t.sections.bordered.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.bordered.description} />
            <ComponentPreview code={borderedCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="compact" title={t.sections.compact.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.compact.description} />
            <ComponentPreview code={compactCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="card" title={t.sections.card.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.card.description} />
            <ComponentPreview code={cardCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="ghost" title={t.sections.ghost.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.ghost.description} />
            <ComponentPreview code={ghostCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="striped" title={t.sections.striped.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.striped.description} />
            <ComponentPreview code={stripedCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="numbered" title={t.sections.numbered.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.numbered.description} />
            <ComponentPreview code={numberedCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="custom-handle" title={t.sections.customHandle.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.customHandle.description} />
            <ComponentPreview code={customHandleCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="with-content" title={t.sections.withContent.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withContent.description} />
            <ComponentPreview code={withContentCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="disabled" title={t.sections.disabled.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.disabled.description} />
            <ComponentPreview code={disabledCode} />
        </section>
    </div>
</Layout>
