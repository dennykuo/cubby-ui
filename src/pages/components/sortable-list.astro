const disabledCode = `<div class="cu-sortable-list" data-cu-sortable-list>
  <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
    <span class="cu-sortable-handle" data-cu-sortable-handle>${gripIcon}</span>
    <div class="cu-sortable-content">Draggable item</div>
  </div>
  <div class="cu-sortable-item cu-sortable-item-disabled" data-cu-sortable-item>
    <span class="cu-sortable-handle" data-cu-sortable-handle>${gripIcon}</span>
    <div class="cu-sortable-content">Locked item (not draggable)</div>
  </div>
  <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
