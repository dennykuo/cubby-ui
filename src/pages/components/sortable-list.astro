---
import Layout from "@/layouts/Layout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { sortableListPage } from "@/i18n/pages/components/sortable-list";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(sortableListPage, locale);

const gripIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="5" r="1"/><circle cx="9" cy="12" r="1"/><circle cx="9" cy="19" r="1"/><circle cx="15" cy="5" r="1"/><circle cx="15" cy="12" r="1"/><circle cx="15" cy="19" r="1"/></svg>`;

const usageCode = `<div class="cu-sortable-list" data-cu-sortable-list>
  <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
    <span class="cu-sortable-handle" data-cu-sortable-handle>${gripIcon}</span>
    <div class="cu-sortable-content">Design mockups</div>
