  </div>
</div>`.trim();

const arrowIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>`;
const menuIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>`;

const customHandleCode = `<div class="space-y-8">
  <div>
    <p class="text-xs font-medium text-muted-foreground mb-2">Arrow</p>
    <div class="cu-sortable-list" data-cu-sortable-list>
      <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
        <span class="cu-sortable-handle" data-cu-sortable-handle>${arrowIcon}</span>
        <div class="cu-sortable-content">Arrow handle</div>
      </div>
      <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
        <span class="cu-sortable-handle" data-cu-sortable-handle>${arrowIcon}</span>
        <div class="cu-sortable-content">Drag me up or down</div>
      </div>
      <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
        <span class="cu-sortable-handle" data-cu-sortable-handle>${arrowIcon}</span>
        <div class="cu-sortable-content">Reorder with arrows</div>
      </div>
    </div>
  </div>

  <div>
    <p class="text-xs font-medium text-muted-foreground mb-2">Hamburger</p>
    <div class="cu-sortable-list" data-cu-sortable-list>
      <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
        <span class="cu-sortable-handle" data-cu-sortable-handle>${menuIcon}</span>
        <div class="cu-sortable-content">Menu handle</div>
      </div>
      <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
        <span class="cu-sortable-handle" data-cu-sortable-handle>${menuIcon}</span>
        <div class="cu-sortable-content">Three lines style</div>
      </div>
      <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
        <span class="cu-sortable-handle" data-cu-sortable-handle>${menuIcon}</span>
        <div class="cu-sortable-content">Familiar pattern</div>
      </div>
    </div>
  </div>

  <div>
    <p class="text-xs font-medium text-muted-foreground mb-2">Hidden</p>
    <div class="cu-sortable-list" data-cu-sortable-list>
      <div class="cu-sortable-item" data-cu-sortable-item draggable="true">
        <div class="cu-sortable-content">No handle — drag anywhere</div>
      </div>
