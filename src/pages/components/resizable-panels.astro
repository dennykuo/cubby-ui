---
import Layout from "@/layouts/Layout.astro";
import Resizable from "@/components/ui/Resizable.astro";
import ResizablePanel from "@/components/ui/ResizablePanel.astro";
import ResizableHandle from "@/components/ui/ResizableHandle.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { resizablePanelsPage } from "@/i18n/pages/components/resizable-panels";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(resizablePanelsPage, locale);

const usageCode = `<div class="cu-resizable" data-cu-resizable>
  <div class="cu-resizable-panel" data-cu-resizable-panel style="flex-grow: 30">
    <div class="p-4">
      <p class="text-sm font-medium">Sidebar</p>
    </div>
  </div>
  <div class="cu-resizable-handle" data-cu-resizable-handle role="separator" tabindex="0"></div>
  <div class="cu-resizable-panel" data-cu-resizable-panel style="flex-grow: 70">
    <div class="p-4">
      <p class="text-sm font-medium">Content</p>
    </div>
  </div>
</div>`.trim();

const verticalCode = `<div class="cu-resizable cu-resizable-vertical" data-cu-resizable style="height: 320px">
  <div class="cu-resizable-panel" data-cu-resizable-panel style="flex-grow: 60">
    <div class="p-4">
      <p class="text-sm font-medium">Editor</p>
    </div>
  </div>
  <div class="cu-resizable-handle" data-cu-resizable-handle role="separator" tabindex="0"></div>
  <div class="cu-resizable-panel" data-cu-resizable-panel style="flex-grow: 40">
    <div class="p-4">
      <p class="text-sm font-medium">Terminal</p>
    </div>
  </div>
</div>`.trim();

const threeCode = `<div class="cu-resizable" data-cu-resizable>
  <div class="cu-resizable-panel" data-cu-resizable-panel style="flex-grow: 20" data-cu-min-size="10" data-cu-max-size="40">
    <div class="p-4">
      <p class="text-sm font-medium">Explorer</p>
    </div>
  </div>
  <div class="cu-resizable-handle" data-cu-resizable-handle role="separator" tabindex="0"></div>
  <div class="cu-resizable-panel" data-cu-resizable-panel style="flex-grow: 55" data-cu-min-size="30">
    <div class="p-4">
      <p class="text-sm font-medium">Editor</p>
    </div>
  </div>
  <div class="cu-resizable-handle" data-cu-resizable-handle role="separator" tabindex="0"></div>
  <div class="cu-resizable-panel" data-cu-resizable-panel style="flex-grow: 25" data-cu-min-size="15">
    <div class="p-4">
      <p class="text-sm font-medium">Preview</p>
    </div>
  </div>
</div>`.trim();

const nestedCode = `<div class="cu-resizable" data-cu-resizable style="height: 400px">
  <div class="cu-resizable-panel" data-cu-resizable-panel style="flex-grow: 25" data-cu-min-size="15">
    <div class="p-4">
      <p class="text-sm font-medium">Sidebar</p>
    </div>
  </div>
  <div class="cu-resizable-handle" data-cu-resizable-handle role="separator" tabindex="0"></div>
  <div class="cu-resizable-panel p-0" data-cu-resizable-panel style="flex-grow: 75">
    <div class="cu-resizable cu-resizable-vertical h-full border-0 rounded-none" data-cu-resizable>
      <div class="cu-resizable-panel" data-cu-resizable-panel style="flex-grow: 65">
        <div class="p-4">
          <p class="text-sm font-medium">Editor</p>
        </div>
      </div>
      <div class="cu-resizable-handle" data-cu-resizable-handle role="separator" tabindex="0"></div>
      <div class="cu-resizable-panel" data-cu-resizable-panel style="flex-grow: 35">
        <div class="p-4">
          <p class="text-sm font-medium">Terminal</p>
        </div>
      </div>
    </div>
  </div>
</div>`.trim();
---

<Layout title={t.title} category={t.category} componentName="Resizable Panels">
  <div class="space-y-3">
    <div class="flex items-center gap-3">
      <h1 class="text-3xl font-bold tracking-tight">Resizable Panels</h1>
      <span class="cu-badge cu-badge-secondary">{t.category}</span>
    </div>
    <p class="text-base text-muted-foreground leading-relaxed">
      {t.description}
    </p>
  </div>

  <div class="mt-10 space-y-10">
    <!-- Usage -->
    <section class="space-y-3">
      <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
        <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        {t.sections.usage.title}
      </h2>
      <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
      <ComponentPreview code={usageCode}>
        <div class="w-full max-w-2xl">
          <Resizable>
            <ResizablePanel defaultSize={30}>
              <div class="flex h-28 items-center justify-center p-4">
                <p class="text-sm font-medium text-muted-foreground">Sidebar</p>
              </div>
            </ResizablePanel>
            <ResizableHandle />
            <ResizablePanel defaultSize={70}>
              <div class="flex h-28 items-center justify-center p-4">
                <p class="text-sm font-medium text-muted-foreground">Content</p>
              </div>
            </ResizablePanel>
          </Resizable>
        </div>
      </ComponentPreview>
    </section>

    <!-- Vertical -->
    <section class="space-y-3">
      <h2 id="vertical" class="text-lg font-semibold tracking-tight relative group">
        <a href="#vertical" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        {t.sections.vertical.title}
      </h2>
      <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.vertical.description} />
      <ComponentPreview code={verticalCode}>
        <div class="w-full max-w-2xl">
          <Resizable vertical class="h-80">
            <ResizablePanel defaultSize={60}>
              <div class="flex h-full items-center justify-center p-4">
                <p class="text-sm font-medium text-muted-foreground">Editor</p>
              </div>
            </ResizablePanel>
            <ResizableHandle />
            <ResizablePanel defaultSize={40}>
              <div class="flex h-full items-center justify-center p-4">
                <p class="text-sm font-medium text-muted-foreground">Terminal</p>
              </div>
            </ResizablePanel>
          </Resizable>
        </div>
      </ComponentPreview>
    </section>

    <!-- Three Panels -->
    <section class="space-y-3">
      <h2 id="three-panels" class="text-lg font-semibold tracking-tight relative group">
        <a href="#three-panels" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        {t.sections.threePanels.title}
      </h2>
      <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.threePanels.description} />
      <ComponentPreview code={threeCode}>
        <div class="w-full max-w-2xl">
          <Resizable>
            <ResizablePanel defaultSize={20} minSize={10} maxSize={40}>
              <div class="flex h-28 items-center justify-center p-4">
                <p class="text-sm font-medium text-muted-foreground">Explorer</p>
              </div>
            </ResizablePanel>
            <ResizableHandle />
            <ResizablePanel defaultSize={55} minSize={30}>
              <div class="flex h-28 items-center justify-center p-4">
                <p class="text-sm font-medium text-muted-foreground">Editor</p>
              </div>
            </ResizablePanel>
            <ResizableHandle />
            <ResizablePanel defaultSize={25} minSize={15}>
              <div class="flex h-28 items-center justify-center p-4">
                <p class="text-sm font-medium text-muted-foreground">Preview</p>
              </div>
            </ResizablePanel>
          </Resizable>
        </div>
      </ComponentPreview>
    </section>

    <!-- Nested -->
    <section class="space-y-3">
      <h2 id="nested" class="text-lg font-semibold tracking-tight relative group">
        <a href="#nested" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        {t.sections.nested.title}
      </h2>
      <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.nested.description} />
      <ComponentPreview code={nestedCode}>
        <div class="w-full max-w-2xl">
          <Resizable class="h-96">
            <ResizablePanel defaultSize={25} minSize={15}>
              <div class="flex h-full items-center justify-center p-4">
                <p class="text-sm font-medium text-muted-foreground">Sidebar</p>
              </div>
            </ResizablePanel>
            <ResizableHandle />
            <ResizablePanel defaultSize={75} class="!overflow-hidden !p-0">
              <Resizable vertical class="h-full !border-0 !rounded-none">
                <ResizablePanel defaultSize={65}>
                  <div class="flex h-full items-center justify-center p-4">
                    <p class="text-sm font-medium text-muted-foreground">Editor</p>
                  </div>
                </ResizablePanel>
                <ResizableHandle />
                <ResizablePanel defaultSize={35}>
                  <div class="flex h-full items-center justify-center p-4">
                    <p class="text-sm font-medium text-muted-foreground">Terminal</p>
                  </div>
                </ResizablePanel>
              </Resizable>
            </ResizablePanel>
          </Resizable>
        </div>
      </ComponentPreview>
    </section>

    <!-- Classes Reference -->
    <section class="space-y-3">
      <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
        <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        {t.sections.classes.title}
      </h2>
      <div class="cu-table-wrapper rounded-lg border border-border">
        <table class="cu-table">
          <thead class="cu-table-header">
            <tr class="cu-table-row">
              <th class="cu-table-head">{t.sections.classes.classLabel}</th>
              <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
            </tr>
          </thead>
          <tbody class="cu-table-body">
            {Object.entries(t.classDescriptions).map(([cls, desc]) => (
              <tr class="cu-table-row">
                <td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
                <td class="cu-table-cell text-muted-foreground">{desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Data Attributes -->
    <section class="space-y-3">
      <h2 id="data-attributes" class="text-lg font-semibold tracking-tight relative group">
        <a href="#data-attributes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        {t.sections.dataAttributes.title}
      </h2>
      <div class="cu-table-wrapper rounded-lg border border-border">
        <table class="cu-table">
          <thead class="cu-table-header">
            <tr class="cu-table-row">
              <th class="cu-table-head">{t.sections.dataAttributes.attributeLabel}</th>
              <th class="cu-table-head">{t.sections.dataAttributes.descriptionLabel}</th>
            </tr>
          </thead>
          <tbody class="cu-table-body">
            {Object.entries(t.dataAttributeDescriptions).map(([attr, desc]) => (
              <tr class="cu-table-row">
                <td class="cu-table-cell"><code class="cu-code">{attr}</code></td>
                <td class="cu-table-cell text-muted-foreground" set:html={desc} />
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Layout>
