---
import Layout from "../../layouts/Layout.astro";
import Hr from "../../components/ui/Hr.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<hr class="cu-hr" />`.trim();

const withContentCode = `<p class="cu-p">
  The first section of content ends here, followed by a thematic break.
</p>
<hr class="cu-hr my-6" />
<p class="cu-p">
  The second section of content begins after the horizontal rule.
</p>`.trim();
---

<Layout title="HR — Cubby UI" category="Typography" componentName="HR">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">HR</h1>
          <span class="cu-badge cu-badge-secondary">Typography</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            A thematic break between content sections, rendered as a horizontal rule.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight flex items-center gap-2 group">
              <a href="#usage" class="text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Usage
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Apply <code class="cu-code">cu-hr</code> to an
                <code class="cu-code">&lt;hr&gt;</code> element.
            </p>
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-lg">
                    <Hr />
                </div>
            </ComponentPreview>
        </section>

        <!-- With Content -->
        <section class="space-y-3">
            <h2 id="with-content" class="text-lg font-semibold tracking-tight flex items-center gap-2 group">
              <a href="#with-content" class="text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              With Content
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Add vertical margin to separate content sections.
            </p>
            <ComponentPreview code={withContentCode}>
                <div class="w-full max-w-lg">
                    <p class="cu-p">
                        The first section of content ends here, followed by a thematic break.
                    </p>
                    <Hr class="my-6" />
                    <p class="cu-p">
                        The second section of content begins after the horizontal rule.
                    </p>
                </div>
            </ComponentPreview>
        </section>
    </div>

    <!-- Classes Reference -->
    <section class="space-y-3 mt-10">
      <h2 id="classes" class="text-lg font-semibold tracking-tight flex items-center gap-2 group">
        <a href="#classes" class="text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        CSS Classes
      </h2>
      <div class="cu-table-wrapper rounded-lg border border-border">
        <table class="cu-table">
          <thead class="cu-table-header">
            <tr class="cu-table-row">
              <th class="cu-table-head">Class</th>
              <th class="cu-table-head">說明</th>
            </tr>
          </thead>
          <tbody class="cu-table-body">
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-hr</code></td>
              <td class="cu-table-cell text-muted-foreground">水平分隔線</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
</Layout>
