---
import Layout from "@/layouts/Layout.astro";
// @ts-ignore - Astro component used in template
import Hr from "@/components/ui/Hr.astro";
import ComponentPreview from "@/components/ComponentPreview.astro";
import { getLocaleFromUrl, useTranslations } from "@/i18n";
import { hrPage } from "@/i18n/pages/components/hr";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(hrPage, locale);

const usageCode = `<hr class="cu-hr" />`.trim();

const withContentCode = `<p class="cu-p">
  The first section of content ends here, followed by a thematic break.
</p>
<hr class="cu-hr my-6" />
<p class="cu-p">
  The second section of content begins after the horizontal rule.
</p>`.trim();
---

<Layout title={t.title} category={t.category} componentName="HR">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">HR</h1>
          <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
              <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.usage.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-lg">
                    <Hr />
                </div>
            </ComponentPreview>
        </section>

    <!-- Classes Reference -->
    <section class="space-y-3">
      <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
        <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        {t.sections.classes.title}
      </h2>
      <div class="cu-table-wrapper rounded-lg border border-border">
        <table class="cu-table">
          <thead class="cu-table-header">
            <tr class="cu-table-row">
              <th class="cu-table-head">{t.sections.classes.classLabel}</th>
              <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
            </tr>
          </thead>
          <tbody class="cu-table-body">
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-hr</code></td>
              <td class="cu-table-cell text-muted-foreground">{t.classDescriptions['cu-hr']}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>


        <!-- With Content -->
        <section class="space-y-3">
            <h2 id="with-content" class="text-lg font-semibold tracking-tight relative group">
              <a href="#with-content" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              {t.sections.withContent.title}
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.withContent.description} />
            <ComponentPreview code={withContentCode}>
                <div class="w-full max-w-lg">
                    <p class="cu-p">
                        The first section of content ends here, followed by a thematic break.
                    </p>
                    <Hr class="my-6" />
                    <p class="cu-p">
                        The second section of content begins after the horizontal rule.
                    </p>
                </div>
            </ComponentPreview>
        </section>
    </div>

</Layout>
