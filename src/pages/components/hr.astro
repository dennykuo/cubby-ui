---
import Layout from "../../layouts/Layout.astro";
import Hr from "../../components/ui/Hr.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<hr class="cu-hr" />`.trim();

const withContentCode = `<p class="cu-p">
  The first section of content ends here, followed by a thematic break.
</p>
<hr class="cu-hr my-6" />
<p class="cu-p">
  The second section of content begins after the horizontal rule.
</p>`.trim();
---

<Layout title="HR — Cubby UI">
    <div class="space-y-3">
        <h1 class="text-3xl font-bold tracking-tight">HR</h1>
        <p class="text-base text-muted-foreground leading-relaxed">
            A thematic break between content sections, rendered as a horizontal rule.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Usage</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Apply <code class="cu-code">cu-hr</code> to an
                <code class="cu-code">&lt;hr&gt;</code> element.
            </p>
            <ComponentPreview code={usageCode}>
                <div class="w-full max-w-lg">
                    <Hr />
                </div>
            </ComponentPreview>
        </section>

        <!-- With Content -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">With Content</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Add vertical margin to separate content sections.
            </p>
            <ComponentPreview code={withContentCode}>
                <div class="w-full max-w-lg">
                    <p class="cu-p">
                        The first section of content ends here, followed by a thematic break.
                    </p>
                    <Hr class="my-6" />
                    <p class="cu-p">
                        The second section of content begins after the horizontal rule.
                    </p>
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>
