---

<Layout title={t.title} category={t.category} componentName="Marquee" description={t.description}>
    <div class="space-y-3">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-bold tracking-tight">Marquee</h1>
            <span class="cu-badge cu-badge-secondary">{t.category}</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed" set:html={t.description} />
    </div>

    <div class="mt-10 space-y-10">
        <section class="space-y-3">
            <SectionHeading id="usage" title={t.sections.usage.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.usage.description} />
            <ComponentPreview code={usageCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="classes" title={t.sections.classes.title} />
            <div class="cu-table-wrapper rounded-lg border border-border">
                <table class="cu-table">
                    <thead class="cu-table-header">
                        <tr class="cu-table-row">
                            <th class="cu-table-head">{t.sections.classes.classLabel}</th>
                            <th class="cu-table-head">{t.sections.classes.descriptionLabel}</th>
                        </tr>
                    </thead>
                    <tbody class="cu-table-body">
                        {Object.entries(t.classDescriptions).map(([cls, desc]) => (
                            <tr class="cu-table-row">
                                <td class="cu-table-cell"><code class="cu-code">{cls}</code></td>
                                <td class="cu-table-cell text-muted-foreground">{desc}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>

        <section class="space-y-3">
            <SectionHeading id="reverse" title={t.sections.reverse.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.reverse.description} />
            <ComponentPreview code={reverseCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="fade" title={t.sections.fade.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.fade.description} />
            <ComponentPreview code={fadeCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="pause-on-hover" title={t.sections.pauseOnHover.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.pauseOnHover.description} />
            <ComponentPreview code={pauseOnHoverCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="vertical" title={t.sections.vertical.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.vertical.description} />
            <ComponentPreview code={verticalCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="speed" title={t.sections.speed.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.speed.description} />
            <ComponentPreview code={speedCode} />
        </section>

        <section class="space-y-3">
            <SectionHeading id="logos" title={t.sections.logos.title} />
            <p class="text-base text-muted-foreground leading-relaxed" set:html={t.sections.logos.description} />
            <ComponentPreview code={logosCode} />
        </section>
    </div>
</Layout>
