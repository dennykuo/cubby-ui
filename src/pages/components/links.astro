---
import Layout from "../../layouts/Layout.astro";
import Link from "../../components/ui/Link.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<a class="cu-link" href="#">Click here</a>`.trim();

const inlineCode = `<p class="cu-p">
  You can read the full documentation on the
  <a class="cu-link" href="#">getting started</a> page,
  or check the <a class="cu-link" href="#">API reference</a>
  for more details.
</p>`.trim();
---

<Layout title="Links — Cubby UI">
    <div class="space-y-3">
        <h1 class="text-3xl font-bold tracking-tight">Links</h1>
        <p class="text-base text-muted-foreground leading-relaxed">
            Styled anchor links with underline offset and hover transition.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Usage</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Apply <code class="cu-code">cu-link</code> to an anchor element
                for a styled inline link.
            </p>
            <ComponentPreview code={usageCode}>
                <Link href="#">Click here</Link>
            </ComponentPreview>
        </section>

        <!-- Inline -->
        <section class="space-y-3">
            <h2 class="text-lg font-semibold tracking-tight">Inline</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
                Links blend naturally within paragraph text.
            </p>
            <ComponentPreview code={inlineCode}>
                <div class="w-full max-w-lg">
                    <p class="cu-p">
                        You can read the full documentation on the
                        <Link href="#">getting started</Link> page,
                        or check the <Link href="#">API reference</Link>
                        for more details.
                    </p>
                </div>
            </ComponentPreview>
        </section>
    </div>
</Layout>
