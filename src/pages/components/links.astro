---
import Layout from "../../layouts/Layout.astro";
import Link from "../../components/ui/Link.astro";
import ComponentPreview from "../../components/ComponentPreview.astro";

const usageCode = `<a class="cu-link" href="#">Click here</a>`.trim();

const plainCode = `<a class="cu-link cu-link-plain" href="#">No underline until hover</a>`.trim();

const mutedCode = `<a class="cu-link cu-link-muted" href="#">Muted link</a>`.trim();

const subtleCode = `<a class="cu-link cu-link-subtle" href="#">Subtle link</a>`.trim();

const variantsCode = `<a class="cu-link" href="#">Default</a>
<a class="cu-link cu-link-plain" href="#">Plain</a>
<a class="cu-link cu-link-muted" href="#">Muted</a>
<a class="cu-link cu-link-subtle" href="#">Subtle</a>`.trim();

const inlineCode = `<p class="cu-p">
  You can read the full documentation on the
  <a class="cu-link" href="#">getting started</a> page,
  or check the <a class="cu-link" href="#">API reference</a>
  for more details.
</p>`.trim();

const externalCode = `<a class="cu-link cu-link-external" href="#" target="_blank" rel="noopener noreferrer">
  View on GitHub
  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
</a>`.trim();

const navListCode = `<nav>
  <ul class="cu-list cu-list-none space-y-1">
    <li><a class="cu-link cu-link-muted" href="#">Profile</a></li>
    <li><a class="cu-link cu-link-muted" href="#">Settings</a></li>
    <li><a class="cu-link cu-link-muted" href="#">Notifications</a></li>
    <li><a class="cu-link cu-link-muted" href="#">Help &amp; Support</a></li>
  </ul>
</nav>`.trim();

const cardLinksCode = `<div class="cu-card cu-card-hover p-5 space-y-3 max-w-sm">
  <h3 class="text-sm font-semibold">Resources</h3>
  <div class="flex flex-col gap-1.5">
    <a class="cu-link cu-link-subtle text-sm" href="#">Documentation</a>
    <a class="cu-link cu-link-subtle text-sm" href="#">Changelog</a>
    <a class="cu-link cu-link-subtle text-sm" href="#">Contributing Guide</a>
  </div>
</div>`.trim();
---

<Layout title="Links — Cubby UI" category="Typography" componentName="Links">
    <div class="space-y-3">
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight">Links</h1>
          <span class="cu-badge cu-badge-secondary">Typography</span>
        </div>
        <p class="text-base text-muted-foreground leading-relaxed">
            Styled anchor links with multiple variants — underlined, plain, muted, and subtle — for different contexts.
        </p>
    </div>

    <div class="mt-10 space-y-10">
        <!-- Usage -->
        <section class="space-y-3">
            <h2 id="usage" class="text-lg font-semibold tracking-tight relative group">
              <a href="#usage" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Usage
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Apply <code class="cu-code">cu-link</code> to an anchor element
                for a styled inline link with underline and hover transition.
            </p>
            <ComponentPreview code={usageCode}>
                <Link href="#">Click here</Link>
            </ComponentPreview>
        </section>

    <!-- Classes Reference -->
    <section class="space-y-3">
      <h2 id="classes" class="text-lg font-semibold tracking-tight relative group">
        <a href="#classes" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
        CSS Classes
      </h2>
      <div class="cu-table-wrapper rounded-lg border border-border">
        <table class="cu-table">
          <thead class="cu-table-header">
            <tr class="cu-table-row">
              <th class="cu-table-head">Class</th>
              <th class="cu-table-head">Description</th>
            </tr>
          </thead>
          <tbody class="cu-table-body">
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-link</code></td>
              <td class="cu-table-cell text-muted-foreground">Base link style with underline and hover transition</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-link-plain</code></td>
              <td class="cu-table-cell text-muted-foreground">No-underline link, underline appears on hover</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-link-muted</code></td>
              <td class="cu-table-cell text-muted-foreground">Soft-colored link, darkens on hover</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-link-subtle</code></td>
              <td class="cu-table-cell text-muted-foreground">Inline link blending with body text, primary color on hover</td>
            </tr>
            <tr class="cu-table-row">
              <td class="cu-table-cell"><code class="cu-code">cu-link-external</code></td>
              <td class="cu-table-cell text-muted-foreground">External link, inline-flex layout with icon</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>


        <!-- Variants -->
        <section class="space-y-3">
            <h2 id="variants" class="text-lg font-semibold tracking-tight relative group">
              <a href="#variants" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Variants
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Four link styles for different use cases.
                <code class="cu-code">cu-link</code> (default with underline),
                <code class="cu-code">cu-link-plain</code> (underline on hover only),
                <code class="cu-code">cu-link-muted</code> (muted color, no underline),
                <code class="cu-code">cu-link-subtle</code> (foreground color, turns primary on hover).
            </p>
            <ComponentPreview code={variantsCode}>
                <div class="flex flex-wrap items-center gap-6">
                    <Link href="#">Default</Link>
                    <a class="cu-link cu-link-plain" href="#">Plain</a>
                    <a class="cu-link cu-link-muted" href="#">Muted</a>
                    <a class="cu-link cu-link-subtle" href="#">Subtle</a>
                </div>
            </ComponentPreview>
        </section>

        <!-- Plain -->
        <section class="space-y-3">
            <h2 id="plain" class="text-lg font-semibold tracking-tight relative group">
              <a href="#plain" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Plain
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-link cu-link-plain</code> for links
                that only show an underline on hover. Cleaner for navigation-heavy areas.
            </p>
            <ComponentPreview code={plainCode}>
                <a class="cu-link cu-link-plain" href="#">No underline until hover</a>
            </ComponentPreview>
        </section>

        <!-- Muted -->
        <section class="space-y-3">
            <h2 id="muted" class="text-lg font-semibold tracking-tight relative group">
              <a href="#muted" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Muted
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-link cu-link-muted</code> for
                de-emphasized links such as footer links or secondary navigation. Text brightens to foreground on hover.
            </p>
            <ComponentPreview code={mutedCode}>
                <a class="cu-link cu-link-muted" href="#">Muted link</a>
            </ComponentPreview>
        </section>

        <!-- Subtle -->
        <section class="space-y-3">
            <h2 id="subtle" class="text-lg font-semibold tracking-tight relative group">
              <a href="#subtle" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Subtle
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-link cu-link-subtle</code> for
                links that blend with body text and reveal their primary color on hover.
            </p>
            <ComponentPreview code={subtleCode}>
                <a class="cu-link cu-link-subtle" href="#">Subtle link</a>
            </ComponentPreview>
        </section>

        <!-- Inline -->
        <section class="space-y-3">
            <h2 id="inline" class="text-lg font-semibold tracking-tight relative group">
              <a href="#inline" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Inline
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Links blend naturally within paragraph text.
            </p>
            <ComponentPreview code={inlineCode}>
                <div class="w-full max-w-lg">
                    <p class="cu-p">
                        You can read the full documentation on the
                        <Link href="#">getting started</Link> page,
                        or check the <Link href="#">API reference</Link>
                        for more details.
                    </p>
                </div>
            </ComponentPreview>
        </section>

        <!-- External -->
        <section class="space-y-3">
            <h2 id="external-link" class="text-lg font-semibold tracking-tight relative group">
              <a href="#external-link" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              External Link
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Add <code class="cu-code">cu-link-external</code> for links that open in a new tab.
                Pairs well with an external-link icon to signal the behavior.
            </p>
            <ComponentPreview code={externalCode}>
                <a class="cu-link cu-link-external" href="#" target="_blank" rel="noopener noreferrer">
                    View on GitHub
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                </a>
            </ComponentPreview>
        </section>

        <!-- Nav List -->
        <section class="space-y-3">
            <h2 id="navigation-list" class="text-lg font-semibold tracking-tight relative group">
              <a href="#navigation-list" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Navigation List
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Combine <code class="cu-code">cu-link-muted</code> with a list for sidebar or footer navigation.
            </p>
            <ComponentPreview code={navListCode}>
                <div class="w-full max-w-xs">
                    <nav>
                        <ul class="cu-list cu-list-none space-y-1">
                            <li><a class="cu-link cu-link-muted" href="#">Profile</a></li>
                            <li><a class="cu-link cu-link-muted" href="#">Settings</a></li>
                            <li><a class="cu-link cu-link-muted" href="#">Notifications</a></li>
                            <li><a class="cu-link cu-link-muted" href="#">Help &amp; Support</a></li>
                        </ul>
                    </nav>
                </div>
            </ComponentPreview>
        </section>

        <!-- Card Links -->
        <section class="space-y-3">
            <h2 id="card-links" class="text-lg font-semibold tracking-tight relative group">
              <a href="#card-links" class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150">#</a>
              Card Links
            </h2>
            <p class="text-base text-muted-foreground leading-relaxed">
                Use <code class="cu-code">cu-link-subtle</code> inside cards for a clean, understated link list.
            </p>
            <ComponentPreview code={cardLinksCode}>
                <div class="cu-card cu-card-hover p-5 space-y-3 max-w-sm">
                    <h3 class="text-sm font-semibold">Resources</h3>
                    <div class="flex flex-col gap-1.5">
                        <a class="cu-link cu-link-subtle text-sm" href="#">Documentation</a>
                        <a class="cu-link cu-link-subtle text-sm" href="#">Changelog</a>
                        <a class="cu-link cu-link-subtle text-sm" href="#">Contributing Guide</a>
                    </div>
                </div>
            </ComponentPreview>
        </section>
    </div>

</Layout>
