---
import { withBase, stripBase } from "@/utils/paths";
import "@/styles/global.css";
import cubbyUiUrl from "../../dist/core/cubby-ui.js?url";

interface Props {
  title: string;
}

const { title } = Astro.props;
const pathname = stripBase(Astro.url.pathname);
const normalizedPath = pathname.endsWith("/") && pathname.length > 1 ? pathname.slice(0, -1) : pathname;

const navItems = [
  { label: "總覽", href: "/examples/dashboard-v5/analytics", icon: "chart-bar" },
  {
    label: "產品管理",
    href: "/examples/dashboard-v5",
    icon: "package",
    count: 248,
    patterns: ["/examples/dashboard-v5/products"],
  },
  { label: "訂單紀錄", href: "/examples/dashboard-v5/orders", icon: "receipt", count: 52 },
  { label: "客戶資料", href: "/examples/dashboard-v5/customers", icon: "users", count: 1847 },
  { label: "活動紀錄", href: "/examples/dashboard-v5/activity", icon: "activity" },
  { label: "系統設定", href: "/examples/dashboard-v5/settings", icon: "settings" },
];
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Dashboard V5 — Cubby UI" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen font-sans antialiased text-foreground bg-muted/30">
    <a
      href="#main-content"
      class="cu-button cu-button-default cu-button-sm sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60]"
    >
      跳至主要內容
    </a>
    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside class="cu-sidebar hidden lg:flex fixed inset-y-0 left-0 z-40 w-60 border-r border-border">
        <!-- Logo -->
        <div class="cu-sidebar-header h-14 border-b border-border pl-6">
          <a href={withBase("/examples/dashboard-v5")} class="cu-header-brand">
            <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary text-primary-foreground">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m7.5 4.27 9 5.15" />
                <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
                <path d="m3.3 7 8.7 5 8.7-5" />
                <path d="M12 22V12" />
              </svg>
            </div>
            <span class="font-semibold">DataHub</span>
          </a>
        </div>

        <!-- Navigation -->
        <div class="cu-sidebar-content py-6">
          <p class="cu-sidebar-section-title mb-4">資料管理</p>
          <nav class="space-y-1 -ml-3" aria-label="主要導覽">
            {navItems.map((item) => {
              const isActive =
                normalizedPath === item.href ||
                (item.href !== "/examples/dashboard-v5" && normalizedPath.startsWith(item.href)) ||
                (item.patterns?.some((p) => normalizedPath.startsWith(p)) ?? false);
              return (
                <a
                  href={withBase(item.href)}
                  aria-current={isActive ? "page" : undefined}
                  class:list={["cu-sidebar-item", isActive && "cu-sidebar-item-active"]}
                >
                  {item.icon === "chart-bar" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <line x1="12" x2="12" y1="20" y2="10" />
                      <line x1="18" x2="18" y1="20" y2="4" />
                      <line x1="6" x2="6" y1="20" y2="16" />
                    </svg>
                  )}
                  {item.icon === "package" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="m7.5 4.27 9 5.15" />
                      <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
                      <path d="m3.3 7 8.7 5 8.7-5" />
                      <path d="M12 22V12" />
                    </svg>
                  )}
                  {item.icon === "receipt" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z" />
                      <path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8" />
                      <path d="M12 17.5v-11" />
                    </svg>
                  )}
                  {item.icon === "users" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                      <circle cx="9" cy="7" r="4" />
                      <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                      <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                    </svg>
                  )}
                  {item.icon === "activity" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2" />
                    </svg>
                  )}
                  {item.icon === "settings" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                      <circle cx="12" cy="12" r="3" />
                    </svg>
                  )}
                  <span class="flex-1">{item.label}</span>
                  {item.count && (
                    <span class="cu-badge cu-badge-secondary cu-badge-sm">{item.count.toLocaleString()}</span>
                  )}
                </a>
              );
            })}
          </nav>
        </div>

        <!-- User -->
        <div class="cu-sidebar-footer">
          <div class="flex items-center gap-3">
            <div class="cu-avatar cu-avatar-sm">
              <div class="cu-avatar-fallback">林</div>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium truncate">林小明</p>
              <p class="text-xs text-muted-foreground truncate">管理員</p>
            </div>
          </div>
        </div>
      </aside>

      <!-- Main Area -->
      <div class="flex flex-col flex-1 min-w-0 lg:pl-60">
        <!-- Top Bar -->
        <header class="cu-header">
          <div class="cu-header-inner">
            <!-- Mobile menu -->
            <button
              type="button"
              class="cu-button cu-button-ghost cu-button-icon-sm lg:hidden"
              data-cu-drawer-trigger="mobile-nav"
              aria-label="開啟導航選單"
              aria-controls="mobile-nav"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="4" x2="20" y1="12" y2="12" />
                <line x1="4" x2="20" y1="6" y2="6" />
                <line x1="4" x2="20" y1="18" y2="18" />
              </svg>
            </button>

            <!-- Breadcrumb -->
            <nav class="hidden lg:block" aria-label="麵包屑">
              <ol class="cu-breadcrumb">
                <li class="cu-breadcrumb-item">
                  <a href={withBase("/examples/dashboard-v5")} class="cu-breadcrumb-link">
                    首頁
                  </a>
                </li>
                <slot name="breadcrumb">
                  <li class="cu-breadcrumb-separator" aria-hidden="true">
                    /
                  </li>
                  <li class="cu-breadcrumb-item">
                    <span class="cu-breadcrumb-current" aria-current="page">
                      資料管理
                    </span>
                  </li>
                </slot>
              </ol>
            </nav>

            <!-- Right actions -->
            <div class="cu-header-actions">
              <!-- Quick search -->
              <div class="cu-input-search hidden sm:flex" role="search">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="cu-input-search-icon"
                  aria-hidden="true"
                >
                  <circle cx="11" cy="11" r="8" />
                  <path d="m21 21-4.3-4.3" />
                </svg>
                <input type="search" placeholder="搜尋..." aria-label="全站搜尋" class="cu-input-search-field w-48" />
              </div>

              <!-- Notification -->
              <button
                type="button"
                class="cu-button cu-button-ghost cu-button-icon-sm relative"
                aria-label="通知（有未讀）"
              >
                <span class="absolute top-1 right-1 w-2 h-2 bg-destructive rounded-full" aria-hidden="true"></span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
                  <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
                </svg>
              </button>

              <!-- Help -->
              <button type="button" class="cu-button cu-button-ghost cu-button-icon-sm" aria-label="說明">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="10" />
                  <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" />
                  <path d="M12 17h.01" />
                </svg>
              </button>
            </div>
          </div>
        </header>

        <!-- Main Content -->
        <main id="main-content" class="flex-1 p-4 sm:p-6 lg:p-8" tabindex="-1">
          <slot />
        </main>
      </div>
    </div>

    <!-- Mobile Nav Drawer -->
    <dialog class="cu-drawer cu-drawer-left" id="mobile-nav" data-cu-drawer aria-label="導航選單">
      <div class="cu-drawer-header border-b border-border">
        <a href={withBase("/examples/dashboard-v5")} class="cu-header-brand">
          <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary text-primary-foreground">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m7.5 4.27 9 5.15" />
              <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
              <path d="m3.3 7 8.7 5 8.7-5" />
              <path d="M12 22V12" />
            </svg>
          </div>
          <span class="font-semibold">DataHub</span>
        </a>
        <button type="button" class="cu-drawer-close" data-cu-drawer-close aria-label="關閉導航選單">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </button>
      </div>
      <div class="p-4">
        <p class="cu-sidebar-section-title mb-4">資料管理</p>
        <nav class="space-y-1" aria-label="主要導覽">
          {navItems.map((item) => {
            const isActive =
              normalizedPath === item.href ||
              (item.href !== "/examples/dashboard-v5" && normalizedPath.startsWith(item.href)) ||
              (item.patterns?.some((p) => normalizedPath.startsWith(p)) ?? false);
            return (
              <a
                href={withBase(item.href)}
                aria-current={isActive ? "page" : undefined}
                class:list={["cu-sidebar-item", isActive && "cu-sidebar-item-active"]}
              >
                {item.icon === "chart-bar" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="12" x2="12" y1="20" y2="10" />
                    <line x1="18" x2="18" y1="20" y2="4" />
                    <line x1="6" x2="6" y1="20" y2="16" />
                  </svg>
                )}
                {item.icon === "package" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m7.5 4.27 9 5.15" />
                    <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
                    <path d="m3.3 7 8.7 5 8.7-5" />
                    <path d="M12 22V12" />
                  </svg>
                )}
                {item.icon === "receipt" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z" />
                    <path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8" />
                    <path d="M12 17.5v-11" />
                  </svg>
                )}
                {item.icon === "users" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                  </svg>
                )}
                {item.icon === "activity" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2" />
                  </svg>
                )}
                {item.icon === "settings" && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                    <circle cx="12" cy="12" r="3" />
                  </svg>
                )}
                <span class="flex-1">{item.label}</span>
                {item.count && (
                  <span class="cu-badge cu-badge-secondary cu-badge-sm">{item.count.toLocaleString()}</span>
                )}
              </a>
            );
          })}
        </nav>
      </div>
      <div class="mt-auto p-4 border-t border-border">
        <div class="flex items-center gap-3">
          <div class="cu-avatar cu-avatar-sm">
            <div class="cu-avatar-fallback">林</div>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium truncate">林小明</p>
            <p class="text-xs text-muted-foreground truncate">管理員</p>
          </div>
        </div>
      </div>
    </dialog>

    <script src={cubbyUiUrl} is:inline></script>
  </body>
</html>
