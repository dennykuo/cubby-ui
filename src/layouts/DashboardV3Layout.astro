---
import { withBase, stripBase } from "@/utils/paths";
import "@/styles/global.css";
import Avatar from "@/components/ui/Avatar.astro";
import AvatarFallback from "@/components/ui/AvatarFallback.astro";

interface Props {
    title: string;
}

const { title } = Astro.props;
// 去掉 base 與尾端斜線（build 輸出的 pathname 帶 `/`，導航資料不帶）
const pathname = stripBase(Astro.url.pathname).replace(/(.)\/$/, "$1");

// Navigation tabs
const navTabs = [
    { label: "Overview", href: "/examples/dashboard-v3" },
    { label: "Analytics", href: "/examples/dashboard-v3/analytics" },
    { label: "Customers", href: "/examples/dashboard-v3/customers" },
    { label: "Settings", href: "/examples/dashboard-v3/settings" },
];
---

<!doctype html>
<html lang="en" class="bg-stone-50" data-theme-nexus>
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Nexus — AI-Powered SaaS Analytics Platform" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <title>{title}</title>
        <style>
            body {
                font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            }
        </style>
        <style is:global>
            /* Nexus 品牌色：覆寫 primary / ring / chart-1 為 teal，語意 token 自動跟隨 */
            html[data-theme-nexus] {
                --color-primary: hsl(175 84% 32%);
                --color-primary-foreground: hsl(0 0% 100%);
                --color-ring: hsl(175 84% 32%);
                --color-chart-1: hsl(175 84% 32%);
            }

            html.dark[data-theme-nexus] {
                --color-primary: hsl(172 66% 50%);
                --color-primary-foreground: hsl(222 47% 11%);
                --color-ring: hsl(175 60% 28%);
                --color-chart-1: hsl(172 66% 50%);
            }
        </style>
    </head>
    <body
        class="min-h-screen antialiased text-foreground bg-stone-50"
    >
        <div class="flex min-h-screen">
            <!-- Mini Sidebar (Collapsible on Hover) -->
            <aside
                class="group/sidebar fixed inset-y-0 left-0 z-50 w-[60px] hover:w-[220px] transition-[width] duration-300 bg-white border-r border-border hidden md:flex flex-col"
                aria-label="Main navigation"
            >
                <!-- Sidebar Icons -->
                <div class="flex-1 py-6 px-3">
                    <nav class="flex flex-col gap-2">
                        <a
                            href={withBase("/examples/dashboard-v3")}
                            class:list={[
                                "flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors duration-200 group",
                                pathname === "/examples/dashboard-v3"
                                    ? "bg-primary/8 text-primary"
                                    : "text-muted-foreground hover:bg-muted/60 hover:text-foreground"
                            ]}
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="shrink-0"
                            >
                                <rect width="7" height="7" x="3" y="3" rx="1"/>
                                <rect width="7" height="7" x="14" y="3" rx="1"/>
                                <rect width="7" height="7" x="14" y="14" rx="1"/>
                                <rect width="7" height="7" x="3" y="14" rx="1"/>
                            </svg>
                            <span class="text-sm font-medium opacity-0 group-hover/sidebar:opacity-100 transition-opacity duration-300 whitespace-nowrap">Dashboard</span>
                        </a>
                        <a
                            href={withBase("/examples/dashboard-v3/analytics")}
                            class:list={[
                                "flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors duration-200 group",
                                pathname === "/examples/dashboard-v3/analytics"
                                    ? "bg-primary/8 text-primary"
                                    : "text-muted-foreground hover:bg-muted/60 hover:text-foreground"
                            ]}
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="shrink-0"
                            >
                                <line x1="18" x2="18" y1="20" y2="10"/>
                                <line x1="12" x2="12" y1="20" y2="4"/>
                                <line x1="6" x2="6" y1="20" y2="14"/>
                            </svg>
                            <span class="text-sm font-medium opacity-0 group-hover/sidebar:opacity-100 transition-opacity duration-300 whitespace-nowrap">Analytics</span>
                        </a>
                        <a
                            href={withBase("/examples/dashboard-v3/customers")}
                            class:list={[
                                "flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors duration-200 group",
                                pathname === "/examples/dashboard-v3/customers"
                                    ? "bg-primary/8 text-primary"
                                    : "text-muted-foreground hover:bg-muted/60 hover:text-foreground"
                            ]}
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="shrink-0"
                            >
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                                <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                            </svg>
                            <span class="text-sm font-medium opacity-0 group-hover/sidebar:opacity-100 transition-opacity duration-300 whitespace-nowrap">Customers</span>
                        </a>
                        <a
                            href={withBase("/examples/dashboard-v3/settings")}
                            class:list={[
                                "flex items-center gap-3 px-3 py-2.5 rounded-lg transition-colors duration-200 group",
                                pathname === "/examples/dashboard-v3/settings"
                                    ? "bg-primary/8 text-primary"
                                    : "text-muted-foreground hover:bg-muted/60 hover:text-foreground"
                            ]}
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="shrink-0"
                            >
                                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                            <span class="text-sm font-medium opacity-0 group-hover/sidebar:opacity-100 transition-opacity duration-300 whitespace-nowrap">Settings</span>
                        </a>
                    </nav>
                </div>

                <!-- Help Icon at Bottom -->
                <div class="p-3 border-t border-border">
                    <button
                        class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-muted-foreground hover:bg-muted/60 hover:text-foreground transition-colors duration-200 w-full group"
                        aria-label="Help"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="shrink-0"
                        >
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
                            <path d="M12 17h.01"/>
                        </svg>
                        <span class="text-sm font-medium opacity-0 group-hover/sidebar:opacity-100 transition-opacity duration-300 whitespace-nowrap">Help</span>
                    </button>
                </div>
            </aside>

            <!-- Main Area -->
            <div class="flex flex-col flex-1 min-w-0 md:pl-[60px]">
                <!-- Header (Sticky) -->
                <header
                    class="sticky top-0 z-40 flex items-center h-16 px-6 bg-white/80 backdrop-blur-xl border-b border-border"
                >
                    <div class="flex items-center gap-4 md:gap-8 flex-1">
                        <!-- Mobile menu toggle -->
                        <button class="md:hidden p-2 -ml-2 text-muted-foreground hover:text-foreground transition-colors duration-150" aria-label="Open menu" data-cu-dashboard-v3-toggle aria-expanded="false">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
                        </button>
                        <!-- Brand Logo -->
                        <a href={withBase("/examples/dashboard-v3")} class="flex items-center gap-2.5 font-bold text-lg">
                            <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-gradient-to-br from-teal-600 to-emerald-600 text-white shadow-md">
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    width="18"
                                    height="18"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path d="m8 3 4 8 5-5 5 15H2L8 3z"/>
                                </svg>
                            </div>
                            <span class="bg-gradient-to-r from-teal-700 to-emerald-700 bg-clip-text text-transparent">Nexus</span>
                        </a>

                        <!-- Horizontal Nav Tabs -->
                        <nav class="hidden md:flex items-center gap-1">
                            {navTabs.map((tab) => {
                                const isActive = pathname === tab.href;
                                return (
                                    <a
                                        href={withBase(tab.href)}
                                        class:list={[
                                            "px-3 py-2 text-sm font-medium rounded-md transition-colors duration-200",
                                            isActive
                                                ? "bg-primary/8 text-primary"
                                                : "text-muted-foreground hover:text-foreground hover:bg-muted/50"
                                        ]}
                                    >
                                        {tab.label}
                                    </a>
                                );
                            })}
                        </nav>
                    </div>

                    <!-- Header Right Actions -->
                    <div class="flex items-center gap-3">
                        <!-- Command Palette Trigger -->
                        <button class="hidden sm:flex items-center gap-2 px-3 py-1.5 text-sm text-muted-foreground bg-muted/50 hover:bg-muted rounded-md border border-border transition-colors duration-150" aria-label="Search">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <circle cx="11" cy="11" r="8"/>
                                <path d="m21 21-4.3-4.3"/>
                            </svg>
                            <span>Search...</span>
                            <kbd class="ml-1 text-[10px] font-mono text-muted-foreground/70">⌘K</kbd>
                        </button>

                        <!-- Notification Bell with Red Dot -->
                        <button class="relative p-2 text-muted-foreground hover:text-foreground hover:bg-muted/60 rounded-lg transition-colors duration-150" aria-label="Notifications">
                            <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/>
                                <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>
                            </svg>
                        </button>

                        <div class="h-6 w-px bg-border"></div>

                        <!-- User Avatar -->
                        <button class="flex items-center gap-2 hover:bg-muted/60 rounded-full pr-3 pl-1 py-1 transition-colors duration-150" aria-label="User menu">
                            <Avatar class="w-8 h-8">
                                <AvatarFallback class="bg-gradient-to-br from-teal-600 to-emerald-600 text-white text-xs font-semibold">JD</AvatarFallback>
                            </Avatar>
                            <span class="hidden md:inline text-sm font-medium text-foreground">Jane Doe</span>
                        </button>
                    </div>
                </header>

                <!-- Main Content -->
                <main class="flex-1 p-6" aria-label="Main content">
                    <slot />
                </main>
            </div>
        </div>

        <!-- Mobile sidebar overlay -->
        <div class="fixed inset-0 z-40 bg-black/50 hidden md:hidden" data-cu-dashboard-v3-overlay></div>

        <script>
            const toggle = document.querySelector("[data-cu-dashboard-v3-toggle]");
            const sidebar = document.querySelector("aside[aria-label]");
            const overlay = document.querySelector("[data-cu-dashboard-v3-overlay]");

            function openMenu() {
                sidebar?.classList.remove("hidden");
                sidebar?.classList.add("flex", "flex-col", "w-[220px]");
                overlay?.classList.remove("hidden");
                toggle?.setAttribute("aria-expanded", "true");
                const firstLink = sidebar?.querySelector("a");
                firstLink?.focus();
            }

            function closeMenu() {
                sidebar?.classList.add("hidden");
                sidebar?.classList.remove("flex", "flex-col", "w-[220px]");
                overlay?.classList.add("hidden");
                toggle?.setAttribute("aria-expanded", "false");
                toggle?.focus();
            }

            toggle?.addEventListener("click", openMenu);
            overlay?.addEventListener("click", closeMenu);
            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape" && !overlay?.classList.contains("hidden")) {
                    closeMenu();
                }
            });
        </script>
    </body>
</html>
