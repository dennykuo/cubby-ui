---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Sidebar from "../components/sidebar/Sidebar.astro";
import cubbyUiUrl from "../scripts/cubby-ui.js?url";

interface Props {
	title: string;
	category?: string;
	componentName?: string;
}

const { title, category, componentName } = Astro.props;
const pathname = Astro.url.pathname;
const normalizedPath =
	pathname.endsWith("/") && pathname.length > 1
		? pathname.slice(0, -1)
		: pathname;
const isComponentPage = !!category && !!componentName;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Elegant Tailwind CSS Components" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<script src={cubbyUiUrl} is:inline></script>
	<script is:inline>document.addEventListener('astro:page-load', () => CubbyUI.init());</script>
	<script>
		function setupInlineCodeCopy() {
			document.querySelectorAll('.cu-code').forEach((el) => {
				if (el.dataset.cuCodeCopy) return;
				el.dataset.cuCodeCopy = 'true';
				el.title = '點擊複製';
				el.addEventListener('click', async () => {
					const text = el.textContent || '';
					try {
						await navigator.clipboard.writeText(text);
						const original = el.textContent;
						el.textContent = '已複製！';
						setTimeout(() => { el.textContent = original; }, 1200);
					} catch (e) {}
				});
			});
		}
		setupInlineCodeCopy();
		document.addEventListener('astro:page-load', setupInlineCodeCopy);
	</script>
	<body class="min-h-screen font-sans">
		<div class="relative flex min-h-screen flex-col">
			<Header />

			<div class="flex-1 flex">
				<Sidebar currentPath={normalizedPath} />

				<main class="flex-1 min-w-0 md:border-l md:border-border pt-6 pb-20 px-4 sm:px-6 md:pt-8 md:pb-26 md:px-8 lg:px-12">
					<div class="mx-auto max-w-3xl">
							<slot />
					</div>
				</main>
			</div>
		</div>
	</body>
</html>
