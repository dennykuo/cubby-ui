---
import "@/styles/global.css";
import Sidebar from "@/components/ui/Sidebar.astro";
import SidebarHeader from "@/components/ui/SidebarHeader.astro";
import SidebarContent from "@/components/ui/SidebarContent.astro";
import SidebarFooter from "@/components/ui/SidebarFooter.astro";
import SidebarGroup from "@/components/ui/SidebarGroup.astro";
import SidebarGroupTitle from "@/components/ui/SidebarGroupTitle.astro";
import Avatar from "@/components/ui/Avatar.astro";
import AvatarFallback from "@/components/ui/AvatarFallback.astro";

interface Props {
    title: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;
const normalizedPath = pathname.endsWith("/") && pathname.length > 1 ? pathname.slice(0, -1) : pathname;

const navGroups = [
    {
        title: "主要功能",
        items: [
            { label: "數據總覽", href: "/examples/dashboard-v4", icon: "layout-dashboard" },
            { label: "分析報表", href: "/examples/dashboard-v4/analytics", icon: "chart-bar" },
            { label: "客戶管理", href: "/examples/dashboard-v4/customers", icon: "users" },
        ],
    },
    {
        title: "系統",
        items: [
            { label: "偏好設定", href: "/examples/dashboard-v4/settings", icon: "settings" },
        ],
    },
];
---

<!doctype html>
<html lang="zh-Hant" class="bg-slate-50">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Dashboard V4 — Cubby UI" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <title>{title}</title>
    </head>
    <body class="min-h-screen font-sans antialiased text-foreground bg-slate-50">
        <div class="flex min-h-screen">
            <!-- Sidebar -->
            <Sidebar
                class="hidden lg:flex fixed inset-y-0 left-0 z-40 w-60 flex-col bg-white border-r border-slate-200/80"
                data-cu-dashboard-sidebar
                aria-label="主導航"
            >
                <SidebarHeader class="h-16 flex items-center px-5 border-b border-slate-100">
                    <a
                        class="flex items-center gap-2.5 font-semibold text-base tracking-tight"
                        href="/examples/dashboard-v4"
                    >
                        <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-gradient-to-br from-violet-500 to-purple-600 text-white shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                <polyline points="2 17 12 22 22 17"></polyline>
                                <polyline points="2 12 12 17 22 12"></polyline>
                            </svg>
                        </div>
                        <span class="text-slate-800">Prism</span>
                        <span class="text-[10px] font-medium text-violet-600 bg-violet-50 px-1.5 py-0.5 rounded">PRO</span>
                    </a>
                </SidebarHeader>
                <SidebarContent class="px-3 py-5 flex-1 overflow-y-auto">
                    {navGroups.map((group) => (
                        <SidebarGroup class="mb-6">
                            <SidebarGroupTitle class="px-3 text-[11px] font-semibold text-slate-400 uppercase tracking-wider mb-2">
                                {group.title}
                            </SidebarGroupTitle>
                            <nav class="flex flex-col gap-0.5">
                                {group.items.map((item) => {
                                    const isActive = normalizedPath === item.href ||
                                        (item.href !== "/examples/dashboard-v4" && normalizedPath.startsWith(item.href));
                                    return (
                                        <a
                                            href={item.href}
                                            class:list={[
                                                "flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-lg transition-all duration-150",
                                                isActive
                                                    ? "bg-violet-50 text-violet-700 shadow-sm"
                                                    : "text-slate-600 hover:text-slate-900 hover:bg-slate-50",
                                            ]}
                                        >
                                            {item.icon === "layout-dashboard" && (
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={isActive ? "text-violet-600" : "text-slate-400"}>
                                                    <rect width="7" height="9" x="3" y="3" rx="1"></rect>
                                                    <rect width="7" height="5" x="14" y="3" rx="1"></rect>
                                                    <rect width="7" height="9" x="14" y="12" rx="1"></rect>
                                                    <rect width="7" height="5" x="3" y="16" rx="1"></rect>
                                                </svg>
                                            )}
                                            {item.icon === "chart-bar" && (
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={isActive ? "text-violet-600" : "text-slate-400"}>
                                                    <line x1="12" x2="12" y1="20" y2="10"></line>
                                                    <line x1="18" x2="18" y1="20" y2="4"></line>
                                                    <line x1="6" x2="6" y1="20" y2="16"></line>
                                                </svg>
                                            )}
                                            {item.icon === "users" && (
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={isActive ? "text-violet-600" : "text-slate-400"}>
                                                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                                                    <circle cx="9" cy="7" r="4"></circle>
                                                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                                </svg>
                                            )}
                                            {item.icon === "settings" && (
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={isActive ? "text-violet-600" : "text-slate-400"}>
                                                    <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
                                                    <circle cx="12" cy="12" r="3"></circle>
                                                </svg>
                                            )}
                                            {item.label}
                                        </a>
                                    );
                                })}
                            </nav>
                        </SidebarGroup>
                    ))}
                </SidebarContent>
                <SidebarFooter class="p-4 border-t border-slate-100">
                    <div class="flex items-center gap-3 p-2 rounded-lg bg-slate-50">
                        <Avatar class="w-9 h-9 shrink-0">
                            <AvatarFallback class="bg-gradient-to-br from-violet-400 to-purple-500 text-white text-sm">林</AvatarFallback>
                        </Avatar>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-slate-700 truncate">林小明</p>
                            <p class="text-[11px] text-slate-500 truncate">管理員</p>
                        </div>
                        <button class="p-1.5 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-md transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" x2="9" y1="12" y2="12"></line>
                            </svg>
                        </button>
                    </div>
                </SidebarFooter>
            </Sidebar>

            <!-- Main Area -->
            <div class="flex flex-col flex-1 min-w-0 lg:pl-60">
                <!-- Header -->
                <header class="sticky top-0 z-30 flex items-center h-16 px-4 sm:px-6 lg:px-8 bg-white/90 backdrop-blur-md border-b border-slate-200/60">
                    <div class="flex items-center gap-4 flex-1">
                        <!-- Mobile menu button -->
                        <button class="lg:hidden p-2 -ml-2 text-slate-500 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="4" x2="20" y1="12" y2="12"></line>
                                <line x1="4" x2="20" y1="6" y2="6"></line>
                                <line x1="4" x2="20" y1="18" y2="18"></line>
                            </svg>
                        </button>

                        <!-- Search -->
                        <div class="relative w-full max-w-md hidden sm:block">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">
                                <circle cx="11" cy="11" r="8"></circle>
                                <path d="m21 21-4.3-4.3"></path>
                            </svg>
                            <input
                                type="text"
                                placeholder="搜尋任何內容..."
                                class="w-full h-10 pl-10 pr-4 text-sm bg-slate-50 border border-slate-200 rounded-lg placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-violet-500/20 focus:border-violet-400 transition-all"
                            />
                        </div>
                    </div>

                    <div class="flex items-center gap-2">
                        <!-- Notification -->
                        <button class="relative p-2 text-slate-500 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition-colors">
                            <span class="absolute top-2 right-2 w-2 h-2 bg-violet-500 rounded-full ring-2 ring-white"></span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
                                <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
                            </svg>
                        </button>

                        <div class="h-6 w-px bg-slate-200 mx-1"></div>

                        <!-- User -->
                        <button class="flex items-center gap-2 hover:bg-slate-100 rounded-lg pr-2 pl-1 py-1 transition-colors">
                            <Avatar class="w-8 h-8">
                                <AvatarFallback class="bg-gradient-to-br from-violet-400 to-purple-500 text-white text-xs">林</AvatarFallback>
                            </Avatar>
                            <span class="hidden md:inline text-sm font-medium text-slate-700">林小明</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 hidden md:block">
                                <path d="m6 9 6 6 6-6"></path>
                            </svg>
                        </button>
                    </div>
                </header>

                <!-- Main Content -->
                <main class="flex-1 py-6 px-4 sm:px-6 lg:px-8">
                    <div class="max-w-7xl mx-auto">
                        <slot />
                    </div>
                </main>
            </div>
        </div>
    </body>
</html>
