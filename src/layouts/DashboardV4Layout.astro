---
import { withBase, stripBase } from "@/utils/paths";
import "@/styles/global.css";
import Sidebar from "@/components/ui/Sidebar.astro";
import SidebarHeader from "@/components/ui/SidebarHeader.astro";
import SidebarContent from "@/components/ui/SidebarContent.astro";
import SidebarFooter from "@/components/ui/SidebarFooter.astro";
import SidebarGroup from "@/components/ui/SidebarGroup.astro";
import SidebarGroupTitle from "@/components/ui/SidebarGroupTitle.astro";
import Avatar from "@/components/ui/Avatar.astro";
import AvatarFallback from "@/components/ui/AvatarFallback.astro";

interface Props {
    title: string;
}

const { title } = Astro.props;
const pathname = stripBase(Astro.url.pathname);
const normalizedPath = pathname.endsWith("/") && pathname.length > 1 ? pathname.slice(0, -1) : pathname;

const navGroups = [
    {
        title: "主要功能",
        items: [
            { label: "數據總覽", href: "/examples/dashboard-v4", icon: "layout-dashboard" },
            { label: "分析報表", href: "/examples/dashboard-v4/analytics", icon: "chart-bar" },
            { label: "客戶管理", href: "/examples/dashboard-v4/customers", icon: "users" },
        ],
    },
    {
        title: "系統",
        items: [
            { label: "偏好設定", href: "/examples/dashboard-v4/settings", icon: "settings" },
        ],
    },
];
---

<!doctype html>
<html lang="zh-Hant" data-theme-prism>
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Dashboard V4 — Cubby UI" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <title>{title}</title>
        <style is:global>
            /* Prism 品牌色：覆寫 primary / ring / chart-1，其餘元件透過語意 token 自動跟隨 */
            html[data-theme-prism] {
                --color-primary: hsl(262 83% 58%);
                --color-primary-foreground: hsl(0 0% 100%);
                --color-ring: hsl(262 83% 58%);
                --color-chart-1: hsl(262 83% 58%);
            }

            html.dark[data-theme-prism] {
                --color-primary: hsl(258 90% 66%);
                --color-primary-foreground: hsl(0 0% 100%);
                --color-ring: hsl(263 60% 40%);
                --color-chart-1: hsl(258 90% 66%);
            }
        </style>
    </head>
    <body class="min-h-screen font-sans antialiased text-foreground bg-muted/40">
        <a
            href="#main-content"
            class="cu-button cu-button-default cu-button-sm sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60]"
        >跳至主要內容</a>

        <div class="flex min-h-screen">
            <!-- Sidebar overlay (mobile) -->
            <div class="fixed inset-0 z-40 bg-foreground/30 hidden lg:hidden" data-cu-dashboard-v4-overlay></div>

            <!-- Sidebar -->
            <Sidebar
                id="dashboard-v4-sidebar"
                class="fixed inset-y-0 left-0 z-50 w-60 flex flex-col bg-card border-r border-border -translate-x-full lg:translate-x-0 transition-transform duration-200"
                aria-label="側邊導覽"
            >
                <SidebarHeader class="h-16 flex items-center px-5 border-b border-border/60">
                    <a
                        class="flex items-center gap-2.5 font-semibold text-base tracking-tight"
                        href={withBase("/examples/dashboard-v4")}
                    >
                        <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-gradient-to-br from-violet-500 to-purple-600 text-white shadow-sm" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                <polyline points="2 17 12 22 22 17"></polyline>
                                <polyline points="2 12 12 17 22 12"></polyline>
                            </svg>
                        </div>
                        <span class="text-foreground">Prism</span>
                        <span class="text-[10px] font-medium text-primary bg-primary/10 px-1.5 py-0.5 rounded">PRO</span>
                    </a>
                </SidebarHeader>
                <SidebarContent class="px-3 py-5 flex-1 overflow-y-auto">
                    {navGroups.map((group) => (
                        <SidebarGroup class="mb-6">
                            <SidebarGroupTitle class="px-3 text-[11px] font-semibold text-muted-foreground/70 tracking-wider mb-2">
                                {group.title}
                            </SidebarGroupTitle>
                            <nav class="flex flex-col gap-0.5" aria-label={group.title}>
                                {group.items.map((item) => {
                                    const isActive = normalizedPath === item.href ||
                                        (item.href !== "/examples/dashboard-v4" && normalizedPath.startsWith(item.href));
                                    const iconClass = isActive ? "text-primary" : "text-muted-foreground/70";
                                    return (
                                        <a
                                            href={withBase(item.href)}
                                            class:list={[
                                                "cu-sidebar-item gap-3 py-2 text-sm font-medium focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring/30",
                                                isActive && "cu-sidebar-item-active",
                                            ]}
                                            aria-current={isActive ? "page" : undefined}
                                        >
                                            {item.icon === "layout-dashboard" && (
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={iconClass} aria-hidden="true">
                                                    <rect width="7" height="9" x="3" y="3" rx="1"></rect>
                                                    <rect width="7" height="5" x="14" y="3" rx="1"></rect>
                                                    <rect width="7" height="9" x="14" y="12" rx="1"></rect>
                                                    <rect width="7" height="5" x="3" y="16" rx="1"></rect>
                                                </svg>
                                            )}
                                            {item.icon === "chart-bar" && (
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={iconClass} aria-hidden="true">
                                                    <line x1="12" x2="12" y1="20" y2="10"></line>
                                                    <line x1="18" x2="18" y1="20" y2="4"></line>
                                                    <line x1="6" x2="6" y1="20" y2="16"></line>
                                                </svg>
                                            )}
                                            {item.icon === "users" && (
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={iconClass} aria-hidden="true">
                                                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                                                    <circle cx="9" cy="7" r="4"></circle>
                                                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                                </svg>
                                            )}
                                            {item.icon === "settings" && (
                                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={iconClass} aria-hidden="true">
                                                    <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
                                                    <circle cx="12" cy="12" r="3"></circle>
                                                </svg>
                                            )}
                                            {item.label}
                                        </a>
                                    );
                                })}
                            </nav>
                        </SidebarGroup>
                    ))}
                </SidebarContent>
                <SidebarFooter class="p-4 border-t border-border/60">
                    <div class="flex items-center gap-3 p-2 rounded-lg bg-muted/50">
                        <Avatar class="w-9 h-9 shrink-0">
                            <AvatarFallback class="bg-primary text-primary-foreground text-sm">林</AvatarFallback>
                        </Avatar>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-foreground truncate">林小明</p>
                            <p class="text-[11px] text-muted-foreground truncate">管理員</p>
                        </div>
                        <a
                            href={withBase("/examples/dashboard-v4/login")}
                            class="cu-button cu-button-ghost cu-button-icon-xs"
                            aria-label="登出"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" x2="9" y1="12" y2="12"></line>
                            </svg>
                        </a>
                    </div>
                </SidebarFooter>
            </Sidebar>

            <!-- Main Area -->
            <div class="flex flex-col flex-1 min-w-0 lg:pl-60">
                <!-- Header -->
                <header class="sticky top-0 z-30 flex items-center h-16 px-4 sm:px-6 lg:px-8 bg-background/90 backdrop-blur-md border-b border-border/60">
                    <div class="flex items-center gap-4 flex-1">
                        <!-- Mobile menu button -->
                        <button
                            type="button"
                            class="cu-button cu-button-ghost cu-button-icon lg:hidden -ml-2"
                            aria-label="開啟導航選單"
                            aria-controls="dashboard-v4-sidebar"
                            aria-expanded="false"
                            data-cu-dashboard-v4-toggle
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <line x1="4" x2="20" y1="12" y2="12"></line>
                                <line x1="4" x2="20" y1="6" y2="6"></line>
                                <line x1="4" x2="20" y1="18" y2="18"></line>
                            </svg>
                        </button>

                        <!-- Search -->
                        <div class="cu-input-search w-full max-w-md hidden sm:flex" role="search">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cu-input-search-icon" aria-hidden="true">
                                <circle cx="11" cy="11" r="8"></circle>
                                <path d="m21 21-4.3-4.3"></path>
                            </svg>
                            <input
                                type="search"
                                placeholder="搜尋任何內容..."
                                aria-label="搜尋"
                                class="cu-input-search-field h-10 bg-muted/50"
                            />
                        </div>
                    </div>

                    <div class="flex items-center gap-2">
                        <!-- Notification -->
                        <button type="button" class="cu-button cu-button-ghost cu-button-icon relative" aria-label="通知（有未讀）">
                            <span class="absolute top-2 right-2 w-2 h-2 bg-primary rounded-full ring-2 ring-background" aria-hidden="true"></span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
                                <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
                            </svg>
                        </button>

                        <div class="h-6 w-px bg-border mx-1" aria-hidden="true"></div>

                        <!-- User -->
                        <button
                            type="button"
                            class="flex items-center gap-2 hover:bg-muted rounded-lg pr-2 pl-1 py-1 transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40"
                            aria-label="使用者選單：林小明"
                        >
                            <Avatar class="w-8 h-8">
                                <AvatarFallback class="bg-primary text-primary-foreground text-xs">林</AvatarFallback>
                            </Avatar>
                            <span class="hidden md:inline text-sm font-medium text-foreground">林小明</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground hidden md:block" aria-hidden="true">
                                <path d="m6 9 6 6 6-6"></path>
                            </svg>
                        </button>
                    </div>
                </header>

                <!-- Main Content -->
                <main id="main-content" class="flex-1 py-6 px-4 sm:px-6 lg:px-8" tabindex="-1">
                    <div class="max-w-7xl mx-auto">
                        <slot />
                    </div>
                </main>
            </div>
        </div>

        <script>
            const toggle = document.querySelector<HTMLButtonElement>("[data-cu-dashboard-v4-toggle]");
            const sidebar = document.getElementById("dashboard-v4-sidebar");
            const overlay = document.querySelector<HTMLElement>("[data-cu-dashboard-v4-overlay]");
            const desktop = window.matchMedia("(min-width: 1024px)");

            function setOpen(open: boolean, restoreFocus = true) {
                if (!toggle || !sidebar || !overlay) return;
                sidebar.classList.toggle("-translate-x-full", !open);
                overlay.classList.toggle("hidden", !open);
                toggle.setAttribute("aria-expanded", String(open));
                // 收合在畫面外時阻止 Tab 走進 sidebar
                sidebar.inert = !open && !desktop.matches;
                if (open) (sidebar.querySelector<HTMLElement>("[aria-current='page']") ?? sidebar.querySelector("a"))?.focus();
                else if (restoreFocus) toggle.focus();
            }

            if (sidebar) sidebar.inert = !desktop.matches;
            toggle?.addEventListener("click", () => setOpen(true));
            overlay?.addEventListener("click", () => setOpen(false));
            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") setOpen(false);
            });
            desktop.addEventListener("change", () => setOpen(false, false));
        </script>
    </body>
</html>
