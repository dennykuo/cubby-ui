---
import "@/styles/global.css";
import Sidebar from "@/components/ui/Sidebar.astro";
import SidebarContent from "@/components/ui/SidebarContent.astro";
import SidebarFooter from "@/components/ui/SidebarFooter.astro";
import SidebarItem from "@/components/ui/SidebarItem.astro";
import SidebarHeader from "@/components/ui/SidebarHeader.astro";
import SidebarGroup from "@/components/ui/SidebarGroup.astro";
import SidebarGroupTitle from "@/components/ui/SidebarGroupTitle.astro";
import Header from "@/components/ui/Header.astro";
import HeaderInner from "@/components/ui/HeaderInner.astro";
import HeaderActions from "@/components/ui/HeaderActions.astro";
import Avatar from "@/components/ui/Avatar.astro";
import AvatarFallback from "@/components/ui/AvatarFallback.astro";
import Input from "@/components/ui/Input.astro";

interface Props {
    title: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;

// Enhanced Navigation Structure
const navGroups = [
    {
        title: "平台管理",
        items: [
            {
                label: "營運總覽",
                href: "/examples/dashboard-v2",
                icon: "layout-grid",
            },
            {
                label: "數據分析",
                href: "/examples/dashboard-v2/analytics",
                icon: "bar-chart",
            },
        ],
    },
    {
        title: "應用程式",
        items: [
            {
                label: "商品管理",
                href: "/examples/dashboard-v2/products",
                icon: "box",
            },
            {
                label: "團隊成員",
                href: "/examples/dashboard-v2/team",
                icon: "users",
            },
            {
                label: "文件中心",
                href: "/examples/dashboard-v2/documents",
                icon: "file-text",
            },
            {
                label: "訊息通知",
                href: "/examples/dashboard-v2/messages",
                icon: "mail",
            },
        ],
    },
    {
        title: "系統設定",
        items: [
            {
                label: "帳號設定",
                href: "/examples/dashboard-v2/settings",
                icon: "settings",
            },
            {
                label: "API 金鑰",
                href: "/examples/dashboard-v2/api",
                icon: "key",
            },
        ],
    },
];
---

<!doctype html>
<html lang="zh-Hant" class="bg-gray-50/50">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Dashboard V2 — Cubby UI" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=onest:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <title>{title}</title>
    </head>
    <body
        class="min-h-screen font-sans antialiased text-foreground bg-background"
    >
        <div class="flex min-h-screen">
            <!-- Sidebar (Dark Mode Style for V2) -->
            <Sidebar
                class="hidden lg:flex fixed inset-y-0 left-0 z-50 w-64 flex-col bg-[#0F172A] text-white border-r-0"
                data-cu-dashboard-sidebar
                aria-label="主導航"
            >
                <SidebarHeader
                    class="h-16 flex items-center px-6 border-b border-white/10"
                >
                    <a
                        class="flex items-center gap-2.5 font-bold text-lg tracking-tight"
                        href="/examples/dashboard-v2"
                    >
                        <div
                            class="flex items-center justify-center w-8 h-8 rounded-lg bg-indigo-500 text-white"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="18"
                                height="18"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path
                                    d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
                                ></path></svg
                            >
                        </div>
                        Cubby<span class="text-indigo-400">Pro</span>
                    </a>
                </SidebarHeader>
                <SidebarContent class="px-3 py-4 gap-6">
                    {
                        navGroups.map((group) => (
                            <SidebarGroup>
                                <SidebarGroupTitle class="px-3 text-xs font-medium text-slate-400 uppercase tracking-wider mb-2">
                                    {group.title}
                                </SidebarGroupTitle>
                                <nav class="flex flex-col gap-0.5">
                                    {group.items.map((item) => {
                                        const isActive = pathname === item.href;
                                        return (
                                            <a
                                                href={item.href}
                                                class:list={[
                                                    "flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md transition-colors duration-200",
                                                    isActive
                                                        ? "bg-indigo-500 text-white shadow-sm"
                                                        : "text-slate-400 hover:text-white hover:bg-white/5",
                                                ]}
                                            >
                                                {/* Icons */}
                                                {item.icon ===
                                                    "layout-grid" && (
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        width="18"
                                                        height="18"
                                                        viewBox="0 0 24 24"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        stroke-width="2"
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                    >
                                                        <rect
                                                            width="7"
                                                            height="7"
                                                            x="3"
                                                            y="3"
                                                            rx="1"
                                                        />
                                                        <rect
                                                            width="7"
                                                            height="7"
                                                            x="14"
                                                            y="3"
                                                            rx="1"
                                                        />
                                                        <rect
                                                            width="7"
                                                            height="7"
                                                            x="14"
                                                            y="14"
                                                            rx="1"
                                                        />
                                                        <rect
                                                            width="7"
                                                            height="7"
                                                            x="3"
                                                            y="14"
                                                            rx="1"
                                                        />
                                                    </svg>
                                                )}
                                                {item.icon === "bar-chart" && (
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        width="18"
                                                        height="18"
                                                        viewBox="0 0 24 24"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        stroke-width="2"
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                    >
                                                        <line
                                                            x1="12"
                                                            x2="12"
                                                            y1="20"
                                                            y2="10"
                                                        />
                                                        <line
                                                            x1="18"
                                                            x2="18"
                                                            y1="20"
                                                            y2="4"
                                                        />
                                                        <line
                                                            x1="6"
                                                            x2="6"
                                                            y1="20"
                                                            y2="16"
                                                        />
                                                    </svg>
                                                )}
                                                {item.icon === "box" && (
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        width="18"
                                                        height="18"
                                                        viewBox="0 0 24 24"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        stroke-width="2"
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                    >
                                                        <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
                                                        <path d="m3.3 7 8.7 5 8.7-5" />
                                                        <path d="M12 22V12" />
                                                    </svg>
                                                )}
                                                {item.icon === "briefcase" && (
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        width="18"
                                                        height="18"
                                                        viewBox="0 0 24 24"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        stroke-width="2"
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                    >
                                                        <rect
                                                            width="20"
                                                            height="14"
                                                            x="2"
                                                            y="7"
                                                            rx="2"
                                                            ry="2"
                                                        />
                                                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                                                    </svg>
                                                )}
                                                {item.icon === "users" && (
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        width="18"
                                                        height="18"
                                                        viewBox="0 0 24 24"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        stroke-width="2"
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                    >
                                                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                                        <circle
                                                            cx="9"
                                                            cy="7"
                                                            r="4"
                                                        />
                                                        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                                                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                                                    </svg>
                                                )}
                                                {item.icon === "file-text" && (
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        width="18"
                                                        height="18"
                                                        viewBox="0 0 24 24"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        stroke-width="2"
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                    >
                                                        <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                                                        <polyline points="14 2 14 8 20 8" />
                                                    </svg>
                                                )}
                                                {item.icon === "mail" && (
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        width="18"
                                                        height="18"
                                                        viewBox="0 0 24 24"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        stroke-width="2"
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                    >
                                                        <rect
                                                            width="20"
                                                            height="16"
                                                            x="2"
                                                            y="4"
                                                            rx="2"
                                                        />
                                                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                                                    </svg>
                                                )}
                                                {item.icon === "settings" && (
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        width="18"
                                                        height="18"
                                                        viewBox="0 0 24 24"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        stroke-width="2"
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                    >
                                                        <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                                                        <circle
                                                            cx="12"
                                                            cy="12"
                                                            r="3"
                                                        />
                                                    </svg>
                                                )}
                                                {item.icon === "key" && (
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        width="18"
                                                        height="18"
                                                        viewBox="0 0 24 24"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        stroke-width="2"
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                    >
                                                        <circle
                                                            cx="7.5"
                                                            cy="15.5"
                                                            r="5.5"
                                                        />
                                                        <path d="m21 2-9.6 9.6" />
                                                        <path d="m15.5 7.5 3 3L22 7l-3-3" />
                                                    </svg>
                                                )}

                                                {item.label}
                                            </a>
                                        );
                                    })}
                                </nav>
                            </SidebarGroup>
                        ))
                    }
                </SidebarContent>
                <SidebarFooter class="p-4 border-t border-white/10">
                    <div
                        class="flex items-center gap-3 p-2 rounded-md bg-white/5 border border-white/5"
                    >
                        <Avatar class="w-8 h-8 rounded shrink-0">
                            <AvatarFallback class="bg-indigo-500 text-white"
                                >DK</AvatarFallback
                            >
                        </Avatar>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-white truncate">
                                Denny Kuo
                            </p>
                            <p class="text-[11px] text-slate-400 truncate">
                                Pro 方案會員
                            </p>
                        </div>
                    </div>
                </SidebarFooter>
            </Sidebar>

            <!-- Main Area -->
            <div
                class="flex flex-col flex-1 min-w-0 lg:pl-64 transition-all duration-300"
            >
                <!-- Header (Sticky, Blurred) -->
                <header
                    class="sticky top-0 z-30 flex items-center h-16 px-4 sm:px-6 lg:px-8 bg-background/80 backdrop-blur-md border-b border-border/60"
                >
                    <div class="flex items-center gap-4 flex-1">
                        <button
                            class="lg:hidden p-2 -ml-2 text-muted-foreground hover:text-foreground"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><line x1="4" x2="20" y1="12" y2="12"
                                ></line><line x1="4" x2="20" y1="6" y2="6"
                                ></line><line x1="4" x2="20" y1="18" y2="18"
                                ></line></svg
                            >
                        </button>

                        <!-- Global Search Command Palette Trigger -->
                        <div
                            class="relative w-full max-w-sm hidden sm:block group"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="16"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground group-hover:text-primary transition-colors"
                                ><circle cx="11" cy="11" r="8"></circle><path
                                    d="m21 21-4.3-4.3"></path></svg
                            >
                            <input
                                type="text"
                                placeholder="搜尋專案、檔案或成員..."
                                class="flex h-9 w-full rounded-md border border-input bg-background/50 px-3 py-1 pl-9 text-sm shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50"
                            />
                            <div
                                class="absolute right-2 top-1/2 -translate-y-1/2 flex gap-0.5"
                            >
                                <kbd
                                    class="pointer-events-none inline-flex h-5 select-none items-center gap-1 rounded border bg-muted px-1.5 font-mono text-[10px] font-medium text-muted-foreground opacity-100"
                                    ><span class="text-xs">⌘</span>K</kbd
                                >
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center gap-3">
                        <button
                            class="relative p-2 text-muted-foreground hover:bg-muted rounded-full transition-colors"
                        >
                            <span
                                class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full border-2 border-background"
                            ></span>
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><path
                                    d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"
                                ></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"
                                ></path></svg
                            >
                        </button>
                        <div class="h-8 w-[1px] bg-border mx-1"></div>
                        <button
                            class="flex items-center gap-2 hover:bg-muted rounded-full pr-3 pl-1 py-1 transition-colors"
                        >
                            <Avatar class="w-8 h-8">
                                <AvatarFallback
                                    class="bg-indigo-100 text-indigo-700"
                                    >DK</AvatarFallback
                                >
                            </Avatar>
                            <span class="hidden md:inline text-sm font-medium"
                                >Denny</span
                            >
                        </button>
                    </div>
                </header>

                <!-- Main Content -->
                <main class="flex-1 py-8 px-4 sm:px-6 lg:px-8">
                    <slot />
                </main>
            </div>
        </div>
    </body>
</html>
