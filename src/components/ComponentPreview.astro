---
import { Code } from "astro-expressive-code/components";

interface Props {
    class?: string;
    code?: string;
    align?: "center" | "start" | "end";
}

const { class: className, code = "", align = "center" } = Astro.props;
---

<div
    class:list={[
        "group relative rounded-xl border border-border bg-background",
        className,
    ]}
    data-component-preview
>
    <div
        class="flex items-center justify-between border-b border-border/40 px-4 py-2.5"
    >
        <div class="flex items-center gap-1 p-0.5 bg-muted/40 rounded-lg">
            <button
                class="text-xs font-medium px-3 py-1 rounded-md transition-colors duration-150 text-muted-foreground hover:text-foreground data-[active]:bg-background data-[active]:text-foreground data-[active]:shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40 focus-visible:ring-offset-1 cursor-pointer"
                data-tab="preview"
            >
                Preview
            </button>
            <button
                class="text-xs font-medium px-3 py-1 rounded-md transition-colors duration-150 text-muted-foreground hover:text-foreground data-[active]:bg-background data-[active]:text-foreground data-[active]:shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40 focus-visible:ring-offset-1 cursor-pointer"
                data-tab="code"
            >
                Code
            </button>
        </div>
        <button
            class="hidden items-center gap-1.5 rounded-md px-2 py-1 text-xs text-muted-foreground transition-colors duration-150 hover:text-foreground cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40 focus-visible:ring-offset-1"
            data-copy-btn
            aria-label="Copy code"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-copy"
            >
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                <path
                    d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
                ></path>
            </svg>
            <span data-copy-label>Copy</span>
        </button>
    </div>

    <div
        class:list={[
            "p-8 min-h-[200px] w-full flex items-center preview-container bg-background/50 relative overflow-hidden transition-all duration-300 ease-in-out",
            align === "center"
                ? "justify-center"
                : align === "start"
                  ? "justify-start"
                  : "justify-end",
        ]}
    >
        <div
            class="absolute inset-0 -z-10 h-full w-full bg-white dark:bg-slate-950 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] dark:bg-[radial-gradient(#1f2937_1px,transparent_1px)] [background-size:16px_16px]"
        >
        </div>
        <slot />
    </div>

    <div
        class="hidden border-t border-border/40 p-4 code-container relative animate-fade-in"
    >
        <div
            class="overflow-x-auto rounded-lg border border-border/40 max-h-[500px]"
        >
            <Code code={code} lang="html" class="text-sm font-mono" />
        </div>
    </div>
</div>

<style>
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-4px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .animate-fade-in {
        animation: fadeIn 0.3s ease-out forwards;
    }
</style>

<script>
    function setupPreviews() {
        const previews = document.querySelectorAll("[data-component-preview]");

        previews.forEach((preview) => {
            const previewBtn = preview.querySelector('[data-tab="preview"]');
            const codeBtn = preview.querySelector('[data-tab="code"]');
            const previewContainer =
                preview.querySelector(".preview-container");
            const codeContainer = preview.querySelector(".code-container");
            const copyBtn = preview.querySelector(
                "[data-copy-btn]",
            ) as HTMLButtonElement | null;
            const copyLabel = copyBtn?.querySelector("[data-copy-label]");
            const codeBlock = codeContainer?.querySelector("pre");

            if (!previewBtn || !codeBtn || !previewContainer || !codeContainer)
                return;

            // Set initial state
            previewBtn.setAttribute("data-active", "true");
            previewContainer.classList.remove("hidden");
            previewContainer.classList.add("flex");

            previewBtn.addEventListener("click", () => {
                previewBtn.setAttribute("data-active", "true");
                codeBtn.removeAttribute("data-active");

                previewContainer.classList.remove("hidden");
                previewContainer.classList.add("flex");
                codeContainer.classList.add("hidden");

                // Hide copy button
                copyBtn?.classList.add("hidden");
                copyBtn?.classList.remove("inline-flex");
            });

            codeBtn.addEventListener("click", () => {
                codeBtn.setAttribute("data-active", "true");
                previewBtn.removeAttribute("data-active");

                previewContainer.classList.add("hidden");
                previewContainer.classList.remove("flex");
                codeContainer.classList.remove("hidden");

                // Show copy button
                copyBtn?.classList.remove("hidden");
                copyBtn?.classList.add("inline-flex");
            });

            copyBtn?.addEventListener("click", async () => {
                const codeText = codeBlock?.textContent || "";

                try {
                    await navigator.clipboard.writeText(codeText);

                    if (copyLabel) {
                        copyLabel.textContent = "Copied!";
                        setTimeout(() => {
                            copyLabel.textContent = "Copy";
                        }, 2000);
                    }
                } catch (err) {
                    console.error("Failed to copy!", err);
                }
            });
        });
    }

    setupPreviews();
    document.addEventListener("astro:page-load", setupPreviews);
</script>
