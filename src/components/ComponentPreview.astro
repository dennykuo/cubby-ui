---
import { Code } from "astro-expressive-code/components";

interface Props {
    class?: string;
    code?: string;
    align?: "center" | "start" | "end";
}

const { class: className, code = "", align = "center" } = Astro.props;
---

<div
    class:list={[
        "group relative rounded-xl border border-border bg-background shadow-sm",
        className,
    ]}
    data-component-preview
>
    <div
        class="flex items-center justify-between border-b border-border/50 px-4 py-3 bg-muted/20 backdrop-blur-sm"
    >
        <div class="flex items-center gap-2">
            <div class="flex items-center gap-1 p-1 bg-muted/50 rounded-lg">
                <button
                    class="text-xs font-medium px-3 py-1.5 rounded-md transition-all duration-200 text-muted-foreground hover:text-foreground data-[active]:bg-background data-[active]:text-foreground data-[active]:shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1"
                    data-tab="preview"
                >
                    Preview
                </button>
                <button
                    class="text-xs font-medium px-3 py-1.5 rounded-md transition-all duration-200 text-muted-foreground hover:text-foreground data-[active]:bg-background data-[active]:text-foreground data-[active]:shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1"
                    data-tab="code"
                >
                    Code
                </button>
            </div>
        </div>
    </div>

    <div
        class:list={[
            "p-10 min-h-[350px] w-full flex items-center preview-container bg-background/50 relative overflow-hidden transition-all duration-300 ease-in-out",
            align === "center"
                ? "justify-center"
                : align === "start"
                  ? "justify-start"
                  : "justify-end",
        ]}
    >
        <div
            class="absolute inset-0 -z-10 h-full w-full bg-white dark:bg-slate-950 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] dark:bg-[radial-gradient(#1f2937_1px,transparent_1px)] [background-size:16px_16px]"
        >
        </div>
        <slot />
    </div>

    <div
        class="hidden border-t border-border/50 bg-muted/5 p-4 code-container relative animate-fade-in"
    >
        <div class="absolute right-4 top-4 z-10">
            <button
                class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-input bg-background/80 backdrop-blur-sm text-muted-foreground shadow-sm hover:bg-accent hover:text-accent-foreground transition-all duration-200 active:scale-95"
                data-copy-btn
                aria-label="Copy code"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="lucide lucide-copy transition-all duration-200 scale-100 data-[hidden]:scale-0 data-[hidden]:opacity-0 absolute"
                >
                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"
                    ></rect>
                    <path
                        d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
                    ></path>
                </svg>
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="lucide lucide-check transition-all duration-200 scale-0 opacity-0 data-[visible]:scale-100 data-[visible]:opacity-100 text-green-500 absolute"
                >
                    <path d="M20 6 9 17l-5-5"></path>
                </svg>
            </button>
        </div>
        <div
            class="overflow-x-auto rounded-lg border border-border/50 bg-background shadow-inner max-h-[500px]"
        >
            <Code code={code} lang="html" class="text-sm font-mono" />
        </div>
    </div>
</div>

<style>
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-4px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .animate-fade-in {
        animation: fadeIn 0.3s ease-out forwards;
    }
</style>

<script>
    function setupPreviews() {
        const previews = document.querySelectorAll("[data-component-preview]");

        previews.forEach((preview) => {
            const previewBtn = preview.querySelector('[data-tab="preview"]');
            const codeBtn = preview.querySelector('[data-tab="code"]');
            const previewContainer =
                preview.querySelector(".preview-container");
            const codeContainer = preview.querySelector(".code-container");
            const copyBtn = preview.querySelector("[data-copy-btn]");
            const copyIcon = copyBtn?.querySelector(".lucide-copy");
            const checkIcon = copyBtn?.querySelector(".lucide-check");
            // Find the code inside the expressive-code output.
            // Expressive Code usually renders a specific structure.
            // We'll try to find the text content reasonably.
            // Often it renders inside <pre><code>...</code></pre>
            const codeBlock = codeContainer?.querySelector("pre");

            if (!previewBtn || !codeBtn || !previewContainer || !codeContainer)
                return;

            // Set initial state
            previewBtn.setAttribute("data-active", "true");
            previewContainer.classList.remove("hidden");
            previewContainer.classList.add("flex");

            previewBtn.addEventListener("click", () => {
                previewBtn.setAttribute("data-active", "true");
                codeBtn.removeAttribute("data-active");

                previewContainer.classList.remove("hidden");
                previewContainer.classList.add("flex");
                codeContainer.classList.add("hidden");
            });

            codeBtn.addEventListener("click", () => {
                codeBtn.setAttribute("data-active", "true");
                previewBtn.removeAttribute("data-active");

                previewContainer.classList.add("hidden");
                previewContainer.classList.remove("flex");
                codeContainer.classList.remove("hidden");
            });

            copyBtn?.addEventListener("click", async () => {
                const codeText = codeBlock?.textContent || "";

                try {
                    await navigator.clipboard.writeText(codeText);

                    // Show check icon
                    copyIcon?.setAttribute("data-hidden", "true");
                    checkIcon?.setAttribute("data-visible", "true");

                    setTimeout(() => {
                        // Revert
                        copyIcon?.removeAttribute("data-hidden");
                        checkIcon?.removeAttribute("data-visible");
                    }, 2000);
                } catch (err) {
                    console.error("Failed to copy!", err);
                }
            });
        });
    }

    setupPreviews();
    document.addEventListener("astro:page-load", setupPreviews);
</script>
