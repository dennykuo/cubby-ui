---
/**
 * 文檔頁面共用的 section 標題（帶 anchor 連結）。
 * 渲染結果與原本各頁 inline 的 h2 anchor heading 完全一致，
 * 收斂 95 個元件頁面中重複 600+ 次的相同結構。
 */
interface Props {
  id: string;
  title?: string;
}
const { id, title } = Astro.props;
---
<h2 id={id} class="text-lg font-semibold tracking-tight relative group">
  <a
    href={`#${id}`}
    class="absolute -left-5 text-muted-foreground/0 group-hover:text-muted-foreground transition-colors duration-150"
    >#</a
  >
  {title ?? <slot />}
</h2>
