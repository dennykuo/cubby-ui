---
import { TOP_CLASS } from "../../config";

interface Props {
	min?: number;
	max?: number;
	step?: number;
	value?: number;
	disabled?: boolean;
	class?: string;
	[key: string]: any;
}

const { min, max, step = 1, value = 0, disabled = false, class: className, ...rest } = Astro.props;
const baseClass = `${TOP_CLASS}-number-input`;
const disabledClass = disabled ? `${TOP_CLASS}-number-input-disabled` : undefined;
---

<div class:list={[baseClass, disabledClass, className]} data-cu-number-input>
	<button class={`${TOP_CLASS}-number-input-button`} data-cu-number-decrement disabled={disabled}>
		<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/></svg>
	</button>
	<input
		class={`${TOP_CLASS}-number-input-field`}
		data-cu-number-field
		type="number"
		value={value}
		min={min}
		max={max}
		step={step}
		disabled={disabled}
		{...rest}
	/>
	<button class={`${TOP_CLASS}-number-input-button`} data-cu-number-increment disabled={disabled}>
		<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
	</button>
</div>
