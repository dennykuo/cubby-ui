---
import { TOP_CLASS } from "../../config";

interface Props {
    orientation?: "horizontal" | "vertical";
    class?: string;
    [key: string]: any;
}

const { orientation = "horizontal", class: className, ...rest } = Astro.props;
const baseClass = `${TOP_CLASS}-separator`;
const orientationClass = `${TOP_CLASS}-separator-${orientation}`;
---

<div role="separator" aria-orientation={orientation} class:list={[baseClass, orientationClass, className]} {...rest}></div>
