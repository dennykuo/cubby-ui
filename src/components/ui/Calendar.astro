---
import { TOP_CLASS } from "../../config";

interface Props {
	min?: string;
	max?: string;
	/** 星期列文字（週日起 7 個），預設英文；月份標題與日期名稱則由 JS 依 lang / data-cu-calendar-locale 產生 */
	weekdays?: string[];
	class?: string;
	[key: string]: any;
}

const { min, max, weekdays = ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"], class: className, ...rest } = Astro.props;
---

<div
	class:list={[`${TOP_CLASS}-calendar`, className]}
	data-cu-calendar
	data-cu-calendar-min={min}
	data-cu-calendar-max={max}
	{...rest}
>
	<div class={`${TOP_CLASS}-calendar-header`}>
		<button type="button" class={`${TOP_CLASS}-calendar-nav`} data-cu-calendar-prev aria-label="Previous month">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
		</button>
		<span class={`${TOP_CLASS}-calendar-title`} data-cu-calendar-title></span>
		<button type="button" class={`${TOP_CLASS}-calendar-nav`} data-cu-calendar-next aria-label="Next month">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
		</button>
	</div>
	<div class={`${TOP_CLASS}-calendar-weekdays`}>
		{weekdays.map((day) => (
			<span class={`${TOP_CLASS}-calendar-weekday`}>{day}</span>
		))}
	</div>
	<div class={`${TOP_CLASS}-calendar-grid`} data-cu-calendar-grid></div>
</div>
