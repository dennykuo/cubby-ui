---
import { TOP_CLASS } from "../../config";

interface Props {
    type?: "disc" | "decimal";
    class?: string;
    [key: string]: any;
}

const { type = "disc", class: className, ...rest } = Astro.props;

const Tag = type === "decimal" ? "ol" : "ul";
const baseClass = `${TOP_CLASS}-list`;
const typeClass = `${TOP_CLASS}-list-${type}`;
---

<Tag class:list={[baseClass, typeClass, className]} {...rest}>
    <slot />
</Tag>
