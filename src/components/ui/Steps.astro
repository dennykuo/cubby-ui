---
import { TOP_CLASS } from "../../config";

interface Props {
	vertical?: boolean;
	class?: string;
	[key: string]: any;
}

const { vertical = false, class: className, ...rest } = Astro.props;
const baseClass = `${TOP_CLASS}-steps`;
---

<div class:list={[baseClass, vertical && `${baseClass}-vertical`, className]} {...rest}>
	<slot />
</div>
