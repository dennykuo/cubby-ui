---
interface Props {
	target: string;
	label?: string;
	breakpoint?: "sm" | "md" | "lg" | "xl" | "always";
	class?: string;
	[key: string]: any;
}

const { target, label = "Open menu", breakpoint = "md", class: className, ...rest } = Astro.props;

const breakpointClass = breakpoint === "always" ? "" : `${breakpoint}:hidden`;
---

<button
	data-cu-mobile-nav-trigger={target}
	class:list={["cu-button cu-button-ghost cu-button-icon-sm", breakpointClass, className]}
	aria-label={label}
	aria-expanded="false"
	{...rest}
>
	<slot>
		<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
	</slot>
</button>
