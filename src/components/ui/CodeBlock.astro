---
import { TOP_CLASS } from "../../config";

interface Props {
	language?: string;
	filename?: string;
	theme?: "dark" | "light";
	/** 舊名,建議改用 theme;保留以向後相容 */
	variant?: "dark" | "light";
	class?: string;
	[key: string]: any;
}

const { language, filename, theme, variant, class: className, ...rest } = Astro.props;
const codeTheme = theme ?? variant ?? "dark";
const hasHeader = !!(language || filename);
const langClass = language ? `language-${language.toLowerCase()}` : undefined;
---

<div class:list={[`${TOP_CLASS}-code-block`, codeTheme === "light" && `${TOP_CLASS}-code-block-light`, className]} data-cu-code-block {...rest}>
    {hasHeader ? (
        <div class={`${TOP_CLASS}-code-block-header`}>
            <span>{filename || language}</span>
            <button type="button" class={`${TOP_CLASS}-code-block-copy`} data-cu-code-block-copy>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                <span data-cu-code-block-label>Copy</span>
            </button>
        </div>
    ) : (
        <button type="button" class={`${TOP_CLASS}-code-block-copy`} data-cu-code-block-copy>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            <span data-cu-code-block-label>Copy</span>
        </button>
    )}
    <pre class={`${TOP_CLASS}-code-block-pre`}><code class={langClass}><slot /></code></pre>
</div>
