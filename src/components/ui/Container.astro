---
import { TOP_CLASS } from "../../config";

interface Props {
	size?: "sm" | "md" | "lg" | "xl" | "2xl" | "prose";
	class?: string;
	[key: string]: any;
}

const { size, class: className, ...rest } = Astro.props;

const baseClass = `${TOP_CLASS}-container`;
const sizeClass = size ? `${TOP_CLASS}-container-${size}` : "";

---

<div class:list={[baseClass, sizeClass, className]} {...rest}>
	<slot />
</div>
