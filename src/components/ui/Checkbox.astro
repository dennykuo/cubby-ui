---
import type { HTMLAttributes } from "astro/types";
import { TOP_CLASS } from "../../config";

// type 固定為 checkbox
interface Props extends Omit<HTMLAttributes<"input">, "type"> {
	class?: string;
}

const { class: className, ...rest } = Astro.props;
const baseClass = `${TOP_CLASS}-checkbox`;
---

<input type="checkbox" class:list={[baseClass, className]} {...rest} />
