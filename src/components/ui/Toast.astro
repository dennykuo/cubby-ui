---
import { TOP_CLASS } from "../../config";
import type { FeedbackVariant } from "../../types";

interface Props {
    variant?: FeedbackVariant;
    class?: string;
    [key: string]: any;
}

const { variant = "default", class: className, ...rest } = Astro.props;
const baseClass = `${TOP_CLASS}-toast`;
const variantClass = `${TOP_CLASS}-toast-${variant}`;
---

<div class:list={[baseClass, variantClass, className]} {...rest}>
    <slot />
</div>
