---
import { TOP_CLASS } from "../../config";

interface Props {
    /** 要複製的文字（data-cu-copy） */
    value?: string;
    /** 改為複製目標元素的內容：CSS selector（data-cu-copy-target） */
    target?: string;
    variant?: "default" | "outline";
    size?: "default" | "sm" | "lg";
    class?: string;
    /** 純圖示按鈕請傳 aria-label；可在 slot 放 <span data-cu-copy-label>Copy</span> 顯示文字 */
    [key: string]: any;
}

const { value, target, variant, size, class: className, ...rest } = Astro.props;

const baseClass = `${TOP_CLASS}-copy-button`;
const variantClass = variant && variant !== "default" ? `${TOP_CLASS}-copy-button-${variant}` : undefined;
const sizeClass = size && size !== "default" ? `${TOP_CLASS}-copy-button-${size}` : undefined;
---

<button type="button" data-cu-copy={value} data-cu-copy-target={target} class:list={[baseClass, variantClass, sizeClass, className]} {...rest}>
    <svg class={`${TOP_CLASS}-copy-button-icon`} xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
    <svg class={`${TOP_CLASS}-copy-button-check`} xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
    <slot />
</button>
