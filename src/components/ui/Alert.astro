---
import { TOP_CLASS } from "../../config";

interface Props {
    variant?: "default" | "destructive" | "success" | "warning" | "info";
    class?: string;
    [key: string]: any;
}

const { variant = "default", class: className, ...rest } = Astro.props;

const baseClass = `${TOP_CLASS}-alert`;
const variantClass = `${TOP_CLASS}-alert-${variant}`;
---

<div role="alert" class:list={[baseClass, variantClass, className]} {...rest}>
    <slot />
</div>
