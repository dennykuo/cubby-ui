---
import { TOP_CLASS } from "../../config";

interface Props {
	active?: boolean;
	class?: string;
	[key: string]: any;
}

const { active = false, class: className, ...rest } = Astro.props;
const baseClass = `${TOP_CLASS}-toolbar-button`;
const activeClass = `${TOP_CLASS}-toolbar-button-active`;
---

<button class:list={[baseClass, active && activeClass, className]} {...rest}>
	<slot />
</button>
