---
import { TOP_CLASS } from "../../config";

interface Props {
    size?: "sm" | "md" | "default" | "xl" | "full";
    class?: string;
    [key: string]: any;
}

const { size, class: className, ...rest } = Astro.props;
const baseClass = `${TOP_CLASS}-dialog`;
const sizeClass = size && size !== "default" ? `${TOP_CLASS}-dialog-${size}` : undefined;
---

<dialog class:list={[baseClass, sizeClass, className]} data-cu-dialog {...rest}>
    <slot />
</dialog>
