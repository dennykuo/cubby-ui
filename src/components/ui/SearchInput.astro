---
import { TOP_CLASS } from "../../config";

interface Props {
	class?: string;
	[key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<div class:list={[`${TOP_CLASS}-input-search`, className]}>
    <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class={`${TOP_CLASS}-input-search-icon`}
    >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
    </svg>
    <input class={`${TOP_CLASS}-input-search-field`} type="search" {...rest} />
</div>
