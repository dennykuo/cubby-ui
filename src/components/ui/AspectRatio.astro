---
import { TOP_CLASS } from "../../config";

interface Props {
    ratio?: "16/9" | "4/3" | "1/1" | "21/9";
    class?: string;
    [key: string]: any;
}

const { ratio = "16/9", class: className, ...rest } = Astro.props;

const baseClass = `${TOP_CLASS}-aspect-ratio`;
const ratioClass = `${TOP_CLASS}-aspect-ratio-${ratio}`;
---

<div class:list={[baseClass, ratioClass, className]} {...rest}>
    <slot />
</div>
