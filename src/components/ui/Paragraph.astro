---
import { TOP_CLASS } from "../../config";

interface Props {
    variant?: "default" | "lead";
    class?: string;
    [key: string]: any;
}

const { variant = "default", class: className, ...rest } = Astro.props;

const baseClass = `${TOP_CLASS}-p`;
const variantClass = variant === "lead" ? `${TOP_CLASS}-p-lead` : "";
---

<p class:list={[baseClass, variantClass, className]} {...rest}>
    <slot />
</p>
