---
import { TOP_CLASS } from "../../config";

interface Props {
	side: "left" | "right";
	placeholder?: string;
	class?: string;
	[key: string]: any;
}

const { side, placeholder = "Search...", class: className, ...rest } = Astro.props;
---

<div class:list={[`${TOP_CLASS}-transfer-list-search`, className]} {...rest}>
	<svg class={`${TOP_CLASS}-transfer-list-search-icon`} xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
	<input class={`${TOP_CLASS}-transfer-list-search-input`} data-cu-transfer-search={side} type="search" placeholder={placeholder} />
</div>
