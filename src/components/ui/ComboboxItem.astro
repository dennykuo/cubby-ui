---
import { TOP_CLASS } from "../../config";

interface Props {
	value?: string;
	active?: boolean;
	class?: string;
	[key: string]: any;
}

const { value, active = false, class: className, ...rest } = Astro.props;
const baseClass = `${TOP_CLASS}-combobox-item`;
const activeClass = active ? `${TOP_CLASS}-combobox-item-active` : undefined;
---

<div
	class:list={[baseClass, activeClass, className]}
	data-cu-combobox-item
	data-cu-value={value}
	{...rest}
>
	<slot />
</div>
