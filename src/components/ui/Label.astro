---
import type { HTMLAttributes } from "astro/types";
import { TOP_CLASS } from "../../config";

// 延伸原生 <label> 屬性：for / form 等有型別檢查，React 寫法（htmlFor）會在 astro check 報錯
interface Props extends HTMLAttributes<"label"> {
	required?: boolean;
	class?: string;
}

const { required = false, class: className, ...rest } = Astro.props;
const baseClass = `${TOP_CLASS}-label`;
const requiredClass = required ? `${TOP_CLASS}-label-required` : undefined;
---

<label class:list={[baseClass, requiredClass, className]} {...rest}>
    <slot />
</label>
