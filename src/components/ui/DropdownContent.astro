---
import { TOP_CLASS } from "../../config";

interface Props {
    class?: string;
    [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
const baseClass = `${TOP_CLASS}-dropdown-content`;
---

<div class:list={[baseClass, className]} data-cu-dropdown-content hidden {...rest}>
    <slot />
</div>
