---
import { TOP_CLASS } from "../../config";

interface Props {
    size?: "sm" | "md" | "lg";
    class?: string;
    [key: string]: any;
}

const { size = "md", class: className, ...rest } = Astro.props;

const baseClass = `${TOP_CLASS}-avatar`;
const sizeClass = `${TOP_CLASS}-avatar-${size}`;
---

<span class:list={[baseClass, sizeClass, className]} {...rest}>
    <slot />
</span>
