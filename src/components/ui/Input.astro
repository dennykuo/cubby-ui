---
import type { HTMLAttributes } from "astro/types";
import { TOP_CLASS } from "../../config";

// 原生 size（字元寬度）由元件尺寸 prop 取代
interface Props extends Omit<HTMLAttributes<"input">, "size"> {
	size?: "sm" | "default" | "lg";
	variant?: "default" | "error" | "success";
	class?: string;
}

const { size, variant, class: className, ...rest } = Astro.props;
const baseClass = `${TOP_CLASS}-input`;
const sizeClass = size && size !== "default" ? `${TOP_CLASS}-input-${size}` : undefined;
const variantClass = variant && variant !== "default" ? `${TOP_CLASS}-input-${variant}` : undefined;
---

<input class:list={[baseClass, sizeClass, variantClass, className]} {...rest} />
