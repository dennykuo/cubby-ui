---
import { TOP_CLASS } from "../../config";

interface Props {
	size?: "sm" | "default" | "lg";
	class?: string;
	[key: string]: any;
}

const { size, class: className, ...rest } = Astro.props;
const baseClass = `${TOP_CLASS}-input`;
const sizeClass = size && size !== "default" ? `${TOP_CLASS}-input-${size}` : undefined;
---

<input class:list={[baseClass, sizeClass, className]} {...rest} />
