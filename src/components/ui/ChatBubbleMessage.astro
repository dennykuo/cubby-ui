---
import { TOP_CLASS } from "../../config";

interface Props {
    prose?: boolean;
    class?: string;
    [key: string]: any;
}

const { prose = false, class: className, ...rest } = Astro.props;

const baseClass = `${TOP_CLASS}-chat-bubble-message`;
const proseClass = prose ? `${TOP_CLASS}-chat-bubble-message-prose` : undefined;
---

<div class:list={[baseClass, proseClass, className]} {...rest}>
    <slot />
</div>
