---
import { TOP_CLASS } from "../../config";

interface Props {
	class?: string;
	[key: string]: any;
}

const { class: className, ...rest } = Astro.props;
---

<div class:list={[`${TOP_CLASS}-select-wrapper`, className]}>
    <select class={`${TOP_CLASS}-select`} {...rest}>
        <slot />
    </select>
    <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class={`${TOP_CLASS}-select-icon`}
    >
        <path d="m6 9 6 6 6-6"></path>
    </svg>
</div>
