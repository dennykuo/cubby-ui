---
import { TOP_CLASS } from "../../config";

interface Props {
    side?: "right" | "left" | "top" | "bottom";
    class?: string;
    [key: string]: any;
}

const { side = "right", class: className, ...rest } = Astro.props;
const baseClass = `${TOP_CLASS}-drawer`;
const sideClass = `${TOP_CLASS}-drawer-${side}`;
---

<dialog class:list={[baseClass, sideClass, className]} data-cu-drawer {...rest}>
    <slot />
</dialog>
