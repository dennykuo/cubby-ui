---
import { TOP_CLASS } from "../../config";

interface Props {
    active?: boolean;
    class?: string;
    [key: string]: any;
}

const { active = false, class: className, ...rest } = Astro.props;
const baseClass = `${TOP_CLASS}-tabs-trigger`;
const activeClass = `${TOP_CLASS}-tabs-trigger-active`;
---

<button
    role="tab"
    class:list={[baseClass, active && activeClass, className]}
    aria-selected={active}
    {...rest}
>
    <slot />
</button>
