---
import { TOP_CLASS } from "../../config";

interface Props {
	placeholder?: string;
	searchPlaceholder?: string;
	emptyText?: string;
	searchable?: boolean;
	class?: string;
	[key: string]: any;
}

const {
	placeholder = "Select...",
	searchPlaceholder = "Search...",
	emptyText = "No results found.",
	searchable = false,
	class: className,
	...rest
} = Astro.props;
---

<div class:list={[`${TOP_CLASS}-multi-select`, className]} data-cu-multi-select {...rest}>
	<button class={`${TOP_CLASS}-multi-select-trigger`} data-cu-multi-select-trigger>
		<div class={`${TOP_CLASS}-multi-select-tags`} data-cu-multi-select-tags>
			<span class={`${TOP_CLASS}-multi-select-placeholder`} data-cu-multi-select-placeholder>{placeholder}</span>
		</div>
		<svg class={`${TOP_CLASS}-multi-select-icon`} xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
	</button>
	<div class={`${TOP_CLASS}-multi-select-content`} data-cu-multi-select-content hidden>
		{searchable && (
			<div class={`${TOP_CLASS}-multi-select-search`}>
				<svg class={`${TOP_CLASS}-multi-select-search-icon`} xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
				<input class={`${TOP_CLASS}-multi-select-input`} data-cu-multi-select-input placeholder={searchPlaceholder} />
			</div>
		)}
		<div class={`${TOP_CLASS}-multi-select-list`} data-cu-multi-select-list>
			<div class={`${TOP_CLASS}-multi-select-empty`} data-cu-multi-select-empty hidden>{emptyText}</div>
			<slot />
		</div>
	</div>
</div>
