---
import { TOP_CLASS } from "../../config";
import type { FeedbackVariant } from "../../types";

interface Props {
    variant?: FeedbackVariant;
    unread?: boolean;
    class?: string;
    [key: string]: any;
}

const { variant, unread, class: className, ...rest } = Astro.props;
const baseClass = `${TOP_CLASS}-notification`;
const variantClass = variant && variant !== "default" ? `${baseClass}-${variant}` : undefined;
const unreadClass = unread ? `${baseClass}-unread` : undefined;
---

<div class:list={[baseClass, variantClass, unreadClass, className]} {...rest}>
    <slot />
</div>
