---
import { TOP_CLASS } from "../../config";

interface Props {
	disabled?: boolean;
	multiple?: boolean;
	accept?: string;
	class?: string;
	[key: string]: any;
}

const { disabled = false, multiple = false, accept, class: className, ...rest } = Astro.props;
const baseClass = `${TOP_CLASS}-dropzone`;
const disabledClass = disabled ? `${TOP_CLASS}-dropzone-disabled` : undefined;
---

<div class:list={[baseClass, disabledClass, className]} data-cu-dropzone {...rest}>
	<input type="file" data-cu-dropzone-input hidden multiple={multiple} accept={accept} />
	<slot />
</div>
