---
import { TOP_CLASS } from "../../config";

interface Props {
	id: string;
	label?: string;
	clone?: boolean;
	class?: string;
	[key: string]: any;
}

const { id, label = "Navigation menu", clone = false, class: className, ...rest } = Astro.props;
const panelId = `${id}-panel`;
---

<div id={id} class:list={[`${TOP_CLASS}-header-mobile-backdrop`, className]} data-cu-mobile-nav></div>
<nav
	id={panelId}
	class:list={[`${TOP_CLASS}-header-mobile-nav`]}
	data-cu-mobile-nav-panel={id}
	{...(clone ? { "data-cu-mobile-nav-clone": "" } : {})}
	role="dialog"
	aria-modal="true"
	aria-label={label}
	{...rest}
>
	<div class={`${TOP_CLASS}-header-mobile-header`}>
		<slot name="header">
			<span class="text-base font-semibold tracking-tight"><slot name="brand" /></span>
		</slot>
		<button data-cu-mobile-nav-close class={`${TOP_CLASS}-header-mobile-close`} aria-label="Close menu">
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
			<span class="sr-only">Close</span>
		</button>
	</div>
	<div class={`${TOP_CLASS}-header-mobile-content`}>
		<slot />
	</div>
</nav>
