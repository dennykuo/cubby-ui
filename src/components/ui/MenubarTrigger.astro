---
import { TOP_CLASS } from "../../config";

interface Props {
    class?: string;
    [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
const baseClass = `${TOP_CLASS}-menubar-trigger`;
---

<button class:list={[baseClass, className]} data-cu-menubar-trigger aria-expanded="false" {...rest}>
    <slot />
</button>
