---
import { TOP_CLASS } from "../../config";

interface Props {
    class?: string;
    [key: string]: any;
}

const { class: className, ...rest } = Astro.props;
const baseClass = `${TOP_CLASS}-breadcrumb-current`;
---

<li class:list={[`${TOP_CLASS}-breadcrumb-item`, className]} {...rest}>
    <span class={baseClass} aria-current="page">
        <slot />
    </span>
</li>
