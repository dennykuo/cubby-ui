---
import { TOP_CLASS } from "../../config";

interface Props {
    disabled?: boolean;
    class?: string;
    [key: string]: any;
}

const { disabled = false, class: className, ...rest } = Astro.props;

const baseClass = `${TOP_CLASS}-input-group`;
const disabledClass = disabled ? `${TOP_CLASS}-input-group-disabled` : "";
---

<div class:list={[baseClass, disabledClass, className]} {...rest}>
    <slot />
</div>
