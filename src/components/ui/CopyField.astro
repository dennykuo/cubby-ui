---
import { TOP_CLASS } from "../../config";

interface Props {
    /** 淡底、無陰影（指令片段常用） */
    muted?: boolean;
    /** 多行片段：保留換行、可水平捲動、按鈕靠上 */
    multiline?: boolean;
    class?: string;
    [key: string]: any;
}

const { muted, multiline, class: className, ...rest } = Astro.props;

const baseClass = `${TOP_CLASS}-copy-field`;
const mutedClass = muted ? `${TOP_CLASS}-copy-field-muted` : undefined;
const multilineClass = multiline ? `${TOP_CLASS}-copy-field-multiline` : undefined;
---

<div class:list={[baseClass, mutedClass, multilineClass, className]} {...rest}>
    <slot />
</div>
