---
import { TOP_CLASS } from "../../config";

interface Props {
	class?: string;
	[key: string]: any;
}

const { class: className, ...rest } = Astro.props;
const baseClass = `${TOP_CLASS}-checkbox-group`;
---

<div class:list={[baseClass, className]} data-cu-checkbox-group {...rest}>
	<slot />
</div>
