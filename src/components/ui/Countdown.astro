---
import { TOP_CLASS } from "../../config";

interface Props {
    size?: "sm" | "default" | "lg";
    variant?: "default" | "flush";
    class?: string;
    [key: string]: any;
}

const { size, variant, class: className, ...rest } = Astro.props;
const baseClass = `${TOP_CLASS}-countdown`;
const sizeClass = size && size !== "default" ? `${baseClass}-${size}` : undefined;
const variantClass = variant === "flush" ? `${baseClass}-flush` : undefined;
---

<div
    class:list={[baseClass, sizeClass, variantClass, className]}
    data-cu-countdown
    {...rest}
>
    <slot />
</div>
