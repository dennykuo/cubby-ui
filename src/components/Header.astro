---
import type { Locale } from "@/i18n";
import { getAlternatePath, localizePath } from "@/i18n";
import { uiTranslations } from "@/i18n/ui";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = uiTranslations[locale];
const currentPath = Astro.url.pathname;
const normalizedPath = currentPath.endsWith("/") && currentPath.length > 1
	? currentPath.slice(0, -1)
	: currentPath;
const enHref = getAlternatePath(normalizedPath, 'en');
const zhHref = getAlternatePath(normalizedPath, 'zh-tw');
const homeHref = localizePath('/', locale);
---

<header class="cu-header">
	<div class="flex h-14 items-center justify-between px-4 sm:px-6 md:pl-9 lg:pl-11 lg:pr-8">
		<div class="flex items-center gap-1">
		<!-- Hamburger (mobile only) -->
		<button
			class="inline-flex size-11 items-center justify-center rounded-lg text-muted-foreground transition-colors duration-150 hover:text-foreground cursor-pointer md:hidden -ml-2"
			data-cu-mobile-nav-open
			aria-label={t.openMenu}
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
		</button>
		<a class="cu-header-brand" href={homeHref}>
			<svg
				width="22"
				height="22"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.5"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="text-primary"
			>
				<path
					d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
				></path>
				<polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
				<line x1="12" y1="22.08" x2="12" y2="12"></line>
			</svg>
			<span class="text-base font-semibold tracking-tight">
				Cubby UI
			</span>
		</a>
		</div>

		<!-- Search trigger -->
		<button class="hidden sm:inline-flex items-center gap-2 rounded-lg border border-border bg-background/60 px-3 py-1.5 text-sm text-muted-foreground transition-colors duration-150 hover:bg-muted/60 hover:text-foreground w-56 cursor-pointer">
			<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
			<span class="flex-1 text-left text-xs">{t.searchPlaceholder}</span>
			<kbd class="text-[10px] border border-border rounded px-1.5 py-0.5 bg-muted font-sans">⌘K</kbd>
		</button>

		<div class="cu-header-actions">
			<!-- Language switcher -->
			<div class="cu-dropdown" data-cu-dropdown>
				<button
					class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-muted-foreground transition-colors duration-150 hover:text-foreground cursor-pointer"
					data-cu-dropdown-trigger
					aria-label={t.switchLanguageLabel}
					title={t.switchLanguageLabel}
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
				</button>
				<div class="cu-dropdown-content right-0" data-cu-dropdown-content hidden>
					<a href={enHref} class:list={["cu-dropdown-item", locale === 'en' && "bg-accent/50 text-accent-foreground"]}>
						English
					</a>
					<a href={zhHref} class:list={["cu-dropdown-item", locale === 'zh-tw' && "bg-accent/50 text-accent-foreground"]}>
						繁體中文
					</a>
				</div>
			</div>

			<!-- Dark mode toggle -->
			<button
				class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-muted-foreground transition-colors duration-150 hover:text-foreground cursor-pointer"
				data-cu-theme-toggle
				aria-label={t.toggleDarkMode}
			>
				<!-- Sun icon (shown in light mode) -->
				<svg class="dark:hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
				<!-- Moon icon (shown in dark mode) -->
				<svg class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
			</button>

			<a
				href="https://github.com/dennykuo/cubby-ui"
				target="_blank"
				rel="noreferrer"
				class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-muted-foreground transition-colors duration-150 hover:text-foreground"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="currentColor"
				>
					<path
						d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
					></path>
				</svg>
				<span class="sr-only">GitHub</span>
			</a>
		</div>
	</div>
</header>

<script>
	function setupThemeToggle() {
		document.querySelectorAll('[data-cu-theme-toggle]').forEach((btn) => {
			btn.addEventListener('click', () => {
				document.documentElement.classList.toggle('dark');
				const isDark = document.documentElement.classList.contains('dark');
				localStorage.setItem('theme', isDark ? 'dark' : 'light');
			});
		});
	}

	// Restore theme on load
	(function() {
		const saved = localStorage.getItem('theme');
		if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
			document.documentElement.classList.add('dark');
		}
	})();

	setupThemeToggle();
	document.addEventListener('astro:page-load', setupThemeToggle);
</script>
